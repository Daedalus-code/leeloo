################################################################################

# shellcheck disable=SC2034  # Unused variables left for readability

# set the locale to "C" to use a decimal point as the separator
export LC_NUMERIC=C
# set ncurses no utf9 acs to fix dialog tearing in macos terminal
export NCURSES_NO_UTF8_ACS=1

################################################################################

# color
source /usr/local/bin/include/leeloo/color
# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges
# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi

################################################################################

exchange_template
account_private_api
account_public_api
repo_head_data
system_load
system_date
log_date_xargs

################################################################################

clear

# menu

EXTRA_WIDTH="$(echo "$ERROR_STATUS" | wc -L)"

HEIGHT=21
WIDTH="$(echo "43+$EXTRA_WIDTH" | bc 2>/dev/null)"
CHOICE_HEIGHT=13
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $DATE_XARGS
Load: $LOAD :: $REPO_HEAD $REPO_DATE"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup Order"
  5 "Update           New Law & Order"
  H "History          Manual History"
  L "Debug            Leeloo Logs ($ERROR_STATUS)"
  7 "Config           Configurations"
  A "Robot            Auto Strategy"
  C "Chat             Chat Menu"
  I "Check            Indicators"
  D "Donate           Donation"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

################################################################################

# balance

"1")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then

    HEIGHT=11
    WIDTH=24
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Account Balances"
    MENU="$DATE"

    OPTIONS=(1 "Poloniex"
      2 "SouthXchange"
      3 "StakeCube"
      4 "XeggeX")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    # poloniex balances ########################################################

    "1")

      EXCHANGE_BALANCE="poloniex"
      exchange_balance

      ;;

      # southxchange balances ##################################################

    "2")

      EXCHANGE_BALANCE="southxchange"
      exchange_balance

      ;;

      # stakecube balances #####################################################

    "3")

      EXCHANGE_BALANCE="stakecube"
      exchange_balance

      ;;

      # xeggex balances ########################################################

    "4")

      EXCHANGE_BALANCE="xeggex"
      exchange_balance

      ;;

    esac

  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # prices

"2")

  HEIGHT=11
  WIDTH=24
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Prices"
  MENU="$DATE"

  OPTIONS=(1 "Poloniex"
    2 "SouthXchange"
    3 "StakeCube"
    4 "XeggeX")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # poloniex prices ############################################################

  "1")

    OBSERVE_MARKET="poloniex"
    observe_market

    ;;

    # southxchange prices ######################################################

  "2")

    OBSERVE_MARKET="southxchange"
    observe_market

    ;;

    # stakecube prices #########################################################

  "3")

    OBSERVE_MARKET="stakecube"
    observe_market

    ;;

    # xeggex prices ############################################################

  "4")

    OBSERVE_MARKET="xeggex"
    observe_market

    ;;

  esac

  ;;

  ##############################################################################

  # search market

"3")

  HEIGHT=11
  WIDTH=24
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Search"
  MENU="$DATE"

  OPTIONS=(1 "Poloniex"
    2 "SouthXchange"
    3 "StakeCube"
    4 "XeggeX")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # poloniex search ############################################################

  "1")

    SEARCH_MARKET="poloniex"
    search_market

    ;;

    # southxchange search ######################################################

  "2")

    SEARCH_MARKET="southxchange"
    search_market

    ;;

    # stakecube search #########################################################

  "3")

    SEARCH_MARKET="stakecube"
    search_market

    ;;

    # xeggex search ############################################################

  "4")

    SEARCH_MARKET="xeggex"
    search_market

    ;;

  esac

  ;;

  ##############################################################################

  # orders

"4")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then

    HEIGHT=11
    WIDTH=24
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Orders"
    MENU="$DATE"

    OPTIONS=(1 "Poloniex"
      2 "SouthXchange"
      3 "StakeCube"
      4 "XeggeX")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1") # poloniex menu

      # set exchange template
      EXCHANGE_API="POL"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    "2") # southxchange menu

      # set exchange template
      EXCHANGE_API="SXC"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    "3") # stakecube menu

      # set exchange template
      EXCHANGE_API="SCE"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    "4") # xeggex menu

      # set exchange template
      EXCHANGE_API="XGX"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    esac

  else
    no_key_no_secret
  fi

  # set exchange template
  EXCHANGE_API=""
  exchange_template

  ;;

  ##############################################################################

  # update repo

"5")

  ##############################################################################

  update_screen

  ##############################################################################

  ### cleanup old junk ###
  if [[ -f "${LOG_DIR:?}"/leeloo/robot.broker.log || -f "${LOG_DIR:?}"/leeloo/looper.log ]] &>/dev/null; then
    echo "Removing old junk.."
    sudo rm "${LOG_DIR:?}"/leeloo/robot.broker.log &>/dev/null
    sudo rm "${LOG_DIR:?}"/leeloo/looper.log &>/dev/null
    sleep 1
  fi

  ##############################################################################

  display_result() {
    dialog --title "Updating Leeloo (Multipass)" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && git pull >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

  # any updates relating to the auto strategies system, restart
  UPDATE_KEYS="looper|leeloo|functions|private_API|public_API"
  if [[ "$(egrep "$UPDATE_KEYS" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | grep '[+-]' | wc -l)" -gt "0" ]] &>/dev/null; then
    ROBOT_UPDATES="$(egrep "$UPDATE_KEYS" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | awk '{ print $3,$4 }')"
    echo " New updates! $ROBOT_UPDATES" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

    if [[ "$(echo "$SCREEN_LIST" | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
      echo " Robot stopping! --" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
      # kill leeloo pid (shell)
      echo "$(ps aux 2>/dev/null | grep "leeloo" | awk '{ print $2 }' | xargs)" >"${LOG_DIR:?}"/leeloo/ps_aux
      LEELOO_PID="$(cat "${LOG_DIR:?}"/leeloo/ps_aux 2>/dev/null)"
      kill -9 "$LEELOO_PID" &>/dev/null
      # kill screen
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit &>/dev/null
      sleep 1
      # start looper
      bash "${SYS_DIR:?}"/robot/looper
      echo " Robot starting! ++" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
    fi
  fi

  # if any updates, skip
  if [[ ! "$(grep "Updating" "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    echo "
$(echo "$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null) $REPO_HEAD")" >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
  fi

  RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
  display_result 2>/dev/null
  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && bash include/install 2>/dev/null
  rm "${LOG_DIR:?}"/leeloo/repo &>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git rev-parse --short HEAD 2>&1 | grep -Eo '[a0-z9]{7}' 2>&1 | head -1 >"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git log -1 --format="%at" | xargs -I{} date -d @{} '+%Y' >>"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  clear

  if [[ ! "$(grep "Already up to date." "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    exit
  fi

  ;;

  ##############################################################################

  # manual history

"H")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then
    last_log
  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # error.log

"L")

  update_screen

  display_result() {
    dialog --title "Leeloo/Strategy Debug" \
      --no-collapse \
      --msgbox "$RESULT" 16 "$WIDTH"
  }

  ##############################################################################

  # system uptime
  function system_uptime() {
    if [[ -f /proc/uptime ]] &>/dev/null; then

      # get uptime, idletime
      echo "$(cat /proc/uptime 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/system
      CAT_SYSTEM="$(cat "${LOG_DIR:?}"/leeloo/system 2>/dev/null)"

      # system files
      FILE_SYSTEM_UPTIME="${LOG_DIR:?}/leeloo/system.uptime"
      FILE_SYSTEM_IDLE="${LOG_DIR:?}/leeloo/system.idle"

      # get uptime
      echo "$(echo "$CAT_SYSTEM" | awk '{ print $1 }')" >"$FILE_SYSTEM_UPTIME"
      # get idletime
      echo "$(echo "$CAT_SYSTEM" | awk '{ print $2 }')" >"$FILE_SYSTEM_IDLE"
    else
      # set uptime
      echo "0.0" >"$FILE_SYSTEM_UPTIME"
      # set idletime
      echo "0.0" >"$FILE_SYSTEM_IDLE"
    fi
  }

  # not found
  if [[ ! -f "$FILE_SYSTEM_UPTIME" || ! -f "$FILE_SYSTEM_IDLE" ]] &>/dev/null; then
    system_uptime
  fi

  # both found
  if [[ -f "$FILE_SYSTEM_UPTIME" && -f "$FILE_SYSTEM_IDLE" ]] &>/dev/null; then
    # greater than n seconds
    SYSTEM_FILE_SECONDS="$(stat -c '%Y' "$FILE_SYSTEM_UPTIME" 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
    if [[ "$SYSTEM_FILE_SECONDS" -gt "60" ]] &>/dev/null; then
      system_uptime
    fi
  fi

  # system uptime, in seconds
  SYSTEM_UPTIME_SECONDS="$(cat "$FILE_SYSTEM_UPTIME" 2>/dev/null | awk -F. '{ print $1 }')"
  # time format (uptime)
  SYSTEM_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)/3600")) $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)%3600/60")) $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)%60")))
  # uptime in days
  SYSTEM_UPTIME_DAYS="$(echo "$SYSTEM_UPTIME_SECONDS/86400" | bc 2>/dev/null)"

  # system idle, in seconds
  SYSTEM_IDLE_SECONDS="$(cat "$FILE_SYSTEM_IDLE" 2>/dev/null | awk -F. '{ print $1 }')"
  # time format (idle)
  SYSTEM_IDLE_TIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${SYSTEM_IDLE_SECONDS:?}" 2>&1)/3600")) $(("$(echo "${SYSTEM_IDLE_SECONDS:?}" 2>&1)%3600/60")) $(("$(echo "${SYSTEM_IDLE_SECONDS:?}" 2>&1)%60")))
  # idle in days
  SYSTEM_IDLE_DAYS="$(echo "$SYSTEM_IDLE_SECONDS/86400" | bc 2>/dev/null)"

  # restarts
  STRATEGY_RESTART_COUNT="$(wc -l "${SYS_DIR:?}"/robot/restart 2>/dev/null | awk '{ print $1 }')"

  if [[ -z "$STRATEGY_RESTART_COUNT" ]] &>/dev/null; then
    STRATEGY_RESTART_COUNT="None"
  fi

  if [[ -z "$SYSTEM_UPTIME" ]] &>/dev/null; then
    SYSTEM_UPTIME="0h:00m:00s"
  fi

  ##############################################################################

  # error log age in seconds
  STRATEGY_SECONDS="$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

  if [[ -z "$STRATEGY_SECONDS" ]] &>/dev/null; then
    STRATEGY_SECONDS="0"
  fi

  # strategy output
  STRATEGY_DATA="$(cat "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | awk '{ print $1 }' | sed -r '/^\s*$/d' | wc -l)"
  # time format
  STRATEGY_LOG_TIME=$(printf '%dh:%dm:%ds\n' $(("$STRATEGY_SECONDS/3600")) $(("$STRATEGY_SECONDS%3600/60")) $(("$STRATEGY_SECONDS%60")))
  # uptime in days
  STRATEGY_UPTIME_DAYS="$(echo "$STRATEGY_SECONDS/86400" | bc 2>/dev/null)"

  STRATEGY_CLOCK="$(echo "$(ls -l "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | awk '{ print $8 }')")"
  STRATEGY_ERROR="$(tail -1 "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null)"
  STRATEGY_ERRORS="$STRATEGY_DATA"

  if [[ "$STRATEGY_DATA" -eq "0" ]] &>/dev/null; then
    WIDTH="$(echo "$(echo "$SYSTEM_UPTIME" | wc -L)+30" | bc 2>/dev/null)"
    STRATEGY_CLOCK="None"
    STRATEGY_ERROR="None"
    STRATEGY_ERRORS="None"
  else
    WIDTH="$(echo "$(echo "$STRATEGY_ERROR" | wc -L)+25" | bc 2>/dev/null)"
  fi

  ##############################################################################

  RESULT="
System:
Uptime........: (${SYSTEM_UPTIME_DAYS:?}d) $SYSTEM_UPTIME
Idle..........: (${SYSTEM_IDLE_DAYS:?}d) $SYSTEM_IDLE_TIME

Strategy:
Last Error....: (${STRATEGY_UPTIME_DAYS:?}d) $STRATEGY_LOG_TIME
Robot Restart.: $STRATEGY_RESTART_COUNT
Error Count...: $STRATEGY_ERRORS
Error Time....: $STRATEGY_CLOCK

error.log.....: $STRATEGY_ERROR"
  display_result 2>/dev/null

  ##############################################################################

  # data exist, check
  if [[ "$STRATEGY_DATA" -gt "0" ]] &>/dev/null; then
    if dialog --stdout --title "Check data?" \
      --backtitle "Check data?" \
      --yesno "Yes: Check! No: Go back!" 5 30; then
      # remove duplicates
      echo "$(cat "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | awk '!a[$0]++')" >"${LOG_DIR:?}"/leeloo/error.log
      # strategy data exist, edit
      nano "$LOG_DIR"/leeloo/error.log
      clear
    fi

    # strategy data exist, keep, delete
    if [[ "$STRATEGY_DATA" -gt "0" ]] &>/dev/null; then
      if ! dialog --stdout --title "Keep data (error.log)?" \
        --backtitle "Keep data (error.log)?" \
        --yesno "Yes: Keep! No: Delete!" 5 30; then
        truncate -s 0 "$LOG_DIR"/leeloo/error.log &>/dev/null
      fi
    fi
  fi

  # restart data exist, keep, delete
  if [[ "$STRATEGY_RESTART_COUNT" -gt "0" ]] &>/dev/null; then
    if ! dialog --stdout --title "Keep restart data?" \
      --backtitle "Keep restart data?" \
      --yesno "Yes: Keep! No: Delete!" 5 30; then
      truncate -s 0 "$SYS_DIR"/robot/restart &>/dev/null
    fi
  fi

  ;;

  ##############################################################################

  # broker.conf, k & s, reset

"7")

  HEIGHT=13
  WIDTH=48
  CHOICE_HEIGHT=6
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Configurations Menu"
  MENU="Multipass $DATE_XARGS"

  OPTIONS=(
    1 "Config           Leeloo config"
    2 "API              Secret & Key config"
    3 "Reset            All Configurations!"
    4 "Reset            Leeloo Config"
    5 "Reset            Secret & Key config"
    6 "Delist           Delisting Markets")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # leeloo configuration

  "1")

    nano "${SYS_DIR:?}"/broker.conf
    broker_conf_update
    clear

    ;;

    # k & s configuration

  "2")

    nano "${SYS_DIR:?}"/sMcD
    clear

    ;;

    # reset all configurations

  "3")

    if dialog --stdout --title "Reset all configurations?" \
      --backtitle "Reset all?" \
      --yesno "Yes: Reset! No: Go back!" 5 31; then
      sudo rm "${SYS_DIR:?}"/*.conf &>/dev/null
      cp /home/"$(whoami)"/leeloo/include/api/DcMs "${SYS_DIR:?}"/sMcD &>/dev/null
      bash /usr/local/bin/include/leeloo/install
      clear
    fi

    ;;

    # reset broker configuration

  "4")

    if dialog --stdout --title "Reset broker configuration?" \
      --backtitle "Reset broker.conf?" \
      --yesno "Yes: Reset! No: Go back!" 5 33; then
      sudo rm "${SYS_DIR:?}"/*.conf &>/dev/null
      bash /usr/local/bin/include/leeloo/install
      clear
    fi

    ;;

    # reset k & s configuration

  "5")

    cp /home/"$(whoami)"/leeloo/include/api/DcMs "${SYS_DIR:?}"/sMcD &>/dev/null
    clear

    ;;

    # delist markets

  "6")

    HEIGHT=11
    WIDTH=40
    CHOICE_HEIGHT=4
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Delisting Menu"
    MENU="Multipass $DATE_XARGS"

    OPTIONS=(
      1 "SXC              SouthXchange"
      2 "POL              Poloniex"
      3 "SCE              StakeCube"
      4 "XGX              XeggeX")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    # southxchange delist

    "1")

      nano "${SYS_DIR:?}"/delisted_southxchange
      clear

      ;;

      # poloniex delist

    "2")

      nano "${SYS_DIR:?}"/delisted_poloniex
      clear

      ;;

      # stakecube delist

    "3")

      nano "${SYS_DIR:?}"/delisted_stakecube
      clear

      ;;

      # xeggex delist

    "4")

      nano "${SYS_DIR:?}"/delisted_xeggex
      clear

      ;;

    esac

    ;;

  esac

  ##############################################################################

  # auto strategy

  ;;

"A")

  update_screen

  if [[ "$(echo "$SCREEN_LIST" | grep "leeloo" | wc -l)" -eq "1" ]] &>/dev/null; then
    LEELOO_RUNNING="Online"
    LEELOO_PID="$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | xargs)"
    LEELOO_TIME=$(ps -p $LEELOO_PID -o etimes=)

    if [[ -z "$LEELOO_TIME" ]] &>/dev/null; then
      LEELOO_TIME="0"
    fi

    # time format
    LEELOO_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${LEELOO_TIME:?}" 2>&1)/3600")) $(("$(echo "${LEELOO_TIME:?}" 2>&1)%3600/60")) $(("$(echo "${LEELOO_TIME:?}" 2>&1)%60")))
    LEELOO_STRAT="$(ls -l "${SYS_DIR:?}"/robot/*.config 2>/dev/null | wc -l)"
  else
    LEELOO_STRAT="0"
    LEELOO_RUNNING="Offline"
    LEELOO_UPTIME="0h:0m:0s"
  fi

  HEIGHT=17
  WIDTH=45
  CHOICE_HEIGHT=10
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Robot Strategy Menu"
  MENU="Multipass $DATE_XARGS
Bots: $LEELOO_STRAT $LEELOO_RUNNING :: Uptime: $LEELOO_UPTIME"

  OPTIONS=(1 "Data             Strategy data"
    2 "Positions        Open positions"
    H "History          Robot history"
    3 "Config           Configurations"
    4 "Setup            Setup strategy"
    C "Control          Robot controller"
    L "Bots             robot.log"
    P "Logs             Specific log"
    0 "Delete           Remove strategy")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # dashbord

  "1")

    key_secret_set

    if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then

      while true; do
        CONFIG_FILES=("${SYS_DIR:?}"/robot/*.data)
        NUM_FILES="${#CONFIG_FILES[@]}"

        if [ "$NUM_FILES" -eq 0 ]; then
          echo "Error: No data files found in $SYS_DIR/robot"
          exit 1
        fi

        OPTIONS=()
        for ((i = 0; i < NUM_FILES; i++)); do
          FILENAME=$(basename "${CONFIG_FILES[$i]}")
          OPTIONS+=("$((i + 1))" "$FILENAME")
        done

        # adjust width based on the length of the longest filename
        WIDTH=$(printf "%s\n" "${OPTIONS[@]}" | awk '{ print length }' | sort -n | tail -1)
        WIDTH=$((WIDTH + 12))

        # set the minimum length for the menu
        LENGTH=$((NUM_FILES < 7 ? NUM_FILES : 7))

        CHOICE=$(dialog --clear --title "Strategy data" --menu "Choose one option:" "$LENGTH" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

        if [ -n "$CHOICE" ]; then
          SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
          display_result() {
            dialog --title "$(echo "$(ls -l "$SELECTED_FILE" 2>/dev/null | awk '{ print $8" :: "$NF }')")" \
              --no-collapse \
              --msgbox "$RESULT" 0 0
          }
          RESULT="$(cat "$SELECTED_FILE" 2>/dev/null)"
          display_result 2>/dev/null
          break
        else
          break
        fi
      done
