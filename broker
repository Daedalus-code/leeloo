#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

source /usr/local/bin/include/leeloo/broker.conf
source include/functions
source include/install

# southxchange api
source include/api/southxchange/private_API
source include/api/southxchange/public_API

DATE="$(date | xargs)"

# menu
HEIGHT=16
WIDTH=44
CHOICE_HEIGHT=9
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass ${DATE:?}"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup order"
  5 "Update           New law & order"
  6 "Debug            Debug logs"
  7 "Config           Configuration"
  A "Auto             Auto strategy"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

"1")

  function result_balance() {
    listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
    result_balance
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
  fi

  sleep 1

  display_result() {
    dialog --title "Account Balance" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  RESULT="Coins:  Deposited    Available   Unconfirmed

$(cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)"
  display_result 2>/dev/null

  ;;

"2")

  function result_market {
    prices | sort -k2 -n -r | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/market
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
    result_market
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
  fi

  # 450 max before dialog breaks
  MARKET_RESULT="$(head -100 "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)"
  WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+12" | bc)"

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  fi

  display_result() {
    dialog --title "100 Market: +$(prices | wc -l) $DATE" \
      --no-collapse \
      --scrollbar \
      --msgbox "$RESULT" 25 "$WIDTH"
  }

  RESULT="Market:       Bid           Ask           Last        (%)        Volume24Hr

$MARKET_RESULT"
  display_result 2>/dev/null

  ;;

"3")

  search

  if [[ ! -z "$MARKET_INPUT" ]] &>/dev/null; then

    MARKET_SEARCH="$(echo "$MARKET_INPUT" | tr '[:lower:]' '[:upper:]')"
    MARKET_RESULT="$(prices | grep "$MARKET_SEARCH" | sort -k2 -n -r | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t)"
    MARKET_COUNT="$(echo "$MARKET_RESULT" | wc -l)"
    LENGTH="$(echo "$MARKET_COUNT+7" | bc)"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+12" | bc)"

    if [[ "$LENGTH" -gt "25" ]] &>/dev/null; then
      LENGTH="25"
    fi
    if [[ -z "$WIDTH" ]] &>/dev/null; then
      MARKET_COUNT="0"
      WIDTH="80"
      LENGTH="7"
    elif [[ "$(echo "$MARKET_RESULT" | wc -L)" -eq "0" ]] &>/dev/null; then
      MARKET_COUNT="0"
      WIDTH="80"
      LENGTH="7"
    fi

    display_result() {
      dialog --title "Search result: +$MARKET_COUNT $DATE" \
        --no-collapse \
        --msgbox "$RESULT" "$LENGTH" "$WIDTH"
    }

    RESULT="Market:       Bid           Ask           Last        (%)        Volume24Hr

$MARKET_RESULT"
    display_result 2>/dev/null
  else
    display_result() {
      dialog --title "Search result: empty!" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="No data found!"
    display_result 2>/dev/null
  fi

  ;;

"4")

  # order menu
  HEIGHT=10
  WIDTH=40
  CHOICE_HEIGHT=3
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Order Menu"
  MENU="${DATE:?}"

  OPTIONS=(1 "Buy              Buy Order"
    2 "Sell             Sell Order"
    3 "Status           Open Orders")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    TYPE="buy"
    HEIGHT=9
    WIDTH=23
    CHOICE_HEIGHT=2
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Buy Order Menu"
    AMOUNT_IN_REFERENCE_CURRENCY="true"
    MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

    OPTIONS=(
      1 "Market Order"
      2 "Limit Order")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      setup_market_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
          if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
            PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            echo "${DATE:?} :: Manual $TYPE ::  Market Order :: $AMOUNT :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
          fi
        fi
      fi

      ;;

    "2")

      setup_limit_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$PRICE" ]] &>/dev/null; then
          if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
            if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
              PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
              echo "${DATE:?} :: Manual $TYPE ::  Limit Order :: $AMOUNT :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
            fi
          fi
        fi
      fi

      ;;

    esac

    last_log

    ;;

  "2")

    TYPE="sell"
    HEIGHT=9
    WIDTH=23
    CHOICE_HEIGHT=2
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Sell Order Menu"
    AMOUNT_IN_REFERENCE_CURRENCY="false"
    MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

    OPTIONS=(
      1 "Market Order"
      2 "Limit Order")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      setup_market_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
          if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
            PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            echo "${DATE:?} :: Manual $TYPE ::  Market Order :: $AMOUNT :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
          fi
        fi
      fi

      ;;

    "2")

      setup_limit_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$PRICE" ]] &>/dev/null; then
          if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
            if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
              PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
              echo "${DATE:?} :: Manual $TYPE ::  Limit Order :: $AMOUNT :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
            fi
          fi
        fi
      fi

      ;;

    esac

    last_log

    ;;

  "3")

    function result_orders {
      listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%0.8f ",$i);} else if($i~/^[0-9]+$/) {printf("%0.8f ",$i);} else {printf("%s ",$i)}} printf("\n")}' | column -t | sort -r >"${LOG_DIR:?}"/leeloo/southxchange/orders
    }

    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
      result_orders
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
    fi

    ORDER_TOTAL="$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/orders | awk '{ print $1 }')"

    display_result() {
      dialog --title "Open Orders: +$ORDER_TOTAL" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="OrderID:    Type  Amount      Original    LimitPrice     List   Ref  DateAdded
$(cat "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)"
    display_result 2>/dev/null

    ;;

  esac

  ;;

"5")

  display_result() {
    dialog --title "Updating Leeloo (Multipass)" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  RESULT="$(cd || exit && cd leeloo || exit && git pull 2>/dev/null)"
  display_result 2>/dev/null
  exit

  ;;

"6")

  last_log

  ;;

"7")

  nano /usr/local/bin/include/leeloo/broker.conf

  ;;

"A")

  HEIGHT=12
  WIDTH=44
  CHOICE_HEIGHT=6
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Strategy Menu"
  MENU="Multipass $(date | xargs)"

  OPTIONS=(1 "Dashbord         Strategy status"
    2 "Create           Create strategy"
    3 "Start            Start strategy"
    4 "Stop             Stop strategy"
    5 "Logs             robot.log")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    echo "You chose Option 1"

    ;;

  "2")

    HEIGHT=12
    WIDTH=47
    CHOICE_HEIGHT=6
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Create strategies"
    MENU="Multipass $(date | xargs)"

    OPTIONS=(1 "Trigger          Buy or Sell trigger"
      2 "EMA              EMA trading"
      3 "RSI              RSI trading"
      4 "MACD             MACD trading"
      5 "Custom           Custom")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      nano include/strategies/buy_sell_trigger

      DIALOG_OPTIONS=(
        --backtitle "Leeloo (Multipass)"
        --title "Creating strategy"
        --yesno "Install new strategy?"
        0 0
      )

      dialog "${DIALOG_OPTIONS[@]}"
      DIALOG_RESULT=$?

      if [ $DIALOG_RESULT -eq "0" ] &>/dev/null; then
        cp include/strategies/buy_sell_trigger /usr/local/bin/include/leeloo/robot
        display_result() {
          dialog --title "Creating strategy" \
            --no-collapse \
            --msgbox "$RESULT" 0 0
        }

        RESULT="Installed.
$(ls -l /usr/local/bin/include/leeloo/robot* 2>/dev/null)"
        display_result 2>/dev/null
      fi

      ;;

    "2")

      # code

      ;;

    "3")

      # code

      ;;

    "4")

      # code

      ;;

    "5")

      # code

      ;;

    esac

    ;;

  "3")

    HEIGHT=12
    WIDTH=47
    CHOICE_HEIGHT=6
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Start strategies"
    MENU="Multipass $(date | xargs)"

    OPTIONS=(1 "Trigger          Buy or Sell trigger"
      2 "EMA              EMA trading"
      3 "RSI              RSI trading"
      4 "MACD             MACD trading"
      5 "Custom           Custom")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      # code

      ;;

    "2")

      # code

      ;;

    "3")

      # code

      ;;

    "4")

      # code

      ;;

    "5")

      # code

      ;;

    esac

    ;;

  "4")

    HEIGHT=12
    WIDTH=47
    CHOICE_HEIGHT=6
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Stop strategies"
    MENU="Multipass $(date | xargs)"

    OPTIONS=(1 "Trigger          Buy or Sell trigger"
      2 "EMA              EMA trading"
      3 "RSI              RSI trading"
      4 "MACD             MACD trading"
      5 "Custom           Custom")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      # code

      ;;

    "2")

      # code

      ;;

    "3")

      # code

      ;;

    "4")

      # code

      ;;

    "5")

      # code

      ;;

    esac

    ;;

  esac

  ;;

"0")

  echo "Exiting..."
  exit 0

  ;;

esac

# shellcheck disable=SC2093 # dialog exec
exec /bin/bash "$0" "$@"
clear

# END
