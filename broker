      echo "Bitcoin (BTC): $BTC_DNT_ADDR

$BTC_MEMPOOL"
    )"
    display_result 2>/dev/null

    if dialog --stdout --title "Save information?" \
      --backtitle "Donate information" \
      --yesno "Yes: Save!, No:  Go back!" 5 30; then

      echo "Bitcoin (BTC): $BTC_DNT_ADDR

$BTC_MEMPOOL" >/home/"$(whoami)"/donate 2>/dev/null

      display_result() {
        dialog --title "BTC Donation" \
          --no-collapse \
          --msgbox "$RESULT" 5 37
      }

      RESULT="$(echo "info saved: /home/$(whoami)/donate")"
      display_result 2>/dev/null
    fi

    ;;

  "2")

    if ! [ -x "$(command -v "qrcode-terminal")" ] &>/dev/null; then
      if dialog --stdout --title "QRCODE" \
        --backtitle "Install" \
        --yesno "Install QRCode-Terminal?" 5 29; then
        # install npm
        if ! [ -x "$(command -v "npm")" ] &>/dev/null; then
          sudo apt-get install npm -y
        fi
        # https://github.com/vercel/install-node
        if ! [ -x "$(command -v "node")" ] &>/dev/null; then
          sudo curl -s https://install-node.now.sh | bash -s --
        fi
        # https://github.com/gtanner/qrcode-terminal
        sudo npm install -g qrcode-terminal
      fi
    fi

    # if non existing, continue
    if [[ ! -f "${LOG_DIR:?}"/leeloo/donate_qr ]] &>/dev/null; then
      qrcode-terminal "$BTC_DNT_ADDR" "{small: true}" >"${LOG_DIR:?}"/leeloo/donate_qr 2>/dev/null
    # if empty, continue
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/donate_qr ]] &>/dev/null; then
      qrcode-terminal "$BTC_DNT_ADDR" "{small: true}" >"${LOG_DIR:?}"/leeloo/donate_qr 2>/dev/null
    fi

    clear
    echo "Bitcoin (BTC): $BTC_DNT_ADDR"
    BTC_DNT_ADDR_QR="$(cat "${LOG_DIR:?}"/leeloo/donate_qr 2>/dev/null)"
    echo "$BTC_DNT_ADDR_QR"
    read -r -p "Press Enter to continue" </dev/tty
    echo

    ;;

  esac

  ;;

"C")

  if [[ ! -f "${LOG_DIR:?}"/leeloo/irc.client ]] &>/dev/null; then
    echo "$(irssi -v 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/irc.client
  fi
  if [[ ! -f "${LOG_DIR:?}"/leeloo/tor.client ]] &>/dev/null; then
    echo "$(tor --version 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/tor.client
  fi

  IRSSI_RAW="$(cat "${LOG_DIR:?}"/leeloo/irc.client 2>/dev/null)"
  PROXY_TOR="$(cat "${LOG_DIR:?}"/leeloo/tor.client 2>/dev/null)"

  if [[ -z "$PROXY_TOR" ]] &>/dev/null; then
    PROXY_TOR="?"
  fi

  if [[ "$PROXY_CHAT_API" == "true" ]] &>/dev/null; then
    PROXY_CHAT_STATUS="Enabled"
  else
    PROXY_CHAT_STATUS="Disabled"
  fi

  HEIGHT=10
  WIDTH=42
  CHOICE_HEIGHT=3
  BACKTITLE="Leeloo (Multipass)"
  TITLE="IRC Chat"
  MENU="Choose one option:"

  OPTIONS=(1 "Chat             Internet Relay"
    2 "Servers          IRC Servers"
    3 "Information      IRC Status")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    # irc chat
    display_result() {
      dialog --title "IRC Chat (irssi)" \
        --no-collapse \
        --msgbox "$RESULT" 13 38
    }

    IRSSI_NAME="$(echo "$IRSSI_RAW" 2>/dev/null | awk '{ print $1 }')"
    IRSSI_VERSION="$(echo "$IRSSI_RAW" 2>/dev/null | awk '{ print $2 }')"
    IRSSI_VERSION_DATE="$(echo "$IRSSI_RAW" 2>/dev/null | awk '{ print $3,$NF }')"
    IRSSI_VERSION="$IRSSI_NAME $IRSSI_VERSION"

    if [[ -z "$IRSSI_RAW" ]] &>/dev/null; then
      IRSSI_VERSION="Not installed"
      IRSSI_VERSION_DATE="?"
    fi

    # if all empty, connect something
    if [[ -z "$IRSSI_NICKNAME" ]] &>/dev/null; then
      TRIGGER_NICK="1"
    fi
    if [[ -z "$IRSSI_PORT" ]] &>/dev/null; then
      TRIGGER_PORT="1"
    fi
    if [[ -z "$IRSSI_SERVER" ]] &>/dev/null; then
      TRIGGER_SERVER="1"
    fi

    # all triggers accounted for, continue
    if [[ "$(echo "$TRIGGER_NICK+$TRIGGER_PORT+$TRIGGER_SERVER" | bc 2>/dev/null)" -eq "3" ]] &>/dev/null; then
      IRSSI_PORTS=(6661 6662 6663 6664 6665 6666 6667 6668 6669 6697 7000 8000)
      IRSSI_INDEX="$((RANDOM % ${#IRSSI_PORTS[@]}))"
      IRSSI_PORT="${IRSSI_PORTS[$IRSSI_INDEX]}"
      if [[ ! -f "${LOG_DIR:?}"/leeloo/irc.servers ]] &>/dev/null; then
        if [[ "$PROXY_CHAT_API" == "true" ]] &>/dev/null; then
          torify curl -s https://www.mirc.com/servers.ini | tr -t ':' ' ' | awk '{ print $3 }' | sed '/^$/d' >"${LOG_DIR:?}"/leeloo/irc.servers
        else
          curl -s https://www.mirc.com/servers.ini | tr -t ':' ' ' | awk '{ print $3 }' | sed '/^$/d' >"${LOG_DIR:?}"/leeloo/irc.servers
        fi
      fi
      # random irc server
      IRSSI_SERVER="$(cat "${LOG_DIR:?}"/leeloo/irc.servers 2>/dev/null | sort -R | head -1)"
      IRSSI_NICKNAME="$(tr -dc '0A-Z9' </dev/urandom 2>/dev/null | head -c 8 | rev)"
    fi

    # default port
    if [[ -z "$IRSSI_PORT" ]] &>/dev/null; then
      IRSSI_PORT="6667"
    fi
    # default random nickname
    if [[ -z "$IRSSI_NICKNAME" ]] &>/dev/null; then
      IRSSI_NICKNAME="$(tr -dc '0A-Z9' </dev/urandom 2>/dev/null | head -c 8 | rev)"
    fi

    RESULT="$(echo "
Client...: $IRSSI_VERSION
Version..: $IRSSI_VERSION_DATE
Server...: $IRSSI_SERVER $IRSSI_PORT
Nick.....: $IRSSI_NICKNAME
Proxy....: $PROXY_CHAT_STATUS
Version..: $PROXY_TOR

COMMANDS.: /help")"
    display_result 2>/dev/null

    if ! [ -x "$(command -v irssi)" ] &>/dev/null; then
      START_INSTALL="Install"
      WIDTH="28"
    else
      START_INSTALL="Start"
      WIDTH="26"
    fi

    if dialog --stdout --title "${START_INSTALL:?} IRC Client?" \
      --backtitle "Starting client" \
      --yesno "Yes: ${START_INSTALL:?}!, No: Quit" 5 "$WIDTH"; then

      if ! [ -x "$(command -v irssi)" ] &>/dev/null; then
        sudo apt-get install irssi
      fi

      if [[ "$PROXY_CHAT_API" == "true" ]] &>/dev/null; then
        torify irssi -c "$IRSSI_SERVER" -p "$IRSSI_PORT" -n "$IRSSI_NICKNAME"
      else
        irssi -c "$IRSSI_SERVER" -p "$IRSSI_PORT" -n "$IRSSI_NICKNAME"
      fi
    fi

    ;;

  "2")

    nano "${LOG_DIR:?}"/leeloo/irc.servers

    ;;

  "3")

    display_result() {
      dialog --title "IRC Chat" \
        --no-collapse \
        --msgbox "$RESULT" 10 55
    }

    RESULT="Chat information

Client..: $IRSSI_RAW
Proxy...: $PROXY_CHAT_STATUS $PROXY_TOR
Servers.: $(wc -l "${LOG_DIR:?}"/leeloo/irc.servers | awk '{ print $1 }')"
    display_result 2>/dev/null

    ;;

  esac

  ;;

"0")

  echo "Exiting..."
  exit 0

  ;;

esac

# shellcheck disable=SC2093 # dialog exec
exec /bin/bash "$0" "$@"
clear

# END
