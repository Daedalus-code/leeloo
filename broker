          echo "Remove leeloo line for total stop"
          read -r -p "Press Enter to continue" </dev/tty
          echo
          clear
          crontab -e

          ;;

        esac
      else
        no_key_no_secret
      fi
    else
      no_key_no_secret
    fi

    ;;

  "L")

    if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
      if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then
        last_log_robot
      else
        no_key_no_secret
      fi
    else
      no_key_no_secret
    fi

    ;;

  "P")

    if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
      if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then

        while true; do
          CONFIG_FILES=("${LOG_DIR:?}"/leeloo/robot.*.log)
          NUM_FILES="${#CONFIG_FILES[@]}"

          if [ $NUM_FILES -eq 0 ] &>/dev/null; then
            echo "Error: No log files found in $LOG_DIR/leeloo"
            exit 1
          fi

          OPTIONS=()
          for ((i = 0; i < "$NUM_FILES"; i++)); do
            FILENAME=$(basename "${CONFIG_FILES[$i]}")
            OPTIONS+=("$((i + 1))" "$FILENAME")
          done

          if [[ "$NUM_FILES" -lt "6" ]] &>/dev/null; then
            NUM_FILES="4"
          fi

          WIDTH="$(ls -l "${CONFIG_FILES[@]}" | awk -F/ '{ print $NF }' | wc -L)"
          WIDTH="$(echo "$WIDTH+12" | bc 2>/dev/null)"
          LENGTH="$NUM_FILES"

          if [[ "$LENGTH" -lt "7" ]] &>/dev/null; then
            LENGTH="7"
          fi

          CHOICE=$(dialog --clear --title "Robot logs" --menu "Choose one option:" "$LENGTH" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

          if [ -n "$CHOICE" ] &>/dev/null; then
            SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
            WIDTH="$(echo "$(tail -19 "${SELECTED_FILE:?}" | wc -L | awk '{ print $1 }')+6" | bc 2>/dev/null)"
            if [[ "$WIDTH" -lt "7" ]] &>/dev/null; then
              WIDTH="77"
            fi
            LOG_COUNT="$(wc -l "${SELECTED_FILE:?}" | awk '{ print $1 }')"
            display_result() {
              dialog --title "Robot Log: $LOG_COUNT :: $SELECTED_FILE:" \
                --no-collapse \
                --tailbox "$RESULT" 25 "$WIDTH"
            }
            RESULT="${SELECTED_FILE:?}"
            display_result 2>/dev/null
            if [[ "$LOG_COUNT" -gt "0" ]] &>/dev/null; then
              # keep history, delete history
              if ! dialog --stdout --title "Keep history? +$LOG_COUNT" \
                --backtitle "Keep history?" \
                --yesno "Yes: Keep!, No: Delete!" 5 30; then
                truncate -s 0 "${SELECTED_FILE:?}" &>/dev/null
                truncate -s 0 "${SELECTED_FILE:?}" &>/dev/null
              fi
            fi
            break
          else
            break
          fi
        done
      else
        no_key_no_secret
      fi
    else
      no_key_no_secret
    fi

    ;;

  "0")

    if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
      if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then

        if dialog --stdout --title "DELETE WARNING!" \
          --backtitle "DELETING" \
          --yesno "Yes: Delete!, No:  Go back!" 5 30; then

          while true; do
            CONFIG_FILES=("${SYS_DIR:?}"/robot/*.config)
            NUM_FILES="${#CONFIG_FILES[@]}"

            if [ $NUM_FILES -eq 0 ] &>/dev/null; then
              echo "Error: No config files found in $SYS_DIR/robot"
              exit 1
            fi

            OPTIONS=()
            for ((i = 0; i < "$NUM_FILES"; i++)); do
              FILENAME=$(basename "${CONFIG_FILES[$i]}")
              OPTIONS+=("$((i + 1))" "$FILENAME")
            done

            if [[ "$NUM_FILES" -lt "6" ]] &>/dev/null; then
              NUM_FILES="4"
            fi

            WIDTH="$(ls -l "${CONFIG_FILES[@]}" | awk -F/ '{ print $NF }' | wc -L)"
            WIDTH="$(echo "$WIDTH+12" | bc 2>/dev/null)"
            LENGTH="$NUM_FILES"

            if [[ "$LENGTH" -lt "7" ]] &>/dev/null; then
              LENGTH="7"
            fi

            CHOICE=$(dialog --clear --title "Delete configurations" --menu "Choose one option:" "$LENGTH" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

            if [ -n "$CHOICE" ] &>/dev/null; then
              SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
              FILE_NAME="$(echo "$SELECTED_FILE" | awk -F. '{ print $1 }' | awk -F/ '{ print $NF }')"

              if dialog --stdout --title "DELETE WARNING!!" \
                --backtitle "DELETING $FILE_NAME Strategy!" \
                --yesno "Yes: Delete!, No:  Go back!" 5 30; then
                rm "$SELECTED_FILE" &>/dev/null
                rm "${SYS_DIR:?}"/robot/"$FILE_NAME"* &>/dev/null
                rm "${LOG_DIR:?}"/leeloo/robot."$FILE_NAME"* &>/dev/null
                rm "${LOG_DIR:?}"/leeloo/open."$FILE_NAME"* &>/dev/null
              fi

              break
            else
              break
            fi
          done
        fi
      else
        no_key_no_secret
      fi
    else
      no_key_no_secret
    fi

    ;;

  esac

  ;;

  ##############################################################################

  # check indicators

"I")

  HEIGHT=10
  WIDTH=55
  CHOICE_HEIGHT=10
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Indicator Menu"
  MENU="Multipass $DATE"

  OPTIONS=(1 "RSI & EMA        RSI & EMA check"
    2 "RSI              Relative Strength Index"
    3 "EMA              Exponential Moving Average")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # rsi & ema

  "1")

    coin_token_search

    if [[ ! -z "$COIN_TOKEN" ]] &>/dev/null; then

      COIN_TOKEN="$(echo "$COIN_TOKEN" | tr '[:lower:]' '[:upper:]')"

      RESULT_RAW="-
RSI
$(get_rsi 14 "$COIN_TOKEN" 2>/dev/null)
$(get_rsi 21 "$COIN_TOKEN" 2>/dev/null)
-
EMA
$(get_ema 6 20 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 8 20 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 10 38 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 12 26 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 50 200 "$COIN_TOKEN" 2>/dev/null)
-"

      echo "$RESULT_RAW" >"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp 2>/dev/null

      BEARISH_SIGNAL="$(echo "$RESULT_RAW" | grep -c "Bearish" "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp)"
      BULLISH_SIGNAL="$(echo "$RESULT_RAW" | grep -c "Bullish" "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp)"
      TOTAL_SIGNAL="$(echo "$BEARISH_SIGNAL+$BULLISH_SIGNAL" | bc 2>/dev/null)"
      BEARISH_PERCENTAGE="$(echo "100/$TOTAL_SIGNAL*$BEARISH_SIGNAL" | bc 2>/dev/null)"
      BULLISH_PERCENTAGE="$(echo "100/$TOTAL_SIGNAL*$BULLISH_SIGNAL" | bc 2>/dev/null)"

      if [[ "$BEARISH_SIGNAL" -gt "$BULLISH_SIGNAL" ]] &>/dev/null; then
        echo "EMA_Signal Bearish ${BEARISH_PERCENTAGE:?}%" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp 2>/dev/null
      elif [[ "$BULLISH_SIGNAL" -gt "$BEARISH_SIGNAL" ]] &>/dev/null; then
        echo "EMA_Signal Bullish ${BULLISH_PERCENTAGE:?}%" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp 2>/dev/null
      fi

      mv "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"
      echo "$(cat "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN" 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN" 2>/dev/null

      RESULT="$(cat "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN" 2>/dev/null)"

      if [[ ! "$(grep "EMA" "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN" | awk '{ print $5 }' | head -1)" == "0.00000000" ]] &>/dev/null; then

        LENGTH="$(echo "$(wc -l "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN" | awk '{ print $1 }')+5" | bc 2>/dev/null)"
        WIDTH="$(echo "$(wc -L "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN" | awk '{ print $1 }')+5" | bc 2>/dev/null)"

        display_result() {
          dialog --title "RSI & EMA Indicator ($COIN_TOKEN)" \
            --no-collapse \
            --msgbox "$RESULT" "$LENGTH" "$WIDTH"
        }

        display_result 2>/dev/null
      else
        display_result() {
          dialog --title "Market info (404)" \
            --no-collapse \
            --msgbox "$RESULT" 5 25
        }

        RESULT="No $COIN_TOKEN EMA found!"
        display_result 2>/dev/null
      fi
    else
      display_result() {
        dialog --title "Market info (empty)" \
          --no-collapse \
          --msgbox "$RESULT" 0 0
      }

      RESULT="No data found!"
      display_result 2>/dev/null
    fi

    ;;

  "2")

    coin_token_search
    rsi_value_output

    COIN_TOKEN="$(echo "$COIN_TOKEN" | tr '[:lower:]' '[:upper:]')"
    GET_RSI="$(get_rsi "$RSI_VALUE_OUTPUT" "$COIN_TOKEN" 2>/dev/null)"
    WIDTH="$(echo "$(echo "$GET_RSI" | wc -L)+4" | bc 2>/dev/null)"

    if [[ -z "$WIDTH" ]] &>/dev/null; then
      WIDTH="30"
    fi

    if [[ ! -z "$COIN_TOKEN" ]] &>/dev/null; then
      if [[ ! -z "$GET_RSI" ]] &>/dev/null; then
        display_result() {
          dialog --title "RSI $COIN_TOKEN" \
            --no-collapse \
            --msgbox "$RESULT" 5 "$WIDTH"
        }

        RESULT="$GET_RSI"
        display_result 2>/dev/null
      fi
    fi

    ;;

  "3")

    coin_token_search
    ema_value_output

    COIN_TOKEN="$(echo "$COIN_TOKEN" | tr '[:lower:]' '[:upper:]')"
    GET_EMA="$(get_ema "$EMA_SHORT_OUTPUT" "$EMA_LONG_OUTPUT" "$COIN_TOKEN" 2>/dev/null)"
    WIDTH="$(echo "$(echo "$GET_EMA" | wc -L)+4" | bc 2>/dev/null)"

    if [[ -z "$WIDTH" ]] &>/dev/null; then
      WIDTH="50"
    fi

    if [[ ! -z "$COIN_TOKEN" ]] &>/dev/null; then
      if [[ ! -z "$GET_EMA" ]] &>/dev/null; then
        display_result() {
          dialog --title "EMA $COIN_TOKEN" \
            --no-collapse \
            --msgbox "$RESULT" 5 "$WIDTH"
        }

        RESULT="$GET_EMA"
        display_result 2>/dev/null
      fi
    fi

    ;;

  esac

  ;;

"D")

  if [[ "$(echo "$BTC_DNT_ADDR" | egrep "bc1.*.c2" | wc -l)" -eq "0" ]] &>/dev/null; then
    echo "grifters are a plague.."
    exit
  fi

  HEIGHT=9
  WIDTH=42
  CHOICE_HEIGHT=3
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Donation"
  MENU="Choose one option:"

  OPTIONS=(1 "Address          Plain Text"
    2 "QRCODE           QRCODE address")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    display_result() {
      dialog --title "Donation" \
        --no-collapse \
        --msgbox "$RESULT" 7 77
    }

    RESULT="$(
      echo "Bitcoin (BTC): $BTC_DNT_ADDR

$BTC_MEMPOOL"
    )"
    display_result 2>/dev/null

    if dialog --stdout --title "Save information?" \
      --backtitle "Donate information" \
      --yesno "Yes: Save!, No:  Go back!" 5 30; then

      echo "Bitcoin (BTC): $BTC_DNT_ADDR

$BTC_MEMPOOL" >/home/"$(whoami)"/donate 2>/dev/null

      display_result() {
        dialog --title "BTC Donation" \
          --no-collapse \
          --msgbox "$RESULT" 5 37
      }

      RESULT="$(echo "info saved: /home/$(whoami)/donate")"
      display_result 2>/dev/null
    fi

    ;;

  "2")

    if ! [ -x "$(command -v "qrcode-terminal")" ] &>/dev/null; then
      if dialog --stdout --title "QRCODE" \
        --backtitle "Install" \
        --yesno "Install QRCode-Terminal?" 5 29; then
        clear
        # install npm
        if ! [ -x "$(command -v "npm")" ] &>/dev/null; then
          sudo apt-get install npm -y
        fi
        # https://github.com/vercel/install-node
        if ! [ -x "$(command -v "node")" ] &>/dev/null; then
          sudo curl -s https://install-node.now.sh 2>/dev/null | bash -s -- 2>/dev/null
        fi
        # https://github.com/gtanner/qrcode-terminal
        if [ -x "$(command -v "npm")" ] &>/dev/null; then
          sudo npm install -g qrcode-terminal
        fi
        read -r -p "Press Enter to continue" </dev/tty
        clear
      fi
    fi

    # if non existing, continue
    if [[ ! -f "${LOG_DIR:?}"/leeloo/donate_qr ]] &>/dev/null; then
      qrcode-terminal "$BTC_DNT_ADDR" "{small: true}" >"${LOG_DIR:?}"/leeloo/donate_qr 2>/dev/null
    # if empty, continue
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/donate_qr ]] &>/dev/null; then
      qrcode-terminal "$BTC_DNT_ADDR" "{small: true}" >"${LOG_DIR:?}"/leeloo/donate_qr 2>/dev/null
    fi

    clear
    echo "Bitcoin (BTC): $BTC_DNT_ADDR"
    BTC_DNT_ADDR_QR="$(cat "${LOG_DIR:?}"/leeloo/donate_qr 2>/dev/null)"
    echo "$BTC_DNT_ADDR_QR"
    read -r -p "Press Enter to continue" </dev/tty
    clear

    ;;

  esac

  ;;

