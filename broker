#!/bin/bash

export LC_ALL=en_US.utf8 2>/dev/null
export NCURSES_NO_UTF8_ACS=1 2>/dev/null

# I'll not rest till I have me gold

# shellcheck disable=SC2034  # Unused variables left for readability

source /usr/local/bin/include/leeloo/broker.conf
source /usr/local/bin/include/leeloo/functions

# southxchange api
source /usr/local/bin/include/leeloo/api/southxchange/private_API
source /usr/local/bin/include/leeloo/api/southxchange/public_API

# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi

# menu
HEIGHT=19
WIDTH=44
CHOICE_HEIGHT=11
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $DATE
Load: $LOAD :: $REPO_HEAD $REPO_DATE"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup order"
  5 "Update           New law & order"
  6 "Debug            Debug logs"
  7 "Config           API Config"
  A "Robot            Auto strategy"
  C "Chat             IRC Chat"
  D "Donate           Donation"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

"1")

  if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
    if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then
      if [[ "$(cat "${LOG_DIR:?}"/leeloo/southxchange/balances | egrep "[0-9]+.[0-9]+" | wc -l)" -gt "0" ]] &>/dev/null; then

        BALANCE_TIMER="$(echo "$BOT_TIMER*3" | bc 2>/dev/null)"

        function result_balance() {
          listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
        }

        # update data every n seconds
        if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$BALANCE_TIMER" ]] &>/dev/null; then
          result_balance
          # update data if missing
        elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
          result_balance
          # update data if empty
        elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
          result_balance
        fi

        sleep 1

        display_result() {
          dialog --title "Account Balance" \
            --no-collapse \
            --msgbox "$RESULT" 0 0
        }

        RESULT="Coins:  Deposited    Available   Unconfirmed

$(cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)"
        display_result 2>/dev/null
      else
        no_key_no_secret
      fi
    else
      no_key_no_secret
    fi
  fi

  ;;

"2")

  MARKET_TIMER="$(echo "$BOT_TIMER*3" | bc 2>/dev/null)"

  function result_market {
    prices | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/market
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)))" 2>/dev/null)" -gt "$MARKET_TIMER" ]] &>/dev/null; then
    result_market
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
  fi

  # 450 max before dialog breaks
  MARKET_RESULT="$(cat "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null | sort -k2 -n -r | head -100)"
  MARKET_COUNT="$(echo "$MARKET_RESULT" | wc -l)"
  MARKET_MOON="$(cat "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
  MARKET_MOON_COUNT="$(cat "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null | awk '{ print $5 }' | wc -l)"
  MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l | awk '{ printf "%.2f\n", $1 }')"
  WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+5" | bc 2>/dev/null)"

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  fi

  display_result() {
    dialog --title "100 Market: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
      --no-collapse \
      --scrollbar \
      --msgbox "$(echo "$RESULT" | column -t)" 25 "$WIDTH"
  }

  RESULT="Market:       Bid             Ask             Last           (%)      Volume24Hr

$MARKET_RESULT"
  display_result 2>/dev/null

  ;;

"3")

  search

  if [[ ! -z "$MARKET_INPUT" ]] &>/dev/null; then

    MARKET_TIMER="$(echo "$BOT_TIMER*3" | bc 2>/dev/null)"

    function result_market {
      prices | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/market
    }

    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)))" 2>/dev/null)" -gt "$MARKET_TIMER" ]] &>/dev/null; then
      result_market
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
      result_market
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
      result_market
    fi

    MARKET_SEARCH="$(echo "$MARKET_INPUT" | tr '[:lower:]' '[:upper:]')"
    MARKET_RESULT="$(grep "$MARKET_SEARCH" "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)"
    MARKET_COUNT="$(echo "$MARKET_RESULT" | wc -l)"
    MARKET_MOON="$(echo "$MARKET_RESULT" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
    MARKET_MOON_COUNT="$(echo "$MARKET_RESULT" | awk '{ print $5 }' | wc -l)"
    MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l | awk '{ printf "%.2f\n", $1 }')"
    LENGTH="$(echo "$MARKET_COUNT+5" | bc 2>/dev/null)"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | column -t | wc -L)+6" | bc 2>/dev/null)"

    if [[ "$LENGTH" -gt "25" ]] &>/dev/null; then
      LENGTH="25"
    fi

    if [[ "$WIDTH" -lt "70" ]] &>/dev/null; then
      WIDTH="70"
    elif [[ "$(echo "$MARKET_RESULT" | wc -L)" -eq "0" ]] &>/dev/null; then
      WIDTH="70"
    fi

    display_result() {
      dialog --title "Search result: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }

    RESULT="Market:       Bid           Ask          Last       (%)      Volume24Hr

$MARKET_RESULT"
    display_result 2>/dev/null
  else
    display_result() {
      dialog --title "Market info (empty)" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="No data found!"
    display_result 2>/dev/null
  fi

  ;;

  # orders

"4")

  if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
    if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then

      # menu
      HEIGHT=10
      WIDTH=40
      CHOICE_HEIGHT=3
      BACKTITLE="Leeloo (Multipass)"
      TITLE="Order Menu"
      MENU="${DATE:?}"

      OPTIONS=(1 "Buy              Buy Order"
        2 "Sell             Sell Order"
        3 "Status           Open Orders")

      CHOICE=$(dialog --clear \
        --backtitle "$BACKTITLE" \
        --title "$TITLE" \
        --menu "$MENU" \
        $HEIGHT $WIDTH $CHOICE_HEIGHT \
        "${OPTIONS[@]}" \
        2>&1 >/dev/tty)

      clear
      case $CHOICE in

      "1")

        TYPE="buy"
        HEIGHT=9
        WIDTH=23
        CHOICE_HEIGHT=2
        BACKTITLE="Leeloo (Multipass)"
        TITLE="Buy Order Menu"
        AMOUNT_IN_REFERENCE_CURRENCY="true"
        MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

        OPTIONS=(
          1 "Market Order"
          2 "Limit Order")

        CHOICE=$(dialog --clear \
          --backtitle "$BACKTITLE" \
          --title "$TITLE" \
          --menu "$MENU" \
          $HEIGHT $WIDTH $CHOICE_HEIGHT \
          "${OPTIONS[@]}" \
          2>&1 >/dev/tty)

        clear
        case $CHOICE in

        "1")

          setup_market_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
              if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                echo "$LOG_DATE :: Manual $TYPE :: Market Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT" >>"${LOG_DIR:?}"/leeloo/broker.log
                echo "$LOG_DATE :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
              fi
            fi
          fi

          ;;

        "2")

          setup_limit_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$PRICE" ]] &>/dev/null; then
              if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
                if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                  PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                  echo "$LOG_DATE :: Manual $TYPE :: Limit Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
                  echo "$LOG_DATE :: Output: $PLACE_ORDER :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
                fi
              fi
            fi
          fi

          ;;

        esac

        last_log

        ;;

      "2")

        TYPE="sell"
        HEIGHT=9
        WIDTH=23
        CHOICE_HEIGHT=2
        BACKTITLE="Leeloo (Multipass)"
        TITLE="Sell Order Menu"
        AMOUNT_IN_REFERENCE_CURRENCY="false"
        MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

        OPTIONS=(
          1 "Market Order"
          2 "Limit Order")

        CHOICE=$(dialog --clear \
          --backtitle "$BACKTITLE" \
          --title "$TITLE" \
          --menu "$MENU" \
          $HEIGHT $WIDTH $CHOICE_HEIGHT \
          "${OPTIONS[@]}" \
          2>&1 >/dev/tty)

        clear
        case $CHOICE in

        "1")

          setup_market_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
              if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                echo "$LOG_DATE :: Manual $TYPE :: Market Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT" >>"${LOG_DIR:?}"/leeloo/broker.log
                echo "$LOG_DATE :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
              fi
            fi
          fi

          ;;

        "2")

          setup_limit_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$PRICE" ]] &>/dev/null; then
              if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
                if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                  PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                  echo "$LOG_DATE :: Manual $TYPE :: Limit Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
                  echo "$LOG_DATE :: Output: $PLACE_ORDER :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
                fi
              fi
            fi
          fi

          ;;

        esac

        last_log

        ;;

      "3")

        function result_orders {
          listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%0.8f ",$i);} else if($i~/^[0-9]+$/) {printf("%0.8f ",$i);} else {printf("%s ",$i)}} printf("\n")}' | column -t | sort -r >"${LOG_DIR:?}"/leeloo/southxchange/orders
        }

        # update data every n seconds
        if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
          result_orders
          # update data if missing
        elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
          result_orders
          # update data if empty
        elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
          result_orders
        fi

        ORDER_TOTAL="$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/orders | awk '{ print $1 }')"

        display_result() {
          dialog --title "Open Orders: +$ORDER_TOTAL" \
            --no-collapse \
            --msgbox "$RESULT" 0 0
        }

        RESULT="OrderID:    Type  Amount      Original    LimitPrice     List   Ref  DateAdded
$(cat "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null | sort -r)"
        display_result 2>/dev/null

        ;;

      esac
    else
      no_key_no_secret
    fi
  else
    no_key_no_secret
  fi

  ;;

  # update repo

"5")

  display_result() {
    dialog --title "Updating Leeloo (Multipass)" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && git pull >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

  # restart looper if any updates
  if [[ "$(egrep "looper|leeloo" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | grep '[+-]' | wc -l)" -eq "1" ]] &>/dev/null; then
    ROBOT_UPDATES="$(egrep "looper|leeloo" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | awk '{ print $3,$4 }')"
    echo " Robot updated! $ROBOT_UPDATES" >>"${LOG_DIR:?}"/leeloo/updating

    if [[ "$(screen -list | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
      screen -S "$(screen -list | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit
      echo " -- Robot stopping!" >>"${LOG_DIR:?}"/leeloo/updating
      if [[ "$(screen -list | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
        killall screen &>/dev/null
      fi
      bash "${SYS_DIR:?}"/robot/looper
      echo " ++ Robot restarting!" >>"${LOG_DIR:?}"/leeloo/updating
    fi
  fi

  # if any updates, skip
  if [[ ! "$(grep "Updating" "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    echo "
$(echo "$(cat "${LOG_DIR:?}"/leeloo/updating) $REPO_HEAD")" >"${LOG_DIR:?}"/leeloo/updating
  fi

  RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
  display_result 2>/dev/null
  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && bash include/install 2>/dev/null
  rm "${LOG_DIR:?}"/leeloo/repo &>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git rev-parse --short HEAD 2>&1 | grep -Eo '[a0-z9]{7}' 2>&1 | head -1 >"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git log -1 --format="%at" | xargs -I{} date -d @{} '+%Y' >>"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  clear

  if [[ ! "$(grep "Already up to date." "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    exit
  fi

  ;;

"6")

  last_log

  ;;

"7")

  nano "${SYS_DIR:?}"/broker.conf

  ;;

"A")

  if [[ "$(screen -list | grep "leeloo" | wc -l)" -eq "1" ]] &>/dev/null; then
    ROBOT_RUNNING="Online"
    ROBOT_PID="$(screen -list | grep "leeloo" | awk -F. '{ print $1 }' | xargs)"
    ROBOT_TIME=$(ps -p $ROBOT_PID -o etimes=)
    ROBOT_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${ROBOT_TIME:?}" 2>&1)/3600")) $(("$(echo "${ROBOT_TIME:?}" 2>&1)%3600/60")) $(("$(echo "${ROBOT_TIME:?}" 2>&1)%60")))
    ROBOT_STRAT="$(ls -l "${SYS_DIR:?}"/robot/*.config | wc -l)"
  else
    ROBOT_STRAT="0"
    ROBOT_RUNNING="Offline"
    ROBOT_UPTIME="0h:0m:0s"
  fi

  HEIGHT=17
  WIDTH=45
  CHOICE_HEIGHT=10
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Robot Strategy Menu"
  MENU="Multipass $DATE
Bots: $ROBOT_STRAT $ROBOT_RUNNING :: Uptime: $ROBOT_UPTIME"

  OPTIONS=(1 "Data             Strategy data"
    2 "Check            Indicator info"
    3 "Positions        Open positions"
    4 "Config           Configurations"
    5 "Create           Create strategy"
    6 "Control          Robot controller"
    7 "Bots             robot.log"
    8 "Debug            Specific log"
    0 "Delete           Remove strategy")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # dashbord

  "1")

    if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
      if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then

        while true; do
          CONFIG_FILES=("${SYS_DIR:?}"/robot/*.data)
          NUM_FILES="${#CONFIG_FILES[@]}"
          # shellcheck disable=SC2128
          WIDTH="$(echo "$CONFIG_FILES" | awk '{print length, $0}' | sort -nr | head -1 | awk '{ print $1 }')"
          WIDTH="$(echo "$WIDTH+11" | bc 2>/dev/null)"

          if [ $NUM_FILES -eq 0 ] &>/dev/null; then
            echo "Error: No data files found in $SYS_DIR/robot"
            exit 1
          fi

          OPTIONS=()
          for ((i = 0; i < "$NUM_FILES"; i++)); do
            OPTIONS+=("$((i + 1))" "${CONFIG_FILES[$i]}")
          done

          if [[ "$NUM_FILES" -lt "6" ]] &>/dev/null; then
            NUM_FILES="4"
          fi

          CHOICE=$(dialog --clear --title "Strategy Data" --menu "Choose one of the following data configurations:" "$(echo "$NUM_FILES+3" | bc 2>/dev/null)" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

          if [ -n "$CHOICE" ]; then
            SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
            display_result() {
              dialog --title "Data $SELECTED_FILE" \
                --no-collapse \
                --msgbox "$RESULT" 0 0
            }
            RESULT="$(cat "$SELECTED_FILE" 2>/dev/null)"
            display_result 2>/dev/null
            break
          else
            break
          fi
        done
      else
        no_key_no_secret
      fi
    else
      no_key_no_secret
    fi

    ;;

    # check

  "2")

    HEIGHT=10
    WIDTH=55
    CHOICE_HEIGHT=10
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Indicator Menu"
    MENU="Multipass $DATE"

    OPTIONS=(1 "RSI & EMA        RSI & EMA check"
      2 "RSI              Relative Strength Index"
      3 "EMA              Exponential Moving Average")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    # rsi & ema

    "1")

      coin_token_search

      if [[ ! -z "$COIN_TOKEN" ]] &>/dev/null; then

        COIN_TOKEN="$(echo "$COIN_TOKEN" | tr '[:lower:]' '[:upper:]')"

        function get_rsi_ema() {
          echo "-" >"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"

          GET_RSI_14="$(get_rsi 14 "$COIN_TOKEN" 2>/dev/null)"
          GET_RSI_21="$(get_rsi 21 "$COIN_TOKEN" 2>/dev/null)"
          GET_RSI_14_NR="$(echo "$GET_RSI_14" | awk '{ print $NF }')"
          GET_RSI_21_NR="$(echo "$GET_RSI_21" | awk '{ print $NF }')"
          GET_EMA_6_20="$(get_ema 6 20 "$COIN_TOKEN" 2>/dev/null)"
          GET_EMA_8_20="$(get_ema 8 20 "$COIN_TOKEN" 2>/dev/null)"
          GET_EMA_10_38="$(get_ema 10 38 "$COIN_TOKEN" 2>/dev/null)"
          GET_EMA_12_26="$(get_ema 12 26 "$COIN_TOKEN" 2>/dev/null)"
          GET_EMA_50_200="$(get_ema 50 200 "$COIN_TOKEN" 2>/dev/null)"

          echo "$GET_RSI_14" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"
          echo "$GET_RSI_21" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"
          echo "-" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"
          GET_RSI_CALC="$(echo "$GET_RSI_14_NR+$GET_RSI_21_NR" | bc -l 2>/dev/null | awk '{ printf "%.8f\n", $1 }')"
          GET_RSI_SIGNAL="$(echo "$GET_RSI_CALC/2" | bc -l 2>/dev/null | awk '{ printf "%.8f\n", $1 }')"

          if (($(echo "$GET_RSI_SIGNAL > 70" | bc -l 2>/dev/null))); then
            echo "RSI_Signal Overbought ${GET_RSI_SIGNAL:?}" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"
          elif (($(echo "$GET_RSI_SIGNAL < 30" | bc -l 2>/dev/null))); then
            echo "RSI_Signal Oversold ${GET_RSI_SIGNAL:?}" >>"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN"
          else
