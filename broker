    MARKET_COUNT="$(grep -v "Market" "${LOG_DIR:?}"/leeloo/stakecube/prices 2>/dev/null | sed '/^$/d' | wc -l)"
    MARKET_MOON="$(echo "$CAT_STAKECUBE_PRICES" | awk '{ print $3 }' | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%.2f\n", $1 }')"
    MARKET_MOON_COUNT="$(echo "$CAT_STAKECUBE_PRICES" | awk '{ print $3 }' | wc -l)"
    MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+8" | bc 2>/dev/null)"
    LENGTH="25"

    if [[ -z "$WIDTH" ]] &>/dev/null; then
      WIDTH="77"
    fi

