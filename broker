#!/bin/bash

# set the locale to "C" to use a decimal point as the separator
export LC_NUMERIC=C
# set ncurses no utf9 acs to fix dialog tearing in macos terminal
export NCURSES_NO_UTF8_ACS=1

# I'll not rest till I have me gold

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

source /usr/local/bin/include/leeloo/broker.conf
source /usr/local/bin/include/leeloo/functions
source /usr/local/bin/include/leeloo/irc_client

# southxchange api
source /usr/local/bin/include/leeloo/api/southxchange/private_API
source /usr/local/bin/include/leeloo/api/southxchange/public_API

# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi

# strategy tools
source /usr/local/bin/include/leeloo/strategies/tools

################################################################################

clear

# menu

HEIGHT=21
WIDTH=44
CHOICE_HEIGHT=13
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $DATE
Load: $LOAD :: $REPO_HEAD $REPO_DATE"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup Order"
  5 "Update           New Law & Order"
  H "History          Manual History"
  L "Debug            Leeloo Logs"
  7 "Config           Configuration"
  A "Robot            Auto Strategy"
  C "Chat             Chat Menu"
  I "Check            Indicators"
  D "Donate           Donation"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

################################################################################

# balance

"1")

  if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
    if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then

      USER_TIMER="$(echo "$BOT_TIMER*1.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

      # get balance
      function result_balances() {
        echo "$(listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
      }
      # update data every n seconds
      if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
        result_balances
        # update data if missing
      elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
        result_balances
        # update data if empty
      elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
        result_balances
      fi

      until [[ -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; do
        clear
        echo "Please wait.."
        sleep 1
      done

      display_result() {
        dialog --title "$FILE_TIME :: Account Balance" \
          --no-collapse \
          --msgbox "$(echo "$RESULT" | column -t)" 0 0
      }
      FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null | awk '{ print $8 }')"
      if [[ -z "$FILE_TIME" ]] &>/dev/null; then
        FILE_TIME="00:00"
      fi
      RESULT="Coins: Deposited Available Unconfirmed
$(cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)"
      display_result 2>/dev/null
    else
      no_key_no_secret
    fi
  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # prices

"2")

  USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

  # get prices
  function result_prices() {
    echo "$(prices | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
    result_prices
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
    result_prices
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
    result_prices
  fi

  # 450 max before dialog breaks
  MARKET_RESULT="$(cat "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | sort -k2 -n -r | head -100)"
  MARKET_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | awk '{ print $1 }')"
  MARKET_MOON="$(cat "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
  MARKET_MOON_COUNT="$(cat "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | awk '{ print $5 }' | wc -l)"
  MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
  WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+5" | bc 2>/dev/null)"

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  fi

  display_result() {
    dialog --title "$FILE_TIME :: Top 100 Market: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
      --no-collapse \
      --scrollbar \
      --msgbox "$(echo "$RESULT" | column -t)" 25 "$WIDTH"
  }
  FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | awk '{ print $8 }')"
  if [[ -z "$FILE_TIME" ]] &>/dev/null; then
    FILE_TIME="00:00"
  fi
  RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
  display_result 2>/dev/null

  ;;

  ##############################################################################

  # search market

"3")

  search

  if [[ ! -z "$MARKET_INPUT" ]] &>/dev/null; then

    USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

    # get prices
    function result_prices() {
      echo "$(prices | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
      result_prices
    fi

    MARKET_SEARCH="$(echo "$MARKET_INPUT" | tr '[:lower:]' '[:upper:]')"
    MARKET_RESULT="$(grep -w "$MARKET_SEARCH" "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | sort -k2 -n -r)"
    MARKET_COUNT="$(echo "$MARKET_RESULT" | sed -r '/^\s*$/d' | wc -l)"
    MARKET_MOON="$(echo "$MARKET_RESULT" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
    MARKET_MOON_COUNT="$(echo "$MARKET_RESULT" | awk '{ print $5 }' | wc -l)"
    MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
    LENGTH="$(echo "$MARKET_COUNT+5" | bc 2>/dev/null)"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | column -t | wc -L)+5" | bc 2>/dev/null)"

    if [[ "$LENGTH" -gt "25" ]] &>/dev/null; then
      LENGTH="25"
    fi

    if [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
      WIDTH="77"
    fi

    display_result() {
      dialog --title "Search result $MARKET_SEARCH: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }

    RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
    display_result 2>/dev/null
  else
    display_result() {
      dialog --title "Market info (empty)" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="No data found!"
    display_result 2>/dev/null
  fi

  ;;

  ##############################################################################

  # orders

"4")

  if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
    if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then

      # menu
      HEIGHT=10
      WIDTH=40
      CHOICE_HEIGHT=3
      BACKTITLE="Leeloo (Multipass)"
      TITLE="Order Menu"
      MENU="${DATE:?}"

      OPTIONS=(1 "Buy              Buy Order"
        2 "Sell             Sell Order"
        3 "Status           Open Orders")

      CHOICE=$(dialog --clear \
        --backtitle "$BACKTITLE" \
        --title "$TITLE" \
        --menu "$MENU" \
        $HEIGHT $WIDTH $CHOICE_HEIGHT \
        "${OPTIONS[@]}" \
        2>&1 >/dev/tty)

      clear
      case $CHOICE in

      "1")

        TYPE="buy"
        HEIGHT=9
        WIDTH=23
        CHOICE_HEIGHT=2
        BACKTITLE="Leeloo (Multipass)"
        TITLE="Buy Order Menu"
        AMOUNT_IN_REFERENCE_CURRENCY="true"
        MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

        OPTIONS=(
          1 "Market Order"
          2 "Limit Order")

        CHOICE=$(dialog --clear \
          --backtitle "$BACKTITLE" \
          --title "$TITLE" \
          --menu "$MENU" \
          $HEIGHT $WIDTH $CHOICE_HEIGHT \
          "${OPTIONS[@]}" \
          2>&1 >/dev/tty)

        clear
        case $CHOICE in

        "1")

          setup_market_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
              if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                echo "$LOG_DATE :: Manual $TYPE :: Market Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
                echo "$LOG_DATE :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
              fi
            fi
          fi

          ;;

        "2")

          setup_limit_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$PRICE" ]] &>/dev/null; then
              if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
                if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                  PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                  echo "$LOG_DATE :: Manual $TYPE :: Limit Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
                  echo "$LOG_DATE :: Output: $PLACE_ORDER :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
                fi
              fi
            fi
          fi

          ;;

        esac

        last_log

        ;;

      "2")

        TYPE="sell"
        HEIGHT=9
        WIDTH=23
        CHOICE_HEIGHT=2
        BACKTITLE="Leeloo (Multipass)"
        TITLE="Sell Order Menu"
        AMOUNT_IN_REFERENCE_CURRENCY="false"
        MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

        OPTIONS=(
          1 "Market Order"
          2 "Limit Order")

        CHOICE=$(dialog --clear \
          --backtitle "$BACKTITLE" \
          --title "$TITLE" \
          --menu "$MENU" \
          $HEIGHT $WIDTH $CHOICE_HEIGHT \
          "${OPTIONS[@]}" \
          2>&1 >/dev/tty)

        clear
        case $CHOICE in

        "1")

          setup_market_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
              if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                echo "$LOG_DATE :: Manual $TYPE :: Market Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
                echo "$LOG_DATE :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
              fi
            fi
          fi

          ;;

        "2")

          setup_limit_order
          if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
            if [[ ! -z "$PRICE" ]] &>/dev/null; then
              if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
                if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
                  PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
                  echo "$LOG_DATE :: Manual $TYPE :: Limit Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
                  echo "$LOG_DATE :: Output: $PLACE_ORDER :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
                fi
              fi
            fi
          fi

          ;;

        esac

        last_log

        ;;

        # open orders

      "3")

        USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

        function result_orders {
          listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%0.8f ",$i);} else if($i~/^[0-9]+$/) {printf("%0.8f ",$i);} else {printf("%s ",$i)}} printf("\n")}' | column -t | sort -r >"${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null
        }
        # update data every n seconds
        if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
          result_orders
          # update data if missing
        elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
          result_orders
          # update data if empty
        elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
          result_orders
        fi

        ORDER_TOTAL="$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/orders | awk '{ print $1 }')"

        display_result() {
          dialog --title "Open Orders: +$ORDER_TOTAL" \
            --no-collapse \
            --msgbox "$(echo "$RESULT" | column -t)" 0 0
        }

        RESULT="OrderID: Type Amount Original LimitPrice List Ref DateAdded
$(cat "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null | sort -r)"
        display_result 2>/dev/null

        ;;

      esac
    else
      no_key_no_secret
    fi
  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # update repo

"5")

  display_result() {
    dialog --title "Updating Leeloo (Multipass)" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && git pull >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

  # any updates relating to the auto strategies system, restart
  UPDATE_KEYS="looper|leeloo|functions|private_API|public_API"
  if [[ "$(egrep "$UPDATE_KEYS" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | grep '[+-]' | wc -l)" -gt "0" ]] &>/dev/null; then
    ROBOT_UPDATES="$(egrep "$UPDATE_KEYS" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | awk '{ print $3,$4 }')"
    echo " New updates! $ROBOT_UPDATES" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

    if [[ "$(echo "$SCREEN_LIST" | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit 2>/dev/null
      echo " Robot stopping! --" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

      # kill screen
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit 2>/dev/null

      # kill leeloo pid (shell)
      echo "$(ps aux 2>/dev/null | grep "leeloo" | grep -v "grep" | grep "bash.*robot/leeloo" | awk '{ print $2 }' | tail -1)" >"${LOG_DIR:?}"/leeloo/ps_aux
      LEELOO_PID="$(cat "${LOG_DIR:?}"/leeloo/ps_aux 2>/dev/null)"
      kill -9 "$LEELOO_PID" &>/dev/null

      bash "${SYS_DIR:?}"/robot/looper
      echo " Robot starting! ++" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
    fi
  fi

  # if any updates, skip
  if [[ ! "$(grep "Updating" "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    echo "
$(echo "$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null) $REPO_HEAD")" >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
  fi

  RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
  display_result 2>/dev/null
  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && bash include/install 2>/dev/null
  rm "${LOG_DIR:?}"/leeloo/repo &>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git rev-parse --short HEAD 2>&1 | grep -Eo '[a0-z9]{7}' 2>&1 | head -1 >"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git log -1 --format="%at" | xargs -I{} date -d @{} '+%Y' >>"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  clear

  if [[ ! "$(grep "Already up to date." "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    exit
  fi

  ;;

  ##############################################################################

  # manual history

"H")

  if [[ ! -z "$API_SOUTHX_KEY" ]] &>/dev/null; then
    if [[ ! -z "$API_SOUTHX_SECRET" ]] &>/dev/null; then
      last_log
    else
      no_key_no_secret
    fi
  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # leeloo.log

"L")

  display_result() {
    dialog --title "Leeloo Debug info: +$LEELOO_LINES" \
      --no-collapse \
      --msgbox "$RESULT" 12 "$WIDTH"
  }

  LEELOO_SECONDS="$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/leeloo.log 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
  if [[ -z "$LEELOO_SECONDS" ]] &>/dev/null; then
    LEELOO_SECONDS="0"
  fi
  LEELOO_DATA="$(wc -l "${LOG_DIR:?}"/leeloo/leeloo.log 2>/dev/null | awk '{ print $1 }')"
  LEELOO_LOG_TIME=$(printf '%dh:%dm:%ds\n' $(("$LEELOO_SECONDS/3600")) $(("$LEELOO_SECONDS%3600/60")) $(("$LEELOO_SECONDS%60")))
  LEELOO_LINES="$(wc -l "${LOG_DIR:?}"/leeloo/leeloo.log 2>/dev/null | awk '{ print $1 }')"
  LEELOO_TIMED="$(echo "$(ls -l "${LOG_DIR:?}"/leeloo/leeloo.log 2>/dev/null | awk '{ print $8 }')")"

  LEELOO_PID="$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | xargs)"
  LEELOO_TIME=$(ps -p $LEELOO_PID -o etimes=)
  LEELOO_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${LEELOO_TIME:?}" 2>&1)/3600")) $(("$(echo "${LEELOO_TIME:?}" 2>&1)%3600/60")) $(("$(echo "${LEELOO_TIME:?}" 2>&1)%60")))

  LEELOO_ERROR="$(grep "$LEELOO_TIMED" "${LOG_DIR:?}"/leeloo/robot.*.log 2>/dev/null | awk -Flog: '{ print $2 }' | tail -1)"
  LEELOO_ERRORS="$(wc -l "${LOG_DIR:?}"/leeloo/leeloo.log | awk '{ print $1 }')"

  WIDTH="$(echo "$(echo "$LEELOO_ERROR" | wc -L)+5" | bc 2>/dev/null)"

  if [[ "$LEELOO_DATA" -eq "0" ]] &>/dev/null; then
    WIDTH="35"
    LEELOO_TIMED="None"
    LEELOO_ERROR="Nothing."
    LEELOO_ERRORS="None"
  fi

  RESULT="
LogAge.: $LEELOO_LOG_TIME
Uptime.: $LEELOO_UPTIME

Time...: $LEELOO_TIMED
ERRORS.: $LEELOO_ERRORS

$LEELOO_ERROR"
  display_result 2>/dev/null

  if [[ "$LEELOO_DATA" -gt "0" ]] &>/dev/null; then
    nano "$LOG_DIR"/leeloo/leeloo.log
    clear
    if ! dialog --stdout --title "Keep data?" \
      --backtitle "Kepp data?" \
      --yesno "Yes: Keep!, No:  Go Delete!" 5 32; then
      truncate -s 0 "$LOG_DIR"/leeloo/leeloo.log &>/dev/null
    fi
  fi

  ;;

  ##############################################################################

  # broker.conf

"7")

  nano "${SYS_DIR:?}"/broker.conf
  clear

  ##############################################################################

  # auto strategy

  ;;

"A")

  if [[ "$(echo "$SCREEN_LIST" | grep "leeloo" | wc -l)" -eq "1" ]] &>/dev/null; then
    LEELOO_RUNNING="Online"
    LEELOO_PID="$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | xargs)"
    LEELOO_TIME=$(ps -p $LEELOO_PID -o etimes=)
    LEELOO_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${LEELOO_TIME:?}" 2>&1)/3600")) $(("$(echo "${LEELOO_TIME:?}" 2>&1)%3600/60")) $(("$(echo "${LEELOO_TIME:?}" 2>&1)%60")))
    LEELOO_STRAT="$(ls -l "${SYS_DIR:?}"/robot/*.config 2>/dev/null | wc -l)"
  else
    LEELOO_STRAT="0"
    LEELOO_RUNNING="Offline"
    LEELOO_UPTIME="0h:0m:0s"
  fi

  HEIGHT=17
  WIDTH=45
  CHOICE_HEIGHT=10
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Robot Strategy Menu"
  MENU="Multipass $DATE
Bots: $LEELOO_STRAT $LEELOO_RUNNING :: Uptime: $LEELOO_UPTIME"

  OPTIONS=(1 "Data             Strategy data"
    2 "Positions        Open positions"
    H "History          Robot history"
    3 "Config           Configurations"
    4 "Setup            Setup strategy"
    C "Control          Robot controller"
    L "Bots             robot.log"
    P "Debug            Specific log"
    0 "Delete           Remove strategy")

