#!/bin/bash

source /usr/local/bin/include/leeloo/broker.conf
source include/install

# menu
HEIGHT=16
WIDTH=45
CHOICE_HEIGHT=9
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $(date | xargs)"

OPTIONS=(1 "Balance          View Portfolio"
  2 "Market           View Market"
  3 "Check            Check Market")

CHOICE=$(dialog --clear \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

"1")

  function result_jq() {
    source include/api/southxchange/private_API
    listBalances
    cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
    result_jq
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_jq
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_jq
  fi

  sleep 1

  ;;

"2")

  echo "You chose Option 2"

  ;;

"3")

  source include/api/southxchange/private_API

  # market (example)
  MARKET_INPUT=$(
    dialog --title "Market (BTC/USDT)" \
      --inputbox "Enter name:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )

  display_result() {
    dialog --title "Result:" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  RESULT="$(checkMarket "$MARKET_INPUT")"
  display_result 2>/dev/null

  ;;

esac

# END
