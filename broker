  ;;

  ##############################################################################

  # search market

"3")

  VALID_OPTIONS=()

  # poloniex option
  VALID_OPTIONS+=("1" "Poloniex")
  # southxchange option
  VALID_OPTIONS+=("2" "SouthXchange")
  # stakecube option
  VALID_OPTIONS+=("3" "StakeCube")

  BASE_HEIGHT=5
  CHOICE_HEIGHT=${#VALID_OPTIONS[@]}
  HEIGHT=$((BASE_HEIGHT + CHOICE_HEIGHT - 1))
  WIDTH=24
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Search"
  MENU="$DATE"

  OPTIONS=()
  for ((i = 0; i < CHOICE_HEIGHT - 1; i += 2)); do
    OPTIONS+=("${VALID_OPTIONS[i]}" "${VALID_OPTIONS[i + 1]}")
  done

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # poloniex search ############################################################

  "1")

    search_poloniex

    if [[ ! -z "$MARKET_INPUT" ]] &>/dev/null; then

      USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

      # get prices
      function result_prices() {
        echo "$(getPrices | column -t)" >"${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null
      }
      # update data every n seconds
      if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
        result_prices
        # update data if missing
