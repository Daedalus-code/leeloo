################################################################################

# shellcheck disable=SC2034  # Unused variables left for readability

# set the locale to "C" to use a decimal point as the separator
export LC_NUMERIC=C
# set ncurses no utf9 acs to fix dialog tearing in macos terminal
export NCURSES_NO_UTF8_ACS=1

################################################################################

# color
source /usr/local/bin/include/leeloo/color
# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges
# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi

################################################################################

exchange_template
account_private_api
account_public_api
repo_head_data
system_load
system_date

################################################################################

clear

# menu

EXTRA_WIDTH="$(echo "$ERROR_STATUS" | wc -L)"

HEIGHT=21
WIDTH="$(echo "43+$EXTRA_WIDTH" | bc 2>/dev/null)"
CHOICE_HEIGHT=13
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $DATE
Load: $LOAD :: $REPO_HEAD $REPO_DATE"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup Order"
  5 "Update           New Law & Order"
  H "History          Manual History"
  L "Debug            Leeloo Logs ($ERROR_STATUS)"
  7 "Config           Configurations"
  A "Robot            Auto Strategy"
  C "Chat             Chat Menu"
  I "Check            Indicators"
  D "Donate           Donation"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

################################################################################

# balance

"1")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then

    VALID_OPTIONS=()

    # poloniex option
    if [[ -n "$API_POLONIEX_KEY" ]] && [[ -n "$API_POLONIEX_SECRET" ]]; then
      VALID_OPTIONS+=("1" "Poloniex")
    fi
    # southxchange option
    if [[ -n "$API_SOUTHX_KEY" ]] && [[ -n "$API_SOUTHX_SECRET" ]]; then
      VALID_OPTIONS+=("2" "SouthXchange")
    fi
    # stakecube option
    if [[ -n "$API_STAKECUBE_KEY" ]] && [[ -n "$API_STAKECUBE_SECRET" ]]; then
      VALID_OPTIONS+=("3" "StakeCube")
    fi

    BASE_HEIGHT="5"
    CHOICE_HEIGHT=$((${#VALID_OPTIONS[@]} / 2))
    HEIGHT=$((BASE_HEIGHT + CHOICE_HEIGHT + 2))
    WIDTH="24"
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Account Balances"
    MENU="$DATE"

    OPTIONS=()
    for ((i = 0; i < CHOICE_HEIGHT * 2; i += 2)); do
      OPTIONS+=("${VALID_OPTIONS[i]}" "${VALID_OPTIONS[i + 1]}")
    done

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    # poloniex balances ########################################################

    "1")

      USER_TIMER="$(echo "$BOT_TIMER*1.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

      display_result() {
        dialog --title "$FILE_TIME :: Account Balance" \
          --no-collapse \
          --msgbox "$(echo "$RESULT" | column -t)" 0 0
      }

      # get balance
      function result_balances() {
        echo "$(returnBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/poloniex/balances 2>/dev/null
      }
      # update data every n seconds
      if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/poloniex/balances 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
        result_balances
        # update data if missing
      elif [[ ! -f "${LOG_DIR:?}"/leeloo/poloniex/balances ]] &>/dev/null; then
        result_balances
        # update data if empty
      elif [[ ! -s "${LOG_DIR:?}"/leeloo/poloniex/balances ]] &>/dev/null; then
        result_balances
      fi

      until [[ -f "${LOG_DIR:?}"/leeloo/poloniex/balances ]] &>/dev/null; do
        clear
        echo "Please wait.."
        sleep 1
      done

      FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/poloniex/balances 2>/dev/null | awk '{ print $8 }')"
      if [[ -z "$FILE_TIME" ]] &>/dev/null; then
        FILE_TIME="00:00"
      fi

      if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/poloniex/balances | awk '{ print $1 }')" -lt "2" ]] &>/dev/null; then
        LENGTH="5"
        RESULT="No balance"
      else
        RESULT="Coins: Deposited Available Unconfirmed
    $(cat "${LOG_DIR:?}"/leeloo/poloniex/balances 2>/dev/null)"
      fi

      display_result 2>/dev/null

      ;;

      # southxchange balances ##################################################

    "2")

      USER_TIMER="$(echo "$BOT_TIMER*1.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

      display_result() {
        dialog --title "$FILE_TIME :: Account Balance" \
          --no-collapse \
          --msgbox "$(echo "$RESULT" | column -t)" 0 0
      }

      # get balance
      function result_balances() {
        echo "$(listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
      }
      # update data every n seconds
      if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
        result_balances
        # update data if missing
      elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
        result_balances
        # update data if empty
      elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
        result_balances
      fi

      until [[ -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; do
