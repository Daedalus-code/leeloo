  fi

  # system uptime, in seconds
  SYSTEM_UPTIME_SECONDS="$(cat "$FILE_SYSTEM_UPTIME" 2>/dev/null | awk -F. '{ print $1 }')"
  # time format (uptime)
  SYSTEM_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)/3600")) $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)%3600/60")) $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)%60")))
