        FILE_TIME="00:00"
      fi

      if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/balances | awk '{ print $1 }')" -lt "2" ]] &>/dev/null; then
        LENGTH="5"
        RESULT="No balance"
      else
        RESULT="Coins: Deposited Available Unconfirmed
    $(cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)"
      fi

      display_result 2>/dev/null

      ;;

      # stakecube balances #####################################################

    "3")

      USER_TIMER="$(echo "$BOT_TIMER*1.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"
      SCE_NONCE_COUNTER=$(cat "${LOG_DIR:?}"/leeloo/nonce.count 2>/dev/null)
      if [[ -z "$SCE_NONCE_COUNTER" ]] &>/dev/null; then
        SCE_NONCE_COUNTER="0"
      fi

      display_result() {
        dialog --title "$FILE_TIME :: Account Balance ($SCE_NONCE_COUNTER)" \
          --no-collapse \
          --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
      }

      # get balance
      function result_balances() {
        echo "$(returnAccount | jq -r '.result.wallets[] | "\(.asset): \(.balance) \(.balanceInOrder) \(.balanceInMasternodes) \(.balanceInInterest)"' 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/stakecube/balances 2>/dev/null
      }
      # update data every n seconds
      if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/stakecube/balances 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
        result_balances
        # update data if missing
      elif [[ ! -f "${LOG_DIR:?}"/leeloo/stakecube/balances ]] &>/dev/null; then
        result_balances
        # update data if empty
      elif [[ ! -s "${LOG_DIR:?}"/leeloo/stakecube/balances ]] &>/dev/null; then
        result_balances
      fi

      until [[ -f "${LOG_DIR:?}"/leeloo/stakecube/balances ]] &>/dev/null; do
        clear
        echo "Please wait.."
        sleep 1
      done

      # balances backup
      # sce_backup_balances

      FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/stakecube/balances 2>/dev/null | awk '{ print $8 }')"
      if [[ -z "$FILE_TIME" ]] &>/dev/null; then
        FILE_TIME="00:00"
      fi

      RESULT_FORMAT="Coins: Deposited InOrder InMasternodes InInterest
  $(cat "${LOG_DIR:?}"/leeloo/stakecube/balances 2>/dev/null)"

      if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/stakecube/balances | awk '{ print $1 }')" -lt "1" ]] &>/dev/null; then
        WIDTH="$(echo "$(echo "$RESULT_FORMAT" | wc -L)+10" | bc 2>/dev/null)"
        LENGTH="$(echo "$(echo "$RESULT_FORMAT" | wc -l)+4" | bc 2>/dev/null)"
        RESULT="No balance"
      else
        WIDTH="$(echo "$(echo "$RESULT_FORMAT" | wc -L)+10" | bc 2>/dev/null)"
        LENGTH="$(echo "$(echo "$RESULT_FORMAT" | wc -l)+4" | bc 2>/dev/null)"
        RESULT="$RESULT_FORMAT"
      fi

      display_result 2>/dev/null

      ;;

    esac

  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # prices

"2")

  VALID_OPTIONS=()

  # poloniex option
  VALID_OPTIONS+=("1" "Poloniex")
  # southxchange option
  VALID_OPTIONS+=("2" "SouthXchange")
  # stakecube option
  VALID_OPTIONS+=("3" "StakeCube")

  BASE_HEIGHT=5
  CHOICE_HEIGHT=${#VALID_OPTIONS[@]}
  HEIGHT=$((BASE_HEIGHT + CHOICE_HEIGHT - 1))
  WIDTH=24
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Prices"
  MENU="$DATE"

  OPTIONS=()
  for ((i = 0; i < CHOICE_HEIGHT - 1; i += 2)); do
    OPTIONS+=("${VALID_OPTIONS[i]}" "${VALID_OPTIONS[i + 1]}")
  done

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # poloniex prices ############################################################

  "1")

    USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

    display_result() {
      dialog --title "$FILE_TIME :: Top 100 Market: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
        --no-collapse \
        --scrollbar \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }

    # get prices
    function result_prices() {
      echo "$(getPrices | column -t)" >"${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/poloniex/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/poloniex/prices ]] &>/dev/null; then
      result_prices
    fi

    CAT_POLONIEX_PRICES="$(cat "${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null)"

    # 450 max before dialog breaks
    MARKET_RESULT="$(echo "$CAT_POLONIEX_PRICES" | sort -k2 -n -r 2>/dev/null | head -100)"
    MARKET_COUNT="$(grep -v "Market" "${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null | sed '/^$/d' | wc -l)"
    MARKET_MOON="$(echo "$CAT_POLONIEX_PRICES" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
    MARKET_MOON_COUNT="$(echo "$CAT_POLONIEX_PRICES" | awk '{ print $5 }' | wc -l)"
    MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)-7" | bc 2>/dev/null)"
    LENGTH="25"

    if [[ -z "$WIDTH" ]] &>/dev/null; then
      WIDTH="77"
    fi

    if [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
      WIDTH="77"
    fi

    if [[ "$MARKET_COUNT" -eq "0" ]] &>/dev/null; then
      LENGTH="5"
      RESULT="Support: https://support.poloniex.com"
    else
      RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
    fi

    FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null | awk '{ print $8 }')"
    if [[ -z "$FILE_TIME" ]] &>/dev/null; then
      FILE_TIME="00:00"
    fi

    display_result 2>/dev/null

    ;;

    # southxchange prices ######################################################

  "2")

    USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

    display_result() {
      dialog --title "$FILE_TIME :: Top 100 Market: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
        --no-collapse \
        --scrollbar \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }

    # get prices
    function result_prices() {
      echo "$(prices | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
      result_prices
    fi

    CAT_SOUTHX_PRICES="$(cat "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)"

    # 450 max before dialog breaks
    MARKET_RESULT="$(echo "$CAT_SOUTHX_PRICES" | sort -k2 -n -r 2>/dev/null | head -100)"
    MARKET_COUNT="$(grep -v "Market" "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | sed '/^$/d' | wc -l)"
    MARKET_MOON="$(echo "$CAT_SOUTHX_PRICES" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
    MARKET_MOON_COUNT="$(echo "$CAT_SOUTHX_PRICES" | awk '{ print $5 }' | wc -l)"
    MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+5" | bc 2>/dev/null)"
    LENGTH="25"

    if [[ -z "$WIDTH" ]] &>/dev/null; then
      WIDTH="77"
    fi

    if [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
      WIDTH="77"
    fi

    if [[ "$MARKET_COUNT" -eq "0" ]] &>/dev/null; then
      LENGTH="5"
      RESULT="Support: https://southxchange.gorgias.help"
    else
      RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
    fi

    FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null | awk '{ print $8 }')"
    if [[ -z "$FILE_TIME" ]] &>/dev/null; then
      FILE_TIME="00:00"
    fi

    display_result 2>/dev/null

    ;;

    # stakecube prices #########################################################

  "3")

    USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

    display_result() {
      dialog --title "$FILE_TIME :: Top 100 Market: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
        --no-collapse \
        --scrollbar \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }

    # get prices
    function result_prices() {
      echo "$(getMarkets | column -t)" >"${LOG_DIR:?}"/leeloo/stakecube/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/stakecube/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/stakecube/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/stakecube/prices ]] &>/dev/null; then
      result_prices
    fi

    CAT_STAKECUBE_PRICES="$(cat "${LOG_DIR:?}"/leeloo/stakecube/prices 2>/dev/null)"

    # 450 max before dialog breaks
