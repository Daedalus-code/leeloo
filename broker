RSI
$(get_rsi 14 "$COIN_TOKEN" 2>/dev/null)
$(get_rsi 21 "$COIN_TOKEN" 2>/dev/null)
-
EMA
$(get_ema 6 20 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 8 20 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 10 38 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 12 26 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 20 200 "$COIN_TOKEN" 2>/dev/null)
$(get_ema 50 200 "$COIN_TOKEN" 2>/dev/null)
-"

      echo "$RESULT_RAW" >"${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp 2>/dev/null

      # disregard ema_signal, count bearish and bullish
      BEARISH_SIGNAL="$(echo "$RESULT_RAW" | egrep "Short_EMA|Long_EMA" | grep -c "Bearish" "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp)"
      BULLISH_SIGNAL="$(echo "$RESULT_RAW" | egrep "Short_EMA|Long_EMA" | grep -c "Bullish" "${LOG_DIR:?}"/leeloo/indicators/check_rsi_ema_"$COIN_TOKEN".tmp)"
      TOTAL_SIGNAL="$(echo "$BEARISH_SIGNAL+$BULLISH_SIGNAL" | bc 2>/dev/null)"
      BEARISH_PERCENTAGE="$(echo "100/$TOTAL_SIGNAL*$BEARISH_SIGNAL" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
      BULLISH_PERCENTAGE="$(echo "100/$TOTAL_SIGNAL*$BULLISH_SIGNAL" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

      if [[ "$BEARISH_SIGNAL" -gt "$BULLISH_SIGNAL" ]] &>/dev/null; then
