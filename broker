#!/bin/bash

################################################################################

# DISCLAIMER

# All trading activities and any resulting losses are solely the user's responsibility.
# This software is provided without warranties or guarantees, use it at your own risk.
# Embrace the chaos, adapt to the shadows, may the odds ever be in your favor.

################################################################################

# shellcheck disable=SC2034  # Unused variables left for readability

# set the locale to "C" to use a decimal point as the separator
export LC_NUMERIC=C
# set ncurses no utf9 acs to fix dialog tearing in macos terminal
export NCURSES_NO_UTF8_ACS=1

################################################################################

# color
source /usr/local/bin/include/leeloo/color
# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges
# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi

################################################################################

exchange_template
account_private_api
account_public_api
repo_head_data
system_load
system_date
log_date_xargs

################################################################################

clear

# menu

EXTRA_WIDTH="$(echo "$ERROR_STATUS" | wc -L)"

HEIGHT=21
WIDTH="$(echo "43+$EXTRA_WIDTH" | bc 2>/dev/null)"
CHOICE_HEIGHT=13
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $DATE_XARGS
Load: $LOAD :: $REPO_HEAD $REPO_DATE"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup Order"
  5 "Update           New Law & Order"
  H "History          Manual History"
  L "Debug            Leeloo Logs ($ERROR_STATUS)"
  7 "Config           Configurations"
  A "Robot            Auto Strategy"
  C "Chat             Chat Menu"
  I "Check            Indicators"
  D "Donate           Donation"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

################################################################################

# balance

"1")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then

    HEIGHT=11
    WIDTH=24
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Account Balances"
    MENU="$DATE"

    OPTIONS=(1 "Poloniex"
      2 "SouthXchange"
      3 "StakeCube"
      4 "XeggeX")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    # poloniex balances ########################################################

    "1")

      EXCHANGE_BALANCE="poloniex"
      exchange_balance

      ;;

      # southxchange balances ##################################################

    "2")

      EXCHANGE_BALANCE="southxchange"
      exchange_balance

      ;;

      # stakecube balances #####################################################

    "3")

      EXCHANGE_BALANCE="stakecube"
      exchange_balance

      ;;

      # xeggex balances ########################################################

    "4")

      EXCHANGE_BALANCE="xeggex"
      exchange_balance

      ;;

    esac

  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # prices

"2")

  HEIGHT=12
  WIDTH=24
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Prices"
  MENU="$DATE"

  OPTIONS=(1 "Poloniex"
    2 "SouthXchange"
    3 "StakeCube"
    4 "XeggeX"
    0 "All")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # poloniex prices ############################################################

  "1")

    OBSERVE_MARKET="poloniex"
    observe_market

    ;;

    # southxchange prices ######################################################

  "2")

    OBSERVE_MARKET="southxchange"
    observe_market

    ;;

    # stakecube prices #########################################################

  "3")

    OBSERVE_MARKET="stakecube"
    observe_market

    ;;

    # xeggex prices ############################################################

  "4")

    OBSERVE_MARKET="xeggex"
    observe_market

    ;;

  "0")

    observe_all_market

    ;;

  esac

  ;;

  ##############################################################################

  # search market

"3")

  HEIGHT=11
  WIDTH=24
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Search"
  MENU="$DATE"

  OPTIONS=(1 "Poloniex"
    2 "SouthXchange"
    3 "StakeCube"
    4 "XeggeX")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # poloniex search ############################################################

  "1")

    SEARCH_MARKET="poloniex"
    search_market

    ;;

    # southxchange search ######################################################

  "2")

    SEARCH_MARKET="southxchange"
    search_market

    ;;

    # stakecube search #########################################################

  "3")

    SEARCH_MARKET="stakecube"
    search_market

    ;;

    # xeggex search ############################################################

  "4")

    SEARCH_MARKET="xeggex"
    search_market

    ;;

  esac

  ;;

  ##############################################################################

  # orders

"4")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then

    HEIGHT=11
    WIDTH=24
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Orders"
    MENU="$DATE"

    OPTIONS=(1 "Poloniex"
      2 "SouthXchange"
      3 "StakeCube"
      4 "XeggeX")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1") # poloniex menu

      # set exchange template
      EXCHANGE_API="POL"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    "2") # southxchange menu

      # set exchange template
      EXCHANGE_API="SXC"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    "3") # stakecube menu

      # set exchange template
      EXCHANGE_API="SCE"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    "4") # xeggex menu

      # set exchange template
      EXCHANGE_API="XGX"
      exchange_template
      open_orders

      # set broker template
      EXCHANGE_API=""
      exchange_template

      ;;

    esac

  else
    no_key_no_secret
  fi

  # set exchange template
  EXCHANGE_API=""
  exchange_template

  ;;

  ##############################################################################

  # update repo

"5")

  ##############################################################################

  update_screen

  ##############################################################################

  ### cleanup old junk ###
  if [[ -f "${LOG_DIR:?}"/leeloo/robot.broker.log || -f "${LOG_DIR:?}"/leeloo/looper.log ]] &>/dev/null; then
    echo "Removing old junk.."
    sudo rm "${LOG_DIR:?}"/leeloo/robot.broker.log &>/dev/null
    sudo rm "${LOG_DIR:?}"/leeloo/looper.log &>/dev/null
    sleep 1
  fi

  ##############################################################################

  while true; do
    # robot log status
    ROBOT_LOG_STATUS="$(stat -c '%n %Y' "${LOG_DIR:?}"/leeloo/robot.*.log 2>/dev/null | while read filename lastedit; do echo "$filename $(($(date +%s) - $lastedit))"; done | column -t | awk -F. '{ print $2,$NF }')"
    # num
    NUMBERS="$(echo "$ROBOT_LOG_STATUS" | awk '{ print $NF }' | sort -n)"
    # loop through each number
    NO_LOGS_BELOW=true
    for NUM in $NUMBERS; do
      # check if the number is below n
      if [ "$NUM" -lt "$(echo "$BOT_TIMER-5" | bc 2>/dev/null | awk '{ printf "%.0f\n", $1 }')" ]; then
        NO_LOGS_BELOW=false
        WAITING_ON_BOT="$NUM"
        break # no need to check further, we found a log below n seconds
      fi
    done
    # if no logs are below n seconds, break the loop
    if $NO_LOGS_BELOW; then
      break
    fi
    ROBOT_STATUS_PERCENTAGE="$(echo "100/$BOT_TIMER*$NUM" | bc 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
    # wait for a specified interval before checking again
    echo "Bots are doing something.. (${ROBOT_STATUS_PERCENTAGE:?}%) Please wait!"
    sleep 1
    clear
  done

  ##############################################################################

  display_result() {
    dialog --title "Updating Leeloo (Multipass)" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && git pull >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

  # any updates relating to the auto strategies system, restart
  UPDATE_KEYS="looper|leeloo|functions|private_API|public_API"
  if [[ "$(egrep "$UPDATE_KEYS" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | grep '[+-]' | wc -l)" -gt "0" ]] &>/dev/null; then
    ROBOT_UPDATES="$(egrep "$UPDATE_KEYS" "${LOG_DIR:?}"/leeloo/updating 2>/dev/null | awk '{ print $3,$4 }')"
    echo " New updates! $ROBOT_UPDATES" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null

    if [[ "$(echo "$SCREEN_LIST" | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
      echo " Robot stopping! --" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
      # kill leeloo pid (shell)
      echo "$(ps aux 2>/dev/null | grep "leeloo" | awk '{ print $2 }' | xargs)" >"${LOG_DIR:?}"/leeloo/ps_aux
      LEELOO_PID="$(cat "${LOG_DIR:?}"/leeloo/ps_aux 2>/dev/null)"
      kill -9 "$LEELOO_PID" &>/dev/null
      # kill screen
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit &>/dev/null
      sleep 1
      # start looper
      bash "${SYS_DIR:?}"/robot/looper
      echo " Robot starting! ++" >>"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
    fi
  fi

  # if any updates, skip
  if [[ ! "$(grep "Updating" "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    echo "
$(echo "$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null) $REPO_HEAD")" >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
  fi

  RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
  display_result 2>/dev/null
  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && bash include/install 2>/dev/null
  rm "${LOG_DIR:?}"/leeloo/repo &>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git rev-parse --short HEAD 2>&1 | grep -Eo '[a0-z9]{7}' 2>&1 | head -1 >"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  cd "${HOME_DIR:?}"/leeloo || exit && git log -1 --format="%at" | xargs -I{} date -d @{} '+%Y' >>"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  clear

  if [[ ! "$(grep "Already up to date." "${LOG_DIR:?}"/leeloo/updating | wc -l)" -gt "0" ]] &>/dev/null; then
    exit
  fi

  ;;

  ##############################################################################

  # manual history

"H")

  key_secret_set

  if [[ "$KEY_SECRET_OK" -eq "1" ]] &>/dev/null; then
    last_log
  else
    no_key_no_secret
  fi

  ;;

  ##############################################################################

  # error.log

"L")

  update_screen

  ##############################################################################

  # strategy error output
  STRATEGY_ERROR_DATA="$(cat "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | sed '/^$/d')"
  # strategy error count
  STRATEGY_ERROR_DATA_COUNT="$(echo "$STRATEGY_ERROR_DATA" 2>/dev/null | sed '/^$/d' | wc -l)"

  # txid null error output
  TXID_NULL_DATA="$(echo "$(cat "${SYS_DIR:?}"/robot/*null.log 2>/dev/null)" | sed '/^$/d')"
  # txid null error count
  TXID_NULL_DATA_COUNT="$(echo "$TXID_NULL_DATA" 2>/dev/null | egrep -c "[a-z]+|[0-9]+")"

  ##############################################################################

  HEIGHT=11
  WIDTH=37
  CHOICE_HEIGHT=4
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Debug Menu"
  MENU="Multipass $DATE_XARGS"

  OPTIONS=(1 "Debug           Status"
    2 "Strategy        error.log"
    3 "TXid            null.log"
    n "Reset           null ($(echo "$TXID_NULL_DATA_COUNT" | awk '{ print $1 }'))")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    display_result() {
      dialog --title "Leeloo/Strategy Debug" \
        --no-collapse \
        --msgbox "$RESULT" 15 "$WIDTH"
    }

    ############################################################################

    # system uptime
    function system_uptime() {
      if [[ -f /proc/uptime ]] &>/dev/null; then

        # get uptime, idletime
        echo "$(cat /proc/uptime 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/system
        CAT_SYSTEM="$(cat "${LOG_DIR:?}"/leeloo/system 2>/dev/null)"

        # system files
        FILE_SYSTEM_UPTIME="${LOG_DIR:?}/leeloo/system.uptime"
        FILE_SYSTEM_IDLE="${LOG_DIR:?}/leeloo/system.idle"

        # get uptime
        echo "$(echo "$CAT_SYSTEM" | awk '{ print $1 }')" >"$FILE_SYSTEM_UPTIME"
        # get idletime
        echo "$(echo "$CAT_SYSTEM" | awk '{ print $2 }')" >"$FILE_SYSTEM_IDLE"
      else
        # set uptime
        echo "0.0" >"$FILE_SYSTEM_UPTIME"
        # set idletime
        echo "0.0" >"$FILE_SYSTEM_IDLE"
      fi
    }

    # not found
    if [[ ! -f "$FILE_SYSTEM_UPTIME" || ! -f "$FILE_SYSTEM_IDLE" ]] &>/dev/null; then
      system_uptime
    fi

    # both found
    if [[ -f "$FILE_SYSTEM_UPTIME" && -f "$FILE_SYSTEM_IDLE" ]] &>/dev/null; then
      # greater than n seconds
      SYSTEM_FILE_SECONDS="$(stat -c '%Y' "$FILE_SYSTEM_UPTIME" 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
      if [[ "$SYSTEM_FILE_SECONDS" -gt "60" ]] &>/dev/null; then
        system_uptime
      fi
    fi

    # system uptime, in seconds
    SYSTEM_UPTIME_SECONDS="$(cat "$FILE_SYSTEM_UPTIME" 2>/dev/null | awk -F. '{ print $1 }')"
    # time format (uptime)
    SYSTEM_UPTIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)/3600")) $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)%3600/60")) $(("$(echo "${SYSTEM_UPTIME_SECONDS:?}" 2>&1)%60")))
    # uptime in days
    SYSTEM_UPTIME_DAYS="$(echo "$SYSTEM_UPTIME_SECONDS/86400" | bc 2>/dev/null)"

    # system idle, in seconds
    SYSTEM_IDLE_SECONDS="$(cat "$FILE_SYSTEM_IDLE" 2>/dev/null | awk -F. '{ print $1 }')"
    # time format (idle)
    SYSTEM_IDLE_TIME=$(printf '%dh:%dm:%ds\n' $(("$(echo "${SYSTEM_IDLE_SECONDS:?}" 2>&1)/3600")) $(("$(echo "${SYSTEM_IDLE_SECONDS:?}" 2>&1)%3600/60")) $(("$(echo "${SYSTEM_IDLE_SECONDS:?}" 2>&1)%60")))
    # idle in days
    SYSTEM_IDLE_DAYS="$(echo "$SYSTEM_IDLE_SECONDS/86400" | bc 2>/dev/null)"

    # restarts
    STRATEGY_RESTART_COUNT="$(wc -l "${SYS_DIR:?}"/robot/restart 2>/dev/null | awk '{ print $1 }')"
    # restarts log age in seconds
    STRATEGY_RESTART_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/restart 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

    # if zero
    if [[ -z "$STRATEGY_RESTART_SECONDS" ]] &>/dev/null; then
      STRATEGY_RESTART_SECONDS="0"
    fi

    # time format
    STRATEGY_RESTART_TIME=$(printf '%dh:%dm:%ds\n' $(("$STRATEGY_RESTART_SECONDS/3600")) $(("$STRATEGY_RESTART_SECONDS%3600/60")) $(("$STRATEGY_RESTART_SECONDS%60")))
    # uptime in days
    STRATEGY_RESTART_UPTIME_DAYS="$(echo "$STRATEGY_RESTART_SECONDS/86400" | bc 2>/dev/null)"

    if [[ -z "$STRATEGY_RESTART_COUNT" ]] &>/dev/null; then
      STRATEGY_RESTART_COUNT="None"
    fi

    if [[ -z "$SYSTEM_UPTIME" ]] &>/dev/null; then
      SYSTEM_UPTIME="0h:00m:00s"
    fi

    ############################################################################

    # error log age in seconds
    STRATEGY_SECONDS="$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

    if [[ -z "$STRATEGY_SECONDS" ]] &>/dev/null; then
      STRATEGY_SECONDS="0"
    fi

    # time format
    STRATEGY_LOG_TIME=$(printf '%dh:%dm:%ds\n' $(("$STRATEGY_SECONDS/3600")) $(("$STRATEGY_SECONDS%3600/60")) $(("$STRATEGY_SECONDS%60")))
    # uptime in days
    STRATEGY_UPTIME_DAYS="$(echo "$STRATEGY_SECONDS/86400" | bc 2>/dev/null)"

    STRATEGY_CLOCK="$(echo "$(ls -l "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | awk '{ print $8 }')")"
    STRATEGY_ERROR="$(echo "$STRATEGY_ERROR_DATA" | tail -1)"

    # default
    WIDTH="48"

    if [[ "$STRATEGY_ERROR_DATA_COUNT" -eq "0" ]] &>/dev/null; then
      WIDTH="$(echo "$(echo "$SYSTEM_UPTIME" | wc -L)+35" | bc 2>/dev/null)"
      STRATEGY_CLOCK="None"
      STRATEGY_ERROR="None"
      STRATEGY_ERROR_DATA_COUNT="0"
    fi

    ############################################################################

    RESULT="
System Uptime......: (${SYSTEM_UPTIME_DAYS:?}d) $SYSTEM_UPTIME
System Idle........: (${SYSTEM_IDLE_DAYS:?}d) $SYSTEM_IDLE_TIME

Strategy Error.....: (${STRATEGY_UPTIME_DAYS:?}d) $STRATEGY_LOG_TIME
Strategy Restart...: (${STRATEGY_RESTART_UPTIME_DAYS:?}d) $STRATEGY_RESTART_TIME
Strategy Errors....: $STRATEGY_ERROR_DATA_COUNT
Strategy Restarts..: $STRATEGY_RESTART_COUNT
Strategy Time......: $STRATEGY_CLOCK

Strategy error.log.: ${STRATEGY_ERROR:0:21}"
    display_result 2>/dev/null

    ;;

  "2")

    # strategy data exist, keep, delete
    if [[ "$STRATEGY_ERROR_DATA_COUNT" -gt "0" ]] &>/dev/null; then

      # strategy data exist, copy temp file
      cp "$LOG_DIR"/leeloo/error.log /tmp/readlog &>/dev/null
      # read temp file
      nano /tmp/readlog
      # remove temp file
      rm /tmp/readlog &>/dev/null

      # prompt user to keep data
      if ! dialog --stdout --title "Keep error.log?" \
        --backtitle "Keep data (error.log)?" \
        --yesno "Yes: Keep! No: Delete!" 5 28; then
        truncate -s 0 "$LOG_DIR"/leeloo/error.log &>/dev/null
      fi
    fi

    # if any duplicates
    if cat "${LOG_DIR:?}"/leeloo/error.log | awk 'seen[$0]++' | grep -q '.'; then
      # prompt user to remove duplicates
      if dialog --stdout --title "Remove duplicates?" \
        --backtitle "Cleanup data?" \
        --yesno "Yes: Clean! No: Go back!" 5 28; then
        # remove duplicates
        awk '!a[$0]++' "${LOG_DIR:?}"/leeloo/error.log >"${LOG_DIR:?}"/leeloo/error.log.tmp
        mv "${LOG_DIR:?}"/leeloo/error.log.tmp "${LOG_DIR:?}"/leeloo/error.log
      fi
    fi

    ;;

  "3")

    # if zero
    if [[ -z "$LOG_LENGTH" ]] &>/dev/null; then
      LOG_LENGTH="7"
    fi

    # strategy data exist, copy temp file
    echo "$TXID_NULL_DATA" >/tmp/readlog 2>/dev/null
    TEMP_READLOG="$(sort -t ':' -k 1.8,1.21n -k 1.4,1.5n -k 1.1,1.2n /tmp/readlog 2>/dev/null | uniq | tac 2>/dev/null)"
    ERROR_CODES="$(echo "$TEMP_READLOG" | head -"$LOG_LENGTH" | egrep -o "error.code..[0-9]+" | tr ':' ' ' | awk '{ print $NF }' | awk '!a[$0]++' | xargs)"

    # if zero
    if [[ -z "$ERROR_CODES" ]] &>/dev/null; then
      ERROR_CODES="0"
    fi

    WIDTH="$(echo "$TEMP_READLOG" | wc -L)"
    WIDTH="$(echo "$WIDTH+4" | bc 2>/dev/null)"
    LENGTH="$(echo "$TEMP_READLOG" | wc -l)"

    # if zero, less than
    if [[ -z "$WIDTH" || "$WIDTH" -lt "64" ]] &>/dev/null; then
      WIDTH="64"
    fi

    # if zero, less than
    if [[ -z "$LENGTH" || "$LENGTH" -lt "5" ]] &>/dev/null; then
      LENGTH=$(echo "$LENGTH+4" | bc 2>/dev/null)
    fi

    # if zero
    if [[ -z "$TEMP_READLOG" ]] &>/dev/null; then
      LENGTH="5"
      TEMP_READLOG="Nothing was found"
    fi

    display_result() {
      dialog --title "Leeloo/Strategy txid Debug :: Error: $TXID_NULL_DATA_COUNT Codes: $ERROR_CODES" \
        --no-collapse \
        --msgbox "$RESULT" "$LENGTH" "$WIDTH"
    }

    # max headroom of 100
    RESULT="$(echo "$TEMP_READLOG" | head -100)"

    display_result 2>/dev/null

    # remove temp file
    rm /tmp/readlog &>/dev/null

    ;;

    # reset null files

  "n")

    if dialog --stdout --title "Reset $TXID_NULL_DATA_COUNT null files?" \
      --backtitle "Reset null?" \
      --yesno "Yes: Reset! No: Go back!" 5 0; then
      truncate -s 0 "${SYS_DIR:?}"/robot/*.null* &>/dev/null
      clear
    fi

    ;;

  esac

  ##############################################################################

  # restart data exist, keep, delete
  if [[ "$STRATEGY_RESTART_COUNT" -gt "0" ]] &>/dev/null; then
    # prompt user to remove restart data
    if ! dialog --stdout --title "Keep restart data?" \
      --backtitle "Keep restart data?" \
      --yesno "Yes: Keep! No: Delete!" 5 28; then
      truncate -s 0 "$SYS_DIR"/robot/restart &>/dev/null
    fi
  fi

  ;;

  ##############################################################################

  # broker.conf, k & s, reset

"7")

  ##############################################################################

  HEIGHT=16
  WIDTH=53
  CHOICE_HEIGHT=9
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Configuration Menu"
  MENU="Multipass $DATE_XARGS"

  OPTIONS=(
    1 "Config           Leeloo config"
    2 "API              Secret & Key config"
    3 "Reset            All Configurations!"
    4 "Reset            Leeloo Config"
    5 "Reset            Secret & Key config"
    G "Graph            Reference graphs"
    8 "Locale           English (United States)"
    F "Filter           robot/orders log filters"
    0 "Delist           Delisting Markets")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
