#!/bin/bash

source /usr/local/bin/include/leeloo/broker.conf
source include/install

# menu
HEIGHT=16
WIDTH=45
CHOICE_HEIGHT=9
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass $(date | xargs)"

OPTIONS=(1 "Balance          View Portfolio"
  2 "Market           View Market"
  3 "Check            Check Market")

CHOICE=$(dialog --clear \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

"1")

  function result_jq() {
    source include/api/southxchange/private_API
    listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
    cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
    result_jq
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_jq
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_jq
  fi

  sleep 1

  ;;

"2")

  echo "You chose Option 2"

  ;;

"3")

  source include/api/southxchange/public_API

  # market (example)
  MARKET_INPUT=$(
    dialog --title "Market (BTC/USDT) (BTC)" \
      --inputbox "Enter name:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )

  MARKET_RESULT="$(prices | egrep "Market|Last|Volume24Hr" | awk -F: '{ print $2 }' | xargs | awk '{ print $1,$2,$3 }' | grep "$(echo "$MARKET_INPUT" | tr '[:lower:]' '[:upper:]')")"
  MARKET_COUNT="$(echo "$MARKET_RESULT" | wc -l)"

  display_result() {
    dialog --title "Result: $MARKET_COUNT" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  RESULT="$(echo "Market Last Volume24Hr
$MARKET_RESULT")"
  display_result 2>/dev/null

  ;;

esac

# END
