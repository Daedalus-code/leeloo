#!/bin/bash

# I'll not rest till I have me gold

# shellcheck disable=SC2034  # Unused variables left for readability

source /usr/local/bin/include/leeloo/broker.conf
source /usr/local/bin/include/leeloo/functions

# southxchange api
source /usr/local/bin/include/leeloo/api/southxchange/private_API
source /usr/local/bin/include/leeloo/api/southxchange/public_API

# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi

export NCURSES_NO_UTF8_ACS=1

DATE="$(date +"%d/%m.%y-%H:%M:%S")"

# menu
HEIGHT=17
WIDTH=44
CHOICE_HEIGHT=10
BACKTITLE="Leeloo (Multipass)"
TITLE="Main Menu"
MENU="Multipass ${DATE:?}"

OPTIONS=(1 "Balance          Account Balance"
  2 "Market           View Market"
  3 "Search           Search Market"
  4 "Order            Setup order"
  5 "Update           New law & order"
  6 "Debug            Debug logs"
  7 "Config           API Config"
  A "Robot            Auto strategy"
  D "Donate           Donation"
  0 "Quit             Exit Menu")

CHOICE=$(dialog --clear \
  --nocancel \
  --backtitle "$BACKTITLE" \
  --title "$TITLE" \
  --menu "$MENU" \
  $HEIGHT $WIDTH $CHOICE_HEIGHT \
  "${OPTIONS[@]}" \
  2>&1 >/dev/tty)

clear
case $CHOICE in

"1")

  function result_balance() {
    listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
    result_balance
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
  fi

  sleep 1

  display_result() {
    dialog --title "Account Balance" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  RESULT="Coins:  Deposited    Available   Unconfirmed

$(cat "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)"
  display_result 2>/dev/null

  ;;

"2")

  function result_market {
    prices | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/market
  }

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)))" 2>/dev/null)" -gt "30" ]] &>/dev/null; then
    result_market
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
  fi

  # 450 max before dialog breaks
  MARKET_RESULT="$(cat "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null | sort -k2 -n -r | head -100)"
  WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+13" | bc)"

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  fi

  display_result() {
    dialog --title "100 Market: +$(prices | wc -l) $DATE" \
      --no-collapse \
      --scrollbar \
      --msgbox "$RESULT" 25 "$WIDTH"
  }

  RESULT="Market:       Bid           Ask          Last       (%)      Volume24Hr

$MARKET_RESULT"
  display_result 2>/dev/null

  ;;

"3")

  search

  if [[ ! -z "$MARKET_INPUT" ]] &>/dev/null; then

    MARKET_SEARCH="$(echo "$MARKET_INPUT" | tr '[:lower:]' '[:upper:]')"
    MARKET_RESULT="$(prices | grep "$MARKET_SEARCH" | sort -k2 -n -r | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t)"
    MARKET_COUNT="$(echo "$MARKET_RESULT" | wc -l)"
    LENGTH="$(echo "$MARKET_COUNT+7" | bc)"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)+16" | bc)"

    if [[ "$LENGTH" -gt "25" ]] &>/dev/null; then
      LENGTH="25"
    fi
    if [[ -z "$WIDTH" ]] &>/dev/null; then
      MARKET_COUNT="0"
      WIDTH="80"
      LENGTH="7"
    elif [[ "$(echo "$MARKET_RESULT" | wc -L)" -eq "0" ]] &>/dev/null; then
      MARKET_COUNT="0"
      WIDTH="80"
      LENGTH="7"
    fi

    display_result() {
      dialog --title "Search result: +$MARKET_COUNT $DATE" \
        --no-collapse \
        --msgbox "$RESULT" "$LENGTH" "$WIDTH"
    }

    RESULT="Market:       Bid           Ask          Last       (%)      Volume24Hr

$MARKET_RESULT"
    display_result 2>/dev/null
  else
    display_result() {
      dialog --title "Market info (empty)" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="No data found!"
    display_result 2>/dev/null
  fi

  ;;

"4")

  # order menu
  HEIGHT=10
  WIDTH=40
  CHOICE_HEIGHT=3
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Order Menu"
  MENU="${DATE:?}"

  OPTIONS=(1 "Buy              Buy Order"
    2 "Sell             Sell Order"
    3 "Status           Open Orders")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    TYPE="buy"
    HEIGHT=9
    WIDTH=23
    CHOICE_HEIGHT=2
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Buy Order Menu"
    AMOUNT_IN_REFERENCE_CURRENCY="true"
    MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

    OPTIONS=(
      1 "Market Order"
      2 "Limit Order")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      setup_market_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
          if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
            PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            echo "$DATE :: Manual $TYPE :: Market Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT" >>"${LOG_DIR:?}"/leeloo/broker.log
            echo "$DATE :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
          fi
        fi
      fi

      ;;

    "2")

      setup_limit_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$PRICE" ]] &>/dev/null; then
          if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
            if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
              PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
              echo "$DATE :: Manual $TYPE :: Limit Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
              echo "$DATE :: Output: $PLACE_ORDER :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
            fi
          fi
        fi
      fi

      ;;

    esac

    last_log

    ;;

  "2")

    TYPE="sell"
    HEIGHT=9
    WIDTH=23
    CHOICE_HEIGHT=2
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Sell Order Menu"
    AMOUNT_IN_REFERENCE_CURRENCY="false"
    MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

    OPTIONS=(
      1 "Market Order"
      2 "Limit Order")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      setup_market_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
          if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
            PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            echo "$DATE :: Manual $TYPE :: Market Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT" >>"${LOG_DIR:?}"/leeloo/broker.log
            echo "$DATE :: Output: $PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.log
          fi
        fi
      fi

      ;;

    "2")

      setup_limit_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$PRICE" ]] &>/dev/null; then
          if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
            if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
              PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$PRICE" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
              echo "$DATE :: Manual $TYPE :: Limit Order :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $AMOUNT :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
              echo "$DATE :: Output: $PLACE_ORDER :: $PRICE" >>"${LOG_DIR:?}"/leeloo/broker.log
            fi
          fi
        fi
      fi

      ;;

    esac

    last_log

    ;;

  "3")

    function result_orders {
      listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%0.8f ",$i);} else if($i~/^[0-9]+$/) {printf("%0.8f ",$i);} else {printf("%s ",$i)}} printf("\n")}' | column -t | sort -r >"${LOG_DIR:?}"/leeloo/southxchange/orders
    }

    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "15" ]] &>/dev/null; then
      result_orders
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
    fi

    ORDER_TOTAL="$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/orders | awk '{ print $1 }')"

    display_result() {
      dialog --title "Open Orders: +$ORDER_TOTAL" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="OrderID:    Type  Amount      Original    LimitPrice     List   Ref  DateAdded
$(cat "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null | sort -r)"
    display_result 2>/dev/null

    ;;

  esac

  ;;

"5")

  display_result() {
    dialog --title "Updating Leeloo (Multipass)" \
      --no-collapse \
      --msgbox "$RESULT" 0 0
  }

  RESULT="$(cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && git pull 2>/dev/null)"
  display_result 2>/dev/null
  cd || exit && cd "${HOME_DIR:?}"/leeloo || exit && bash include/install 2>/dev/null
  exit

  ;;

"6")

  last_log

  ;;

"7")

  nano "${SYS_DIR:?}"/broker.conf

  ;;

"A")

  HEIGHT=16
  WIDTH=45
  CHOICE_HEIGHT=10
  BACKTITLE="Leeloo (Multipass)"
  TITLE="Robot Strategy Menu"
  MENU="Multipass $(date | xargs)"

  OPTIONS=(1 "Dashbord         Strategy status"
    2 "Check            Indicator info"
    3 "Orders           Last Orders"
    4 "Config           Configurations"
    5 "Create           Create strategy"
    6 "Control          Robot controller"
    7 "Robots           robot.log"
    8 "Debug            Specific log"
    0 "Delete           Remove strategy")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  # dashbord

  "1")

    echo "$(echo "Currency Amount Result
$(cat "${LOG_DIR:?}"/leeloo/robot.hodl 2>/dev/null)" | awk '!a[$0]++' | column -t)" >"${LOG_DIR:?}"/leeloo/robot.hodl
    WIDTH="$(echo "$(wc -L "${LOG_DIR:?}"/leeloo/robot.hodl | awk '{ print $1 }')+7" | bc)"

    display_result() {
      dialog --title "Dashbord Status" \
        --no-collapse \
        --msgbox "$RESULT" 15 "$WIDTH"
    }

    RESULT="$(cat "${LOG_DIR:?}"/leeloo/robot.hodl 2>/dev/null | awk '!a[$0]++')"
    display_result 2>/dev/null

    ;;

    # check

  "2")

    info_search

    if [[ ! -z "$COIN_TOKEN" ]] &>/dev/null; then

      COIN_TOKEN="$(echo "$COIN_TOKEN" | tr '[:lower:]' '[:upper:]')"

      echo "$(get_rsi 14 "$COIN_TOKEN" 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "$(get_rsi 21 "$COIN_TOKEN" 2>/dev/null)" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "-" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "$(get_ema 6 20 "$COIN_TOKEN" 2>/dev/null)" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "$(get_ema 8 20 "$COIN_TOKEN" 2>/dev/null)" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "$(get_ema 10 38 "$COIN_TOKEN" 2>/dev/null)" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "$(get_ema 12 26 "$COIN_TOKEN" 2>/dev/null)" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "$(get_ema 50 200 "$COIN_TOKEN" 2>/dev/null)" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
      echo "-" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators

      if [[ ! "$(grep "EMA" "${LOG_DIR:?}"/leeloo/indicators/check_indicators | awk '{ print $5 }' | head -1)" == "0.00000000" ]] &>/dev/null; then

        BEARISH_SIGNAL="$(grep -c "Bearish" "${LOG_DIR:?}"/leeloo/indicators/check_indicators)"
        BULLISH_SIGNAL="$(grep -c "Bullish" "${LOG_DIR:?}"/leeloo/indicators/check_indicators)"

        TOTAL_SIGNAL="$(echo "$BEARISH_SIGNAL+$BULLISH_SIGNAL" | bc)"

        BEARISH_PERCENTAGE="$(echo "100/$TOTAL_SIGNAL*$BEARISH_SIGNAL" | bc)"
        BULLISH_PERCENTAGE="$(echo "100/$TOTAL_SIGNAL*$BULLISH_SIGNAL" | bc)"

        if [[ "$BEARISH_SIGNAL" -gt "$BULLISH_SIGNAL" ]] &>/dev/null; then
          echo "Signal :: Bearish ${BEARISH_PERCENTAGE:?}%" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
        elif [[ "$BULLISH_SIGNAL" -gt "$BEARISH_SIGNAL" ]] &>/dev/null; then
          echo "Signal :: Bullish ${BULLISH_PERCENTAGE:?}%" >>"${LOG_DIR:?}"/leeloo/indicators/check_indicators
        fi

        echo "$(cat "${LOG_DIR:?}"/leeloo/indicators/check_indicators 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/indicators/check_indicators

        LENGTH="$(echo "$(wc -l "${LOG_DIR:?}"/leeloo/indicators/check_indicators | awk '{ print $1 }')+7" | bc)"
        WIDTH="$(echo "$(wc -L "${LOG_DIR:?}"/leeloo/indicators/check_indicators | awk '{ print $1 }')+5" | bc)"

        display_result() {
          dialog --title "Indicators ($COIN_TOKEN)" \
            --no-collapse \
            --msgbox "$RESULT" "$LENGTH" "$WIDTH"
        }

        RESULT="$(cat "${LOG_DIR:?}"/leeloo/indicators/check_indicators 2>/dev/null)"
        display_result 2>/dev/null
      else
        display_result() {
          dialog --title "Market info (404)" \
            --no-collapse \
            --msgbox "$RESULT" 5 25
        }

        RESULT="No $COIN_TOKEN EMA found!"
        display_result 2>/dev/null
      fi
    else
      display_result() {
        dialog --title "Market info (empty)" \
          --no-collapse \
          --msgbox "$RESULT" 0 0
      }

      RESULT="No data found!"
      display_result 2>/dev/null
    fi

    ;;

    # last auto orders

  "3")

    echo "$(cat "${SYS_DIR:?}"/robot/bst.*.txid 2>/dev/null | egrep "[0-9]+")" >"${SYS_DIR:?}"/robot/bst.txid
    echo "$(cat "${SYS_DIR:?}"/robot/ema.*.txid 2>/dev/null | egrep "[0-9]+")" >"${SYS_DIR:?}"/robot/ema.txid

    truncate -s 0 "${SYS_DIR:?}"/robot/*.pool &>/dev/null

    # if empty skip
    if [[ "$(egrep "[0-9]+" "${SYS_DIR:?}"/robot/bst.txid | wc -l)" -gt "0" ]] &>/dev/null; then
      while read TXID; do
        getOrder "$TXID" | jq -s >>"${SYS_DIR:?}"/robot/bst.pool
        sleep 1
      done <"${SYS_DIR:?}"/robot/bst.txid
    fi

    # if empty skip
    if [[ "$(egrep "[0-9]+" "${SYS_DIR:?}"/robot/ema.txid | wc -l)" -gt "0" ]] &>/dev/null; then
      while read TXID; do
        getOrder "$TXID" | jq -s >>"${SYS_DIR:?}"/robot/ema.pool
        sleep 1
      done <"${SYS_DIR:?}"/robot/ema.txid
    fi

    display_result() {
      dialog --title "Last Auto Orders" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="$(cat "${SYS_DIR:?}"/robot/*.pool 2>/dev/null)"
    display_result 2>/dev/null

    ;;

    # configurations

  "4")

    while true; do
      CONFIG_FILES=("${SYS_DIR:?}"/robot/*.config)
      NUM_FILES="${#CONFIG_FILES[@]}"
      WIDTH="$(echo "$(wc -L "${CONFIG_FILES:?}" | awk '{ print $1 }')+3" | bc 2>/dev/null)"

      if [ $NUM_FILES -eq 0 ] &>/dev/null; then
        echo "Error: No config files found in $SYS_DIR/robot"
        exit 1
      fi

      OPTIONS=()
      for ((i = 0; i < "$NUM_FILES"; i++)); do
        OPTIONS+=("$((i + 1))" "${CONFIG_FILES[$i]}")
      done

      if [[ "$NUM_FILES" -lt "6" ]] &>/dev/null; then
        NUM_FILES="4"
      fi

      CHOICE=$(dialog --clear --title "Strategy Menu" --menu "Choose one of the following strategy configurations:" "$(echo "$NUM_FILES+3" | bc)" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

      if [ -n "$CHOICE" ]; then
        SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
        nano "$SELECTED_FILE"
        break
      else
        break
      fi
    done

    ;;

    # create strategies

  "5")

    HEIGHT=10
    WIDTH=45
    CHOICE_HEIGHT=4
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Create strategies"
    MENU="Multipass $(date | xargs)"

    OPTIONS=(1 "BST              Buy/Sell trigger"
      2 "EMA              EMA trading"
      3 "RSI              RSI trading")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      cp "${HOME_DIR:?}"/leeloo/include/strategies/buy_sell_config "${LOG_DIR:?}"/stgc.tmp &>/dev/null
      cp "${HOME_DIR:?}"/leeloo/include/strategies/buy_sell_strategy "${LOG_DIR:?}"/stgt.tmp &>/dev/null
      nano "${LOG_DIR:?}"/stgc.tmp

      DIALOG_OPTIONS=(
        --backtitle "Leeloo (Multipass)"
        --title "Creating Buy/Sell strategy"
        --yesno "Install new strategy?"
        0 0
      )

      dialog "${DIALOG_OPTIONS[@]}"
      DIALOG_RESULT=$?

      if [ $DIALOG_RESULT -eq "0" ] &>/dev/null; then
        # installing strategy

        display_result() {
          dialog --title "Creating Buy/Sell strategy" \
            --no-collapse \
            --msgbox "$RESULT" 0 0
        }

        # create strategy.robot_id
        ROBOT_CONFIG="$(egrep "TYPE|COOLDOWN|MARKET_LIMIT|REFERENCE_STATUS|LISTING_CURRENCY|REFERENCE_CURRENCY" "${LOG_DIR:?}"/stgc.tmp | head -6 | awk -F= '{ print $2 }' | awk '{ print $1 }' | tr -d '".' | xargs | tr -d ' ')"
        # install new strategy.robot_id
        mv "${LOG_DIR:?}"/stgc.tmp "${SYS_DIR:?}"/robot/bst."$ROBOT_CONFIG".config
        mv "${LOG_DIR:?}"/stgt.tmp "${SYS_DIR:?}"/robot/bst."$ROBOT_CONFIG".strategy

        RESULT="bst.robot installed!
$(ls -lSah "${SYS_DIR:?}"/robot* 2>/dev/null | column -t)"
        display_result 2>/dev/null
      else
        # not installing strategy
        rm "${LOG_DIR:?}"/stgc.tmp &>/dev/null
        rm "${LOG_DIR:?}"/stgt.tmp &>/dev/null
      fi

      ;;

    "2")

      cp "${HOME_DIR:?}"/leeloo/include/strategies/ema_config "${LOG_DIR:?}"/stgc.tmp &>/dev/null
      cp "${HOME_DIR:?}"/leeloo/include/strategies/ema_strategy "${LOG_DIR:?}"/stgt.tmp &>/dev/null
      nano "${LOG_DIR:?}"/stgc.tmp

      DIALOG_OPTIONS=(
        --backtitle "Leeloo (Multipass)"
        --title "Creating EMA strategy"
        --yesno "Install new strategy?"
        0 0
      )

      dialog "${DIALOG_OPTIONS[@]}"
      DIALOG_RESULT=$?

      if [ $DIALOG_RESULT -eq "0" ] &>/dev/null; then
        # installing strategy

        display_result() {
          dialog --title "Creating EMA strategy" \
            --no-collapse \
            --msgbox "$RESULT" 0 0
        }

        # create strategy.robot_id
        ROBOT_CONFIG="$(egrep "EMA_SHORT|EMA_LONG|MARKET_LIMIT|REFERENCE_STATUS|LISTING_CURRENCY|REFERENCE_CURRENCY" "${LOG_DIR:?}"/stgc.tmp | head -6 | awk -F= '{ print $2 }' | awk '{ print $1 }' | tr -d '".' | xargs | tr -d ' ')"
        # install new strategy.robot_id
        mv "${LOG_DIR:?}"/stgc.tmp "${SYS_DIR:?}"/robot/ema."$ROBOT_CONFIG".config
        mv "${LOG_DIR:?}"/stgt.tmp "${SYS_DIR:?}"/robot/ema."$ROBOT_CONFIG".strategy

        RESULT="ema.robot installed!
$(ls -lSah "${SYS_DIR:?}"/robot* 2>/dev/null | column -t)"
        display_result 2>/dev/null
      else
        # not installing strategy
        rm "${LOG_DIR:?}"/stgc.tmp &>/dev/null
        rm "${LOG_DIR:?}"/stgt.tmp &>/dev/null
      fi

      ;;

    "3")

      # code

      ;;

    "4")

      # code

      ;;

    "5")

      # code

      ;;

    esac

    ;;

    # robot controller

  "6")

    HEIGHT=11
    WIDTH=41
    CHOICE_HEIGHT=4
    BACKTITLE="Leeloo (Multipass)"
    TITLE="Robot controller"
    MENU="Choose one option:"

    OPTIONS=(1 "Status           Robot status"
      2 "Start            Start robot"
      3 "Stop             Stop robot"
      4 "Crontab          Linux jobs")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      display_result() {
        dialog --title "Robot status" \
          --no-collapse \
          --msgbox "$RESULT" 0 0
      }

      RESULT="$(screen -list 2>/dev/null)"
      display_result 2>/dev/null

      ;;

    "2")

      bash "${SYS_DIR:?}"/robot/looper

      ;;

    "3")

      screen -X -S leeloo quit &>/dev/null

      if [[ "$(screen -list | grep "leeloo" | wc -l)" -eq "1" ]] &>/dev/null; then
        killall screen &>/dev/null
      fi

      echo "leeloo line: */1 * * * * bash /usr/local/bin/include/leeloo/robot/looper"
      echo "Remove leeloo line for total stop"
      read -r -p "Press Enter to continue" </dev/tty
      echo
      crontab -e

      ;;

    "4")

      crontab -e

      ;;

    esac

    ;;

  "7")

    last_log_robot

    ;;

  "8")

    while true; do
      CONFIG_FILES=("${LOG_DIR:?}"/leeloo/robot.*.log)
      NUM_FILES="${#CONFIG_FILES[@]}"
      WIDTH="$(echo "$(wc -L "${CONFIG_FILES:?}" | awk '{ print $1 }')-51" | bc 2>/dev/null)"

      if [ $NUM_FILES -eq 0 ] &>/dev/null; then
        echo "Error: No log files found in $LOG_DIR/leeloo"
        exit 1
      fi

      OPTIONS=()
      for ((i = 0; i < "$NUM_FILES"; i++)); do
        OPTIONS+=("$((i + 1))" "${CONFIG_FILES[$i]}")
      done

      if [[ "$NUM_FILES" -lt "6" ]] &>/dev/null; then
        NUM_FILES="4"
      fi

      CHOICE=$(dialog --clear --title "Robot logs" --menu "Choose one of the following robot logs:" "$(echo "$NUM_FILES+3" | bc)" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

      if [ -n "$CHOICE" ]; then
        SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
        WIDTH="$(echo "$(wc -L "${SELECTED_FILE:?}" | awk '{ print $1 }')+6" | bc 2>/dev/null)"
        LOG_COUNT="$(wc -l "${SELECTED_FILE:?}" | awk '{ print $1 }')"
        display_result() {
          dialog --title "Robot Log: $LOG_COUNT $SELECTED_FILE:" \
            --no-collapse \
            --tailbox "$RESULT" 25 "$WIDTH"
        }
        RESULT="${SELECTED_FILE:?}"
        display_result 2>/dev/null
        break
      else
        break
      fi
    done

    ;;

  "0")

    if dialog --stdout --title "DELETE WARNING!" \
      --backtitle "DELETING" \
      --yesno "Yes: Delete!, No:  Go back!" 5 30; then

      while true; do
        CONFIG_FILES=("${SYS_DIR:?}"/robot/*.config)
        NUM_FILES="${#CONFIG_FILES[@]}"
        WIDTH="$(echo "$(wc -L "${CONFIG_FILES:?}" | awk '{ print $1 }')+3" | bc 2>/dev/null)"

        if [ $NUM_FILES -eq 0 ] &>/dev/null; then
          echo "Error: No config files found in $SYS_DIR/robot"
          exit 1
        fi

        OPTIONS=()
        for ((i = 0; i < "$NUM_FILES"; i++)); do
          OPTIONS+=("$((i + 1))" "${CONFIG_FILES[$i]}")
        done

        if [[ "$NUM_FILES" -lt "6" ]] &>/dev/null; then
          NUM_FILES="4"
        fi

        CHOICE=$(dialog --clear --title "Delete Strategy Menu" --menu "Choose one of the following strategy configurations:" "$(echo "$NUM_FILES+3" | bc)" "$WIDTH" 0 "${OPTIONS[@]}" 2>&1 >/dev/tty)

        if [ -n "$CHOICE" ] &>/dev/null; then
          SELECTED_FILE="${CONFIG_FILES[$((CHOICE - 1))]}"
          rm "$SELECTED_FILE" &>/dev/null
          rm "${SYS_DIR:?}"/robot/*."$(echo "$SELECTED_FILE" | egrep -o "[0-9]+")".* &>/dev/null
          rm "${LOG_DIR:?}"/robot."$(echo "$SELECTED_FILE" | egrep -o "[0-9]+")".log &>/dev/null
          break
        else
          break
        fi
      done
    fi

    ;;

  esac

  ;;

"D")

  if [[ "$(echo "$BTC_DNT_ADDR" | egrep "bc1.*.c2" | wc -l)" -eq "0" ]] &>/dev/null; then
    echo "grifters are a plague.."
