#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

# returnBalances ###############################################################
# https://poloniex.com/tradingApi
# Return balances for all currencies. Permission required: Return Balances

function returnBalances {
  API_POLONIEX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_POLONIEX_NONCE\",\"key\":\"$API_POLONIEX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_POLONIEX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" "command=returnBalances&nonce=$API_POLONIEX_NONCE" https://poloniex.com/tradingApi
}

# END
