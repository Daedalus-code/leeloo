#!/bin/bash

# getPrices ####################################################################
# https://poloniex.com/public
# Example: getPrices

function getPrices {
  URL="https://poloniex.com/public"
  PARAMETERS="command=returnTicker"
  API_RESPONSE=$(curl -s "$URL?$PARAMETERS")
  echo "$API_RESPONSE" | jq -r 'to_entries[] | "Market: \(.key), Bid: \(.value.highestBid), Ask: \(.value.lowestAsk), Last (%): \(.value.percentChange), Volume24Hr: \(.value.baseVolume)"'
}

