#!/bin/bash

# getPrices ####################################################################
# https://poloniex.com/public
# Example: getPrices

function getPrices {
  URL="https://poloniex.com/public"
  PARAMETERS="command=returnTicker"
  API_RESPONSE=$(curl -s "$URL?$PARAMETERS")
  echo "$API_RESPONSE" | jq -r '.[] | "Market: \(keys_unsorted[0]), Bid: \(.highestBid), Ask: \(.lowestAsk), Last (%): \(.percentChange), Volume24Hr: \(.baseVolume)"'
}

