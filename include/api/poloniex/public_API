#!/bin/bash

# getPrices ####################################################################
# https://poloniex.com/public
# Example: getPrices

function getPrices {
  URL="https://poloniex.com/public"
  PARAMETERS="command=returnTicker"
  API_RESPONSE=$(curl -s "$URL?$PARAMETERS")
  echo "$API_RESPONSE" | jq -r 'to_entries[] | "\(.key) \(.value.highestBid) \(.value.lowestAsk) (%): \(.value.percentChange) \(.value.baseVolume)"'
}

