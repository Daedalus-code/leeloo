#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

# listBalances #################################################################
# https://www.southxchange.com/api/listBalances
# Lists balances for all currencies. Permission required: List Balances

function listBalances {
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"key\":\"$API_SOUTHX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/listBalances
}

# placeOrder_market ############################################################
# https://www.southxchange.com/api/placeOrder
# Places an order in a given market. Permission required: Place Order
# Example: placeOrder "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT"

function placeOrder_market {
  TYPE="$1"
  LISTING_CURRENCY="$2"
  REFERENCE_CURRENCY="$3"
  AMOUNT="$4"
  AMOUNT_IN_REFERENCE_CURRENCY="$5"
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"listingCurrency\":\"$LISTING_CURRENCY\",\"referenceCurrency\":\"$REFERENCE_CURRENCY\",\"type\":\"$TYPE\",\"amount\":\"$AMOUNT\",\"amountInReferenceCurrency\":\"$AMOUNT_IN_REFERENCE_CURRENCY\",\"key\":\"$API_SOUTHX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/placeOrder
}

