#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

source /usr/local/bin/include/leeloo/broker.conf

# listBalances #################################################################
# https://www.southxchange.com/api/listBalances
# Lists balances for all currencies. Permission required: List Balances

function listBalances {
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"key\":\"$API_SOUTHX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/listBalances
}

# placeOrder ###################################################################
# https://www.southxchange.com/api/placeOrder
# Places an order in a given market. Permission required: Place Order
# Example: placeOrder "$TYPE" "$PRICE" "$AMOUNT" "$MARKET" "$LIMIT_ORDER" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY"

function placeOrder {
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  if [ "$LIMIT_ORDER" = "true" ] &>/dev/null; then
    JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"listingCurrency\":\"$LISTING_CURRENCY\",\"referenceCurrency\":\"$REFERENCE_CURRENCY\",\"type\":\"$TYPE\",\"amount\":$AMOUNT,\"amountInReferenceCurrency\":$AMOUNT_IN_REFERENCE_CURRENCY,\"limitPrice\":$PRICE,\"key\":\"$API_SOUTHX_KEY\"}"
  else
    JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"listingCurrency\":\"$LISTING_CURRENCY\",\"referenceCurrency\":\"$REFERENCE_CURRENCY\",\"type\":\"$TYPE\",\"amount\":$AMOUNT,\"amountInReferenceCurrency\":$AMOUNT_IN_REFERENCE_CURRENCY,\"key\":\"$API_SOUTHX_KEY\"}"
  fi
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/placeOrder
}

# cancelOrder ##################################################################
# https://www.southxchange.com/api/cancelOrder
# Cancels a given order. Permission required: Cancel Order
# Example: cancelOrder "$ORDER_ID"

function cancelOrder {
  ORDER_ID="$1"
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"orderCode\":\"$ORDER_ID\",\"key\":\"$API_SOUTHX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/cancelOrder
}

# cancelMarketOrders ###########################################################
# https://www.southxchange.com/api/cancelMarketOrders
# Example: cancelMarketOrders "$LISTING_CURRENCY" "$REFERENCE_CURRENCY"

function cancelMarketOrders() {
  LISTING_CURRENCY="$1"
  REFERENCE_CURRENCY="$2"
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"listingCurrency\":\"$LISTING_CURRENCY\",\"referenceCurrency\":\"$REFERENCE_CURRENCY\",\"key\":\"$API_SOUTHX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/cancelMarketOrders
}

# listOrders ###################################################################
# https://www.southxchange.com/api/listOrders
# Example: listOrders "$LISTING_CURRENCY" "$REFERENCE_CURRENCY"

function listOrders {
  LISTING_CURRENCY="$1"
  REFERENCE_CURRENCY="$2"
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"listingCurrency\":\"$LISTING_CURRENCY\",\"referenceCurrency\":\"$REFERENCE_CURRENCY\",\"key\":\"$API_SOUTHX_KEY\",\"Code\":\"\",\"Type\":\"\",\"Amount\":0,\"OriginalAmount\":0,\"LimitPrice\":0,\"ListingCurrency\":\"\",\"ReferenceCurrency\":\"\",\"DateAdded\":\"\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" -X POST https://www.southxchange.com/api/listOrders
}

# END
