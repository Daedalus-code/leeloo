# listTransactions #############################################################
# https://www.southxchange.com/api/listTransactions
# Example: listTransactions BTC deposits "" 1 50 "" false
# This will list the first 50 BTC deposit transactions.
# If you want to list all transactions (including trades, withdrawals, etc.),
# you can omit the second argument: listTransactions BTC "" "" 1 50 "" false

function listTransactions {
  CURRENCY="$1"
  TRANSACTION_TYPE="${2:-transactions}" # Optional argument, defaults to "transactions"
  OPTIONAL_FILTER="$3"
  PAGE_INDEX="$4"
  PAGE_SIZE="$5"
  SORT_FIELD="$6"
  DESCENDING="$7"
  API_SOUTHX_NONCE=$(($(date +%s) * 10))
  JSON_DATA="{\"nonce\":\"$API_SOUTHX_NONCE\",\"currency\":\"$CURRENCY\",\"transactionType\":\"$TRANSACTION_TYPE\",\"optionalFilter\":\"$OPTIONAL_FILTER\",\"pageIndex\":$PAGE_INDEX,\"pageSize\":$PAGE_SIZE,\"sortField\":\"$SORT_FIELD\",\"descending\":$DESCENDING,\"key\":\"$API_SOUTHX_KEY\"}"
  HASH=$(echo -n "$JSON_DATA" | openssl sha512 -hmac "$API_SOUTHX_SECRET" | awk '{print $NF}')
  curl -s -H "Hash: $HASH" -H "Content-Type: application/json" -d "$JSON_DATA" https://www.southxchange.com/api/listTransactions
}

