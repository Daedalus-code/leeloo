#!/bin/bash

# markets ######################################################################
# https://www.southxchange.com/api/markets
# Example: markets BTC

if [[ "$PROXY_PUBLIC_API" == "true" ]] &>/dev/null; then
  function markets {
    curl -s --proxy socks5h://localhost:9050 https://www.southxchange.com/api/markets | egrep -o '"[aA0-zZ9]+","[aA0-zZ9]+"' | tr -d '"' | tr "," /
  }
else
  function markets {
    curl -s https://www.southxchange.com/api/markets | egrep -o '"[aA0-zZ9]+","[aA0-zZ9]+"' | tr -d '"' | tr "," /
  }
fi

# prices #######################################################################
# https://market.southxchange.com/api/v4/prices
# Example: prices

if [[ "$PROXY_PUBLIC_API" == "true" ]] &>/dev/null; then
  function prices {
    curl -s --proxy socks5h://localhost:9050 -X GET "https://market.southxchange.com/api/v4/prices" -H "accept: application/json" | jq -r '.[] | "\(.Market): \(.Bid) \(.Ask) \(.Last) \(.Variation24Hr) \(.Volume24Hr)"' | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/) {printf("%.9f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}'
  }
else
  function prices {
    curl -s -X GET "https://market.southxchange.com/api/v4/prices" -H "accept: application/json" | jq -r '.[] | "\(.Market): \(.Bid) \(.Ask) \(.Last) \(.Variation24Hr) \(.Volume24Hr)"' | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/) {printf("%.9f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}'
  }
fi

# trades #######################################################################
# https://market.southxchange.com/api/v4/trades
# Example: trades BTC USDT

function trades() {
  LISTING_CURRENCY="$1"
  REFERENCE_CURRENCY="$2"
  if [[ "$PROXY_PUBLIC_API" == "true" ]] &>/dev/null; then
    curl -s --proxy socks5h://localhost:9050 -X GET "https://market.southxchange.com/api/v4/trades/$LISTING_CURRENCY/$REFERENCE_CURRENCY" -H "accept: application/json" | jq '.[0]'
  else
    curl -X GET "https://market.southxchange.com/api/v4/trades/$LISTING_CURRENCY/$REFERENCE_CURRENCY" -H "accept: application/json" | jq '.[0]'
  fi
}

# fees #########################################################################
# https://market.southxchange.com/api/v4/fees
# Example: fees

if [[ "$PROXY_PUBLIC_API" == "true" ]] &>/dev/null; then
  function fees {
    curl -s --proxy socks5h://localhost:9050 -X GET "https://market.southxchange.com/api/v4/fees" -H "accept: application/json" | jq -s
  }
else
  function fees {
    curl -X GET "https://market.southxchange.com/api/v4/fees" -H "accept: application/json" | jq -s
  }
fi

# END
