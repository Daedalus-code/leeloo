# last log #####################################################################

function last_log {
  LOG_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null)"
  WIDTH="$(echo "$(tail -19 "${LOG_DIR:?}"/leeloo/broker.log | wc -L | awk '{ print $1 }')+4" | bc 2>/dev/null)"
  LENGTH="$(echo "$(wc -l "${LOG_DIR:?}"/leeloo/broker.log | awk '{ print $1 }')+5" | bc 2>/dev/null)"

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="77"
  elif [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
    WIDTH="77"
  fi
  if [[ -z "$LENGTH" ]] &>/dev/null; then
    LENGTH="7"
  elif [[ "$LENGTH" -gt "25" ]] &>/dev/null; then
    LENGTH="25"
  fi

  display_result() {
    dialog --title "Broker Log: $LOG_COUNT" \
      --no-collapse \
      --tailbox "$RESULT" "$LENGTH" "$WIDTH"
  }
  RESULT="${LOG_DIR:?}/leeloo/broker.log"
  display_result 2>/dev/null
}

# last log robot ###############################################################

function last_log_robot {
  LOG_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/robot.log)"
  WIDTH="$(echo "$(tail -19 "${LOG_DIR:?}"/leeloo/robot.log | wc -L | awk '{ print $1 }')+6" | bc 2>/dev/null)"
  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="89"
  elif [[ "$WIDTH" -lt "89" ]] &>/dev/null; then
    WIDTH="89"
  fi
  display_result() {
    dialog --title "Robot Log: $LOG_COUNT" \
      --no-collapse \
      --tailbox "$RESULT" 25 "$WIDTH"
  }
  RESULT="${LOG_DIR:?}/leeloo/robot.log"
  display_result 2>/dev/null
}

# cleanup log ##################################################################

function cleanup_log {
  # reset broker.log
  if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/broker.log | awk '{ print $1 }')" -gt "$MAX_LOG" ]] &>/dev/null; then
    echo "$(tail -"$(echo "$MAX_LOG/3" | bc 2>/dev/null)" "${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null
    echo "$DATE :: LogReset :: Line $MAX_LOG" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null
  fi
}

