# last_log #####################################################################

function last_log {
  WIDTH="$(echo "$(wc -L "${LOG_DIR:?}"/leeloo/broker.log | awk '{ print $1 }')+7" | bc)"
  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  fi
  display_result() {
    dialog --title "Log Message: $(wc -l "${LOG_DIR:?}"/leeloo/broker.log)" \
      --no-collapse \
      --tailbox "$RESULT" 25 "$WIDTH"
  }
  RESULT="${LOG_DIR:?}/leeloo/broker.log"
  display_result 2>/dev/null
}

