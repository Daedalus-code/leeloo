  # coin token search
  COIN_TOKEN_CURRENCY=$(
    dialog --title "Coin/Token (BTC)" \
      --inputbox "Enter name:" 8 30 \
      3>&1 1>&2 2>&3 3>&-
  )

  # upper case
  FIAT_CURRENCY="$(echo "$FIAT_CURRENCY" | tr '[:lower:]' '[:upper:]')"
  COIN_TOKEN_CURRENCY="$(echo "$COIN_TOKEN_CURRENCY" | tr '[:lower:]' '[:upper:]')"

  # if data exist
  if [[ -n "$FIAT_CURRENCY" && -n "$COIN_TOKEN_CURRENCY" ]] &>/dev/null; then
    # search up token coin price in fiat currency
    COIN_TOKEN_PRICE="$(torify curl -s -X "https://min-api.cryptocompare.com/data/price?fsym=$COIN_TOKEN_CURRENCY&tsyms=$FIAT_CURRENCY" | jq -r '."'$FIAT_CURRENCY'"' | awk '{ printf "%.9f\n", $1 }')"
    # search up token coin data
    COIN_TOKEN_DATA="$(cat "${LOG_DIR:?}"/leeloo/*/*prices* 2>/dev/null | tr '_' '/' | awk '!a[$1,$2]++' | tr -d ':' | grep -w "$COIN_TOKEN_CURRENCY" | awk -F: '{ print $2,$3,$4,$5 }' | sort -n -k 2 -r | head -225)"
    # search count
    COIN_TOKEN_COUNT="$(echo "$COIN_TOKEN_DATA" | wc -l)"

    # if null
    if [[ "$COIN_TOKEN_PRICE" == "null" ]] &>/dev/null; then
      COIN_TOKEN_PRICE="no data"
    fi

    RESULT="$COIN_TOKEN_CURRENCY/$FIAT_CURRENCY $COIN_TOKEN_PRICE
$COIN_TOKEN_DATA"

    LENGTH="$(echo "$(echo "$RESULT" | column -t | wc -l)+4" | bc 2>/dev/null)"
    WIDTH="$(echo "$(echo "$RESULT" | column -t | wc -L)+4" | bc 2>/dev/null)"

    display_result() {
      dialog --title "Price Search: $FIAT_CURRENCY > $COIN_TOKEN_CURRENCY +$COIN_TOKEN_COUNT" \
        --no-collapse \
        --scrollbar \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }
    display_result 2>/dev/null
  else
    RESULT="Empty values!"
    LENGTH="$(echo "$(echo "$RESULT" | column -t | wc -l)+4" | bc 2>/dev/null)"
    WIDTH="$(echo "$(echo "$RESULT" | column -t | wc -L)+14" | bc 2>/dev/null)"

    display_result() {
      dialog --title "Price Search: no data" \
        --no-collapse \
        --scrollbar \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }
    display_result 2>/dev/null
  fi
}

