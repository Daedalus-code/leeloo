# open orders ##################################################################

function open_orders {

  # poloniex data
  if [[ "$EXCHANGE_API" == "POL" ]] &>/dev/null; then
    # set orders format
    ORDERS_FORMAT="OrderID: Type Amount Original LimitPrice List Ref DateAdded"
    # set exchange template
    EXCHANGE_API="POL"
    exchange_template
    ORDER_EXCHANGE="Poloniex"
    # open orders function
    function result_orders {
      echo "BETA"
    }
  fi

  ##############################################################################

  # southxchange data
  if [[ "$EXCHANGE_API" == "SXC" ]] &>/dev/null; then
    # set orders format
    ORDERS_FORMAT="OrderID: Type Amount Original LimitPrice List Ref DateAdded"
    # set exchange template
    EXCHANGE_API="SXC"
    exchange_template
    ORDER_EXCHANGE="SouthXchange"
    # open orders function
    function result_orders {
      listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' 2>/dev/null | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%0.8f ",$i);} else if($i~/^[0-9]+$/) {printf("%0.8f ",$i);} else {printf("%s ",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null
    }
  fi

  ##############################################################################

  # stakecube data
  if [[ "$EXCHANGE_API" == "SCE" ]] &>/dev/null; then
    # set orders format
    ORDERS_FORMAT="OrderID: Type Amount Original LimitPrice List Ref DateAdded"
    # set exchange template
    EXCHANGE_API="SCE"
    exchange_template
    ORDER_EXCHANGE="StakeCube"
    # open orders function
    function result_orders {
      echo "BETA"
    }
  fi

  ##############################################################################

  # xeggex data
  if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
    # set orders format
    ORDERS_FORMAT="OrderID Type Amount Original LimitPrice List Ref DateAdded"
    # set exchange template
    EXCHANGE_API="XGX"
    exchange_template
    ORDER_EXCHANGE="XeggeX"
    # open orders function
    function result_orders {
      echo "$(getOrders | jq -r '.[] | "\(.id): \(.side) \(.remainQuantity) \(.quantity) \(.price) \(.market.symbol) \(.updatedAt)"' | awk '{printf "%s %s %s %s %s %s %s\n", $1, $2, $3, $4, $5, $6, strftime("%Y-%m-%dT%H:%M:%S", $7/1000)}' 2>/dev/null | column -t | sed "s/\// /g")" >"${LOG_DIR:?}"/leeloo/xeggex/orders 2>/dev/null
    }
  fi

  # xeggex order format
  function place_order_format {
    # get id, price, output format
    PLACE_ORDER="$(cat "${LOG_DIR:?}"/leeloo/broker.tx 2>/dev/null)"
    PLACE_ORDER_ID="$(echo "$PLACE_ORDER" | tr -d '"' | egrep -wo "id:[A-Za-z0-9]+" | awk -F: '{ print $2 }' | tail -1)"
    PLACE_ORDER_PRICE="$(echo "$PLACE_ORDER" | egrep -wo "price:[0-9]+.[0-9]+" | awk -F: '{ print $2 }' | tail -1)"
    PLACE_ORDER="$PLACE_ORDER_ID$PLACE_ORDER_PRICE"
  }

  ##############################################################################

  HEIGHT=10
  WIDTH=40
  CHOICE_HEIGHT=3
  BACKTITLE="Leeloo (Multipass)"
  TITLE="$EXCHANGE_API Order Menu"
  MENU="${DATE:?}"

  OPTIONS=(1 "Buy              Buy Order"
    2 "Sell             Sell Order"
    3 "Status           Open Orders")

  CHOICE=$(dialog --clear \
    --backtitle "$BACKTITLE" \
    --title "$TITLE" \
    --menu "$MENU" \
    $HEIGHT $WIDTH $CHOICE_HEIGHT \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

  clear
  case $CHOICE in

  "1")

    TYPE="buy"
    HEIGHT=9
    WIDTH=23
    CHOICE_HEIGHT=2
    BACKTITLE="Leeloo (Multipass)"
    TITLE="$EXCHANGE_API Buy Order Menu"
    AMOUNT_IN_REFERENCE_CURRENCY="true"
    MENU="$(date | xargs | awk '{ print $4,$5,$6 }')"

    OPTIONS=(
      1 "Market Order"
      2 "Limit Order")

    CHOICE=$(dialog --clear \
      --backtitle "$BACKTITLE" \
      --title "$TITLE" \
      --menu "$MENU" \
      $HEIGHT $WIDTH $CHOICE_HEIGHT \
      "${OPTIONS[@]}" \
      2>&1 >/dev/tty)

    clear
    case $CHOICE in

    "1")

      log_date
      setup_market_order
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
          if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then

            # if southxchange
            if [[ "$ORDER_EXCHANGE" == "SouthXchange" ]] &>/dev/null; then
              PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
              PLACE_ORDER="$(echo "$PLACE_ORDER" | tr -d '"')"
            fi
            # if xeggex
            if [[ "$ORDER_EXCHANGE" == "XeggeX" ]] &>/dev/null; then
              PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "$TYPE" "market" "$AMOUNT" "" "false")"
              echo "$PLACE_ORDER" >>"${LOG_DIR:?}"/leeloo/broker.tx
              place_order_format
            fi

            # if zero api
            if [[ -z "$PLACE_ORDER" ]] &>/dev/null; then
