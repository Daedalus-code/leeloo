# exchange balance #############################################################

function exchange_balance() {

  USER_TIMER="$(echo "$BOT_TIMER*1.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

  ##############################################################################

  install_exchange_dir

  ##############################################################################

  # poloniex balance
  if [[ "$EXCHANGE_BALANCE" == "poloniex" ]] &>/dev/null; then
    EXCHANGE_API="POL"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(returnBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
  fi

  ##############################################################################

  # stakecube balance
  if [[ "$EXCHANGE_BALANCE" == "stakecube" ]] &>/dev/null; then
    EXCHANGE_API="SCE"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(returnAccount | jq -r '.result.wallets[] | "\(.asset): \(.balance) \(.balanceInOrder) \(.balanceInMasternodes) \(.balanceInInterest)"' 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
    SCE_NONCE_COUNTER=$(cat "${LOG_DIR:?}"/leeloo/nonce.count 2>/dev/null)
    # if zero
    if [[ -z "$SCE_NONCE_COUNTER" ]] &>/dev/null; then
      SCE_NONCE_COUNTER="0"
    fi
  fi

  ##############################################################################

  # xeggex balance
  if [[ "$EXCHANGE_BALANCE" == "xeggex" ]] &>/dev/null; then
    EXCHANGE_API="XGX"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(Balances | jq -r '.[] | "\(.asset): \(.held) \(.available) \(.pending)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
  fi

  ##############################################################################

  # nonkyc balance
  if [[ "$EXCHANGE_BALANCE" == "nonkyc" ]] &>/dev/null; then
    EXCHANGE_API="NKY"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(Balances_nky | jq -r '.[] | "\(.asset): \(.held) \(.available) \(.pending)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
  fi

  ##############################################################################

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
    result_balances
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances ]] &>/dev/null; then
    result_balances
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances ]] &>/dev/null; then
    result_balances
  fi

  until [[ -f "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances ]] &>/dev/null; do
    clear
    echo "Please wait.."
    sleep 1
  done

  FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{ print $8 }')"
  if [[ -z "$FILE_TIME" ]] &>/dev/null; then
    FILE_TIME="00:00"
  fi

  if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances | awk '{ print $1 }')" -lt "2" ]] &>/dev/null; then
    LENGTH="5"
    RESULT="No balance"
  else
    # keep lines with n, disregard zeros
    RESULT="Coins: Deposited Available Unconfirmed
  $(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}')"
  fi

  # asset count, disregard zeros
  EXCHANGE_ASSETS="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}' | wc -l)"

  ##############################################################################

  if [[ "$EXCHANGE_BALANCE" == "stakecube" ]] &>/dev/null; then

    RESULT_FORMAT="Coins: Deposited InOrder InMasternodes InInterest
$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null)"

    # if lines are less than n
    if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances | awk '{ print $1 }')" -lt "1" ]] &>/dev/null; then
      WIDTH="$(echo "$(echo "$RESULT_FORMAT" | column -t | wc -L)+11" | bc 2>/dev/null)"
      LENGTH="$(echo "$(echo "$RESULT_FORMAT" | column -t | wc -l)+4" | bc 2>/dev/null)"
      RESULT="No Balance available"
    else
      WIDTH="$(echo "$(echo "$RESULT_FORMAT" | column -t | wc -L)+4" | bc 2>/dev/null)"
      LENGTH="$(echo "$(echo "$RESULT_FORMAT" | column -t | wc -l)+4" | bc 2>/dev/null)"
      RESULT="$RESULT_FORMAT"
    fi

    display_result() {
      dialog --title "$FILE_TIME :: +$EXCHANGE_ASSETS :: $EXCHANGE_API Account Balance ($SCE_NONCE_COUNTER)" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }
  fi

  ##############################################################################

  if [[ "$EXCHANGE_BALANCE" == "poloniex" || "$EXCHANGE_BALANCE" == "xeggex" || "$EXCHANGE_BALANCE" == "nonkyc" ]] &>/dev/null; then

    # default
    WIDTH="0"
    LENGTH="0"

    # if no lines has n
    if [[ "$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}' | wc -l)" -eq "0" ]] &>/dev/null; then
      WIDTH="45"
      LENGTH="5"
      RESULT="No Balance available"
    fi

    ############################################################################

    if [[ "$EXCHANGE_BALANCE" == "xeggex" ]] &>/dev/null; then
      # keep lines with n
      RESULT="Coins: Deposited Available Unconfirmed
    $(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}')"
      WIDTH="$(echo "$(echo "$RESULT" | column -t | wc -L)+4" | bc 2>/dev/null)"
      LENGTH="$(echo "$(echo "$RESULT" | column -t | wc -l)+4" | bc 2>/dev/null)"
    fi

    ############################################################################

    if [[ "$EXCHANGE_BALANCE" == "nonkyc" ]] &>/dev/null; then
      # keep lines with n
      RESULT="Coins: Deposited Available Unconfirmed
    $(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}')"
      WIDTH="$(echo "$(echo "$RESULT" | column -t | wc -L)+4" | bc 2>/dev/null)"
      LENGTH="$(echo "$(echo "$RESULT" | column -t | wc -l)+4" | bc 2>/dev/null)"
    fi

    ############################################################################

    display_result() {
      dialog --title "$FILE_TIME :: +$EXCHANGE_ASSETS :: $EXCHANGE_API Account Balance" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }
  fi
  display_result 2>/dev/null
}

