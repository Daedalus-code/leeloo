# system directory #############################################################

SYS_DIR="/usr/local/bin/include/leeloo" # system folder

# log directory ################################################################

if [[ ! -d "${LOG_DIR:?}"/leeloo ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo &>/dev/null
fi

# exchange directory ###########################################################

function install_exchange_dir() {
  # if no directory
  if [[ ! -d "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE" ]] &>/dev/null; then
    mkdir "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE" &>/dev/null
    if [[ ! -d "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET" ]] &>/dev/null; then
      mkdir "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET" &>/dev/null
      if [[ ! -d "${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET" ]] &>/dev/null; then
        mkdir "${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET" &>/dev/null
      fi
    fi
  fi
}

# date, log date ###############################################################

function system_date() {
  DATE="$(date +"%d.%m.%Y %H:%M:%S")"
}

function log_date() {
  LOG_DATE="$(date +"%d/%m.%y-%H:%M:%S")"
}

function log_date_xargs() {
  DATE_XARGS="$(date | awk '{ print $1,$2,$3,$4,$5 }' | xargs)"
}

# log timer ####################################################################

if [[ -z "$LOG_LENGTH" ]] &>/dev/null; then
  LOG_LENGTH="7"
fi

LOG_TIMER="$(echo "$LOG_LENGTH+1" | bc 2>/dev/null)" # log schedule, in lines

# erro status ##################################################################

# error status (default)
ERROR_STATUS="0"

if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | awk '{ print $1 }')" -gt "0" ]] &>/dev/null; then
  ERROR_STATUS="$(cat "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | awk '{ print $1 }' | sed -r '/^\s*$/d' | wc -l)"
fi

if [[ -z "$ERROR_STATUS" ]] &>/dev/null; then
  ERROR_STATUS="0"
fi

# possible update error (interference)
if [[ "$(grep "syntax error near unexpected token" "${LOG_DIR:?}"/leeloo/error.log 2>/dev/null | tr -d '`' | grep -c "(")" -gt "0" ]] &>/dev/null; then
  truncate -s 0 "${LOG_DIR:?}"/leeloo/error.log &>/dev/null
  ERROR_STATUS="!"
fi

# system #######################################################################

function system_load() {
  LOAD="$(cat /proc/loadavg 2>/dev/null | awk '{ print $1,$2,$3 }')"
}

# screen -list #################################################################

function update_screen() {
  # update screen list
  echo "$(screen -list 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/screen
  SCREEN_LIST="$(cat "${LOG_DIR:?}"/leeloo/screen 2>/dev/null)"
}

################################################################################

ERROR_LOG="${LOG_DIR:?}/leeloo/error.log"

################################################################################

function key_secret_set() {

  KEY_SECRET_SET_PLX="0" # poloniex
  KEY_SECRET_SET_SXC="0" # southxchange
  KEY_SECRET_SET_SCE="0" # stakecube
  KEY_SECRET_SET_XGX="0" # xeggex

  ##############################################################################

  # poloniex option
  if [[ -n "$API_POLONIEX_KEY" ]] && [[ -n "$API_POLONIEX_SECRET" ]]; then
    KEY_SECRET_SET_PLX="1"
  fi
  # southxchange option
  if [[ -n "$API_SOUTHX_KEY" ]] && [[ -n "$API_SOUTHX_SECRET" ]]; then
    KEY_SECRET_SET_SXC="1"
  fi
  # stakecube option
  if [[ -n "$API_STAKECUBE_KEY" ]] && [[ -n "$API_STAKECUBE_SECRET" ]]; then
    KEY_SECRET_SET_SCE="1"
  fi
  # xeggex option
  if [[ -n "$API_XEGGEX_KEY" ]] && [[ -n "$API_XEGGEX_SECRET" ]]; then
    KEY_SECRET_SET_XGX="1"
  fi

  ##############################################################################

  # calculate general status
  KEY_SECRET_SET="$(echo "$KEY_SECRET_SET_PLX+$KEY_SECRET_SET_SXC+$KEY_SECRET_SET_SCE+$KEY_SECRET_SET_XGX" | bc 2>/dev/null)"
  # if zero
  if [[ -z "$KEY_SECRET_SET" ]] &>/dev/null; then
    KEY_SECRET_SET="0"
  fi

  # if set
  if [[ "$KEY_SECRET_SET" -gt "0" ]] &>/dev/null; then
    KEY_SECRET_OK="1"
  else
    KEY_SECRET_OK="0"
  fi
}

################################################################################

function broker_conf_update() {
  LEELOO_CONFIG_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/broker.conf | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done | awk '{ SUM += $1} END { print SUM }')"

  # updating broker configuration, restart robots
  if [[ "$LEELOO_CONFIG_SECONDS" -lt "10" ]] &>/dev/null; then
    if [[ "$(echo "$SCREEN_LIST" | grep -c "leeloo")" -gt "0" ]] &>/dev/null; then
      # kill screen
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit 2>/dev/null
      # kill leeloo pid (shell)
      echo "$(ps aux 2>/dev/null | grep "leeloo" | grep -v "grep" | grep "bash.*robot/leeloo" | awk '{ print $2 }' | tail -1)" >"${LOG_DIR:?}"/leeloo/ps_aux
      LEELOO_PID="$(cat "${LOG_DIR:?}"/leeloo/ps_aux 2>/dev/null)"
      kill -9 "$LEELOO_PID" &>/dev/null
      bash "${SYS_DIR:?}"/robot/looper
      echo "Robot restarting!" >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
      display_result() {
        dialog --title "Updating Configuration." \
          --no-collapse \
          --msgbox "$RESULT" 0 0
      }
      RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
      display_result 2>/dev/null
    fi
  fi
}

