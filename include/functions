      SUPPORT_LENGTH="+5"
      function result_prices() {
        echo "$(tickers | column -t)" >"${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET"/prices 2>/dev/null
      }
    fi

    USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET"/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET"/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET"/prices ]] &>/dev/null; then
      result_prices
    fi

    MARKET_SEARCH="$(echo "$MARKET_INPUT" | tr '[:lower:]' '[:upper:]')"
    MARKET_RESULT="$(grep "$MARKET_SEARCH" "${LOG_DIR:?}"/leeloo/"$SEARCH_MARKET"/prices 2>/dev/null | sort -k2 -n -r 2>/dev/null)"
    MARKET_COUNT="$(echo "$MARKET_RESULT" | sed -r '/^\s*$/d' | wc -l)"
    MARKET_MOON="$(echo "$MARKET_RESULT" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
    MARKET_MOON_COUNT="$(echo "$MARKET_RESULT" | awk '{ print $5 }' | wc -l)"
    MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
    LENGTH="$(echo "$MARKET_COUNT$SUPPORT_LENGTH" | bc 2>/dev/null)"
    WIDTH="$(echo "$(echo "$MARKET_RESULT" | column -t | wc -L)$SUPPORT_WIDTH" | bc 2>/dev/null)"

    if [[ -z "$LOG_LENGTH" ]] &>/dev/null; then
      LOG_LENGTH="7"
    fi
    if [[ "$LENGTH" -gt "$LOG_LENGTH" ]] &>/dev/null; then
      LENGTH="$LOG_LENGTH"
    fi

    if [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
      WIDTH="77"
    fi

    display_result() {
      dialog --title "Search $EXCHANGE_API result $MARKET_SEARCH: +$MARKET_COUNT | $DATE | ${MARKET_MOON_VALUE:?}%" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }

    if [[ "$MARKET_COUNT" -eq "0" ]] &>/dev/null; then
      RESULT="No market was found."
    else
      RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
    fi

    display_result 2>/dev/null
  else
    display_result() {
      dialog --title "Market info (empty)" \
        --no-collapse \
        --msgbox "$RESULT" 0 0
    }

    RESULT="No $EXCHANGE_API data found!"
    display_result 2>/dev/null
  fi
}

# last log #####################################################################

function last_log {

  if [[ ! -f "${LOG_DIR:?}"/leeloo/broker.log ]] &>/dev/null; then
    touch "${LOG_DIR:?}"/leeloo/broker.log &>/dev/null
  fi

  LOG_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null | awk '{ print $1 }')"
  WIDTH="$(echo "$(tail -19 "${LOG_DIR:?}"/leeloo/broker.log | wc -L | awk '{ print $1 }')+4" | bc 2>/dev/null)"
  LENGTH="$(echo "$(wc -l "${LOG_DIR:?}"/leeloo/broker.log | awk '{ print $1 }')+5" | bc 2>/dev/null)"

  if [[ -z "$LOG_LENGTH" ]] &>/dev/null; then
    LOG_LENGTH="7"
  fi
  if [[ -z "$LENGTH" ]] &>/dev/null; then
    LENGTH="7"
  elif [[ "$LENGTH" -gt "$LOG_LENGTH" ]] &>/dev/null; then
    LENGTH="$LOG_LENGTH"
  fi

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="77"
  elif [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
    WIDTH="77"
  fi

  display_result() {
    dialog --title "Broker Log: $LOG_COUNT" \
      --no-collapse \
      --tailbox "$RESULT" "$LENGTH" "$WIDTH"
  }
  RESULT="${LOG_DIR:?}/leeloo/broker.log"
  display_result 2>/dev/null

  # if greater than n
  if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/broker.log | awk '{ print $1 }')" -gt "0" ]] &>/dev/null; then
    # ask for reset
    if ! dialog --stdout --title "Keep history? +$LOG_COUNT" \
      --backtitle "Reset history?" \
      --yesno "Yes: Keep! No: Delete!" 5 30; then
      truncate -s 0 "${LOG_DIR:?}"/leeloo/broker.log &>/dev/null
    fi
  fi
}

