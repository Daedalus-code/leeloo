# exchange balance #############################################################

function exchange_balance() {

  USER_TIMER="$(echo "$BOT_TIMER*1.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

  ##############################################################################

  # if no directory
  if [[ ! -d "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE" ]] &>/dev/null; then
    mkdir "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE" &>/dev/null
  fi

  ##############################################################################

  # poloniex
  if [[ "$EXCHANGE_BALANCE" == "poloniex" ]] &>/dev/null; then
    EXCHANGE_API="POL"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(returnBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
  fi

  ##############################################################################

  # southxchange
  if [[ "$EXCHANGE_BALANCE" == "southxchange" ]] &>/dev/null; then
    EXCHANGE_API="SXC"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
  fi

  ##############################################################################

  # stakecube
  if [[ "$EXCHANGE_BALANCE" == "stakecube" ]] &>/dev/null; then
    EXCHANGE_API="SCE"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(returnAccount | jq -r '.result.wallets[] | "\(.asset): \(.balance) \(.balanceInOrder) \(.balanceInMasternodes) \(.balanceInInterest)"' 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
    SCE_NONCE_COUNTER=$(cat "${LOG_DIR:?}"/leeloo/nonce.count 2>/dev/null)
    # if zero
    if [[ -z "$SCE_NONCE_COUNTER" ]] &>/dev/null; then
      SCE_NONCE_COUNTER="0"
    fi
  fi

  ##############################################################################

  # xeggex
  if [[ "$EXCHANGE_BALANCE" == "xeggex" ]] &>/dev/null; then
    EXCHANGE_API="XGX"
    exchange_template
    # get balance
    function result_balances() {
      echo "$(Balances | jq -r '.[] | "\(.asset): \(.held) \(.available) \(.pending)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null
    }
  fi

  ##############################################################################

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
    result_balances
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances ]] &>/dev/null; then
    result_balances
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances ]] &>/dev/null; then
    result_balances
  fi

  until [[ -f "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances ]] &>/dev/null; do
    clear
    echo "Please wait.."
    sleep 1
  done

  FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{ print $8 }')"
  if [[ -z "$FILE_TIME" ]] &>/dev/null; then
    FILE_TIME="00:00"
  fi

  if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances | awk '{ print $1 }')" -lt "2" ]] &>/dev/null; then
    LENGTH="5"
    RESULT="No balance"
  else
    # keep lines with n
    RESULT="Coins: Deposited Available Unconfirmed
  $(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}')"
  fi

  ##############################################################################

  if [[ "$EXCHANGE_BALANCE" == "stakecube" ]] &>/dev/null; then

    RESULT_FORMAT="Coins: Deposited InOrder InMasternodes InInterest
$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances 2>/dev/null)"

    # if lines are less than n
    if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances | awk '{ print $1 }')" -lt "1" ]] &>/dev/null; then
      WIDTH="$(echo "$(echo "$RESULT_FORMAT" | wc -L)+14" | bc 2>/dev/null)"
      LENGTH="$(echo "$(echo "$RESULT_FORMAT" | wc -l)+4" | bc 2>/dev/null)"
      RESULT="No Balance available"
    else
      WIDTH="$(echo "$(echo "$RESULT_FORMAT" | wc -L)+14" | bc 2>/dev/null)"
      LENGTH="$(echo "$(echo "$RESULT_FORMAT" | wc -l)+4" | bc 2>/dev/null)"
      RESULT="$RESULT_FORMAT"
    fi

    display_result() {
      dialog --title "$FILE_TIME :: $EXCHANGE_API Account Balance ($SCE_NONCE_COUNTER)" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }
  fi

  ##############################################################################

  if [[ "$EXCHANGE_BALANCE" == "poloniex" || "$EXCHANGE_BALANCE" == "southxchange" || "$EXCHANGE_BALANCE" == "xeggex" ]] &>/dev/null; then

    # default
    WIDTH="0"
    LENGTH="0"

    # if no lines has n
    if [[ "$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE"/balances | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}' | wc -l)" -eq "0" ]] &>/dev/null; then
      WIDTH="45"
      LENGTH="5"
      RESULT="No Balance available"
    fi

    display_result() {
      dialog --title "$FILE_TIME :: $EXCHANGE_API Account Balance" \
        --no-collapse \
        --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
    }
  fi

  display_result 2>/dev/null
}

# observe markets ##############################################################

function observe_market() {

  # exchanges, includes functions
  source /usr/local/bin/include/leeloo/strategies/templates/exchanges

  ##############################################################################

  # if no directory
  if [[ ! -d "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE" ]] &>/dev/null; then
    mkdir "${LOG_DIR:?}"/leeloo/"$EXCHANGE_BALANCE" &>/dev/null
  fi

  ##############################################################################

  # poloniex prices
  if [[ "$OBSERVE_MARKET" == "poloniex" ]] &>/dev/null; then
    EXCHANGE_API="POL"
    exchange_template
    SUPPORT_WIDTH="+5"
    SUPPORT_LENGTH="5"
    SUPPORT="Support: https://support.poloniex.com"
    function result_prices() {
      echo "$(getPrices | column -t)" >"${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null
    }
  fi

  ##############################################################################

  # southxchange prices
  if [[ "$OBSERVE_MARKET" == "southxchange" ]] &>/dev/null; then
    EXCHANGE_API="SXC"
    exchange_template
    SUPPORT_WIDTH="+4"
    SUPPORT_LENGTH="5"
    SUPPORT="Support: https://southxchange.gorgias.help"
    function result_prices() {
      echo "$(prices | column -t)" >"${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null
    }
  fi

  ##############################################################################

  # stakecube prices
  if [[ "$OBSERVE_MARKET" == "stakecube" ]] &>/dev/null; then
    EXCHANGE_API="SCE"
    exchange_template
    SUPPORT_WIDTH="+0"
    SUPPORT_LENGTH="5"
    SUPPORT_RESULT="Support Mail: support@stakecube.zohodesk.com"
    function result_prices() {
      echo "$(getMarkets | column -t)" >"${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null
    }
  fi

  ##############################################################################

  # xeggex prices
  if [[ "$OBSERVE_MARKET" == "xeggex" ]] &>/dev/null; then
    EXCHANGE_API="XGX"
    exchange_template
    SUPPORT_WIDTH="+5"
    SUPPORT_LENGTH="5"
    SUPPORT_RESULT="Support: https://xeggex.com/account/support"
    function result_prices() {
      echo "$(tickers | column -t)" >"${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null
    }
  fi

  ##############################################################################

  # observe markets
  USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
    result_prices
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices ]] &>/dev/null; then
    result_prices
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices ]] &>/dev/null; then
    result_prices
  fi

  CAT_EXCHANGE_PRICES="$(cat "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null)"

  # 450 max before dialog breaks
  MARKET_RESULT="$(echo "$CAT_EXCHANGE_PRICES" | sort -k2 -n -r 2>/dev/null | head -100)"
  MARKET_COUNT="$(grep -v "Market" "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null | sed '/^$/d' | wc -l)"
  MARKET_MOON="$(echo "$CAT_EXCHANGE_PRICES" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
  MARKET_MOON_COUNT="$(echo "$CAT_EXCHANGE_PRICES" | awk '{ print $5 }' | wc -l)"
  MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
  WIDTH="$(echo "$(echo "$MARKET_RESULT" | column -t | wc -L)$SUPPORT_WIDTH" | bc 2>/dev/null)"
  LENGTH="25"

  # if zero
  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="77"
  fi

  # if less than n
  if [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
    WIDTH="77"
  fi

  # if market has data
  if [[ "$MARKET_COUNT" -eq "0" ]] &>/dev/null; then
    LENGTH="$SUPPORT_LENGTH"
    RESULT="$SUPPORT"
  else
    RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
  fi

  FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null | awk '{ print $8 }')"
  if [[ -z "$FILE_TIME" ]] &>/dev/null; then
    FILE_TIME="00:00"
  fi

  display_result() {
    dialog --title "$FILE_TIME | Top 100 $EXCHANGE_API Market: +$MARKET_COUNT | $DATE | ${MARKET_MOON_VALUE:?}%" \
      --no-collapse \
      --scrollbar \
      --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
  }
  display_result 2>/dev/null
}

