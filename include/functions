# observe markets ##############################################################

function observe_market() {

  # exchanges, includes functions
  source /usr/local/bin/include/leeloo/strategies/templates/exchanges

  # search markets
  USER_TIMER="$(echo "$BOT_TIMER*3.5" | bc 2>/dev/null | awk -F. '{ print $1 }')"

  display_result() {
    dialog --title "$FILE_TIME :: Top 100 Market: +$MARKET_COUNT :: $DATE :: ${MARKET_MOON_VALUE:?}%" \
      --no-collapse \
      --scrollbar \
      --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
  }

  # get poloniex prices
  if [[ "$OBSERVE_MARKET" == "poloniex" ]] &>/dev/null; then
    EXCHANGE_API="POL"
    exchange_template
    SUPPORT_LENGTH="5"
    SUPPORT_WIDTH="-7"
    SUPPORT="Support: https://support.poloniex.com"
    function result_prices() {
      echo "$(getPrices | column -t)" >"${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null
    }
  fi

  # get southxchange prices
  if [[ "$OBSERVE_MARKET" == "southxchange" ]] &>/dev/null; then
    EXCHANGE_API="SXC"
    exchange_template
    SUPPORT_LENGTH="5"
    SUPPORT_WIDTH="+5"
    SUPPORT="Support: https://southxchange.gorgias.help"
    function result_prices() {
      echo "$(prices | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null
    }
  fi

  # get stakecube prices
  if [[ "$OBSERVE_MARKET" == "stakecube" ]] &>/dev/null; then
    EXCHANGE_API="SCE"
    exchange_template
    SUPPORT_LENGTH="5"
    SUPPORT_WIDTH="+8"
    SUPPORT_RESULT="Support Mail: support@stakecube.zohodesk.com"
    function result_prices() {
      echo "$(getMarkets | column -t)" >"${LOG_DIR:?}"/leeloo/stakecube/prices 2>/dev/null
    }
  fi

  # get xeggex prices
  if [[ "$OBSERVE_MARKET" == "xeggex" ]] &>/dev/null; then
    EXCHANGE_API="XGX"
    exchange_template
    SUPPORT_LENGTH="5"
    SUPPORT_WIDTH="-42"
    SUPPORT_RESULT="Support: https://xeggex.com/account/support"
    function result_prices() {
      echo "$(tickers | column -t)" >"${LOG_DIR:?}"/leeloo/xeggex/prices 2>/dev/null
    }
  fi

  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null)))" 2>/dev/null)" -gt "$USER_TIMER" ]] &>/dev/null; then
    result_prices
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices ]] &>/dev/null; then
    result_prices
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices ]] &>/dev/null; then
    result_prices
  fi

  CAT_EXCHANGE_PRICES="$(cat "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null)"

  # 450 max before dialog breaks
  MARKET_RESULT="$(echo "$CAT_EXCHANGE_PRICES" | sort -k2 -n -r 2>/dev/null | head -100)"
  MARKET_COUNT="$(grep -v "Market" "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null | sed '/^$/d' | wc -l)"
  MARKET_MOON="$(echo "$CAT_EXCHANGE_PRICES" | awk '{ print $5 }' | awk '{ SUM += $1} END { print SUM }')"
  MARKET_MOON_COUNT="$(echo "$CAT_EXCHANGE_PRICES" | awk '{ print $5 }' | wc -l)"
  MARKET_MOON_VALUE="$(echo "$MARKET_MOON/$MARKET_MOON_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
  WIDTH="$(echo "$(echo "$MARKET_RESULT" | wc -L)$SUPPORT_WIDTH" | bc 2>/dev/null)"
  LENGTH="25"

  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="77"
  fi

  if [[ "$WIDTH" -lt "77" ]] &>/dev/null; then
    WIDTH="77"
  fi

  if [[ "$MARKET_COUNT" -eq "0" ]] &>/dev/null; then
    LENGTH="$SUPPORT_LENGTH"
    RESULT="$SUPPORT"
  else
    RESULT="Market: Bid Ask Last (%) Volume24Hr
$MARKET_RESULT"
  fi

  FILE_TIME="$(ls -l "${LOG_DIR:?}"/leeloo/"$OBSERVE_MARKET"/prices 2>/dev/null | awk '{ print $8 }')"
  if [[ -z "$FILE_TIME" ]] &>/dev/null; then
    FILE_TIME="00:00"
  fi

  display_result 2>/dev/null
}

