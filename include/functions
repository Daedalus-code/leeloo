# last_log #####################################################################

function last_log {
  echo "$(cat "${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/broker.log
  LOG_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/broker.log)"
  WIDTH="$(echo "$(tail -25 "${LOG_DIR:?}"/leeloo/broker.log | wc -L | awk '{ print $1 }')+7" | bc 2>/dev/null)"
  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  elif [[ "$WIDTH" -lt "25" ]] &>/dev/null; then
    WIDTH="25"
  fi
  display_result() {
    dialog --title "Broker Log: $LOG_COUNT" \
      --no-collapse \
      --tailbox "$RESULT" 25 "$WIDTH"
  }
  RESULT="${LOG_DIR:?}/leeloo/broker.log"
  display_result 2>/dev/null
}

# last_log_robot ###############################################################

function last_log_robot {
  # sort by date
  echo "$(sort -k 1.5M -k 1.3n -k 1.4n -k 2n -k 3.1n -k 3.2n "${LOG_DIR:?}"/leeloo/robot.log)" >"${LOG_DIR:?}"/leeloo/robot.log
  LOG_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/robot.log)"
  WIDTH="$(echo "$(tail -25 "${LOG_DIR:?}"/leeloo/robot.log | wc -L | awk '{ print $1 }')+6" | bc 2>/dev/null)"
  if [[ -z "$WIDTH" ]] &>/dev/null; then
    WIDTH="100"
  elif [[ "$WIDTH" -lt "25" ]] &>/dev/null; then
    WIDTH="25"
  fi
  display_result() {
    dialog --title "Robot Log: $LOG_COUNT" \
      --no-collapse \
      --tailbox "$RESULT" 25 "$WIDTH"
  }
  RESULT="${LOG_DIR:?}/leeloo/robot.log"
  display_result 2>/dev/null
}

# cleanup_log ##################################################################

function cleanup_log {
  if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/broker.log | awk '{ print $1 }')" -gt "$MAX_LOG" ]] &>/dev/null; then
    echo "$(tail -512 "${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/broker.log
    echo "$DATE :: LogReset :: Line $MAX_LOG" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log
  else
    echo "$(cat "${LOG_DIR:?}"/leeloo/broker.log 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/broker.log
  fi
}

