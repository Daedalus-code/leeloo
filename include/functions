# order history data ###########################################################

function order_history_data {

  # if missing directory
  if [[ ! -d "${LOG_DIR:?}"/leeloo/orders ]] &>/dev/null; then
    mkdir "${LOG_DIR:?}"/leeloo/orders &>/dev/null
  fi

  # target orders age (seconds)
  TARGET_ORDERS_AGE_SECONDS=$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/orders/history 2>/dev/null | awk '{ SUM += $1} END { print SUM }' | awk -F. '{ print $1 }')

  # if greater than n
  if [[ "$TARGET_ORDERS_AGE_SECONDS" -gt "180" || ! -f "${LOG_DIR:?}"/leeloo/orders/history ]] &>/dev/null; then

    # if xeggex order
    if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
      # fetch latest orders
      getTrades >"${LOG_DIR:?}"/leeloo/orders/raw.trades 2>/dev/null
    fi

    # if nonkyc order
    if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
      # fetch latest orders
      getTrades_nky >"${LOG_DIR:?}"/leeloo/orders/raw.trades 2>/dev/null
    fi

    # create a copy of history (orders)
    cat "${LOG_DIR:?}"/leeloo/*/*.trades 2>/dev/null | awk '!a[$1]++' | tr -d '{}"' | tr ',:' ' ' | awk '{ print $1,$3,$5,$6,$7,$8,$9,$NF }' | column -t | sort -n -k 8 | tac >"${LOG_DIR:?}"/leeloo/orders/history 2>/dev/null
    # remove old file
    rm "${LOG_DIR:?}"/leeloo/orders/raw.trades &>/dev/null
  fi

  # display result
  RESULT="$(grep "$COIN_TOKEN" "${LOG_DIR:?}"/leeloo/orders/history 2>/dev/null | head -225)"
  RESULT_COUNT="$(echo "$RESULT" | wc -l)"

  # if less than n
  if [[ "$RESULT_COUNT" -lt "25" ]] &>/dev/null; then
    WIDTH="125"
    LENGTH="25"
  else
    WIDTH="0"
    LENGTH="0"
  fi

  COIN_TOKEN_BALANCE="$(grep -w "$COIN_TOKEN" "${LOG_DIR:?}"/leeloo/*/balances | awk '!a[$1]++' | awk '{ print $3 }')"

  ORDER_HISTORY_TOTAL="$(grep -c "$COIN_TOKEN" "${LOG_DIR:?}"/leeloo/orders/history || true)"
  ORDER_HISTORY_TOTAL_BUY="$(grep "$COIN_TOKEN" "${LOG_DIR:?}"/leeloo/orders/history | grep -c "buy" || true)"
  ORDER_HISTORY_PERCENTAGE_BUY="$(echo "100/$ORDER_HISTORY_TOTAL*$ORDER_HISTORY_TOTAL_BUY" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
  ORDER_HISTORY_TOTAL_SELL="$(grep "$COIN_TOKEN" "${LOG_DIR:?}"/leeloo/orders/history | grep -c "sell" || true)"
  ORDER_HISTORY_PERCENTAGE_SELL="$(echo "100/$ORDER_HISTORY_TOTAL*$ORDER_HISTORY_TOTAL_SELL" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # no data
  if [[ -z "$RESULT" ]] &>/dev/null; then
    RESULT="Nothing was found."
    ORDER_HISTORY_TOTAL="0"
    ORDER_HISTORY_TOTAL_BUY="0"
    ORDER_HISTORY_PERCENTAGE_BUY="0"
    ORDER_HISTORY_TOTAL_SELL="0"
    ORDER_HISTORY_PERCENTAGE_SELL="0"
  fi

  display_result() {
    dialog --title "Order history: +$ORDER_HISTORY_TOTAL :: Buy: $ORDER_HISTORY_TOTAL_BUY (${ORDER_HISTORY_PERCENTAGE_BUY:?}%) :: Sell: $ORDER_HISTORY_TOTAL_SELL (${ORDER_HISTORY_PERCENTAGE_SELL:?}%) Balance: $COIN_TOKEN_BALANCE $COIN_TOKEN" \
      --no-collapse \
      --msgbox "$(echo "$RESULT" | column -t)" "$LENGTH" "$WIDTH"
  }

  display_result 2>/dev/null
}

