function key_secret_set() {

  KEY_SECRET_SET_PLX="0" # poloniex
  KEY_SECRET_SET_SXC="0" # southxchange
  KEY_SECRET_SET_SCE="0" # stakecube

  ##############################################################################

  # poloniex option
  if [[ -n "$API_POLONIEX_KEY" ]] && [[ -n "$API_POLONIEX_SECRET" ]]; then
    KEY_SECRET_SET_PLX="1"
  fi
  # southxchange option
  if [[ -n "$API_SOUTHX_KEY" ]] && [[ -n "$API_SOUTHX_SECRET" ]]; then
    KEY_SECRET_SET_SXC="1"
  fi
  # stakecube option
  if [[ -n "$API_STAKECUBE_KEY" ]] && [[ -n "$API_STAKECUBE_SECRET" ]]; then
    KEY_SECRET_SET_SCE="1"
  fi

  ##############################################################################

  # calculate status
  KEY_SECRET_SET="$(echo "$KEY_SECRET_SET_PLX+$KEY_SECRET_SET_SXC+$KEY_SECRET_SET_SCE" | bc 2>/dev/null)"
  if [[ -z "$KEY_SECRET_SET" ]] &>/dev/null; then
    KEY_SECRET_SET="0"
  fi
  # if set
  if [[ "$KEY_SECRET_SET" -gt "0" ]] &>/dev/null; then
    KEY_SECRET_OK="1"
  else
    KEY_SECRET_OK="0"
  fi
}

################################################################################

function broker_conf_update() {
  LEELOO_CONFIG_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/broker.conf | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done | awk '{ SUM += $1} END { print SUM }')"

  # updating broker configuration, restart robots
  if [[ "$LEELOO_CONFIG_SECONDS" -lt "10" ]] &>/dev/null; then
    if [[ "$(echo "$SCREEN_LIST" | grep -c "leeloo")" -gt "0" ]] &>/dev/null; then
      # kill screen
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit 2>/dev/null
      # kill leeloo pid (shell)
      echo "$(ps aux 2>/dev/null | grep "leeloo" | grep -v "grep" | grep "bash.*robot/leeloo" | awk '{ print $2 }' | tail -1)" >"${LOG_DIR:?}"/leeloo/ps_aux
      LEELOO_PID="$(cat "${LOG_DIR:?}"/leeloo/ps_aux 2>/dev/null)"
      kill -9 "$LEELOO_PID" &>/dev/null
      bash "${SYS_DIR:?}"/robot/looper
      echo "Robot restarting!" >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
      display_result() {
        dialog --title "Updating Configuration." \
          --no-collapse \
          --msgbox "$RESULT" 0 0
      }
      RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
      display_result 2>/dev/null
    fi
  fi
}

