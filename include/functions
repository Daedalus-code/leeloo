function key_secret_set() {

  KEY_SECRET_SET_PLX="0" # poloniex
  KEY_SECRET_SET_SCE="0" # stakecube
  KEY_SECRET_SET_XGX="0" # xeggex
  KEY_SECRET_SET_NKY="0" # nonkyc

  ##############################################################################

  # poloniex option
  if [[ -n "$API_POLONIEX_KEY" ]] && [[ -n "$API_POLONIEX_SECRET" ]]; then
    KEY_SECRET_SET_PLX="1"
  fi
  # stakecube option
  if [[ -n "$API_STAKECUBE_KEY" ]] && [[ -n "$API_STAKECUBE_SECRET" ]]; then
    KEY_SECRET_SET_SCE="1"
  fi
  # xeggex option
  if [[ -n "$API_XEGGEX_KEY" ]] && [[ -n "$API_XEGGEX_SECRET" ]]; then
    KEY_SECRET_SET_XGX="1"
  fi
  # nonkyc option
  if [[ -n "$API_NONKYC_KEY" ]] && [[ -n "$API_NONKYC_SECRET" ]]; then
    KEY_SECRET_SET_NKY="1"
  fi

  ##############################################################################

  # calculate general status
  KEY_SECRET_SET="$(echo "$KEY_SECRET_SET_PLX+$KEY_SECRET_SET_SCE+$KEY_SECRET_SET_XGX" | bc 2>/dev/null)"
  # if zero
  if [[ -z "$KEY_SECRET_SET" ]] &>/dev/null; then
    KEY_SECRET_SET="0"
  fi

  # if set
  if [[ "$KEY_SECRET_SET" -gt "0" ]] &>/dev/null; then
    KEY_SECRET_OK="1"
  else
    KEY_SECRET_OK="0"
  fi
}

################################################################################

function pool_duration {

  # if searching
  if [[ "$POOL_SEARCHING" == "1" ]] &>/dev/null; then
    DURATIONS_FILE="${SYS_DIR:?}/$COIN_TOKEN.durations.txt"
  else
    DURATIONS_FILE="${SYS_DIR:?}/durations.txt"
  fi

  TOTAL_SECONDS=0

  # if searching
  if [[ "$POOL_SEARCHING" == "1" ]] &>/dev/null; then
    # fetch the list of time durations
    grep -w "$COIN_TOKEN" "${SYS_DIR:?}"/robot/pool.view 2>/dev/null | awk '{ print $NF }' | egrep -v "N/A|Age" >"$DURATIONS_FILE"
  else
    # fetch the list of time durations
    cat "${SYS_DIR:?}"/robot/pool.view 2>/dev/null | awk '{ print $NF }' | egrep -v "N/A|Age" >"$DURATIONS_FILE"
  fi

  while IFS=: read -r DURATION; do

    # remove any non-numeric characters
    DURATION_NUMERIC=$(echo "$DURATION" | tr -cd '0-9hms')

    # parse the duration into HOURS, MINUTES, and SECONDS
    HOURS=$(echo "$DURATION_NUMERIC" | sed 's/h.*//')
    MINUTES=$(echo "$DURATION_NUMERIC" | sed 's/.*h//' | sed 's/m.*//')
    SECONDS=$(echo "$DURATION_NUMERIC" | sed 's/.*m//' | sed 's/s.*//')

    # check if the values are non-empty and numeric
    if [[ -n "$HOURS" && -n "$MINUTES" && -n "$SECONDS" && "$HOURS" =~ ^[0-9]+$ && "$MINUTES" =~ ^[0-9]+$ && "$SECONDS" =~ ^[0-9]+$ ]]; then
      TOTAL_SECONDS=$((TOTAL_SECONDS + HOURS * 3600 + MINUTES * 60 + SECONDS))
    fi
  done <"$DURATIONS_FILE"

  # remove temp file
  rm "$DURATIONS_FILE" &>/dev/null

  # if searching
  if [[ "$POOL_SEARCHING" == "1" ]] &>/dev/null; then
    OPEN_COUNT="$(grep -wc "$COIN_TOKEN" "${SYS_DIR:?}"/robot/pool.view || true)"
  else
    OPEN_COUNT="$(echo "$(wc -l "${SYS_DIR:?}"/robot/pool.view 2>/dev/null | awk '{ print $1 }')-1" | bc 2>/dev/null)"
  fi

  if [[ "$(echo "$OPEN_COUNT" | grep '[-]' 2>/dev/null | wc -l)" -gt "0" ]] &>/dev/null; then
    OPEN_COUNT="0"
  fi

  OPEN_TOTAL_SECONDS="$(echo "$TOTAL_SECONDS/$OPEN_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  # if zero
  if [[ -z "$OPEN_TOTAL_SECONDS" ]] &>/dev/null; then
    OPEN_TOTAL_SECONDS="0"
  fi

  OPEN_TOTAL_AGE=$(printf '%dh:%dm:%ds\n' $(("$(echo "${OPEN_TOTAL_SECONDS:?}" 2>&1)/3600")) $(("$(echo "${OPEN_TOTAL_SECONDS:?}" 2>&1)%3600/60")) $(("$(echo "${OPEN_TOTAL_SECONDS:?}" 2>&1)%60")))
  OPEN_TOTAL_AGE_DAYS="$(echo "$OPEN_TOTAL_SECONDS/86400" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
}

################################################################################

function broker_conf_update() {
  LEELOO_CONFIG_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/broker.conf | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done | awk '{ SUM += $1} END { print SUM }')"

  # updating broker configuration, restart robots
  if [[ "$LEELOO_CONFIG_SECONDS" -lt "10" ]] &>/dev/null; then
    if [[ "$(echo "$SCREEN_LIST" | grep -c "leeloo")" -gt "0" ]] &>/dev/null; then
      # kill screen
      screen -S "$(echo "$SCREEN_LIST" | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit 2>/dev/null
      # kill leeloo pid (shell)
      echo "$(ps aux 2>/dev/null | grep "leeloo" | grep -v "grep" | grep "bash.*robot/leeloo" | awk '{ print $2 }' | tail -1)" >"${LOG_DIR:?}"/leeloo/ps_aux
      LEELOO_PID="$(cat "${LOG_DIR:?}"/leeloo/ps_aux 2>/dev/null)"
      kill -9 "$LEELOO_PID" &>/dev/null
      bash "${SYS_DIR:?}"/robot/looper
      echo "Robot restarting!" >"${LOG_DIR:?}"/leeloo/updating 2>/dev/null
      display_result() {
        dialog --title "Updating Configuration." \
          --no-collapse \
          --msgbox "$RESULT" 0 0
      }
      RESULT="$(cat "${LOG_DIR:?}"/leeloo/updating 2>/dev/null)"
      display_result 2>/dev/null
    fi
  fi
}

