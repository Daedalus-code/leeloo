# repo version #################################################################

function repo_head_data() {
  if [[ ! -f "${LOG_DIR:?}"/leeloo/repo ]] &>/dev/null; then
    cd "${HOME_DIR:?}"/leeloo || exit && git rev-parse --short HEAD 2>&1 | grep -Eo '[a0-z9]{7}' 2>&1 | head -1 >"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
    cd "${HOME_DIR:?}"/leeloo || exit && git log -1 --format="%at" | xargs -I{} date -d @{} '+%Y' >>"${LOG_DIR:?}"/leeloo/repo 2>/dev/null
  fi

  REPO_HEAD="$(cat "${LOG_DIR:?}"/leeloo/repo 2>/dev/null | head -1)"
  REPO_DATE="$(cat "${LOG_DIR:?}"/leeloo/repo 2>/dev/null | tail -1)"

  if [[ -z "$REPO_HEAD" ]] &>/dev/null; then
    REPO_HEAD="edit"
    REPO_DATE="config."
  fi
}

