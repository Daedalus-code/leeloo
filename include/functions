#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

source /usr/local/bin/include/leeloo/broker.conf

# search market ################################################################

function search {
  MARKET_INPUT=$(
    dialog --title "Market (BTC/USDT) (BTC)" \
      --inputbox "Enter name:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )
}

# setup_type_order #############################################################

function setup_type_order {
  SETUP_TYPE_ORDER=(
    --backtitle "Market/Limit setup"
    --title "Setup type of orders:"
    --yesno "Using Market orders?"
    0 0
  )
  dialog "${SETUP_TYPE_ORDER[@]}"
  DIALOG_RESULT=$?
  if [ $DIALOG_RESULT -eq 0 ] &>/dev/null; then
    echo "true" >"${LOG_DIR:?}"/leeloo/creating_strategy
  else
    echo "false" >"${LOG_DIR:?}"/leeloo/creating_strategy
  fi
}

# setup_market_order_strategy ##################################################

function setup_market_order_strategy {
  LISTING_CURRENCY=$(
    dialog --title "Listing Currency (BTC)" \
      --inputbox "Enter name:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )
  REFERENCE_CURRENCY=$(
    dialog --title "Reference Currency (USDT)" \
      --inputbox "Enter name:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )

  LISTING_CURRENCY_AMOUNT="$LISTING_CURRENCY: $(grep "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/southxchange/balances | awk '{ print $3 }')"
  REFERENCE_CURRENCY_AMOUNT="$REFERENCE_CURRENCY: $(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/southxchange/balances | awk '{ print $3 }')"

  SETUP_TYPE_ORDER=(
    --backtitle "Listing/Reference setup"
    --title "Setup type of orders:"
    --yesno "Using Listing market?"
    0 0
  )
  dialog "${SETUP_TYPE_ORDER[@]}"
  DIALOG_RESULT=$?
  if [ $DIALOG_RESULT -eq 0 ] &>/dev/null; then
    TRIGGER_AMOUNT=$(
      dialog --title "Trigger $LISTING_CURRENCY" \
        --inputbox "Enter trigger amount:
  $LISTING_CURRENCY_AMOUNT" 8 40 \
        3>&1 1>&2 2>&3 3>&-
    )
    echo "ListingCurrencyAmount...: $LISTING_CURRENCY_AMOUNT" >>"${LOG_DIR:?}"/leeloo/creating_strategy
  else
    TRIGGER_AMOUNT=$(
      dialog --title "Trigger $REFERENCE_CURRENCY" \
        --inputbox "Enter trigger amount:
  $REFERENCE_CURRENCY_AMOUNT" 8 40 \
        3>&1 1>&2 2>&3 3>&-
    )
    echo "ReferenceCurrency.......: $REFERENCE_CURRENCY" >>"${LOG_DIR:?}"/leeloo/creating_strategy
  fi

  if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then
    if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
      if [[ ! -z "$TRIGGER_AMOUNT" ]] &>/dev/null; then
        # is this a strategy
        if [[ -f "${LOG_DIR:?}"/leeloo/creating_strategy ]] &>/dev/null; then
          echo "ListingCurrency.........: $LISTING_CURRENCY" >>"${LOG_DIR:?}"/leeloo/creating_strategy
          echo "TriggerAmount...........: $TRIGGER_AMOUNT" >>"${LOG_DIR:?}"/leeloo/creating_strategy
        fi
      fi
    fi
  fi
}

