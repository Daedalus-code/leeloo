#!/bin/bash

# directories ##################################################################

if [[ ! -d /usr/local/bin/include/leeloo ]] &>/dev/null; then
  sudo mkdir /usr/local/bin/include &>/dev/null
  sudo mkdir /usr/local/bin/include/leeloo &>/dev/null
  sudo mkdir /usr/local/bin/include/leeloo/robot &>/dev/null
  sudo chown -R "$(whoami)":"$(whoami)" /usr/local/bin/include
fi

if [[ -f /usr/local/bin/include/leeloo/broker.conf ]] &>/dev/null; then
  source /usr/local/bin/include/leeloo/broker.conf
else
  HOME_DIR=$(
    dialog --title "Set install (HOME_DIR/leeloo/broker.conf)" \
      --inputbox "Enter dir:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )
  cp "$HOME_DIR"/leeloo/broker.conf /usr/local/bin/include/leeloo/broker.conf
  echo "edit /usr/local/bin/include/leeloo/broker.conf!"
  nano /usr/local/bin/include/leeloo/broker.conf
  exit
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo/indicators ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo/indicators &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo/southxchange ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo/southxchange &>/dev/null
fi

# system files #################################################################

clear

if ! [ -x "$(command -v dialog)" ] &>/dev/null; then
  sudo apt-get install dialog
fi

if ! [ -x "$(command -v tor)" ] &>/dev/null; then
  sudo apt-get install tor
fi

if ! [ -x "$(command -v bc)" ] &>/dev/null; then
  sudo apt-get install bc
fi

if ! [ -x "$(command -v jq)" ] &>/dev/null; then
  sudo apt-get install jq
fi

# install files ################################################################

sudo cp "${HOME_DIR:?}"/leeloo/broker /usr/local/bin/broker
sudo chmod +x /usr/local/bin/broker
sudo chown "$(whoami)":"$(whoami)" /usr/local/bin/broker

cp -a "${HOME_DIR:?}"/leeloo/include/indicators/ "$SYS_DIR" &>/dev/null
cp -a "${HOME_DIR:?}"/leeloo/include/strategies/ "$SYS_DIR" &>/dev/null
cp -a "${HOME_DIR:?}"/leeloo/include/robot/ "$SYS_DIR" &>/dev/null
cp -a "${HOME_DIR:?}"/leeloo/include/api/ "$SYS_DIR" &>/dev/null
cp "${HOME_DIR:?}"/leeloo/include/functions "$SYS_DIR" &>/dev/null

# update specific strategies ###################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | egrep "BST*.config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update buy and sell strategy
  for BST_UPDATES in "$SYS_DIR"/robot/BST*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/buy_sell_strategy >"$BST_UPDATES"
  done
fi

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | egrep "EMA*.config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update EMA strategy
  for EMA_UPDATES in "$SYS_DIR"/robot/EMA*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/ema_strategy >"$EMA_UPDATES"
  done
fi

# END
