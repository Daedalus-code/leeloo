#!/bin/bash

################################################################################

# DISCLAIMER

# All trading activities and any resulting losses are solely the user's responsibility.
# This software is provided without warranties or guarantees, use it at your own risk.
# Embrace the chaos, adapt to the shadows, may the odds ever be in your favor.

################################################################################

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

HOME_DIR="$(cat /usr/local/bin/include/leeloo/home_dir 2>/dev/null)"

if [[ -z "$HOME_DIR" ]] &>/dev/null; then
  HOME_DIR=$(
    dialog --title "Set install (HOME_DIR/leeloo/broker.conf)" \
      --inputbox "git clone directory:
Example: /home/$(whoami)" 8 47 \
      3>&1 1>&2 2>&3 3>&-
  )
  # set home directory
  echo "$HOME_DIR" >/usr/local/bin/include/leeloo/home_dir
fi

HOME_DIR="$(cat /usr/local/bin/include/leeloo/home_dir 2>/dev/null)"

# directories ##################################################################

if [[ ! -f /usr/local/bin/include/leeloo/broker.conf ]] &>/dev/null; then
  if dialog --stdout --title "New Install?" \
    --backtitle "Is this a new install?" \
    --yesno "Yes: New!, No: Continue!" 5 30; then
    sudo rm -R /usr/local/bin/include/leeloo &>/dev/null
    sudo rm /usr/local/bin/broker &>/dev/null
    clear
  fi
fi

if [[ ! -d /usr/local/bin/include/leeloo ]] &>/dev/null; then
  sudo mkdir /usr/local/bin/include &>/dev/null
  sudo mkdir /usr/local/bin/include/leeloo &>/dev/null
  sudo mkdir /usr/local/bin/include/leeloo/robot &>/dev/null
  sudo chown -R "$(whoami)":"$(whoami)" /usr/local/bin/include
fi

# set home directory
echo "$HOME_DIR" >/usr/local/bin/include/leeloo/home_dir

if [[ -f /usr/local/bin/include/leeloo/broker.conf ]] &>/dev/null; then
  source /usr/local/bin/include/leeloo/broker.conf
else

  mv "$HOME_DIR"/leeloo-main "$HOME_DIR"/leeloo &>/dev/null
  cp "$HOME_DIR"/leeloo/broker.conf /usr/local/bin/include/leeloo/broker.conf &>/dev/null

  # error
  if [[ ! -f /usr/local/bin/include/leeloo/broker.conf ]] &>/dev/null; then
    WIDTH="$(echo "$(echo "$HOME_DIR" | wc -L)*2" | bc 2>/dev/null)"
    if [[ "$WIDTH" -lt "30" ]] &>/dev/null; then
      WIDTH="30"
    fi
    display_result() {
      dialog --title "ERROR" \
        --no-collapse \
        --msgbox "$RESULT" 6 "$WIDTH"
    }
    RESULT="$(echo "HOME_DIR=$HOME_DIR
No install found!")"
    display_result 2>/dev/null
    clear
    exit
    # working directory
  else
    clear
    echo "HOME_DIR=$HOME_DIR # repo install" >>/usr/local/bin/include/leeloo/broker.conf
    broker
  fi
  exit
fi

if [[ "$(egrep -c "HOME_DIR=" /usr/local/bin/include/leeloo/broker.conf)" -eq "0" ]] &>/dev/null; then
  echo "HOME_DIR=${HOME_DIR:?}" >>/usr/local/bin/include/leeloo/broker.conf
fi

if [[ ! -f /usr/local/bin/include/leeloo/sMcD ]] &>/dev/null; then
  cp "$HOME_DIR"/leeloo/include/api/DcMs /usr/local/bin/include/leeloo/sMcD &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo/indicators ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo/indicators &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo/poloniex ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo/poloniex &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo/southxchange ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo/southxchange &>/dev/null
fi

if [[ ! -d "${LOG_DIR:?}"/leeloo/stakecube ]] &>/dev/null; then
  mkdir "${LOG_DIR:?}"/leeloo/stakecube &>/dev/null
fi

# system files #################################################################

# true
function proxy_chat_true() {
  echo "PROXY_CHAT_API=true" >>/usr/local/bin/include/leeloo/broker.conf
}

# true
function proxy_public_true() {
  echo "PROXY_PUBLIC_API=true" >>/usr/local/bin/include/leeloo/broker.conf
}
function proxy_indicator_true() {
  echo "PROXY_INDICATOR_API=true" >>/usr/local/bin/include/leeloo/broker.conf
}

# false
function proxy_chat_false() {
  echo "PROXY_CHAT_API=false" >>/usr/local/bin/include/leeloo/broker.conf
}

# false
function proxy_public_false() {
  echo "PROXY_PUBLIC_API=false" >>/usr/local/bin/include/leeloo/broker.conf
}
function proxy_indicator_false() {
  echo "PROXY_INDICATOR_API=false" >>/usr/local/bin/include/leeloo/broker.conf
}

if [[ "$(egrep -c "true|false" /usr/local/bin/include/leeloo/broker.conf)" -eq "0" ]] &>/dev/null; then
  proxy_chat_false
  proxy_public_false
  proxy_indicator_false
fi

clear

################################################################################

if ! [ -x "$(command -v dialog)" ] &>/dev/null; then
  sudo apt-get install dialog
fi

if [[ ! -f /usr/local/bin/include/leeloo/no_tor ]] &>/dev/null; then
  if ! [ -x "$(command -v tor)" ] &>/dev/null; then
    if [[ ! -f /usr/local/bin/include/leeloo/broker.conf ]] &>/dev/null; then
      if dialog --stdout --title "Install proxy?" \
        --backtitle "Proxy (tor) install?" \
        --yesno "Yes: Install!, No: Continue!" 5 30; then
        proxy_chat_true
        proxy_public_true
        proxy_indicator_true
        sudo apt-get install tor
      else
        proxy_chat_false
        proxy_public_false
        proxy_indicator_false
        echo "No proxy" >/usr/local/bin/include/leeloo/no_tor
      fi
    fi
  fi
fi

################################################################################

if [[ "$(grep -c "PROXY_CHAT_API" /usr/local/bin/include/leeloo/broker.conf)" -eq "0" ]] &>/dev/null; then
  proxy_chat_false
fi
if [[ "$(grep -c "PROXY_PUBLIC_API" /usr/local/bin/include/leeloo/broker.conf)" -eq "0" ]] &>/dev/null; then
  proxy_public_false
fi
if [[ "$(grep -c "PROXY_INDICATOR_API" /usr/local/bin/include/leeloo/broker.conf)" -eq "0" ]] &>/dev/null; then
  proxy_indicator_false
fi

################################################################################

if ! [ -x "$(command -v bc)" ] &>/dev/null; then
  sudo apt-get install bc
fi

if ! [ -x "$(command -v jq)" ] &>/dev/null; then
  sudo apt-get install jq
fi

# install files ################################################################

sudo cp "${HOME_DIR:?}"/leeloo/broker /usr/local/bin/broker &>/dev/null
sudo chmod +x /usr/local/bin/broker
sudo chown -R "$(whoami)":"$(whoami)" /usr/local/bin/include/leeloo

cp -a "${HOME_DIR:?}"/leeloo/include/indicators/ "$SYS_DIR" &>/dev/null
cp -a "${HOME_DIR:?}"/leeloo/include/strategies/ "$SYS_DIR" &>/dev/null
cp -a "${HOME_DIR:?}"/leeloo/include/robot/ "$SYS_DIR" &>/dev/null
cp -a "${HOME_DIR:?}"/leeloo/include/api/ "$SYS_DIR" &>/dev/null
cp "${HOME_DIR:?}"/leeloo/include/functions "$SYS_DIR" &>/dev/null
cp "${HOME_DIR:?}"/leeloo/include/irc_client "$SYS_DIR" &>/dev/null

# update specific strategies ###################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | grep "BST" | grep ".config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update buy and sell strategy
  for BST_UPDATES in "$SYS_DIR"/robot/BST*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/bst_strategy >"$BST_UPDATES" 2>/dev/null
  done
fi

################################################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | grep "EMA" | grep ".config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update EMA strategy
  for EMA_UPDATES in "$SYS_DIR"/robot/EMA*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/ema_strategy >"$EMA_UPDATES" 2>/dev/null
  done
fi

################################################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | grep "RSI" | grep ".config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update RSI strategy
  for RSI_UPDATES in "$SYS_DIR"/robot/RSI*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/rsi_strategy >"$RSI_UPDATES" 2>/dev/null
  done
fi

################################################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | grep "LZN" | grep ".config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update LZN strategy
  for LZN_UPDATES in "$SYS_DIR"/robot/LZN*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/lzn_strategy >"$LZN_UPDATES" 2>/dev/null
  done
fi

################################################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | grep "CST" | grep ".config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update CST strategy
  for CST_UPDATES in "$SYS_DIR"/robot/CST*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/custom_strategy >"$CST_UPDATES" 2>/dev/null
  done
fi

################################################################################

# if configuration exist, continue
if [[ "$(echo "$(ls -l "$SYS_DIR"/robot/)" | grep "MCS" | grep ".config" | wc -l)" -gt "0" ]] &>/dev/null; then
  # update MCS strategy
  for MCS_UPDATES in "$SYS_DIR"/robot/MCS*.strategy; do
    cat "${HOME_DIR:?}"/leeloo/include/strategies/mcs_strategy >"$MCS_UPDATES" 2>/dev/null
  done
fi

# END
