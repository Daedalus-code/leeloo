#!/bin/bash

source /usr/local/bin/include/leeloo/broker.conf
source /usr/local/bin/include/leeloo/functions
# southxchange api
source /usr/local/bin/include/leeloo/api/southxchange/private_API
source /usr/local/bin/include/leeloo/api/southxchange/public_API

# loop
for (( ; ; )); do

  LEELOO_TIMER="$(echo "$BOT_TIMER-5" | bc 2>/dev/null)"

  ##############################################################################

  cleanup_log

  ##############################################################################

  # get balance
  function result_balances() {
    echo "$(listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$LEELOO_TIMER" ]] &>/dev/null; then
    result_balances
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balances
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balances
  fi
  sleep 1

  ##############################################################################

  # get orders
  function result_orders() {
    echo "$(listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "$LEELOO_TIMER" ]] &>/dev/null; then
    result_orders
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
    result_orders
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
    result_orders
  fi
  sleep 1

  ##############################################################################

  # get prices
  function result_prices() {
    echo "$(prices | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)))" 2>/dev/null)" -gt "$LEELOO_TIMER" ]] &>/dev/null; then
    result_prices
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
    result_prices
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
    result_prices
  fi

  ##############################################################################

  if [[ ! -f "${SYS_DIR:?}"/robot/pool ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/robot/pool &>/dev/null
  fi

  # update pool
  echo "Strategy Currency Amount Cost Result Age" >"${SYS_DIR:?}"/robot/pool 2>/dev/null

  ##############################################################################

  # run all shell strategies installed
  for f in "${SYS_DIR:?}"/robot/*.strategy; do
    bash "$f"
  done

  ##############################################################################

  # combine all logs, sort by date
  echo "$(cat "${LOG_DIR:?}"/leeloo/robot.*.log 2>/dev/null | awk '!a[$0]++' | sed '/^$/d')" >"${LOG_DIR:?}"/leeloo/robot.log 2>/dev/null

  ##############################################################################

  sleep "$BOT_TIMER"
done

# END
