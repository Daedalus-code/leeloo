#!/bin/bash

source /usr/local/bin/include/leeloo/broker.conf
source /usr/local/bin/include/leeloo/functions
# southxchange api
source /usr/local/bin/include/leeloo/api/southxchange/private_API
source /usr/local/bin/include/leeloo/api/southxchange/public_API

# loop
for (( ; ; )); do

  ##############################################################################

  if [[ "$(screen -list | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
    # nothing is happening for n seconds, while something needs to be happening
    ROBOT_LOG_AGE="$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/robot.log 2>/dev/null)))"
    ROBOT_LOG_AGE_MINUTES="$(echo "$ROBOT_LOG_AGE/60" | bc 2>/dev/null)"
    if [[ "$(echo "$ROBOT_LOG_AGE" 2>/dev/null)" -gt "300" ]] &>/dev/null; then
      echo "$LOG_DATE :: Strategy NON WORK :: Reboot robots! $ROBOT_LOG_AGE_MINUTES Minutes behind.." >>"${LOG_DIR:?}"/leeloo/robot.log
      # kill old screen
      screen -S "$(screen -list | grep "leeloo" | awk -F. '{ print $1 }' | head -1 | xargs)".leeloo -p 0 -X quit
      if [[ "$(screen -list | grep "leeloo" 2>/dev/null | wc -l)" -eq "1" ]] &>/dev/null; then
        echo "$LOG_DATE :: Strategy NON WORK :: Killall screen!" >>"${LOG_DIR:?}"/leeloo/robot.log
        killall screen &>/dev/null
      fi
      # start looper
      echo "$LOG_DATE :: Strategy NON WORK :: Starting robots!" >>"${LOG_DIR:?}"/leeloo/robot.log
      bash "${SYS_DIR:?}"/robot/looper
    fi
  fi

  ##############################################################################

  cleanup_log

  ##############################################################################

  # get balance
  function result_balance() {
    listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER" ]] &>/dev/null; then
    result_balance
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
  fi
  sleep 1

  ##############################################################################

  # get orders
  function result_orders() {
    listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' 2>/dev/null | column -t >"${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER" ]] &>/dev/null; then
    result_orders
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
    result_orders
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
    result_orders
  fi
  sleep 1

  ##############################################################################

  # get market
  function result_market {
    prices | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/market
  }
  # update data every n seconds
  if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER" ]] &>/dev/null; then
    result_market
    # update data if missing
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
    # update data if empty
  elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
  fi

  ##############################################################################

  if [[ ! -f "${SYS_DIR:?}"/robot/pool ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/robot/pool &>/dev/null
  fi

  # update pool
  echo "Strategy Currency Amount Cost Result Age" >"${SYS_DIR:?}"/robot/pool

  ##############################################################################

  # run all strategies installed
  for f in "${SYS_DIR:?}"/robot/*.strategy; do
    bash "$f"
  done

  ##############################################################################

  # combine all logs, sort by date
  echo "$(sort -t '.' -k 1.3n -k 1.1,1.2n -k 2 "${LOG_DIR:?}"/leeloo/robot.*.log 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/robot.log

  ##############################################################################

  sleep "$(echo "$BOT_TIMER-2" | bc 2>/dev/null)"
done

# END
