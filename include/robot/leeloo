#!/bin/bash

source /usr/local/bin/include/leeloo/broker.conf
source /usr/local/bin/include/leeloo/functions
# southxchange api
source /usr/local/bin/include/leeloo/api/southxchange/private_API
source /usr/local/bin/include/leeloo/api/southxchange/public_API

# loop
for (( ; ; )); do

  cleanup_log

  ##############################################################################

  function result_balance() {
    listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/balances.tmp 2>/dev/null
  }
  if [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances.tmp ]] &>/dev/null; then
    result_balance
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
    result_balance
  fi
  if [[ "$(egrep "[0-9]+.[0-9]+" "${LOG_DIR:?}"/leeloo/southxchange/balances.tmp 2>/dev/null | wc -l)" -gt "0" ]] &>/dev/null; then
    mv "${LOG_DIR:?}"/leeloo/southxchange/balances.tmp "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$(echo "$BOT_TIMER-10" | bc 2>/dev/null)" ]] &>/dev/null; then
      result_balance
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
      result_balance
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
      result_balance
    fi
    sleep 1
  fi

  ##############################################################################

  function result_orders() {
    listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' 2>/dev/null | column -t >"${LOG_DIR:?}"/leeloo/southxchange/orders.tmp 2>/dev/null
  }
  if [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders.tmp ]] &>/dev/null; then
    result_orders
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
    result_orders
  fi
  if [[ "$(egrep "[0-9]+.[0-9]+" "${LOG_DIR:?}"/leeloo/southxchange/orders.tmp 2>/dev/null | wc -l)" -gt "0" ]] &>/dev/null; then
    mv "${LOG_DIR:?}"/leeloo/southxchange/orders.tmp "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "$(echo "$BOT_TIMER-10" | bc 2>/dev/null)" ]] &>/dev/null; then
      result_orders
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
    fi
    sleep 1
  fi

  ##############################################################################

  function result_market {
    prices | awk '{for(i=1;i<=NF;i++) {if($i~/^[0-9]*\.?[0-9]*[eE][-+]?[0-9]+$/) {printf("%.6f\t",$i);} else {printf("%s\t",$i)}} printf("\n")}' | column -t >"${LOG_DIR:?}"/leeloo/southxchange/market.tmp
  }
  if [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market.tmp ]] &>/dev/null; then
    result_market
  elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
    result_market
  fi
  if [[ "$(egrep "[0-9]+.[0-9]+" "${LOG_DIR:?}"/leeloo/southxchange/market.tmp 2>/dev/null | wc -l)" -gt "0" ]] &>/dev/null; then
    mv "${LOG_DIR:?}"/leeloo/southxchange/market.tmp "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/market 2>/dev/null)))" 2>/dev/null)" -gt "$(echo "$BOT_TIMER-10" | bc 2>/dev/null)" ]] &>/dev/null; then
      result_market
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
      result_market
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/market ]] &>/dev/null; then
      result_market
    fi
  fi

  ##############################################################################

  if [[ ! -f "${SYS_DIR:?}"/robot/pool ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/robot/pool &>/dev/null
  fi

  # update pool
  echo "Strategy Currency Amount Cost Result Age" >"${SYS_DIR:?}"/robot/pool

  ##############################################################################

  # run all strategies installed
  for f in "${SYS_DIR:?}"/robot/*.strategy; do
    bash "$f"
  done

  ##############################################################################

  # combine all logs, sort by date
  echo "$(sort -t '.' -k 1.3n -k 1.1,1.2n -k 2 "${LOG_DIR:?}"/leeloo/robot.*.log 2>/dev/null)" >"${LOG_DIR:?}"/leeloo/robot.log

  ##############################################################################

  sleep "$(echo "$BOT_TIMER-2" | bc 2>/dev/null)"
done

# END
