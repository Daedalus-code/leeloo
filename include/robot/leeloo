#!/bin/bash

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# loop
for (( ; ; )); do

  ##############################################################################

  account_private_api
  account_public_api

  ##############################################################################

  cleanup_log

  ##############################################################################

  # get active bots
  LEELOO_RUNNING_BOTS="$(cat "${LOG_DIR:?}"/leeloo/robots 2>/dev/null)"
  # bot timer api
  BOT_TIMER_API="$(echo "$BOT_TIMER-5" | bc 2>/dev/null)"
  # if zero
  if [[ "$BOT_TIMER_API" -lt "5" ]] &>/dev/null; then
    BOT_TIMER_API="5"
  fi

  ##############################################################################

  if [[ -f "${SYS_DIR:?}"/robot/orders || -f "${SYS_DIR:?}"/robot/pool ]] &>/dev/null; then
    # create a copy of orders (history), pool (positions)
    cp "${SYS_DIR:?}"/robot/orders "${SYS_DIR:?}"/robot/orders.view 2>/dev/null
    cp "${SYS_DIR:?}"/robot/pool "${SYS_DIR:?}"/robot/pool.view 2>/dev/null
  fi

  ##############################################################################
  # southxchange
  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "SXC")" -gt "0" ]] &>/dev/null; then
    # get southxchange balance
    function result_balances() {
      echo "$(listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_balances
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
      result_balances
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/balances ]] &>/dev/null; then
      result_balances
    fi
    sleep 1
  fi

  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "SXC")" -gt "0" ]] &>/dev/null; then
    # get southxchange orders
    function result_orders() {
      echo "$(listOrders | jq -r '.[] | "\(.Code): \(.Type) \(.Amount) \(.OriginalAmount) \(.LimitPrice) \(.ListingCurrency) \(.ReferenceCurrency) \(.DateAdded)"' 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/orders 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_orders
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/orders ]] &>/dev/null; then
      result_orders
    fi
    sleep 1
  fi

  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "SXC")" -gt "0" ]] &>/dev/null; then
    # get southxchange prices
    function result_prices() {
      echo "$(prices 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/southxchange/prices ]] &>/dev/null; then
      result_prices
    fi
  fi

  ##############################################################################
  # poloniex
  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "POL")" -gt "0" ]] &>/dev/null; then
    # get poloniex prices
    function result_prices() {
      echo "$(getPrices 2>/dev/null | column -t)" >"${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/poloniex/prices 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/poloniex/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/poloniex/prices ]] &>/dev/null; then
      result_prices
    fi
  fi

  ##############################################################################
  # xeggex
  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "XGX")" -gt "0" ]] &>/dev/null; then
    # get xeggex balance
    function result_balances() {
      echo "$(Balances | jq -r '.[] | "\(.asset): \(.held) \(.available) \(.pending)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/xeggex/balances 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/xeggex/balances 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_balances
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/xeggex/balances ]] &>/dev/null; then
      result_balances
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/xeggex/balances ]] &>/dev/null; then
      result_balances
    fi
    sleep 1
  fi

  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "XGX")" -gt "0" ]] &>/dev/null; then
    # get xeggex orders
    function result_orders() {
      echo "$(getOrders | jq -r '.[] | "\(.id): \(.side) \(.remainQuantity) \(.quantity) \(.price) \(.market.symbol) \(.updatedAt)"' | awk '{printf "%s %s %s %s %s %s %s\n", $1, $2, $3, $4, $5, $6, strftime("%Y-%m-%dT%H:%M:%S", $7/1000)}' 2>/dev/null | column -t | sed "s/\// /g" | tac)" >"${LOG_DIR:?}"/leeloo/xeggex/orders 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/xeggex/orders 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_orders
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/xeggex/orders ]] &>/dev/null; then
      result_orders
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/xeggex/orders ]] &>/dev/null; then
      result_orders
    fi
    sleep 1
  fi

  ##############################################################################

  # bots running
  if [[ "$(echo "$LEELOO_RUNNING_BOTS" | grep -c "XGX")" -gt "0" ]] &>/dev/null; then
    # get xeggex prices
    function result_prices() {
      echo "$(tickers | column -t)" >"${LOG_DIR:?}"/leeloo/xeggex/prices 2>/dev/null
    }
    # update data every n seconds
    if [[ "$(echo "$(($(date +%s) - $(date +%s -r "${LOG_DIR:?}"/leeloo/xeggex/prices 2>/dev/null)))" 2>/dev/null)" -gt "$BOT_TIMER_API" ]] &>/dev/null; then
      result_prices
      # update data if missing
    elif [[ ! -f "${LOG_DIR:?}"/leeloo/xeggex/prices ]] &>/dev/null; then
      result_prices
      # update data if empty
    elif [[ ! -s "${LOG_DIR:?}"/leeloo/xeggex/prices ]] &>/dev/null; then
      result_prices
    fi
  fi

  ##############################################################################
  # strategy pool & fetch, sort logs
  ##############################################################################

  if [[ ! -f "${SYS_DIR:?}"/robot/pool ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/robot/pool &>/dev/null
  fi

  # update pool
  echo "Exchange Strategy Currency Amount Cost Result Age" >"${SYS_DIR:?}"/robot/pool 2>/dev/null

  ##############################################################################

  # run all shell strategies installed
  for f in "${SYS_DIR:?}"/robot/*.strategy; do
    # error log file
    STRATEGY_LOG_FILE="${LOG_DIR:?}/leeloo/error.log"

    # execute the script and log only the error lines
    {
      if [[ ! -f "${LOG_DIR:?}"/loop ]] &>/dev/null; then
        touch "${LOG_DIR:?}"/loop
      fi
      # reset loop file
      truncate -s 0 "${LOG_DIR:?}"/loop &>/dev/null
      # run strategies
      while IFS= read -r line; do
        if echo "$line" | grep -Ei "error|exit status|command not found|syntax error|not found|is empty|permission denied|= ''|\${[A-Za-z0-9_]*}|unbound variable|\$()" >/dev/null; then
          echo "$line"
        fi
      done < <(bash "$f" 2>&1) > >(grep -Ei "error|exit status|command not found|syntax error|not found|is empty|permission denied|= ''|\${[A-Za-z0-9_]*}|unbound variable|\$()" >>"$STRATEGY_LOG_FILE")
      # create loop file
      echo "$(date | xargs)" >"${LOG_DIR:?}"/loop
    }

    # check the exit status of the script
    if [ $? -ne 0 ]; then
      echo "Error occurred while running $f. Check $STRATEGY_LOG_FILE for details." >>"$STRATEGY_LOG_FILE"
    fi
  done

  ##############################################################################

  # sort all logs by date, remove duplicates, remove empty lines
  echo "$(sort -t '/' -k 2.3,2.4n -k 2.1,2.2n "${LOG_DIR:?}"/leeloo/robot.*.log 2>/dev/null | awk '!a[$0]++' | sed '/^$/d')" >"${LOG_DIR:?}"/leeloo/robot.log 2>/dev/null

  ##############################################################################

  # remove duplicates, remove empty lines
  echo "$(cat "${SYS_DIR:?}"/robot/*.orders 2>/dev/null | sort -t '/' -k 2.3,2.4n -k 2.1,2.2n | awk '!a[$0]++' | sed '/^$/d')" >"${SYS_DIR:?}"/robot/orders 2>/dev/null

  ##############################################################################

  # strategies running equals more time
  STRAT_TIMED="$(ls -l "${SYS_DIR:?}"/robot/*.strategy | wc -l)"

  # if zero
  if [[ -z "$STRAT_TIMED" ]] &>/dev/null; then
    STRAT_TIMED="0"
  fi

  BOT_TIMER="$(echo "$BOT_TIMER+$STRAT_TIMED" | bc 2>/dev/null)"

  # ruled by configuration and strategies
  sleep "$BOT_TIMER"
done

# END
