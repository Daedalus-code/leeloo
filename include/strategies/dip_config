################################################################################

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf

################################################################################
# dip strategy configuration (dynamic)
################################################################################

# XGX xeggex template

################################################################################

EXCHANGE_API=""        # exchange api (template)
DIP_MARKETS="USDT"     # choose available market (USDT, BTC, LTC, DOGE, ETH)
DIP_MIN_DIP="1"        # minimum dip percentage (slightly higher for added caution)
DIP_MAX_DIP="70"       # maximum dip percentage (adjust based on market conditions)
DIP_RSI_LIMIT="36"     # relative strength index limit (when below limit, buy)
DIP_MIN_SPREAD="2"     # minimum spread percentage (lower for higher liquidity)
DIP_MAX_SPREAD="80"    # maximum spread percentage (be cautious in volatile markets)
DIP_MIN_VOLUME="0"     # minimum volume (higher for liquidity)
DIP_MAX_ORDERS="100"   # maximum open orders (manage exposure)
DIP_MIN_MOVEMENT="0"   # minimum price movement (filter out minor fluctuations)
DIP_MAX_ALLOCATED="1"  # max allocated (allocate max 1% of the balance)
DIP_EXTRA_LOGS="false" # extra dip logs (extra information)
DIP_ALLOCATED="0.1"    # dip allocated (allocate 0.1% of the balance)
DIP_MAX_AGE="180"      # dip max age (react faster to changing market conditions)
DIP_ALL_IN="0"         # don´t use the reference as targets (maintain independent strategy) (default 0)
DIP_CHAOS="0"          # look for more beneath the veil (this is chaos, most trades are risky)
DIP_DCA="0"            # dollar cost averaging (DCA) percentage (default 0 Max: 100)
DIP_DUST="1"           # dust coins/tokens not being traded (not active) when profit
DIP_DUST_PROFIT="10"   # dust profit minimum amount (10%)
DIP_MAKER_TAKER="0.40" # exchange market taker total fee (maker=0.20+taker=0.20=0.40%)
DIP_DYNAMIC_AGE="0"    # max age based on order profit (could be years!)
DIP_MAX_BUY_AGE="1"    # max buy order age (days) before reconsideration
DIP_MAX_SELL_AGE="2"   # max sell order age (days) before reconsideration
DIP_DISREGARD_BOTS="1" # disregard other markets run by other bots (focus on own strategy)

################################################################################
# strategy
################################################################################

# get strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"
bash "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".strategy

