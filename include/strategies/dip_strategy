  fi

  # active file average (hours:minutes:seconds)
  DIP_ACTIVE_FILE_AVERAGE_AGE=$(printf '%dh:%dm:%ds\n' $(("$DIP_ACTIVE_FILE_AVERAGE_SECONDS/3600")) $(("$DIP_ACTIVE_FILE_AVERAGE_SECONDS%3600/60")) $(("$DIP_ACTIVE_FILE_AVERAGE_SECONDS%60")))

  ##############################################################################

  # total average price movement
  DIP_ACTIVE_FILE_PRICE_MOVEMENT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $20 }' | tr -d '%' | awk '{ SUM += $1} END { print SUM }')"
  # top average price movement
  DIP_ACTIVE_TOP_PRICE_MOVEMENT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $20 }' | tr -d '%' | sort -n | tail -1)"
  # calculate average price movement
  DIP_ACTIVE_FILE_A_PRICE_MOVEMENT="$(echo "$DIP_ACTIVE_FILE_PRICE_MOVEMENT/$DIP_ACTIVE_FILE_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  ##############################################################################

  # top price movement data
  DIP_TOP_ACTIVE_PRICE_MOVEMENT="$(grep -w -- "$DIP_ACTIVE_TOP_PRICE_MOVEMENT" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null || true)"
  # top price movement market
  PRICE_MOVEMENT_TOP_MARKET="$(echo "$DIP_TOP_ACTIVE_PRICE_MOVEMENT" | awk '{ print $1}' | tr -d ':' | head -1)"
  # top price movement amount
  PRICE_MOVEMENT_TOP_MARKET_AMOUNT="$(echo "$DIP_TOP_ACTIVE_PRICE_MOVEMENT" | awk '{ print $20}' | tr -d '%' | awk '{ printf "%.2f\n", $1 }' | head -1)"

  ##############################################################################

  # top volume
  DIP_TOP_ACTIVE_VOLUME="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $23 }' | sort -n | tail -1)"
  # top volume market
  DIP_TOP_VOLUME_MARKET="$(grep -w -- "$DIP_TOP_ACTIVE_VOLUME" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1}' | tr -d ':' || true)"
  # top volume listing
  DIP_TOP_VOLUME_LISTING="$(echo "$DIP_TOP_VOLUME_MARKET" | awk -F/ '{ print $1 }')"
  # top volume amount
  DIP_TOP_VOLUME_AMOUNT="$(grep -w -- "$DIP_TOP_ACTIVE_VOLUME" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $23}' | awk '{ printf "%.0f\n", $1 }' || true)"

  ##############################################################################

  # top amount
  DIP_TOP_ACTIVE_AMOUNT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $26 }' | sort -n | tail -1)"
  # top amount market
  DIP_TOP_AMOUNT_MARKET="$(grep -w -- "$DIP_TOP_ACTIVE_AMOUNT" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1}' | tr -d ':' || true)"
  # top amount reference
  DIP_TOP_AMOUNT_LISTING="$(echo "$DIP_TOP_AMOUNT_MARKET" | awk -F/ '{ print $1 }')"
  # top amount amount
  DIP_TOP_AMOUNT_AMOUNT="$(grep -w -- "$DIP_TOP_ACTIVE_AMOUNT" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $26}' | awk '{ printf "%.0f\n", $1 }' || true)"

  ##############################################################################

  log_date

  # log position output
  DIP_POSITIONS_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : All/INFO :: Active: $DIP_ACTIVE_FILE_COUNT/$DIP_ORDERS_FILE_COUNT Dip: ${DIP_ACTIVE_FILE_AVERAGE_DIP:?}% Spread: ${DIP_ACTIVE_FILE_AVERAGE_SPREAD:?}% Buy: $DIP_ORDER_BUY_COUNT Sell: $DIP_ORDER_SELL_COUNT"
  echo "$DIP_POSITIONS_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################

  # total sum (confirmed sell)
  DIP_TOTAL_SOLD_SUM="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold 2>/dev/null | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%.9f\n", $1 }' | sed '/^$/d')"

  # if zero, equals zero
  if [[ -z "$DIP_TOTAL_SOLD_SUM" || "$DIP_TOTAL_SOLD_SUM" -eq "0" ]] &>/dev/null; then
    DIP_TOTAL_SOLD_SUM="0"
  fi

  ##############################################################################

  # leftover sell amount
  DIP_LEFTOVER_SOLD="$(echo "$DIP_TARGET_AMOUNT-$DIP_TOTAL_SOLD_SUM" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

  # if zero, equals zero
  if [[ -z "$DIP_LEFTOVER_SOLD" || "$DIP_LEFTOVER_SOLD" -eq "0" ]] &>/dev/null; then
    DIP_LEFTOVER_SOLD="0"
  fi

  ##############################################################################

  # leftover sell amount (without decimal)
  DIP_LEFTOVER_SOLD_CHECK="$(echo "$DIP_LEFTOVER_SOLD" | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$DIP_LEFTOVER_SOLD_CHECK" ]] &>/dev/null; then
    DIP_LEFTOVER_SOLD_CHECK="0"
  fi

  ##############################################################################

  # total sum (without decimal)
  DIP_TOTAL_SOLD_SUM_CHECK="$(echo "$DIP_TOTAL_SOLD_SUM" | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$DIP_TOTAL_SOLD_SUM_CHECK" ]] &>/dev/null; then
    DIP_TOTAL_SOLD_SUM_CHECK="0"
  fi

  ##############################################################################

  # listing balance, available (without decimal)
  DIP_LISTING_BALANCE_CHECK="$(echo "$LISTING_BALANCE" | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"

  # target amount (without decimal)
  DIP_TARGET_BALANCE_CHECK="$(echo "$DIP_TARGET_AMOUNT" | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$DIP_LISTING_BALANCE_CHECK" ]] &>/dev/null; then
    DIP_LISTING_BALANCE_CHECK="0"
  fi
  # if zero
  if [[ -z "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then
    DIP_TARGET_BALANCE_CHECK="0"
  fi

  ##############################################################################

  # buy order count
  DIP_BUY_ORDER_COUNT="$(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep "$LISTING_CURRENCY" 2>/dev/null | grep -c "buy" || true)"
  # sell order count
  DIP_SELL_ORDER_COUNT="$(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep "$LISTING_CURRENCY" 2>/dev/null | grep -c "sell" || true)"
  # total order check
  DIP_TOTAL_ORDER_CHECK="$(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -c "$LISTING_CURRENCY" 2>/dev/null || true)"

  # if zero
  if [[ -z "$DIP_BUY_ORDER_COUNT" ]] &>/dev/null; then
    DIP_BUY_ORDER_COUNT="0"
  fi
  # if zero
  if [[ -z "$DIP_SELL_ORDER_COUNT" ]] &>/dev/null; then
    DIP_SELL_ORDER_COUNT="0"
  fi

  # total orders
  DIP_TOTAL_ORDER_COUNT="$(echo "$DIP_BUY_ORDER_COUNT+$DIP_SELL_ORDER_COUNT" | bc 2>/dev/null)"

  # if zero
  if [[ -z "$DIP_TOTAL_ORDER_COUNT" ]] &>/dev/null; then
    DIP_TOTAL_ORDER_COUNT="0"
  fi

  ##############################################################################

  # percentage of buy
  DIP_BUY_PERCENTAGE="$(echo "100/$DIP_TOTAL_ORDER_COUNT*$DIP_BUY_ORDER_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  # percentage of sell
  DIP_SELL_PERCENTAGE="$(echo "100/$DIP_TOTAL_ORDER_COUNT*$DIP_SELL_ORDER_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_BUY_PERCENTAGE" ]] &>/dev/null; then
    DIP_BUY_PERCENTAGE="0"
  fi
  # if zero
  if [[ -z "$DIP_SELL_PERCENTAGE" ]] &>/dev/null; then
    DIP_SELL_PERCENTAGE="0"
  fi

  ##############################################################################

  # active check
  DIP_CHECK_ACTIVE="$(grep "$LISTING_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | grep -c "$REFERENCE_CURRENCY" || true)"
  # orders check
  DIP_CHECK_ORDERS="$(grep "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)"

  # if true active
  if [[ "$DIP_CHECK_ACTIVE" -gt "0" && "$DIP_CHECK_ORDERS" -gt "0" ]] &>/dev/null; then

    # if buy percentage greater than sell percentage
    if [[ "$DIP_BUY_PERCENTAGE" > "$DIP_SELL_PERCENTAGE" ]] &>/dev/null; then
      DIP_BS_STATUS="Buy: ${DIP_BUY_ORDER_COUNT:?} Sell: ${DIP_SELL_ORDER_COUNT:?}"

      # if sell percentage greater than buy percentage
    elif [[ "$DIP_SELL_PERCENTAGE" > "$DIP_BUY_PERCENTAGE" ]] &>/dev/null; then
      DIP_BS_STATUS="Sell: ${DIP_SELL_ORDER_COUNT:?} Buy: ${DIP_BUY_ORDER_COUNT:?}"

      # if sell percentage equals buy percentage
    elif [[ "$DIP_SELL_PERCENTAGE" == "$DIP_BUY_PERCENTAGE" ]] &>/dev/null; then
      DIP_BS_STATUS="Broker $DIP_BUY_ORDER_COUNT:$DIP_SELL_ORDER_COUNT"

      # if sell count and buy count equals zero
    elif [[ "$DIP_BUY_ORDER_COUNT" == "0" && "$DIP_SELL_ORDER_COUNT" == "0" ]] &>/dev/null; then
      DIP_BS_STATUS="Waiting $DIP_BUY_ORDER_COUNT:$DIP_SELL_ORDER_COUNT"
    fi

  else # no active, no orders
    DIP_BS_STATUS="Trading"
  fi

  # if zero
  if [[ -z "$DIP_BS_STATUS" ]] &>/dev/null; then
    DIP_BS_STATUS="null"
  fi

  ##############################################################################

  # dca status
  if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then
    DIP_DCA_STATUS="(DCA)"
  fi

  # status output (log)
  DIP_ACTIVE_CHECK_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $DIP_BS_STATUS $DIP_DCA_STATUS Dip: ${DIP_TARGET_DIP:?}% Spread: ${DIP_TARGET_SPREAD:?}% Age: $DIP_BOUGHT_AGE_OUTPUT"
  echo "$DIP_ACTIVE_CHECK_OUTPUT" | xargs >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################
  # selling block
  ##############################################################################

  # balance has selling power (available)
  if [[ "$DIP_LISTING_BALANCE_CHECK" -gt "0" ]] &>/dev/null; then
    # if total sum (sold) is less than target amount
    if [[ "$DIP_TOTAL_SOLD_SUM_CHECK" -lt "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then

      ##########################################################################

      # if balance (available) are greater or equal to leftover
      if [[ "$DIP_LISTING_BALANCE_CHECK" -ge "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then
        # sell target amount (available)
        LISTING_BALANCE="$DIP_TARGET_AMOUNT"
      fi

      ##########################################################################

      # if balance is less than leftover of target
      if [[ "$DIP_LISTING_BALANCE_CHECK" -lt "$DIP_LEFTOVER_SOLD_CHECK" ]] &>/dev/null; then
        # sell balance (available)
        LISTING_BALANCE="$LISTING_BALANCE"
        # if balance is greater than leftover of target
      else
        # sell leftover (available)
        LISTING_BALANCE="$DIP_LEFTOVER_SOLD"
      fi

      ##########################################################################

      # calculate percentage of order size
      DIP_LEFTOVER_SIZE=$(awk "BEGIN { result = 100 / $DIP_TARGET_AMOUNT * $LISTING_BALANCE; printf \"%.9f\", (result > 100 ? 100 : result) }")

      # if zero
      if [[ -z "$DIP_LEFTOVER_SIZE" ]] &>/dev/null; then
        DIP_LEFTOVER_SIZE="0"
      fi

      DIP_LEFTOVER_SIZE_OUTPUT="$DIP_LEFTOVER_SIZE"

      # if leftover size greater or equal to n
      if [[ "$(echo "$DIP_LEFTOVER_SIZE" | awk -F. '{ print $1 }')" -ge "99" ]] &>/dev/null; then
        DIP_LEFTOVER_SIZE="100.000000000"
        # dip leftover output
        DIP_LEFTOVER_SIZE_OUTPUT="100"
      fi

      # default leftover size limit (0.005000000%)
      DIP_LEFTOVER_SIZE_LIMIT="0.005000000"

      # if market fail at selling (null)
      if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null || true)" -gt "0" ]] &>/dev/null; then
        # increase leftover size limit to (1.000000000%)
        DIP_LEFTOVER_SIZE_LIMIT="1.000000000"
      fi

      # if leftover size is greater than leftover size limit
      if [[ "$(echo "$DIP_LEFTOVER_SIZE" | tr -d '.' | sed 's/^0*//')" -gt "$(echo "$DIP_LEFTOVER_SIZE_LIMIT" | tr -d '.' | sed 's/^0*//')" ]] &>/dev/null; then

        # disregard duplicates, empty lines
        echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold 2>/dev/null | awk '!a[$0]++' | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold

        # calculate percentage of order filled
        DIP_LEFTOVER_FILLED_AMOUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold 2>/dev/null | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%.9f\n", $1 }' | sed '/^$/d')"

        # if zero, equals zero
        if [[ -z "$DIP_LEFTOVER_FILLED_AMOUNT" || "$DIP_LEFTOVER_FILLED_AMOUNT" -eq "0" ]] &>/dev/null; then
          DIP_LEFTOVER_FILLED_AMOUNT="0"
        fi

        # calculate total filled
        DIP_LEFTOVER_FILLED=$(awk "BEGIN { result = 100 / $DIP_TARGET_AMOUNT * $DIP_LEFTOVER_FILLED_AMOUNT; printf \"%.9f\", (result > 100 ? 100 : result) }" 2>/dev/null | awk '{ printf "%.4f\n", $1 }')

        # if zero
        if [[ -z "$DIP_LEFTOVER_FILLED" ]] &>/dev/null; then
          DIP_LEFTOVER_FILLED="0"
        fi

        # if zero
        if [[ "$(echo "$DIP_LEFTOVER_FILLED" | awk -F. '{ print $1 }')" -ge "99" ]] &>/dev/null; then
          DIP_LEFTOVER_FILLED="100"
        fi

        # re calculate receive amount based on order size
        DIP_SELL_AMOUNT_REFERENCE="$(echo "$(echo "$DIP_LEFTOVER_SIZE/100" | bc -l 2>/dev/null)*$DIP_GET_AMOUNT_REFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
        # re calculate profit amount based on order size
        DIP_SELL_AMOUNT_PROFIT="$(echo "$(echo "$DIP_LEFTOVER_SIZE/100" | bc -l 2>/dev/null)*$DIP_GET_AMOUNT_PROFIT" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

        ########################################################################

        log_date

        ########################################################################
        ########################################################################

        # if southxchange order
        if [[ "$EXCHANGE_API" == "SXC" ]] &>/dev/null; then
          # setup limit sell order #############################################
          PLACE_ORDER="$(placeOrder_limit "sell" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$DIP_TARGET_ASK" "$LISTING_BALANCE" "false")"
          ######################################################################
        fi
        # if xeggex order
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # CreateOrder limit ##################################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "sell" "limit" "$LISTING_BALANCE" "$DIP_TARGET_ASK" "false")"
          ######################################################################
          sleep 1
        fi

        ########################################################################
        ########################################################################

        tx_id

        # track amount being sold
        echo "$LISTING_BALANCE" | awk '{ printf "%.9f\n", $1 }' | sed '/^$/d' >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold
        # selling output (log)
        DIP_SELL_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Selling $LISTING_BALANCE $LISTING_CURRENCY for $DIP_SELL_AMOUNT_REFERENCE $REFERENCE_CURRENCY"
        echo "$DIP_SELL_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
        # filled output (log)
        DIP_FILLED_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Selling ${DIP_LEFTOVER_SIZE_OUTPUT:?}% of the order. ${DIP_LEFTOVER_FILLED:?}% Filled."
        echo "$DIP_FILLED_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
        # profit output (log)
        DIP_PROFIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Profit: $DIP_SELL_AMOUNT_PROFIT $REFERENCE_CURRENCY -> ${DIP_GET_RATIO_PROFIT:?}%"
        echo "$DIP_PROFIT_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
      fi
    fi
  fi
fi

################################################################################

# if active file has zero orders
if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | sed '/^$/d' | wc -l)" -eq "0" ]] &>/dev/null; then
  ACTIVE_MARKET_PAIRS="N/A"
  DIP_ACTIVE_FILE_A_PRICE_MOVEMENT="0"
  DIP_ACTIVE_FILE_AVERAGE_AGE="N/A"
  DIP_ACTIVE_FILE_AVERAGE_DAYS="N/A"
  DIP_ACTIVE_FILE_AVERAGE_DIP="0"
  DIP_ACTIVE_FILE_AVERAGE_SPREAD="0"
  DIP_ACTIVE_FILE_COUNT="N/A"
  DIP_LATEST_ORDER_ID="N/A"
  DIP_LATEST_ORDER_LISTING="N/A"
  DIP_LATEST_ORDER_REFERENCE="N/A"
  DIP_LOW_ACTIVE_DIP="N/A"
  DIP_LOW_ACTIVE_PROFIT="N/A"
  DIP_LOW_DIP_AMOUNT="0"
  DIP_LOW_DIP="N/A"
  DIP_LOW_PROFIT_AMOUNT="0"
  DIP_LOW_PROFIT="N/A"
  DIP_OLDEST_ORDER_ID="N/A"
  DIP_OLDEST_ORDER_LISTING="N/A"
  DIP_OLDEST_ORDER_REFERENCE="N/A"
  DIP_ORDER_BUY_COUNT="N/A"
  DIP_ORDER_PERCENTAGE_BUY="0"
  DIP_ORDER_PERCENTAGE_SELL="0"
  DIP_ORDER_SELL_COUNT="N/A"
  DIP_SPECIFIC_PROFIT="N/A"
  DIP_TOP_ACTIVE_DIP="N/A"
  DIP_TOP_ACTIVE_PRICE_MOVEMENT="N/A"
  DIP_TOP_AMOUNT_AMOUNT="N/A"
  DIP_TOP_AMOUNT_LISTING="N/A"
  DIP_TOP_AMOUNT_MARKET="N/A"
  DIP_TOP_DIP_AMOUNT="0"
  DIP_TOP_DIP="N/A"
  DIP_TOP_PROFIT_AMOUNT="0"
  DIP_TOP_PROFIT="N/A"
  DIP_TOP_VOLUME_AMOUNT="N/A"
  DIP_TOP_VOLUME_LISTING="N/A"
  DIP_TOP_VOLUME_MARKET="N/A"
  PRICE_MOVEMENT_TOP_MARKET_AMOUNT="0"
  PRICE_MOVEMENT_TOP_MARKET="N/A"
fi

################################################################################
# sold order
################################################################################

# if no orders exist
if [[ "$(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -c "$LISTING_CURRENCY" || true)" -eq "0" ]] &>/dev/null; then

  # total sum (confirmed sell)
  DIP_TOTAL_SOLD_SUM="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold 2>/dev/null | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%.9f\n", $1 }' | sed '/^$/d')"

  # if zero, equals zero
  if [[ -z "$DIP_TOTAL_SOLD_SUM" || "$DIP_TOTAL_SOLD_SUM" -eq "0" ]] &>/dev/null; then
    DIP_TOTAL_SOLD_SUM="0"
  fi

  # total sum (confirmed sell, without decimal)
  DIP_TOTAL_SOLD_SUM="$(echo "$DIP_TOTAL_SOLD_SUM" | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"
  # include fees (0.004% taker, maker fees)
  DIP_TARGET_BALANCE_FEES="$(echo "0.004*$DIP_TARGET_AMOUNT" | bc -l 2>/dev/null)"
  # target amount with fees (without decimal)
  DIP_TARGET_BALANCE_CHECK="$(echo "$DIP_TARGET_AMOUNT-$DIP_TARGET_BALANCE_FEES" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"

  ##############################################################################
  # partially sold order
  ##############################################################################

  # if no orders, has sold data, still active
  if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold 2>/dev/null | sed '/^$/d' | wc -l)" -gt "0" ]] &>/dev/null; then
    # if age older than n
    if [[ "$DIP_SOLD_FILE_AGE_SECONDS" -gt "3600" ]] &>/dev/null; then
      # include trigger
      DIP_TARGET_BALANCE_FEES="$(echo "0.03*$DIP_TARGET_AMOUNT" | bc -l 2>/dev/null)"
      # target amount with trigger (without decimal)
      DIP_TARGET_BALANCE_CHECK="$(echo "$DIP_TARGET_AMOUNT-$DIP_TARGET_BALANCE_FEES" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"
    fi
  fi

  ##############################################################################
  # fully sold order
  ##############################################################################

  # if total sum greater or equal than target
  if [[ "$DIP_TOTAL_SOLD_SUM_CHECK" -ge "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then

    log_date

    # remove old (sold) order
    echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY")" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active

    # if dca
    if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then

      # use last profit value
      DIP_GET_RATIO_PROFIT="$(grep "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought | tail -1 | awk '{ print $NF }' | tr -d '%')*"

      # if zero
      if [[ -z "$DIP_GET_RATIO_PROFIT" ]] &>/dev/null; then
        DIP_GET_RATIO_PROFIT="DCA"
      fi
    fi

    # sell output (trade history)
    DIP_LIMIT_POSITION="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : sell :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $LISTING_BALANCE $REFERENCE_BALANCE ${DIP_GET_RATIO_PROFIT:?}% $DIP_BOUGHT_FILE_AGE"
    echo "$DIP_LIMIT_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
    # cleanup output (log)
