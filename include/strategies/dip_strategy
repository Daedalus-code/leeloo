################################################################################
# open positions
################################################################################

DIP_OUTPUT_FILE="${SYS_DIR:?}/robot/pool"

# read the active list from the file
DIP_ACTIVE_LIST=$(cat "${SYS_DIR:?}/robot/${BASENAME_STRATEGY}.active" 2>/dev/null)

# function to extract values from the active list
extract_values() {
  CURRENCY=$1
  FIELD=$2
  VALUE=$(grep "$CURRENCY" <<<"$DIP_ACTIVE_LIST" | awk -F "| $FIELD: " '{print $2}' | awk '{print $1}')
  echo "$VALUE"
}

# function to calculate the age of the sold file
calculate_sold_file_age() {
  CURRENCY=$1
  FILE_PATH_BOUGHT="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.bought"
  FILE_PATH_SOLD="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.sold"
  if [[ -f "$FILE_PATH_BOUGHT" ]] &>/dev/null; then
    FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.bought"
  fi
  if [[ -f "$FILE_PATH_SOLD" ]] &>/dev/null; then
    FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.sold"
  fi
  if [[ -f "$FILE_PATH" ]] &>/dev/null; then
    LAST_EDIT=$(stat -c '%Y' "$FILE_PATH")
    AGE_SECONDS=$(($(date +%s) - $LAST_EDIT))
    if [[ -z "$AGE_SECONDS" ]] &>/dev/null; then
      AGE_SECONDS="0"
    fi
    printf '%dh:%dm:%ds\n' $((AGE_SECONDS / 3600)) $((AGE_SECONDS % 3600 / 60)) $((AGE_SECONDS % 60))
  else
    echo "N/A"
  fi
}

# values for each currency
while IFS= read -r line; do
  # currency
  CURRENCY=$(echo "$line" | awk -F ": " '{print $1}')
  # amount to buy (listing)
  AMOUNT=$(extract_values "$CURRENCY" "Amount")
  # order bid (reference)
  COST_BID=$(extract_values "$CURRENCY" "Bid")
  # order ask (reference)
  COST_ASK=$(extract_values "$CURRENCY" "Ask")
  # amount for buy (reference)
  COST_BUY=$(echo "$AMOUNT*$COST_BID" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')
  # amount to get (reference)
  RESULT_GET="$(echo "$AMOUNT*$COST_ASK" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # amount to profit (reference)
  RESULT_DIFF="$(echo "$RESULT_GET-$COST_BUY" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # amount to profit (reference percentage)
  RESULT_PROFIT="$(echo "100/$RESULT_GET*$RESULT_DIFF" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
  # order age
  AGE=$(calculate_sold_file_age "$CURRENCY")

  # result output (positions)
  echo "$STRATEGY_TYPE $CURRENCY $AMOUNT $COST_BUY ${RESULT_PROFIT:?}% $AGE" >>"$DIP_OUTPUT_FILE"
done < <(grep -oE '^[^:]*' <<<"$DIP_ACTIVE_LIST")

# format output
column -t <"$DIP_OUTPUT_FILE" >"${DIP_OUTPUT_FILE}.tmp"
mv "${DIP_OUTPUT_FILE}.tmp" "$DIP_OUTPUT_FILE"

