  DIP_PRICES_DIP_FILE="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices 2>/dev/null | sed '/^$/d' | wc -l)"
  # n% of total lines
  DIP_PRICES_DIP_LIMIT="$(echo "0.369*$DIP_PRICES_DIP_FILE" | bc 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  # if prices.dip files is less than n lines
  if [[ "$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices.dip 2>/dev/null | sed '/^$/d' | wc -l)" -lt "$DIP_PRICES_DIP_LIMIT" ]] &>/dev/null; then
    # reset search
    truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".search &>/dev/null
  fi
fi

