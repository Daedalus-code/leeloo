# latest and oldest dip order data
function dip_order_data {

  # if data
  if [[ -n "$DIP_MARKETS" ]] &>/dev/null; then
    DIP_MARKETS_ORDER_CHECK="$DIP_MARKETS"
  else # default
    DIP_MARKETS_ORDER_CHECK="[A-Z0-9]+ [A-Z]+|[A-Z]+ [0-9]+|[0-9]+ [A-Z]+|[0-9]+ [0-9]+"
  fi

  # order data, sort by date
  DIP_LATEST_ORDER_DATA="$(echo "$CAT_ORDERS_FILE" | egrep -w "$DIP_MARKETS_ORDER_CHECK" | sort -n -k 8 | tail -1)"
  DIP_OLDEST_ORDER_DATA="$(echo "$CAT_ORDERS_FILE" | egrep -w "$DIP_MARKETS_ORDER_CHECK" | sort -n -k 8 | head -1)"

  # order id
  DIP_LATEST_ORDER_ID="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $1 }' | tr -d ':')"
  DIP_OLDEST_ORDER_ID="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $1 }' | tr -d ':')"
  # order type
  DIP_LATEST_ORDER_TYPE="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $2 }')"
  DIP_OLDEST_ORDER_TYPE="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $2 }')"
  # order listing
  DIP_LATEST_ORDER_LISTING="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $6 }')"
  DIP_OLDEST_ORDER_LISTING="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $6 }')"
  # order reference
  DIP_LATEST_ORDER_REFERENCE="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $7 }')"
  DIP_OLDEST_ORDER_REFERENCE="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $7 }')"

  # if zeros
  if [[ -z "$DIP_LATEST_ORDER_ID" ]] &>/dev/null; then
    DIP_LATEST_ORDER_ID="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_ID" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_ID="0"
  fi
  if [[ -z "$DIP_LATEST_ORDER_TYPE" ]] &>/dev/null; then
    DIP_LATEST_ORDER_TYPE="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_TYPE" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_TYPE="0"
  fi
  if [[ -z "$DIP_LATEST_ORDER_LISTING" ]] &>/dev/null; then
    DIP_LATEST_ORDER_LISTING="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_LISTING" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_LISTING="0"
  fi
  if [[ -z "$DIP_LATEST_ORDER_REFERENCE" ]] &>/dev/null; then
    DIP_LATEST_ORDER_REFERENCE="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_REFERENCE" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_REFERENCE="0"
  fi
}

