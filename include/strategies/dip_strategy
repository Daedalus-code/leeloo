# broken buy age check x n
DIP_MAX_BUY_AGE_SECONDS_BROKEN="$(echo "$DIP_MAX_BUY_AGE_SECONDS*1.369" | bc 2>/dev/null | awk -F. '{ print $1 }')"
# broken sell age check x n
DIP_MAX_SELL_AGE_SECONDS_BROKEN="$(echo "$DIP_MAX_SELL_AGE_SECONDS*1.369" | bc 2>/dev/null | awk -F. '{ print $1 }')"

