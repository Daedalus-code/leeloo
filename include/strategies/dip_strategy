################################################################################
# search market for a target
################################################################################

# prices file path
DIP_PRICES_FILE="${LOG_DIR:?}/leeloo/$EXCHANGE_DIR_NAME/prices.$DIP_MARKETS"

################################################################################

# variables for potential buy recommendation (default)
POTENTIAL_BUY_SYMBOL=""
POTENTIAL_BUY_BID="0"
POTENTIAL_BUY_ASK="0"

################################################################################

# market file age
DIP_MARKET_FILE_AGE="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

# if zero
if [[ -z "$DIP_MARKET_FILE_AGE" ]] &>/dev/null; then
  DIP_MARKET_FILE_AGE="0"
fi

################################################################################

# total active count
DIP_ACTIVE_FILE_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | awk '{ print $1 }')"

# total order count
if [[ -n "$DIP_MARKETS" ]] &>/dev/null; then
  DIP_ORDERS_FILE_COUNT="$(grep -wc "$DIP_MARKETS" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null || true)"
else
  DIP_ORDERS_FILE_COUNT="$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | awk '{ print $1 }')"
fi

################################################################################

# file age greater than max age
if [[ "$DIP_MARKET_FILE_AGE" -gt "$DIP_MAX_AGE" ]] &>/dev/null; then

  # reset market file
  if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | sed '/^$/d' | wc -l)" -gt "0" ]] &>/dev/null; then
    truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market &>/dev/null
  fi

  ##############################################################################
  ##############################################################################

  # read the file line by line
  while IFS= read -r line; do

    # extract relevant information from the line
    SYMBOL=$(echo "$line" | awk '{print $1}')
    BID=$(echo "$line" | awk '{print $2}')
    ASK=$(echo "$line" | awk '{print $3}')
    LAST=$(echo "$line" | awk '{print $4}')
    DIP=$(echo "$line" | awk '{print $5}' | sed 's/%//')
    VOLUME=$(echo "$line" | awk '{print $6}' | sed 's/%//')

    # if zero
    if [[ -z "$DIP_MAX_DIP" ]] &>/dev/null; then
      DIP_MAX_DIP="50"
    fi
    # if zero
    if [[ -z "$DIP_MIN_SPREAD" ]] &>/dev/null; then
      DIP_MIN_SPREAD="10"
    fi
    # if zero
    if [[ -z "$DIP_MAX_SPREAD" ]] &>/dev/null; then
      DIP_MAX_SPREAD="50"
    fi

    # if the symbol matches the specified market and if the dip, spread, and volume meet the criteria
    if [[ "$SYMBOL" == *"$DIP_MARKETS"* ]] &&
      # if dip minimum limit is met
      (($(echo "$DIP < -$DIP_MIN_DIP" | bc -l 2>/dev/null))) &&
      # if dip maximum limit is met
      (($(echo "$DIP > -$DIP_MAX_DIP" | bc -l 2>/dev/null))) &&
      # if volume minimum limit is met
      (($(echo "$VOLUME > $DIP_MIN_VOLUME" | bc -l 2>/dev/null))); then

      # check if bid is neither "0" nor "0.000000000"
      if [[ $BID != "0" ]] && [[ $BID != "0.000000000" ]] &>/dev/null; then

        # spread
        SPREAD=$(awk -v ask="$ASK" -v bid="$BID" 'BEGIN { printf "%.2f\n", ((ask - bid) / bid * 100) }')

        # if spread minimum limit is met
        if (($(echo "$SPREAD > $DIP_MIN_SPREAD" | bc -l 2>/dev/null))); then
          # if spread maximum limit is met
          if (($(echo "$SPREAD < $DIP_MAX_SPREAD" | bc -l 2>/dev/null))); then

            # price movement
            PRICE_MOVEMENT=$(awk -v last="$LAST" -v bid="$BID" 'BEGIN { printf "%.2f\n", ((last - bid) / bid * 100) }')
            # volume (configuration)
            VOLUME="$(echo "$VOLUME" | awk '{ printf "%.2f\n", $1 }')"
            # price movement check (without decimal)
            PRICE_MOVEMENT_CHECK="$(echo "$PRICE_MOVEMENT" | tr -d '.' | sed 's/^0*//')"

            # create market file (everyone)
            echo "$SYMBOL | Bid: $BID | Ask: $ASK | Dip: $DIP% | Spread: $SPREAD% | Price Movement: $PRICE_MOVEMENT% | Volume: $VOLUME" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market

            # if zero
            if [[ -z "$DIP_MIN_MOVEMENT" ]] &>/dev/null; then
              # use default
              DIP_MIN_MOVEMENT="0"
            fi

            # if price movement greater than minimum price movement
            if (($(echo "$PRICE_MOVEMENT_CHECK > $DIP_MIN_MOVEMENT" | bc -l 2>/dev/null))); then
              # if the symbol meets the potential buy criteria, ruled by configuration
              if (($(echo "$BID < $POTENTIAL_BUY_BID" | bc -l 2>/dev/null))) || [[ -z "$POTENTIAL_BUY_SYMBOL" ]] &>/dev/null; then

                # potential symbol, bid, ask, last
                POTENTIAL_BUY_SYMBOL="$SYMBOL"
                POTENTIAL_BUY_BID="$BID"
                POTENTIAL_BUY_ASK="$ASK"
                POTENTIAL_BUY_LAST="$LAST"

                # target output
                POTENTIAL_TARGET_FOUND="$POTENTIAL_BUY_SYMBOL | Bid: $POTENTIAL_BUY_BID | Ask: $POTENTIAL_BUY_ASK | Last: $POTENTIAL_BUY_LAST | Dip: $DIP% | Spread: $SPREAD% | Price Movement: $PRICE_MOVEMENT% | Volume: $VOLUME"

                ################################################################

                # potential rsi target (listing)
                POTENTIAL_RSI_LISTING="$(echo "$POTENTIAL_TARGET_FOUND" | awk '{ print $1 }' | tr -d ':' | awk -F/ '{ print $1 }')"
                # potential rsi target (reference)
                POTENTIAL_RSI_REFERENCE="$(echo "$POTENTIAL_TARGET_FOUND" | awk '{ print $1 }' | tr -d ':' | awk -F/ '{ print $2 }')"

                # if xeggex rsi
                if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
                  # potential rsi data (using rsi xeggex) ######################
                  echo "$(get_rsi_xgx "$POTENTIAL_RSI_LISTING" "$POTENTIAL_RSI_REFERENCE")" >"${LOG_DIR:?}"/leeloo/indicators/get_rsi_xgx
                  ##############################################################

                  # potential rsi data
                  POTENTIAL_RSI_DATA="$(cat "${LOG_DIR:?}"/leeloo/indicators/get_rsi_xgx 2>/dev/null)"
                  # potential rsi status
                  POTENTIAL_RSI_STATUS="$(echo "$POTENTIAL_RSI_DATA" | awk '{ print $1 }')"
                  # potential rsi value
                  POTENTIAL_RSI_VALUE="$(echo "$POTENTIAL_RSI_DATA" | awk '{ print $NF }' | awk '{ printf "%.2f\n", $1 }')"
                  # potential rsi value check
                  POTENTIAL_RSI_VALUE_CHECK="$(echo "$POTENTIAL_RSI_VALUE" | awk -F. '{ print $1 }')"

                  ##############################################################

                  # if target overbought
                  if [[ "$POTENTIAL_RSI_STATUS" == "Overbought" ]] &>/dev/null; then
                    POTENTIAL_RSI_OUTPUT="Skip $POTENTIAL_RSI_LISTING! RSI: $POTENTIAL_RSI_VALUE ($POTENTIAL_RSI_STATUS) Volume: $VOLUME"
                  fi
                  # if target neutral
                  if [[ "$POTENTIAL_RSI_STATUS" == "Neutral" || ! "$POTENTIAL_RSI_VALUE" -lt "$DIP_RSI_LIMIT" ]] &>/dev/null; then
                    POTENTIAL_RSI_OUTPUT="Skip $POTENTIAL_RSI_LISTING! RSI: $POTENTIAL_RSI_VALUE ($POTENTIAL_RSI_STATUS) Volume: $VOLUME"
                  fi

                  ##############################################################

                  # default
                  POTENTIAL_RSI="$POTENTIAL_RSI_STATUS"

                  # if zero
                  if [[ -z "$DIP_RSI_LIMIT" ]] &>/dev/null; then
                    # default
                    DIP_RSI_LIMIT="34"
                  fi

                  ##############################################################
                  ##############################################################

                  # if target is new listing, has potential, greater than n & less than n, equals zero
                  if [[ "$POTENTIAL_RSI_STATUS" == "Oversold_zwcd" || "$POTENTIAL_RSI_VALUE_CHECK" -gt "30" && "$POTENTIAL_RSI_VALUE_CHECK" -lt "$DIP_RSI_LIMIT" ]] &>/dev/null; then
                    # less than n
                    POTENTIAL_RSI_STATUS="Oversold"
                    POTENTIAL_RSI="Potential"
                  fi

                  ##############################################################
                  ##############################################################

                  # if target oversold
                  if [[ "$POTENTIAL_RSI_STATUS" == "Oversold" || "$POTENTIAL_RSI_VALUE" -lt "$DIP_RSI_LIMIT" ]] &>/dev/null; then
                    POTENTIAL_RSI_OUTPUT="Select $POTENTIAL_RSI_LISTING! RSI: $POTENTIAL_RSI_VALUE ($POTENTIAL_RSI) Volume: $VOLUME"
                    # create/update target file
                    echo "$POTENTIAL_TARGET_FOUND" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
                  fi

                  ##############################################################
                  ##############################################################

                  # target status output (log)
                  POTENTIAL_RSI_STRENGTH_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $POTENTIAL_BUY_SYMBOL :: $POTENTIAL_RSI_OUTPUT"

                  # if extra logs are set
                  if [[ "$DIP_EXTRA_LOGS" == "true" ]] &>/dev/null; then
                    echo "$POTENTIAL_RSI_STRENGTH_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
                  else
                    echo "$POTENTIAL_RSI_STRENGTH_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".ssr 2>>"${LOG_ERROR:?}"
                  fi
                fi
              fi
            fi
          fi
        fi
      fi
    fi
  done <"$DIP_PRICES_FILE" 2>/dev/null

  ##############################################################################
  ##############################################################################

  # if target is new
  if [[ -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target.new ]] &>/dev/null; then
    # potential buy symbol
    POTENTIAL_BUY_SYMBOL="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target.new 2>/dev/null | awk '{ print $1 }' | tr -d ':')"
    # create/update target file
    mv "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target.new "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
  fi

  ##############################################################################
  ##############################################################################

  # create market.list
  cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market.list 2>/dev/null

  # keep n lines, remove duplicates, remove empty lines, sort
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market.list 2>/dev/null | awk '!a[$1]++' | sed '/^$/d' | sort | column -t)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market.list

  ##############################################################################
  # setup buy order (limit) using target file
  ##############################################################################

  # target data
  TARGET_ACTIVE="TARGET"
  target_data
  target_profit
  decimal_market
  bought_sold_age
  remove_ghost_orders

  ##############################################################################

  # if listing, reference dont exist in orders
  if [[ "$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)" -eq "0" ]] &>/dev/null; then
    # remove old dca order
    remove_old_dca
  fi

  ##############################################################################

  # if no profit
  if [[ "$DIP_GET_RATIO_PROFIT_CHECK" -eq "0" ]] &>/dev/null; then
    # reset target file
    truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
    # target variable empty
    POTENTIAL_BUY_SYMBOL="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null)"
  fi

  ##############################################################################
  # potential buy target
  ##############################################################################

  # target found
  if [[ -n "$POTENTIAL_BUY_SYMBOL" ]] &>/dev/null; then
    # update target
    if [[ "$(egrep -c "[0-9]+" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target || true)" -gt "0" ]] &>/dev/null; then
      # order status
      if [[ "$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)" -gt "0" ]] &>/dev/null; then
        # if old order
        if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active || true)" -gt "0" ]] &>/dev/null; then
          # track old amount (listing)
          DIP_BUY_AMOUNT_LISTING="$(grep "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($26 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
        fi
      fi

      ##########################################################################

      # if zero
      if [[ -z "$DIP_DCA" ]] &>/dev/null; then
        # default
        DIP_DCA="0"
      fi

      # if dca enabled
      if [[ "$DIP_DCA" -gt "0" ]] &>/dev/null; then
        # if order already been checked
        if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca || true)" -eq "0" ]] &>/dev/null; then
          # if order already has balance (ruled by balance + decimal market)
          if [[ "$(echo "$LISTING_BALANCE" | tr -d '.' | sed 's/^0*//')" -gt "1" ]] &>/dev/null; then

            # active listing dca count (market list)
            DIP_ACTIVE_LISTING_DCA="$(cat "${SYS_DIR:?}"/robot/*.market.list 2>/dev/null | grep -wc "$LISTING_CURRENCY" 2>/dev/null || true)"

            # if listing DCA already checked, based on log rotation
            if [[ "$(tail -100 "${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null | grep -w "$LISTING_CURRENCY" | grep -c "Has balance!" || true)" -eq "0" ]] &>/dev/null; then
              # if listing is single inside active
              if [[ "$DIP_ACTIVE_LISTING_DCA" -eq "1" ]] &>/dev/null; then

                # ruled by configuration
                DIP_DCA_RAW="$DIP_DCA"
                # calculate dca value
                DIP_DCA_NUM="$(echo "$DIP_DCA/100" | bc -l 2>/dev/null)"
                # include old balance, ruled by configuration (dollar cost average)
                DIP_BUY_AMOUNT_LISTING_DCA="$(echo "$DIP_DCA_NUM*$LISTING_BALANCE" | bc -l 2>/dev/null | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"

                log_date

                # order count (buy)
                DIP_ORDER_BUY="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -w "$LISTING_CURRENCY" | grep -c "buy" || true)"
                # order count (sell)
                DIP_ORDER_SELL="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -w "$LISTING_CURRENCY" | grep -c "sell" || true)"

                # if zero
                if [[ -z "$DIP_ORDER_BUY" ]] &>/dev/null; then
                  DIP_ORDER_BUY="0"
                fi

                # if zero
                if [[ -z "$DIP_ORDER_SELL" ]] &>/dev/null; then
                  DIP_ORDER_SELL="0"
                fi

                # log dca balance output
                DIP_TARGET_DCA_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: DCA: $LISTING_CURRENCY Has balance! $LISTING_BALANCE $LISTING_CURRENCY (${DIP_ORDER_BUY:?}b/${DIP_ORDER_SELL:?}s)"
                echo "$DIP_TARGET_DCA_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

                # log dca data output
                DIP_TARGET_DCA_I_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: DCA: +Target amount ${DIP_DCA_RAW:?}% -> +$DIP_BUY_AMOUNT_LISTING_DCA $LISTING_CURRENCY"
                echo "$DIP_TARGET_DCA_I_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

                # reset order (sell orders)
                DIP_DCA_ORDER_ID="$(grep "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep "$REFERENCE_CURRENCY" | grep "sell" | awk '{ print $1 }' | tr -d ':' | head -1)"
                # cancel order
                cancelOrder "$DIP_DCA_ORDER_ID" 2>>"${LOG_ERROR:?}"

                # reset sold file (reset data, age)
                truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".sold &>/dev/null
                # reset sell_id file (reset data)
                truncate -s 0 "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".sell_id &>/dev/null
                # reset selling file (reset data)
                truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".selling &>/dev/null

                # remove old dca order
                remove_old_dca

                ################################################################
                ################################################################

                # create/update dca list
                echo "$LISTING_CURRENCY/$REFERENCE_CURRENCY Deposited: $LISTING_DEPOSITED_BALANCE $LISTING_CURRENCY DCA: ${DIP_DCA_RAW:?}% Extra: +$DIP_BUY_AMOUNT_LISTING_DCA $LISTING_CURRENCY $(date | xargs)" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca

                ################################################################
                ################################################################

              else

                # log potential dca data output
                DIP_TARGET_DCA_NO_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: DCA Potential: $LISTING_BALANCE $LISTING_CURRENCY on $DIP_ACTIVE_LISTING_DCA active markets."
                echo "$DIP_TARGET_DCA_NO_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
                # if no_dca market data
                if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca || true)" -gt "0" ]] &>/dev/null; then
                  # reset no_dca market
                  echo "$(grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca 2>/dev/null)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca
                fi
              fi
            fi
          fi
        else
          # if zero
          if [[ -z "$LISTING_DEPOSITED_BALANCE" ]] &>/dev/null; then
            LISTING_DEPOSITED_BALANCE="0.000000000"
          fi
          # order has no balance (no_dca)
          echo "$LISTING_CURRENCY/$REFERENCE_CURRENCY Deposited: $LISTING_DEPOSITED_BALANCE $LISTING_CURRENCY Available: $LISTING_BALANCE $LISTING_CURRENCY NO DCA Available" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca
          # format output, remove duplicates
          echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca 2>/dev/null | column -t | awk '!a[$1]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca
        fi
      fi

      ##########################################################################

      # if active order already exist
      if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active || true)" -gt "0" ]] &>/dev/null; then
        # remove old (active) order
        echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY")" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active
      fi

      ##########################################################################

      # update active file and add amount(+balance) to buy & sell at end
      echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null) | Amount: $DIP_BUY_AMOUNT_LISTING $LISTING_CURRENCY" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null

      ##########################################################################

      # old order id (buy)
      DIP_ORDER_ID_BUY="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -w "$LISTING_CURRENCY" | grep "buy" | awk '{ print $1 }' | tr -d ':' | head -1)"
      # last order profit
      DIP_LAST_ORDER_PROFIT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".bought 2>/dev/null | tail -1 | awk '{ print $NF }' | tr -d '%.' | sed 's/^0*//')"

      # if zero
      if [[ -z "$DIP_LAST_ORDER_PROFIT" ]] &>/dev/null; then
        DIP_LAST_ORDER_PROFIT="0"
      fi

      # if new ratio is the same, skip
      if [[ ! "$DIP_GET_RATIO_PROFIT_CHECK" -eq "$DIP_LAST_ORDER_PROFIT" ]] &>/dev/null; then
        # order id found
        if [[ -n "$DIP_ORDER_ID_BUY" ]] &>/dev/null; then

          ######################################################################
          ######################################################################

          # cancel old order (buy)
          cancelOrder "$DIP_ORDER_ID_BUY" 2>>"${LOG_ERROR:?}"

          ######################################################################

          # old order id (sell)
          DIP_ORDER_ID_SELL="$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -w "$REFERENCE_CURRENCY" | grep "sell" | awk '{ print $1 }' | tr -d ':')"

          # order id found
          if [[ -n "$DIP_ORDER_ID_SELL" ]] &>/dev/null; then
            # use a while loop to read each line of the string into the variable order_id
            echo "$DIP_ORDER_ID_SELL" | while IFS= read -r ORDER_ID; do
              # cancel old order (sell)
              cancelOrder "$ORDER_ID" 2>>"${LOG_ERROR:?}"
            done
          fi

          ######################################################################
          ######################################################################

          sleep 1

          # remove old order
          echo "$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -v "$DIP_ORDER_ID_BUY")" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders

          log_date

          # log target update output (buy)
          DIP_UPDATE_ORDER_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Updating (Buy) order: $DIP_ORDER_ID_BUY Age: $DIP_BOUGHT_AGE_OUTPUT"
          echo "$DIP_UPDATE_ORDER_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

          # order id found
          if [[ -n "$DIP_ORDER_ID_SELL" ]] &>/dev/null; then
            # use a while loop to read each line of the string into the variable order_id
            echo "$DIP_ORDER_ID_SELL" | while IFS= read -r ORDER_ID; do
              # log target update output (sell)
              DIP_UPDATE_ORDER_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Updating (Sell) order: $DIP_ORDER_ID_SELL Age: $DIP_BOUGHT_AGE_OUTPUT"
              echo "$DIP_UPDATE_ORDER_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            done
          fi
        fi
      fi
    fi

    ############################################################################

    # remove active duplicates (markets), empty lines, lines less than n
    echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | awk '!a[$1]++' | sed '/^$/d' | sed -r '/^.{,69}$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active

    # market count
    POTENTIAL_MARKET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market | awk '{ print $1 }')"

    ############################################################################

    # total market spread
    POTENTIAL_MARKET_TOTAL_SPREAD="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | awk '{ print $13 }' | awk '{ SUM += $1} END { print SUM }')"
    # average market spread
    POTENTIAL_MARKET_AVERAGE_SPREAD="$(echo "$POTENTIAL_MARKET_TOTAL_SPREAD/$POTENTIAL_MARKET_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

    # if zero
    if [[ -z "$POTENTIAL_MARKET_AVERAGE_SPREAD" ]] &>/dev/null; then
      POTENTIAL_MARKET_AVERAGE_SPREAD="0"
    fi

    ############################################################################

    # total price movement
    POTENTIAL_MARKET_TOTAL_MOVEMENT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | awk '{ print $17 }' | awk '{ SUM += $1} END { print SUM }')"
    # average price movement
    POTENTIAL_MARKET_AVERAGE_MOVEMENT="$(echo "$POTENTIAL_MARKET_TOTAL_MOVEMENT/$POTENTIAL_MARKET_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

    # if zero
    if [[ -z "$POTENTIAL_MARKET_AVERAGE_MOVEMENT" ]] &>/dev/null; then
      POTENTIAL_MARKET_AVERAGE_MOVEMENT="0"
    fi

    ############################################################################

    # total price dip
    POTENTIAL_MARKET_TOTAL_DIP="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | awk '{ print $10 }' | awk '{ SUM += $1} END { print SUM }')"
    # average dip
    POTENTIAL_MARKET_AVERAGE_DIP="$(echo "$POTENTIAL_MARKET_TOTAL_DIP/$POTENTIAL_MARKET_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

    # if zero
    if [[ -z "$POTENTIAL_MARKET_AVERAGE_DIP" ]] &>/dev/null; then
      POTENTIAL_MARKET_AVERAGE_DIP="0"
    fi

    ############################################################################

    # log target output
    DIP_MARKET_FOUND_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : All/$REFERENCE_CURRENCY :: Found: $POTENTIAL_MARKET_COUNT Dip: $POTENTIAL_MARKET_AVERAGE_DIP Spread: ${POTENTIAL_MARKET_AVERAGE_SPREAD:?}% Price Movement: ${POTENTIAL_MARKET_AVERAGE_MOVEMENT:?}%"
    echo "$DIP_MARKET_FOUND_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

    ############################################################################

    target_order_status

    # amount of order filled (sold)
    DIP_LEFTOVER_FILLED_AMOUNT="$ORDER_SOLD_QUANTITY"
    # target amount (bought)
    DIP_TARGET_AMOUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".bought 2>/dev/null | tail -1 | awk '{ print $4 }' | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"

    # if zero
    if [[ -z "$DIP_LEFTOVER_FILLED_AMOUNT" ]] &>/dev/null; then
      DIP_LEFTOVER_FILLED_AMOUNT="0"
    fi

    # calculate leftover filled
    DIP_LEFTOVER_FILLED=$(awk "BEGIN { result = 100 / $DIP_TARGET_AMOUNT * $DIP_LEFTOVER_FILLED_AMOUNT; printf \"%.9f\", (result > 100 ? 100 : result) }" 2>/dev/null | awk '{ printf "%.4f\n", $1 }')

    # if zero
    if [[ -z "$DIP_LEFTOVER_FILLED" || "$DIP_LEFTOVER_FILLED" == "0.0000" || "$(echo "$DIP_LEFTOVER_FILLED" | awk -F. '{ print $1 }')" -eq "0" ]] &>/dev/null; then
      DIP_LEFTOVER_FILLED="0"
    fi

    # if leftover filled greater or equal to n
    if [[ "$(echo "$DIP_LEFTOVER_FILLED" | awk -F. '{ print $1 }')" -gt "99" ]] &>/dev/null; then
      DIP_LEFTOVER_FILLED="100"
    fi

    ############################################################################

    # active target status
    if [[ "$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)" -gt "0" ]] &>/dev/null; then

      log_date

      # buy order count
      DIP_BUY_ORDER_COUNT="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -w "$LISTING_CURRENCY" 2>/dev/null | grep -c "buy" || true)"
      # sell order count
      DIP_SELL_ORDER_COUNT="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -w "$LISTING_CURRENCY" 2>/dev/null | grep -c "sell" || true)"

      # log target output
      DIP_MARKET_FOUND_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Active Target: $DIP_BOUGHT_AGE_OUTPUT F: ${DIP_LEFTOVER_FILLED:?}% D: $DIP_TARGET_DIP S: $DIP_TARGET_SPREAD PM: $DIP_TARGET_PRICE_MOVEMENT B/S: $DIP_BUY_ORDER_COUNT/$DIP_SELL_ORDER_COUNT"
      echo "$DIP_MARKET_FOUND_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    fi

    ############################################################################
    # setup buy order (limit) using target file
    ############################################################################

    # max active orders, set by configuration
    if [[ "$DIP_ORDERS_FILE_COUNT" -gt "$DIP_MAX_ORDERS" ]] &>/dev/null; then

      dip_order_data
      log_date

      # log max orders output
      DIP_MAX_ORDERS_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : All/$REFERENCE_CURRENCY :: Reached max open orders! $DIP_ORDERS_FILE_COUNT/$DIP_MAX_ORDERS"
      echo "$DIP_MAX_ORDERS_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
      # log removing output
      DIP_MAX_ORDERS_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : All/$REFERENCE_CURRENCY :: Removing old order! ${DIP_OLDEST_ORDER_LISTING:?}/${DIP_OLDEST_ORDER_REFERENCE:?} $DIP_OLDEST_ORDER_ID $DIP_OLDEST_ORDER_SPREAD"
      echo "$DIP_MAX_ORDERS_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

      # order id found
      if [[ -n "$DIP_OLDEST_ORDER_ID" ]] &>/dev/null; then
        # cancel old order (buy/sell)
        cancelOrder "$DIP_OLDEST_ORDER_ID" 2>>"${LOG_ERROR:?}"
        sleep 1
      fi
    fi

    ############################################################################
    # buying block
    ############################################################################

    # if zero
    if [[ -z "$LISTING_CURRENCY" ]] &>/dev/null; then
      # target symbol
      DIP_TARGET_SYMBOL="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $1 }' | tr -d ':')"
      # listing (target from above)
      LISTING_CURRENCY="$(echo "$DIP_TARGET_SYMBOL" 2>/dev/null | awk -F/ '{ print $1 }')"
    fi

    # if zero
    if [[ -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then
      # target symbol
      DIP_TARGET_SYMBOL="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $1 }' | tr -d ':')"
      # reference (market from above)
      REFERENCE_CURRENCY="$(echo "$DIP_TARGET_SYMBOL" 2>/dev/null | awk -F/ '{ print $2 }')"
    fi

    ############################################################################

    # minimum spread check (ruled by configuration)
    DIP_MIN_SPREAD_CHECK="$(echo "$DIP_MIN_SPREAD" | tr -d '.' | sed 's/^0*//')"

    # if any orders with reference, listing currency does not exist
    if [[ "$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)" -eq "0" ]] &>/dev/null; then
      # if profit is greater or equal than minimum spread
      if [[ "$DIP_GET_RATIO_PROFIT_CHECK" -ge "$DIP_MIN_SPREAD_CHECK" ]] &>/dev/null; then
        # has buying power (balance)
        if [[ "$(echo "$REFERENCE_BALANCE" | tr -d '.' | sed 's/^0*//')" -gt "0" ]] &>/dev/null; then

          log_date

          ######################################################################
          ######################################################################

          # if xeggex order
          if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
            # CreateOrder market ###############################################
            PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "limit" "$DIP_BUY_AMOUNT_LISTING" "$DIP_TARGET_BID" "false")"
            # debug line #######################################################
            echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY buy limit $DIP_BUY_AMOUNT_LISTING $DIP_TARGET_BID false <--- Buying asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
            ####################################################################
            sleep 1
          fi

          ######################################################################
          ######################################################################

          tx_id

          # track amount being bought
          echo "$LOG_DATE : Buying $DIP_BUY_AMOUNT_LISTING $LISTING_CURRENCY for ($DIP_BUY_AMOUNT_REFERENCE $REFERENCE_CURRENCY) @ $(echo "$DIP_TARGET_BID" | awk '{ printf "%.9f\n", $1 }') Price -> Quest: Selling @ $(echo "$DIP_TARGET_ASK" | awk '{ printf "%.9f\n", $1 }') Price for ($DIP_GET_AMOUNT_REFERENCE $REFERENCE_CURRENCY) Earning: $DIP_GET_AMOUNT_PROFIT $REFERENCE_CURRENCY ${DIP_GET_RATIO_PROFIT:?}%" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".bought
          # keep n lines
          echo "$(tail -3 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".bought 2>/dev/null)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".bought

          # target file age (seconds)
          DIP_TARGET_FILE_AGE_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

          # if zero
          if [[ -z "$DIP_TARGET_FILE_AGE_SECONDS" ]] &>/dev/null; then
            DIP_TARGET_FILE_AGE_SECONDS="0"
          fi

          # target file age (hours:minutes:seconds)
          DIP_TARGET_FILE_AGE=$(printf '%dh:%dm:%ds\n' $(("$DIP_TARGET_FILE_AGE_SECONDS/3600")) $(("$DIP_TARGET_FILE_AGE_SECONDS%3600/60")) $(("$DIP_TARGET_FILE_AGE_SECONDS%60")))

          log_date

          # profit output (log)
          DIP_BUY_PROFIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Gains: $DIP_GET_AMOUNT_PROFIT $REFERENCE_CURRENCY -> ${DIP_GET_RATIO_PROFIT:?}%"
          echo "$DIP_BUY_PROFIT_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
          # buying output (log)
          DIP_BUY_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Buy $DIP_BUY_AMOUNT_LISTING $LISTING_CURRENCY for $DIP_BUY_AMOUNT_REFERENCE $REFERENCE_CURRENCY"
          echo "$DIP_BUY_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
          # buy output (trade history)
          DIP_LIMIT_POSITION="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : buy :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $LISTING_BALANCE $REFERENCE_BALANCE ${DIP_GET_RATIO_PROFIT:?}% $DIP_TARGET_FILE_AGE"
          echo "$DIP_LIMIT_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

          # reset sold file (reset data, age)
          truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".sold &>/dev/null
          # reset selling file (reset data)
          truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".selling &>/dev/null

          # remove duplicates
          echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
        fi
      fi
    fi
  fi
fi

################################################################################
################################################################################

# reset target file
if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | sed '/^$/d' | wc -l)" -gt "0" ]] &>/dev/null; then
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
fi

################################################################################
# setup sell order (limit) using active file
################################################################################

# target data
TARGET_ACTIVE="ACTIVE"
target_data
decimal_market
bought_sold_age
remove_ghost_orders
target_order_status

################################################################################

# if listing, reference dont exist in orders
if [[ "$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)" -eq "0" ]] &>/dev/null; then
  # remove old dca order
  remove_old_dca
fi

################################################################################

# create strategy directory
if [[ ! -d "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY" ]] &>/dev/null; then
  mkdir "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY" &>/dev/null
fi

################################################################################

# if active file has any orders
if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | sed '/^$/d' | wc -l)" -gt "0" ]] &>/dev/null; then

  time_and_profit

  # active market pairs
  ACTIVE_MARKET_PAIRS="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $1 }' | awk -F/ '{ print $2 }' | tr -d ':' | sort -n | awk '!a[$0]++' | xargs | sed '/^$/d')"

  ##############################################################################

  # buy count
  DIP_ORDER_BUY_COUNT="$(echo "$CAT_ORDERS_FILE" | grep -w "$ACTIVE_MARKET_PAIRS" | grep -c "buy" || true)"

  # if zero
  if [[ -z "$DIP_ORDER_BUY_COUNT" ]] &>/dev/null; then
    DIP_ORDER_BUY_COUNT="0"
  fi

  ##############################################################################

  # sell count
  DIP_ORDER_SELL_COUNT="$(echo "$CAT_ORDERS_FILE" | grep -w "$ACTIVE_MARKET_PAIRS" | grep -c "sell" || true)"

  # if zero
  if [[ -z "$DIP_ORDER_SELL_COUNT" ]] &>/dev/null; then
    DIP_ORDER_SELL_COUNT="0"
  fi

  ##############################################################################

  # missing markets
  DIP_MISSING_MARKETS="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".missing 2>/dev/null)"

  # market count
  DIP_MISSING_MARKETS_COUNT="$(echo "$DIP_MISSING_MARKETS" | sed '/^$/d' | wc -w)"

  # if zero
  if [[ -z "$DIP_MISSING_MARKETS_COUNT" ]] &>/dev/null; then
    DIP_MISSING_MARKETS_COUNT="0"
  fi

  ##############################################################################

  # sell, buy and missing combined
  DIP_ORDERS_COMBINED="$(echo "$DIP_ORDER_SELL_COUNT+$DIP_ORDER_BUY_COUNT+$DIP_MISSING_MARKETS_COUNT" | bc 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  ##############################################################################

  # calculate buy count percentage
  DIP_ORDER_PERCENTAGE_BUY="$(echo "100/$DIP_ORDERS_COMBINED*$DIP_ORDER_BUY_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"
  # calculate sell count percentage
  DIP_ORDER_PERCENTAGE_SELL="$(echo "100/$DIP_ORDERS_COMBINED*$DIP_ORDER_SELL_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_ORDER_PERCENTAGE_BUY" ]] &>/dev/null; then
    DIP_ORDER_PERCENTAGE_BUY="0.00"
  fi
  # if zero
  if [[ -z "$DIP_ORDER_PERCENTAGE_SELL" ]] &>/dev/null; then
    DIP_ORDER_PERCENTAGE_SELL="0.00"
  fi

  ##############################################################################

  # missing markets percentage
  DIP_MISSING_MARKETS_PERCENTAGE="$(echo "100/$DIP_ORDERS_COMBINED*$DIP_MISSING_MARKETS_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_MISSING_MARKETS_PERCENTAGE" ]] &>/dev/null; then
    DIP_MISSING_MARKETS_PERCENTAGE="0"
  fi

  ##############################################################################

  # total active dip
  DIP_ACTIVE_FILE_DIP="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | awk '{ print $13 }' | awk '{ SUM += $1} END { print SUM }')"

  ##############################################################################

  # calculate average dip
  DIP_ACTIVE_FILE_AVERAGE_DIP="$(echo "$DIP_ACTIVE_FILE_DIP/$DIP_ACTIVE_FILE_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_ACTIVE_FILE_AVERAGE_DIP" ]] &>/dev/null; then
    DIP_ACTIVE_FILE_AVERAGE_DIP="0.00"
  fi

  ##############################################################################

  # top active dip
  DIP_ACTIVE_TOP_DIP="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | awk '{ print $13 }' | sort -n | head -1)"
  # top dip data
  DIP_TOP_ACTIVE_DIP="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w -- "$DIP_ACTIVE_TOP_DIP" | head -1 || true)"
  # top dip market
  DIP_TOP_DIP="$(echo "$DIP_TOP_ACTIVE_DIP" | awk '{ print $1}' | tr -d ':' | head -1)"
  # top dip amount
  DIP_TOP_DIP_AMOUNT="$(echo "$DIP_TOP_ACTIVE_DIP" | awk '{ print $13}' | tr -d '%' | awk '{ printf "%.2f\n", $1 }' | head -1)"

  ##############################################################################

  # low active dip
  DIP_ACTIVE_LOW_DIP="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | awk '{ print $13 }' | sort -n | tail -1)"
  # low dip data
  DIP_LOW_ACTIVE_DIP="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w -- "$DIP_ACTIVE_LOW_DIP" | head -1 || true)"
  # low dip market
  DIP_LOW_DIP="$(echo "$DIP_LOW_ACTIVE_DIP" | awk '{ print $1}' | tr -d ':' | head -1)"
  # low dip amount
  DIP_LOW_DIP_AMOUNT="$(echo "$DIP_LOW_ACTIVE_DIP" | awk '{ print $13}' | tr -d '%' | awk '{ printf "%.2f\n", $1 }' | head -1)"

  ##############################################################################

  # total active spread
  DIP_ACTIVE_FILE_SPREAD="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | awk '{ print $16 }' | awk '{ SUM += $1} END { print SUM }')"

  ##############################################################################

  # calculate average spread
  DIP_ACTIVE_FILE_AVERAGE_SPREAD="$(echo "$DIP_ACTIVE_FILE_SPREAD/$DIP_ACTIVE_FILE_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_ACTIVE_FILE_AVERAGE_SPREAD" ]] &>/dev/null; then
    DIP_ACTIVE_FILE_AVERAGE_SPREAD="0"
  fi

  ##############################################################################

  # if not found
  if [[ ! -f "${SYS_DIR:?}"/robot/pool.view ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/robot/pool.view
  fi

  # cat pool data
  CAT_POOL_FILE="$(cat "${SYS_DIR:?}"/robot/pool.view 2>/dev/null)"

  ##############################################################################

  # top active profit (spread)
  DIP_ACTIVE_TOP_PROFIT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | awk '{ print $16 }' | sort -n | tail -1)"
  # top profit (spread) data
  DIP_SPECIFIC_PROFIT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | grep -w -- "$DIP_ACTIVE_TOP_PROFIT" || true)"
  # top profit (spread) market
  DIP_TOP_PROFIT="$(echo "$DIP_SPECIFIC_PROFIT" 2>/dev/null | awk '{ print $1}' | tr -d ':' | head -1)"
  # top profit (spread) amount
  DIP_TOP_PROFIT_AMOUNT="$(echo "$DIP_SPECIFIC_PROFIT" 2>/dev/null | awk '{ print $16}' | tr -d '%' | awk '{ printf "%.2f\n", $1 }' | head -1)"

  ##############################################################################

  # lowest active profit (spread)
  DIP_ACTIVE_LOW_PROFIT="$(echo "$CAT_POOL_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | grep "$STRATEGY_TYPE" | grep "$EXCHANGE_API" | awk '{ print $6 }' | tr -d '%' | sort -n | head -1)"
  # lowest profit (spread) data
  DIP_LOW_ACTIVE_PROFIT="$(echo "$CAT_POOL_FILE" 2>/dev/null | grep -w "$REFERENCE_CURRENCY" | grep -w -- "$DIP_ACTIVE_LOW_PROFIT" || true)"
  # lowest profit (spread) market
  DIP_LOW_PROFIT="$(echo "$DIP_LOW_ACTIVE_PROFIT" 2>/dev/null | awk '{ print $3}' | tr -d ':' | head -1)"
  # lowest profit (spread) amount
  DIP_LOW_PROFIT_AMOUNT="$(echo "$DIP_LOW_ACTIVE_PROFIT" 2>/dev/null | awk '{ print $6}' | tr -d '%' | awk '{ printf "%.2f\n", $1 }' | head -1)"

  ##############################################################################

  dip_order_data

  # order age (bought,seconds)
  DIP_LATEST_ORDER_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_LATEST_ORDER_LISTING:?}"_"${DIP_LATEST_ORDER_REFERENCE:?}".bought 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
  DIP_OLDEST_ORDER_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_OLDEST_ORDER_LISTING:?}"_"${DIP_OLDEST_ORDER_REFERENCE:?}".bought 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

  # if latest sold has data
  if [[ "$(egrep -c "[0-9]+" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_LATEST_ORDER_LISTING:?}"_"${DIP_LATEST_ORDER_REFERENCE:?}".sold || true)" -gt "0" ]] &>/dev/null; then
    # order age (sold,seconds)
    DIP_LATEST_ORDER_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_LATEST_ORDER_LISTING:?}"_"${DIP_LATEST_ORDER_REFERENCE:?}".sold 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
  fi
  # if oldest bought has data
  if [[ "$(egrep -c "[0-9]+" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_OLDEST_ORDER_LISTING:?}"_"${DIP_OLDEST_ORDER_REFERENCE:?}".bought || true)" -gt "0" ]] &>/dev/null; then
    # order age (sold,seconds)
    DIP_OLDEST_ORDER_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_OLDEST_ORDER_LISTING:?}"_"${DIP_OLDEST_ORDER_REFERENCE:?}".bought 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
  fi

  # if zero
  if [[ -z "$DIP_LATEST_ORDER_SECONDS" ]] &>/dev/null; then
    DIP_LATEST_ORDER_SECONDS="0"
  fi
  # if zero
  if [[ -z "$DIP_OLDEST_ORDER_SECONDS" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_SECONDS="0"
  fi

  # latest order spread
  DIP_LATEST_ORDER_SPREAD="$(grep "$DIP_LATEST_ORDER_LISTING/$DIP_LATEST_ORDER_REFERENCE" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $16 }')"
  # oldest order spread
  DIP_OLDEST_ORDER_SPREAD="$(grep "$DIP_OLDEST_ORDER_LISTING/$DIP_OLDEST_ORDER_REFERENCE" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $16 }')"

  ##############################################################################

  # calculate latest file age, minutes, hours, days
  DIP_FILE_AGE_MINUTES="$(echo "$DIP_LATEST_ORDER_SECONDS/60" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  DIP_FILE_AGE_HOURS="$(echo "$DIP_LATEST_ORDER_SECONDS/3600" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  DIP_FILE_AGE_DAYS="$(echo "$DIP_LATEST_ORDER_SECONDS/86400" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  # if greater than n seconds (day)
  if [[ "$DIP_LATEST_ORDER_SECONDS" -gt "86400" ]] &>/dev/null; then
    DIP_LATEST_ORDER_AGE="${DIP_FILE_AGE_DAYS:?}d"
    # if greater than n seconds (hours)
  elif [[ "$DIP_LATEST_ORDER_SECONDS" -gt "3600" ]] &>/dev/null; then
    DIP_LATEST_ORDER_AGE="${DIP_FILE_AGE_HOURS:?}h"
    # if greater than n seconds (minutes)
  elif [[ "$DIP_LATEST_ORDER_SECONDS" -gt "60" ]] &>/dev/null; then
    DIP_LATEST_ORDER_AGE="${DIP_FILE_AGE_MINUTES:?}m"
    # if less than n seconds (minutes)
  elif [[ "$DIP_LATEST_ORDER_SECONDS" -lt "60" ]] &>/dev/null; then
    DIP_LATEST_ORDER_AGE="0m"
  fi

  # calculate oldest file age, minutes, hours, days
  DIP_FILE_AGE_MINUTES="$(echo "$DIP_OLDEST_ORDER_SECONDS/60" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  DIP_FILE_AGE_HOURS="$(echo "$DIP_OLDEST_ORDER_SECONDS/3600" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  DIP_FILE_AGE_DAYS="$(echo "$DIP_OLDEST_ORDER_SECONDS/86400" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  # if greater than n seconds (day)
  if [[ "$DIP_OLDEST_ORDER_SECONDS" -gt "86400" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_AGE="${DIP_FILE_AGE_DAYS:?}d"
    # if greater than n seconds (hours)
  elif [[ "$DIP_OLDEST_ORDER_SECONDS" -gt "3600" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_AGE="${DIP_FILE_AGE_HOURS:?}h"
    # if greater than n seconds (minutes)
  elif [[ "$DIP_OLDEST_ORDER_SECONDS" -gt "60" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_AGE="${DIP_FILE_AGE_MINUTES:?}m"
    # if less than n seconds (minutes)
  elif [[ "$DIP_OLDEST_ORDER_SECONDS" -lt "60" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_AGE="0m"
  fi

  ##############################################################################

  # total order time (hours)
  DIP_ACTIVE_FILE_TOTAL_TIME="$(echo "$CAT_POOL_FILE" | grep "/$REFERENCE_CURRENCY" | grep "$STRATEGY_TYPE" | grep "$EXCHANGE_API" | awk '{ print $NF }' | awk -Fh '{ print $1 }' | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%.0f\n", $1 }')"
  # calculate average order age
  DIP_ACTIVE_FILE_AVERAGE_TIME="$(echo "$DIP_ACTIVE_FILE_TOTAL_TIME/$DIP_ACTIVE_FILE_COUNT" | bc -l 2>/dev/null)"
  # calculate average order age into seconds
  DIP_ACTIVE_FILE_AVERAGE_SECONDS="$(echo "$DIP_ACTIVE_FILE_AVERAGE_TIME*3600" | bc 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  # calculate average order age into days
  DIP_ACTIVE_FILE_AVERAGE_DAYS="$(echo "$DIP_ACTIVE_FILE_AVERAGE_SECONDS/86400" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_ACTIVE_FILE_AVERAGE_SECONDS" ]] &>/dev/null; then
    DIP_ACTIVE_FILE_AVERAGE_SECONDS="0"
  fi

  # active file average (hours:minutes:seconds)
  DIP_ACTIVE_FILE_AVERAGE_AGE=$(printf '%dh:%dm:%ds\n' $(("$DIP_ACTIVE_FILE_AVERAGE_SECONDS/3600")) $(("$DIP_ACTIVE_FILE_AVERAGE_SECONDS%3600/60")) $(("$DIP_ACTIVE_FILE_AVERAGE_SECONDS%60")))

  ##############################################################################

  # total average price movement
  DIP_ACTIVE_FILE_PRICE_MOVEMENT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $20 }' | tr -d '%' | awk '{ SUM += $1} END { print SUM }')"
  # top average price movement
  DIP_ACTIVE_TOP_PRICE_MOVEMENT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $20 }' | tr -d '%' | sort -n | tail -1)"
  # calculate average price movement
  DIP_ACTIVE_FILE_A_PRICE_MOVEMENT="$(echo "$DIP_ACTIVE_FILE_PRICE_MOVEMENT/$DIP_ACTIVE_FILE_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  ##############################################################################

  # top price movement data
  DIP_TOP_ACTIVE_PRICE_MOVEMENT="$(grep -w -- "$DIP_ACTIVE_TOP_PRICE_MOVEMENT" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null || true)"
  # top price movement market
  PRICE_MOVEMENT_TOP_MARKET="$(echo "$DIP_TOP_ACTIVE_PRICE_MOVEMENT" | awk '{ print $1}' | tr -d ':' | head -1)"
  # top price movement amount
  PRICE_MOVEMENT_TOP_MARKET_AMOUNT="$(echo "$DIP_TOP_ACTIVE_PRICE_MOVEMENT" | awk '{ print $20}' | tr -d '%' | awk '{ printf "%.2f\n", $1 }' | head -1)"

  ##############################################################################

  # top volume
  DIP_TOP_ACTIVE_VOLUME="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | sort -n -k 23 | tail -1)"
  # top volume market
  DIP_TOP_VOLUME_MARKET="$(grep -w -- "$DIP_TOP_ACTIVE_VOLUME" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1}' | tr -d ':' || true)"
  # top volume listing
  DIP_TOP_VOLUME_LISTING="$(echo "$DIP_TOP_VOLUME_MARKET" | awk -F/ '{ print $1 }')"
  # top volume amount
  DIP_TOP_VOLUME_AMOUNT="$(grep -w -- "$DIP_TOP_ACTIVE_VOLUME" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $23}' | awk '{ printf "%.0f\n", $1 }' || true)"

  ##############################################################################

  # low volume
  DIP_LOW_ACTIVE_VOLUME="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | sort -n -k 23 | head -1)"
  # low volume market
  DIP_LOW_VOLUME_MARKET="$(grep -w -- "$DIP_LOW_ACTIVE_VOLUME" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1}' | tr -d ':' || true)"
  # low volume listing
  DIP_LOW_VOLUME_LISTING="$(echo "$DIP_LOW_VOLUME_MARKET" | awk -F/ '{ print $1 }')"
  # low volume amount
  DIP_LOW_VOLUME_AMOUNT="$(grep -w -- "$DIP_LOW_ACTIVE_VOLUME" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $23}' | awk '{ printf "%.0f\n", $1 }' || true)"

  ##############################################################################

  # top amount
  DIP_TOP_ACTIVE_AMOUNT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | sort -n -k 26 | tail -1)"
  # top amount market
  DIP_TOP_AMOUNT_MARKET="$(grep -w -- "$DIP_TOP_ACTIVE_AMOUNT" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1}' | tr -d ':' || true)"
  # top amount reference
  DIP_TOP_AMOUNT_LISTING="$(echo "$DIP_TOP_AMOUNT_MARKET" | awk -F/ '{ print $1 }')"
  # top amount amount
  DIP_TOP_AMOUNT_AMOUNT="$(grep -w -- "$DIP_TOP_ACTIVE_AMOUNT" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $26}' | awk '{ printf "%.0f\n", $1 }' || true)"

  ##############################################################################

  log_date

  # if data
  if [[ -n "$DIP_MARKETS" ]] &>/dev/null; then
    ALL_INFO="INFO/$DIP_MARKETS"
  else
    ALL_INFO="INFO/ALL"
  fi

  # log position output
  DIP_POSITIONS_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $ALL_INFO :: A/O: $DIP_ACTIVE_FILE_COUNT/$DIP_ORDERS_FILE_COUNT Dip: ${DIP_ACTIVE_FILE_AVERAGE_DIP:?}% Spread: ${DIP_ACTIVE_FILE_AVERAGE_SPREAD:?}% Buy: $DIP_ORDER_BUY_COUNT Sell: $DIP_ORDER_SELL_COUNT"
  echo "$DIP_POSITIONS_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################

  # total sum (confirmed sell)
  DIP_TOTAL_SOLD_SUM="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".selling 2>/dev/null | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | sed '/^$/d')"

  # if zero, equals zero
  if [[ -z "$DIP_TOTAL_SOLD_SUM" || "$DIP_TOTAL_SOLD_SUM" -eq "0" ]] &>/dev/null; then
    DIP_TOTAL_SOLD_SUM="0"
  fi

  ##############################################################################

  # dca status
  if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then
    # use target amount
    DIP_LEFTOVER_SOLD="$(echo "$DIP_TARGET_AMOUNT" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
  else
    # leftover sell amount
    DIP_LEFTOVER_SOLD="$(echo "$DIP_TARGET_AMOUNT-$DIP_TOTAL_SOLD_SUM" | bc -l 2>/dev/null | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
  fi

  # if zero, equals zero
  if [[ -z "$DIP_LEFTOVER_SOLD" ]] &>/dev/null; then
    DIP_LEFTOVER_SOLD="0"
  fi

  ##############################################################################

  # leftover sell amount (without decimal)
  DIP_LEFTOVER_SOLD_CHECK="$(echo "$DIP_LEFTOVER_SOLD" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$DIP_LEFTOVER_SOLD_CHECK" ]] &>/dev/null; then
    DIP_LEFTOVER_SOLD_CHECK="0"
  fi

  ##############################################################################

  # total sum (without decimal)
  DIP_TOTAL_SOLD_SUM_CHECK="$(echo "$DIP_TOTAL_SOLD_SUM" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$DIP_TOTAL_SOLD_SUM_CHECK" ]] &>/dev/null; then
    DIP_TOTAL_SOLD_SUM_CHECK="0"
  fi

  ##############################################################################

  # listing balance, available check (without decimal)
  DIP_LISTING_BALANCE_CHECK="$(echo "$LISTING_BALANCE" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | tr -d '.' | sed 's/^0*//')"

  # target amount check (without decimal)
  DIP_TARGET_BALANCE_CHECK="$(echo "$DIP_TARGET_AMOUNT" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | tr -d '.' | sed 's/^0*//')"

  # listing balance deposited check (without decimal)
  DIP_DEPOSITED_BALANCE_CHECK="$(echo "$LISTING_DEPOSITED_BALANCE" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$DIP_LISTING_BALANCE_CHECK" ]] &>/dev/null; then
    DIP_LISTING_BALANCE_CHECK="0"
  fi
  # if zero
  if [[ -z "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then
    DIP_TARGET_BALANCE_CHECK="0"
  fi

  ##############################################################################

  # buy order count
  DIP_BUY_ORDER_COUNT="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -w "$LISTING_CURRENCY" 2>/dev/null | grep -c "buy" || true)"
  # sell order count
  DIP_SELL_ORDER_COUNT="$(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -w "$LISTING_CURRENCY" 2>/dev/null | grep -c "sell" || true)"
  # total order check
  DIP_TOTAL_ORDER_CHECK="$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -c "$REFERENCE_CURRENCY" 2>/dev/null || true)"

  # if zero
  if [[ -z "$DIP_BUY_ORDER_COUNT" ]] &>/dev/null; then
    DIP_BUY_ORDER_COUNT="0"
  fi
  # if zero
  if [[ -z "$DIP_SELL_ORDER_COUNT" ]] &>/dev/null; then
    DIP_SELL_ORDER_COUNT="0"
  fi

  # total orders
  DIP_TOTAL_ORDER_COUNT="$(echo "$DIP_BUY_ORDER_COUNT+$DIP_SELL_ORDER_COUNT" | bc 2>/dev/null)"

  # if zero
  if [[ -z "$DIP_TOTAL_ORDER_COUNT" ]] &>/dev/null; then
    DIP_TOTAL_ORDER_COUNT="0"
  fi

  ##############################################################################

  # percentage of buy
  DIP_BUY_PERCENTAGE="$(echo "100/$DIP_TOTAL_ORDER_COUNT*$DIP_BUY_ORDER_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
  # percentage of sell
  DIP_SELL_PERCENTAGE="$(echo "100/$DIP_TOTAL_ORDER_COUNT*$DIP_SELL_ORDER_COUNT" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_BUY_PERCENTAGE" ]] &>/dev/null; then
    DIP_BUY_PERCENTAGE="0"
  fi
  # if zero
  if [[ -z "$DIP_SELL_PERCENTAGE" ]] &>/dev/null; then
    DIP_SELL_PERCENTAGE="0"
  fi

  ##############################################################################

  # active check
  DIP_CHECK_ACTIVE="$(grep -w "$LISTING_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | grep -c "$REFERENCE_CURRENCY" || true)"
  # orders check
  DIP_CHECK_ORDERS="$(grep -w "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$REFERENCE_CURRENCY" || true)"

  # target status (default)
  DIP_TARGET_SPREAD_STATUS="[OK]"

  # if true active
  if [[ "$DIP_CHECK_ACTIVE" -gt "0" && "$DIP_CHECK_ORDERS" -gt "0" ]] &>/dev/null; then
    # if buy percentage greater than sell percentage
    if [[ "$DIP_BUY_PERCENTAGE" > "$DIP_SELL_PERCENTAGE" ]] &>/dev/null; then
      DIP_BS_STATUS="Buy: ${DIP_BUY_ORDER_COUNT:?} Sell: ${DIP_SELL_ORDER_COUNT:?}"
      # if sell percentage greater than buy percentage
    elif [[ "$DIP_SELL_PERCENTAGE" > "$DIP_BUY_PERCENTAGE" ]] &>/dev/null; then
      DIP_BS_STATUS="Sell: ${DIP_SELL_ORDER_COUNT:?} Buy: ${DIP_BUY_ORDER_COUNT:?}"
      # if sell percentage equals buy percentage
    elif [[ "$DIP_SELL_PERCENTAGE" == "$DIP_BUY_PERCENTAGE" ]] &>/dev/null; then
      DIP_BS_STATUS="Broker $DIP_BUY_ORDER_COUNT:$DIP_SELL_ORDER_COUNT"
    fi
  else # no active, no orders
    DIP_BS_STATUS="Waiting"
    # probably not good enough
    DIP_TARGET_SPREAD_STATUS="[N0]"
  fi

  ##############################################################################

  # if zero
  if [[ -z "$DIP_BS_STATUS" ]] &>/dev/null; then
    DIP_BS_STATUS="null"
  fi

  ##############################################################################

  # dca status
  if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then
    DIP_DCA_STATUS="(DCA)"
  fi

  ##############################################################################

  time_and_profit

  # default
  DIP_MAX_BUY_AGE_OUTPUT="?"

  # days
  if [[ "$DIP_MAX_BUY_AGE" -lt "7" ]] &>/dev/null; then
    DIP_MAX_BUY_AGE_OUTPUT="${DIP_MAX_BUY_AGE:?}d"
  fi
  # weeks
  if [[ "$DIP_MAX_BUY_AGE" -gt "6" ]] &>/dev/null; then
    DIP_MAX_BUY_AGE_OUTPUT="$(echo "$DIP_MAX_BUY_AGE/7" | bc -l 2>/dev/null | awk -F. '{ print $1 }')w"
  fi
  # months
  if [[ "$DIP_MAX_BUY_AGE" -gt "30" ]] &>/dev/null; then
    DIP_MAX_BUY_AGE_OUTPUT="$(echo "$DIP_MAX_BUY_AGE/31" | bc -l 2>/dev/null | awk -F. '{ print $1 }')m"
  fi
  # years
  if [[ "$DIP_MAX_BUY_AGE" -gt "364" ]] &>/dev/null; then
    DIP_MAX_BUY_AGE_OUTPUT="$(echo "$DIP_MAX_BUY_AGE/365" | bc -l 2>/dev/null | awk -F. '{ print $1 }')y"
  fi

  ##############################################################################

  # default
  DIP_MAX_SELL_AGE_OUTPUT="?"

  # days
  if [[ "$DIP_MAX_SELL_AGE" -lt "7" ]] &>/dev/null; then
    DIP_MAX_SELL_AGE_OUTPUT="${DIP_MAX_SELL_AGE:?}d"
  fi
  # weeks
  if [[ "$DIP_MAX_SELL_AGE" -gt "6" ]] &>/dev/null; then
    DIP_MAX_SELL_AGE_OUTPUT="$(echo "$DIP_MAX_SELL_AGE/7" | bc -l 2>/dev/null | awk -F. '{ print $1 }')w"
  fi
  # months
  if [[ "$DIP_MAX_SELL_AGE" -gt "30" ]] &>/dev/null; then
    DIP_MAX_SELL_AGE_OUTPUT="$(echo "$DIP_MAX_SELL_AGE/31" | bc -l 2>/dev/null | awk -F. '{ print $1 }')m"
  fi
  # years
  if [[ "$DIP_MAX_SELL_AGE" -gt "364" ]] &>/dev/null; then
    DIP_MAX_SELL_AGE_OUTPUT="$(echo "$DIP_MAX_SELL_AGE/365" | bc -l 2>/dev/null | awk -F. '{ print $1 }')y"
  fi

  ##############################################################################

  # status output (log)
  DIP_ACTIVE_CHECK_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $DIP_BS_STATUS - $DIP_DCA_STATUS Dip: ${DIP_TARGET_DIP:?}% Spread: ${DIP_TARGET_SPREAD:?}% Age: $DIP_BOUGHT_AGE_OUTPUT ${DIP_MAX_BUY_AGE_OUTPUT:?}/${DIP_MAX_SELL_AGE_OUTPUT:?}"
  echo "$DIP_ACTIVE_CHECK_OUTPUT" | xargs >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################
  # waiting block (once a day until limit is met)
  ##############################################################################

  # buying status
  DIP_BUYING_STATUS="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -w "$LISTING_CURRENCY" | grep -w "$REFERENCE_CURRENCY" | grep -c "buy" || true)"
  # buying count
  DIP_BUYING_COUNT="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -c "buy" || true)"

  # if greater than n
  if [[ "$DIP_BUYING_STATUS" -gt "0" ]] &>/dev/null; then
    # keep track of buying status
    echo "$DIP_BUYING_STATUS" >>"${LOG_DIR}"/leeloo/buying_status
  fi

  # if any data
  if [[ -f "${LOG_DIR}"/leeloo/buying_status ]] &>/dev/null; then
    # if greater than n
    if [[ "$(cat "${LOG_DIR}"/leeloo/buying_status 2>/dev/null | awk '{ SUM += $1} END { print SUM }' | awk -F. '{ print $1 }')" -gt "$DIP_BUYING_COUNT" ]] &>/dev/null; then
      DIP_BUYING_STATUS="0"
    fi
  fi

  ##############################################################################
  # selling block
  ##############################################################################

  decimal_market

  # balance has selling power (available), not buying, good enough to sell
  if [[ "$DIP_LISTING_BALANCE_CHECK" -gt "0" && "$DIP_BUYING_STATUS" -eq "0" && ! "$DIP_TARGET_SPREAD_STATUS" == "[N0]" ]] &>/dev/null; then
    # if total sum (sold) is less than target amount
    if [[ "$DIP_TOTAL_SOLD_SUM_CHECK" -lt "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then

      ##########################################################################

      # if balance (available) are greater or equal to leftover
      if [[ "$DIP_LISTING_BALANCE_CHECK" -ge "$DIP_TARGET_BALANCE_CHECK" ]] &>/dev/null; then
        # sell target amount (available)
        LISTING_BALANCE="$(echo "$DIP_TARGET_AMOUNT" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
      fi

      ##########################################################################

      # if balance (available) is less than leftover of target
      if [[ ! "$DIP_LISTING_BALANCE_CHECK" -lt "$DIP_LEFTOVER_SOLD_CHECK" ]] &>/dev/null; then
        # sell leftover (available)
        LISTING_BALANCE="$(echo "$DIP_LEFTOVER_SOLD" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
      fi

      ##########################################################################

      # if zero, if below zero, negative
      if [[ -z "$LISTING_BALANCE" || "$LISTING_BALANCE" -lt "0" || "$(echo "$LISTING_BALANCE" | grep -c "-" || true)" -eq "1" ]] &>/dev/null; then
        LISTING_BALANCE="$(echo "0.000000000" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
      fi

      ##########################################################################

      # total selling amount
      DIP_TOTAL_SELLING="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | grep -w "$LISTING_CURRENCY" | grep -w "$REFERENCE_CURRENCY" | grep "sell" | awk '{ print $3 }' | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%.9f\n", $1 }')"

      # calculate percentage of order size
      DIP_LEFTOVER_SIZE=$(awk "BEGIN { result = 100 / $DIP_TARGET_AMOUNT * $LISTING_BALANCE; printf \"%.9f\", (result > 100 ? 100 : result) }" | awk '{ printf "%.9f\n", $1 }')
      # calculate percentage of total orders
      DIP_LEFTOVER_TOTAL=$(awk "BEGIN { result = 100 / $DIP_TARGET_AMOUNT * $DIP_TOTAL_SELLING; printf \"%.9f\", (result > 100 ? 100 : result) }" | awk '{ printf "%.2f\n", $1 }')

      # if zero
      if [[ -z "$DIP_LEFTOVER_SIZE" ]] &>/dev/null; then
        DIP_LEFTOVER_SIZE="0"
      fi

      # if zero
      if [[ -z "$DIP_LEFTOVER_TOTAL" ]] &>/dev/null; then
        DIP_LEFTOVER_TOTAL="0"
      fi

      DIP_LEFTOVER_SIZE_OUTPUT="$DIP_LEFTOVER_SIZE"

      # if leftover size greater or equal to n
      if [[ "$(echo "$DIP_LEFTOVER_SIZE" | awk -F. '{ print $1 }')" -ge "99" ]] &>/dev/null; then
        DIP_LEFTOVER_SIZE="100.000000000"
        # dip leftover output
        DIP_LEFTOVER_SIZE_OUTPUT="100"
      fi

      # default leftover size limit (0.005000000%)
      DIP_LEFTOVER_SIZE_LIMIT="0.005000000"

      ##########################################################################

      # if market fail at selling (null)
      if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null || true)" -gt "0" ]] &>/dev/null; then
        # increase leftover size limit to (1.000000000%)
        DIP_LEFTOVER_SIZE_LIMIT="1.000000000"
      fi

      ##########################################################################

      # if zero
      if [[ -z "$DIP_LEFTOVER_FILLED" || "$DIP_LEFTOVER_FILLED" == "0.0000" ]] &>/dev/null; then
        DIP_LEFTOVER_FILLED="0"
      fi

      # sell + selling + filled (sold) - DIP_LEFTOVER_SIZE_OUTPUT + DIP_LEFTOVER_TOTAL + DIP_LEFTOVER_FILLED
      DIP_LEFTOVER_TOTAL_CHECK="$(echo "${DIP_LEFTOVER_SIZE_OUTPUT:?}+${DIP_LEFTOVER_TOTAL:?}+${DIP_LEFTOVER_FILLED:?}" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

      ##########################################################################

      # if percentage of total orders has not reached 100%, if not greater than 100, if DCA
      if [[ "$(echo "$DIP_LEFTOVER_TOTAL_CHECK" | awk -F. '{ print $1 }')" -lt "101" && ! "$(echo "$DIP_LEFTOVER_TOTAL_CHECK" | awk -F. '{ print $1 }')" -gt "100" || "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -gt "0" ]] &>/dev/null; then

        # if leftover size is greater than leftover size limit
        if [[ "$(echo "$DIP_LEFTOVER_SIZE" | tr -d '.' | sed 's/^0*//')" -gt "$(echo "$DIP_LEFTOVER_SIZE_LIMIT" | tr -d '.' | sed 's/^0*//')" ]] &>/dev/null; then

          # amount of order filled (sold)
          DIP_LEFTOVER_FILLED_AMOUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".selling 2>/dev/null | awk '{ SUM += $1} END { print SUM }')"
          # target amount (bought)
          DIP_TARGET_AMOUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY}"_"${REFERENCE_CURRENCY}".bought 2>/dev/null | tail -1 | awk '{ print $4 }' | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"

          # if zero, equals zero
          if [[ -z "$DIP_LEFTOVER_FILLED_AMOUNT" || "$DIP_LEFTOVER_FILLED_AMOUNT" -eq "0" ]] &>/dev/null; then
            DIP_LEFTOVER_FILLED_AMOUNT="0"
          fi

          # calculate total filled
          DIP_LEFTOVER_FILLED=$(awk "BEGIN { result = 100 / $DIP_TARGET_AMOUNT * $DIP_LEFTOVER_FILLED_AMOUNT; printf \"%.9f\", (result > 100 ? 100 : result) }" 2>/dev/null | awk '{ printf "%.4f\n", $1 }')

          # if zero
          if [[ -z "$DIP_LEFTOVER_FILLED" || "$DIP_LEFTOVER_FILLED" == "0.0000" ]] &>/dev/null; then
            DIP_LEFTOVER_FILLED="0"
          fi

          # if zero
          if [[ "$(echo "$DIP_LEFTOVER_FILLED" | awk -F. '{ print $1 }')" -gt "99" ]] &>/dev/null; then
            DIP_LEFTOVER_FILLED="100"
          fi

          # re calculate receive amount based on order size
          DIP_SELL_AMOUNT_REFERENCE="$(echo "$(echo "$DIP_LEFTOVER_SIZE/100" | bc -l 2>/dev/null)*$DIP_GET_AMOUNT_REFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
          # re calculate profit amount based on order size
          DIP_SELL_AMOUNT_PROFIT="$(echo "$(echo "$DIP_LEFTOVER_SIZE/100" | bc -l 2>/dev/null)*$DIP_GET_AMOUNT_PROFIT" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

          # if order has no losses (negative symbol)
          if [[ "$(echo "$DIP_SELL_AMOUNT_PROFIT" | grep -c "-" || true)" -eq "0" ]] &>/dev/null; then

            ####################################################################

            log_date

            ####################################################################
            ####################################################################

            # if xeggex order
            if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
              # CreateOrder limit ##############################################
              PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "sell" "limit" "$LISTING_BALANCE" "$DIP_TARGET_ASK" "false")"
              # debug line #####################################################
              echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY sell limit $LISTING_BALANCE $DIP_TARGET_ASK false <--- Selling asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
              ##################################################################
              sleep 1
            fi

            ####################################################################
            ####################################################################

            tx_id

            # selling output (log)
            DIP_SELL_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Sell $LISTING_BALANCE $LISTING_CURRENCY for $DIP_SELL_AMOUNT_REFERENCE $REFERENCE_CURRENCY"
            echo "$DIP_SELL_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            # filled output (log)
            DIP_FILLED_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Sell ${DIP_LEFTOVER_SIZE_OUTPUT:?}% Selling: ${DIP_LEFTOVER_TOTAL:?}% Filled: ${DIP_LEFTOVER_FILLED:?}%"
            echo "$DIP_FILLED_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            # profit output (log)
            DIP_SELL_PROFIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Gains: $DIP_SELL_AMOUNT_PROFIT $REFERENCE_CURRENCY -> ${DIP_GET_RATIO_PROFIT:?}%"
            echo "$DIP_SELL_PROFIT_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
          fi
        fi
      fi
    fi
  fi
fi

