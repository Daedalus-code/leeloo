  DIP_ACTIVE_FILE_AVERAGE_DAYS="$(echo "$DIP_ACTIVE_FILE_AVERAGE_SECONDS/86400" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

