################################################################################

function time_and_profit() {
  # if listing and reference data exist
  if [[ -n "$LISTING_CURRENCY" && -n "$REFERENCE_CURRENCY" ]] &>/dev/null; then

    # market spread
    EXTRA_TIME_WITH_SPREAD=$(grep "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $16 }' | awk '{ printf "%.2f\n", $1 }')

    # if data is present
    if [[ -n "$EXTRA_TIME_WITH_SPREAD" ]] &>/dev/null; then
      # increase limit based on spread
      DIP_BUY_EXTRA_TIME=$(echo "$EXTRA_TIME_WITH_SPREAD*1.369/10" | bc -l 2>/dev/null)
      DIP_SELL_EXTRA_TIME=$(echo "$EXTRA_TIME_WITH_SPREAD*3.69/10" | bc -l 2>/dev/null)

      # max buy order age (days) (default)
      DIP_MAX_BUY_AGE=$(egrep "DIP_MAX_BUY_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')
      # max sell order age (days) (default)
      DIP_MAX_SELL_AGE=$(egrep "DIP_MAX_SELL_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')

      # adjust DIP_MAX_BUY_AGE and DIP_MAX_SELL_AGE using calculated percentages
      DIP_MAX_BUY_AGE=$(echo "$DIP_BUY_EXTRA_TIME+$DIP_MAX_BUY_AGE" | bc -l 2>/dev/null | awk -F. '{ print $1 }')
      DIP_MAX_SELL_AGE=$(echo "$DIP_SELL_EXTRA_TIME+$DIP_MAX_SELL_AGE" | bc -l 2>/dev/null | awk -F. '{ print $1 }')
    fi
  fi

  # if zero (ruled by configuration)
  if [[ -z "$DIP_MAX_BUY_AGE" || "$DIP_MAX_BUY_AGE" == "0" ]] &>/dev/null; then
    # use default n days
    DIP_MAX_BUY_AGE="7"
  fi

  # if zero (ruled by configuration)
  if [[ -z "$DIP_MAX_SELL_AGE" || "$DIP_MAX_SELL_AGE" == "0" ]] &>/dev/null; then
    # use default n days
    DIP_MAX_SELL_AGE="14"
  fi

  # recalculate days into seconds
  DIP_MAX_BUY_AGE_SECONDS="$(echo "$DIP_MAX_BUY_AGE*86400" | bc -l 2>/dev/null | awk -F. '{ print $1 }')"
  # recalculate days into seconds
  DIP_MAX_SELL_AGE_SECONDS="$(echo "$DIP_MAX_SELL_AGE*86400" | bc -l 2>/dev/null | awk -F. '{ print $1 }')"
}

