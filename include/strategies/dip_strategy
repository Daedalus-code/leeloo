    if [[ -z "$RANDOM_REF_CURRENCY" ]] &>/dev/null; then
      RANDOM_REF_CURRENCY="1"
    fi

    # dump on btc
    if [[ "$RANDOM_REF_CURRENCY" == "1" ]] &>/dev/null; then
      REFERENCE_CURRENCY="BTC"
    fi
    # dump on usdt
    if [[ "$RANDOM_REF_CURRENCY" == "2" ]] &>/dev/null; then
      REFERENCE_CURRENCY="USDT"
    fi
    # dump on usdc
    if [[ "$RANDOM_REF_CURRENCY" == "3" ]] &>/dev/null; then
      REFERENCE_CURRENCY="USDC"
    fi
    # dump on every reference available
