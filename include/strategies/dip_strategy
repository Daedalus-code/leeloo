#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# exit strategy if any error
set -e

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# get strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"

################################################################################

log_date

################################################################################
# dip strategy configuration (static)
################################################################################

STRATEGY_TYPE="DIP"

# exchange template
EXCHANGE_API="$(egrep "EXCHANGE_API=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum dip percentage (default 5%)
MIN_DIP_PERCENTAGE="$(egrep "MIN_DIP_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum spread percentage (default 15%)
MIN_SPREAD_PERCENTAGE="$(egrep "MIN_SPREAD_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# define the markets to consider
DIP_MARKETS="$(egrep "DIP_MARKETS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# max open orders (default 10)
DIP_MAX_ORDERS="$(egrep "DIP_MAX_ORDERS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# dip max age (default 600 seconds)
DIP_MAX_AGE="$(egrep "DIP_MAX_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"

################################################################################
# exchange template
################################################################################

exchange_template

################################################################################
# data
################################################################################

last_tx # last tx

################################################################################

if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target ]] &>/dev/null; then
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
fi

DIP_TARGET_COUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target | wc -l)"

if [[ -z "$DIP_TARGET_COUNT" ]] &>/dev/null; then
  DIP_TARGET_COUNT="0"
fi

if [[ -z "$TX_ID_LAST" ]] &>/dev/null; then
  TX_ID_LAST="null"
fi

################################################################################

# get data
echo "Market(s).............: $DIP_TARGET_COUNT

Last_Order.txid.......: $TX_ID_LAST" | column -t >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".data 2>>"${LOG_ERROR:?}"

################################################################################

open_positions

################################################################################

DIP_MARKET_FILE_AGE="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

if [[ -z "$DIP_MARKET_FILE_AGE" ]] &>/dev/null; then
  DIP_MARKET_FILE_AGE="0"
fi

if [[ "$DIP_MARKET_FILE_AGE" -gt "$DIP_MAX_AGE" ]] &>/dev/null; then

  # reset target
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null

  DIP_STATUS_SEARCH="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Searching market!"

  ##############################################################################

  echo "$DIP_STATUS_SEARCH" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################

  # read the market data file line by line
  while IFS= read -r line; do

    # extract the relevant fields from the line (southxchange)
    if [[ "$EXCHANGE_API" == "SXC" ]] &>/dev/null; then
      MARKET_FILE="${LOG_DIR:?}/leeloo/southxchange/prices"
      MARKET_PAIR=$(echo "$line" | awk '{print $1}')
      BUY_PRICE=$(echo "$line" | awk '{print $2}')
      SELL_PRICE=$(echo "$line" | awk '{print $3}')
      PERCENTAGE_CHANGE=$(echo "$line" | awk '{print $5}' | tr -d '%')
    fi

    # check if the market pair is in the list of desired markets
    for market in "${DIP_MARKETS[@]}"; do
      if [[ $MARKET_PAIR == *"$market"* ]]; then

        # calculate the dip threshold and spread threshold based on the percentages
        DIP_THRESHOLD=$(echo "scale=2; $BUY_PRICE * $MIN_DIP_PERCENTAGE" | bc)
        SPREAD_THRESHOLD=$(echo "scale=2; $BUY_PRICE * $MIN_SPREAD_PERCENTAGE" | bc)

        if (($(echo "$PERCENTAGE_CHANGE < 0" | bc -l))) && (($(echo "$PERCENTAGE_CHANGE <= -$MIN_DIP_PERCENTAGE" | bc -l))); then
          if [[ $SELL_PRICE != "N/A" ]] && (($(echo "$BUY_PRICE != 0" | bc -l))); then

            # calculate the spread and spread percentage
            SPREAD=$(echo "scale=2; $SELL_PRICE - $BUY_PRICE" | bc)
            SPREAD_PERCENT=$(echo "scale=2; ($SPREAD / $BUY_PRICE) * 100" | bc)

            if (($(echo "$SPREAD_PERCENT >= $MIN_SPREAD_PERCENTAGE" | bc -l))) && (($(echo "$DIP_THRESHOLD <= $PERCENTAGE_CHANGE * 100" | bc -l))) && (($(echo "$SPREAD_THRESHOLD <= $SPREAD * 100" | bc -l))); then
              # create order list
              echo "$MARKET_PAIR Buy: $BUY_PRICE Sell: $SELL_PRICE Dip: $PERCENTAGE_CHANGE% Spread: $SPREAD ($SPREAD_PERCENT%)" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
              # column file
              echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target | column -t)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
            fi
          fi
        fi

        break # exit the loop if the market pair is found in the list
      fi
    done

  done <"$MARKET_FILE"

  DIP_TARGET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target | awk '{ print $1 }')"

  if [[ -z "$DIP_TARGET_COUNT" ]] &>/dev/null; then
    DIP_TARGET_COUNT="0"
  fi
fi

################################################################################

if [[ "$(tail -"${DIP_MAX_AGE:?}" "${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null | grep -c "Searching market!")" -eq "1" ]] &>/dev/null; then
  DIP_STATUS_RESULT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Found $DIP_TARGET_COUNT target(s)!"
  echo "$DIP_STATUS_RESULT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
fi

################################################################################

save_orders
last_orders
sxc_backup_orders

################################################################################

robot_Log_cleanup

################################################################################

# END
