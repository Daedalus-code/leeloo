      # remove failed order (orders)
      echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>/dev/null | grep -v "$DIP_CHANGE_NAME/$DIP_REFERENCE_NAME")" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders
    fi
  fi

  ##############################################################################

