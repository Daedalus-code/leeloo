# function to extract values from the active list
extract_values() {
  CURRENCY=$1
  FIELD=$2
  VALUE=$(grep "$CURRENCY" <<<"$DIP_ACTIVE_LIST" | awk -F "| $FIELD: " '{print $2}' | awk '{print $1}')
  echo "$VALUE"
}

# function to calculate the age of the sold file
calculate_sold_file_age() {

  # input currency
  CURRENCY=$1

  # bought file path
  FILE_PATH_BOUGHT="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.bought"
  # sold file path
  FILE_PATH_SOLD="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.sold"

  # file exist
  if [[ -f "$FILE_PATH_BOUGHT" ]] &>/dev/null; then
    FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.bought"
  fi
  # file exist
  if [[ -f "$FILE_PATH_SOLD" ]] &>/dev/null; then
    FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY/${CURRENCY//\//_}.sold"
  fi

  if [[ -f "$FILE_PATH" ]] &>/dev/null; then
    LAST_EDIT=$(stat -c '%Y' "$FILE_PATH" 2>/dev/null)
    AGE_SECONDS=$(($(date +%s) - $LAST_EDIT))

    # if zero
    if [[ -z "$AGE_SECONDS" ]] &>/dev/null; then
      AGE_SECONDS="0"
    fi

    # positions age (hours:minutes:seconds)
    printf '%dh:%dm:%ds\n' $((AGE_SECONDS / 3600)) $((AGE_SECONDS % 3600 / 60)) $((AGE_SECONDS % 60))
  else
    echo "N/A"
  fi
}

