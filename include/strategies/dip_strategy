#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# exit strategy if any error
set -e

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# get strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"

################################################################################

log_date

################################################################################
# dip strategy configuration (static) BETA
################################################################################

STRATEGY_TYPE="DIP"

# exchange template
EXCHANGE_API="$(egrep "EXCHANGE_API=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum dip percentage (default 5%)
MIN_DIP_PERCENTAGE="$(egrep "MIN_DIP_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum spread percentage (default 10%)
MIN_SPREAD_PERCENTAGE="$(egrep "MIN_SPREAD_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum volume percentage (default 0.5)
MIN_VOLUME_PERCENTAGE="$(egrep "MIN_VOLUME_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# define the markets to consider
DIP_MARKETS="$(egrep "DIP_MARKETS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk '{ print $1 }' | awk -F= '{ print $2 }' | tr -d '"#')"
# max open orders (default 10)
DIP_MAX_ORDERS="$(egrep "DIP_MAX_ORDERS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# dip max age (default 600 seconds)
DIP_MAX_AGE="$(egrep "DIP_MAX_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"

################################################################################
# exchange template
################################################################################

exchange_template

################################################################################
# data
################################################################################

last_tx # last tx

################################################################################

if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market ]] &>/dev/null; then
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market &>/dev/null
fi
if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target ]] &>/dev/null; then
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
fi

DIP_MARKET_COUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | wc -l)"
DIP_TARGET_COUNT="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | wc -l)"
DIP_MARKET_SYMBOL="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market | awk '{ print $1 }' | awk -F/ '{ print $2 }' | tr -d ':()' | head -1)"
DIP_TARGET_MARKET="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | awk -FBuy: '{ print $2 }' | xargs)"

if [[ -z "$DIP_MARKET_COUNT" ]] &>/dev/null; then
  DIP_MARKET_COUNT="0"
fi
if [[ -z "$DIP_TARGET_COUNT" ]] &>/dev/null; then
  DIP_TARGET_COUNT="0"
fi
if [[ -z "$DIP_MARKET_SYMBOL" ]] &>/dev/null; then
  DIP_MARKET_SYMBOL="N/A"
fi
if [[ -z "$DIP_TARGET_MARKET" ]] &>/dev/null; then
  DIP_TARGET_MARKET="N/A"
fi
if [[ -z "$TX_ID_LAST" ]] &>/dev/null; then
  TX_ID_LAST="N/A"
fi

################################################################################

# get data
echo "Market(s).............: $DIP_MARKET_COUNT ($DIP_MARKET_SYMBOL)
Target(s).............: $DIP_TARGET_COUNT
Target.Market.........: $DIP_TARGET_MARKET

Last_Order.txid.......: $TX_ID_LAST" | column -t >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".data 2>>"${LOG_ERROR:?}"

################################################################################

open_positions

################################################################################

DIP_MARKET_FILE_AGE="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

if [[ -z "$DIP_MARKET_FILE_AGE" ]] &>/dev/null; then
  DIP_MARKET_FILE_AGE="0"
fi

################################################################################

DIP_MARKET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
DIP_TARGET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"

if [[ -z "$DIP_MARKET_COUNT" ]] &>/dev/null; then
  DIP_MARKET_COUNT="0"
fi
if [[ -z "$DIP_TARGET_COUNT" ]] &>/dev/null; then
  DIP_TARGET_COUNT="0"
fi

if [[ "$DIP_TARGET_COUNT" -gt "0" ]] &>/dev/null; then
  DIP_TARGET_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Potential Buy: $POTENTIAL_BUY_SYMBOL at Bid: $POTENTIAL_BUY_BID"
  DIP_STATUS_RESULT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Found $DIP_MARKET_COUNT $DIP_MARKETS Market(s) - $DIP_TARGET_COUNT Target(s)!"
  echo "$DIP_STATUS_RESULT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
  echo "$DIP_TARGET_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
fi

################################################################################

if [[ "$DIP_MARKET_FILE_AGE" -gt "$DIP_MAX_AGE" ]] &>/dev/null; then

  # reset markets, target
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BTC &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ETH &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".LTC &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BNB &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".USDT &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null

  if [[ -z "$DIP_MARKETS" ]] &>/dev/null; then

    # set by configuration (default)
    DIP_FILE_PATH="${LOG_DIR:?}/leeloo/southxchange/prices"
    DIP_MARKETS="BTC"

    # get big markets (BTC, ETH, LTC, BNB, USDT)
    grep "BTC" "${LOG_DIR:?}"/leeloo/southxchange/prices >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BTC
    grep "ETH" "${LOG_DIR:?}"/leeloo/southxchange/prices >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ETH
    grep "LTC" "${LOG_DIR:?}"/leeloo/southxchange/prices >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".LTC
    grep "BNB" "${LOG_DIR:?}"/leeloo/southxchange/prices >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BNB
    grep "USDT" "${LOG_DIR:?}"/leeloo/southxchange/prices >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".USDT

    # random market
    RANDOM_MARKET=$((((RANDOM % 5) + 1)))

    # set by random_market
    if [[ "$RANDOM_MARKET" == "1" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BTC | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.BTC"
      DIP_MARKETS="BTC"
    elif [[ "$RANDOM_MARKET" == "2" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ETH | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.ETH"
      DIP_MARKETS="ETH"
    elif [[ "$RANDOM_MARKET" == "3" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".LTC | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.LTC"
      DIP_MARKETS="LTC"
    elif [[ "$RANDOM_MARKET" == "4" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BNB | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.BNB"
      DIP_MARKETS="BNB"
    elif [[ "$RANDOM_MARKET" == "5" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".USDT | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.USDT"
      DIP_MARKETS="USDT"
    fi
  else
    if [[ ! -z "$DIP_MARKETS" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "$DIP_FILE_PATH" 2>/dev/null | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
    fi
  fi

  # error output
  if [[ -z "$DIP_MARKETS" ]] &>/dev/null; then
    echo "$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Exiting strategy! No market available!" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    exit
  fi

  ##############################################################################

  DIP_STATUS_SEARCH="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Searching :: Market: $DIP_MARKETS +$DIP_MARKET_LIST"

  ##############################################################################

  echo "$DIP_STATUS_SEARCH" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################

  # variables for potential buy recommendation (default)
  POTENTIAL_BUY_SYMBOL=""
  POTENTIAL_BUY_BID="0"

  # read the file line by line
  while IFS= read -r line; do

    # extract relevant information from the line
    SYMBOL=$(echo "$line" | awk '{print $1}')
    BID=$(echo "$line" | awk '{print $2}')
    ASK=$(echo "$line" | awk '{print $3}')
    LAST=$(echo "$line" | awk '{print $4}')
    DIP=$(echo "$line" | awk '{print $5}' | sed 's/%//')
    VOLUME_PERCENTAGE=$(echo "$line" | awk '{print $6}' | sed 's/%//')

    # check if the symbol matches the specified market and if the spread, dip, and volume meet the criteria
    if [[ "$SYMBOL" == *"$DIP_MARKETS"* ]] && (($(echo "$DIP < -$MIN_DIP_PERCENTAGE" | bc -l))) && (($(echo "$VOLUME_PERCENTAGE > $MIN_VOLUME_PERCENTAGE" | bc -l))); then
      if [[ $BID != "0" ]] && [[ $BID != "0.000000000" ]]; then
        SPREAD=$(bc <<<"scale=2; ($ASK - $BID) / $BID * 100")
        if (($(echo "$SPREAD > $MIN_SPREAD_PERCENTAGE" | bc -l))); then
          PRICE_MOVEMENT=$(bc <<<"scale=2; ($LAST - $BID) / $BID * 100")
          VOLUME_PERCENTAGE="$(echo "$VOLUME_PERCENTAGE" | awk '{ printf "%.2f\n", $1 }')"
          echo "$SYMBOL | Bid: $BID | Ask: $ASK | Dip: $DIP% | Spread: $SPREAD% | Price Movement: $PRICE_MOVEMENT% | Volume: $VOLUME_PERCENTAGE%" | sed '/^$/d' >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market

          # check if the symbol meets the potential buy criteria
          if (($(echo "$PRICE_MOVEMENT > 0" | bc -l))); then
            if (($(echo "$BID < $POTENTIAL_BUY_BID" | bc -l))) || [[ -z "$POTENTIAL_BUY_SYMBOL" ]]; then
              POTENTIAL_BUY_SYMBOL=$SYMBOL
              POTENTIAL_BUY_BID=$BID
            fi
          fi
        fi
      fi
    fi
  done <"$DIP_FILE_PATH"

  # clean up file for duplicates
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | awk '!a[$0]++' | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market

  ##############################################################################

  if [[ -z "$POTENTIAL_BUY_SYMBOL" ]] &>/dev/null; then
    POTENTIAL_BUY_SYMBOL="N/A"
  fi
  if [[ -z "$POTENTIAL_BUY_BID" ]] &>/dev/null; then
    POTENTIAL_BUY_BID="N/A"
  fi

  DIP_TARGET_OUTPUT="Potential Buy: $POTENTIAL_BUY_SYMBOL at Bid: $POTENTIAL_BUY_BID"

  ##############################################################################

  # provide potential buy recommendation if any
  if [[ -n "$POTENTIAL_BUY_SYMBOL" ]] &>/dev/null; then
    echo "$DIP_TARGET_OUTPUT" | sed '/^$/d' >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
    # clean up file for duplicates
    echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | awk '!a[$0]++' | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
  fi
fi

################################################################################

save_orders
last_orders
sxc_backup_orders

################################################################################

robot_Log_cleanup

################################################################################

# END
