  echo "$(grep -vf "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".search "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices.dip)" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices.dip

