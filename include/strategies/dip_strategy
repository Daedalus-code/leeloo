#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# exit strategy if any error
set -e

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# get strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"

################################################################################

log_date

################################################################################
# dip strategy configuration (static) BETA
################################################################################

STRATEGY_TYPE="DIP"

# exchange template
EXCHANGE_API="$(egrep "EXCHANGE_API=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum dip percentage (default 5%)
MIN_DIP_PERCENTAGE="$(egrep "MIN_DIP_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum spread percentage (default 10%)
MIN_SPREAD_PERCENTAGE="$(egrep "MIN_SPREAD_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum volume percentage (default 0.5)
MIN_VOLUME_PERCENTAGE="$(egrep "MIN_VOLUME_PERCENTAGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# define the markets to consider
DIP_MARKETS="$(egrep "DIP_MARKETS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk '{ print $1 }' | awk -F= '{ print $2 }' | tr -d '"#')"
# dip allocated (1% of balance)
DIP_ALLOCATED="$(egrep "DIP_ALLOCATED=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# max open orders (default 10)
DIP_MAX_ORDERS="$(egrep "DIP_MAX_ORDERS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# dip max age (default 600 seconds)
DIP_MAX_AGE="$(egrep "DIP_MAX_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"

################################################################################
# exchange template
################################################################################

exchange_template

################################################################################
# data
################################################################################

last_tx # last tx

################################################################################

if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market ]] &>/dev/null; then
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market &>/dev/null
fi
if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target ]] &>/dev/null; then
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
fi

################################################################################

# potential data
POTENTIAL_BUY_SYMBOL="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".potential 2>/dev/null | awk '{ print $1 }')"
POTENTIAL_BUY_BID="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".potential 2>/dev/null | awk '{ print $2 }')"
POTENTIAL_BUY_ASK="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".potential 2>/dev/null | awk '{ print $3 }')"

################################################################################

# market count
DIP_MARKET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
# target count
DIP_TARGET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"

if [[ -z "$DIP_MARKET_COUNT" ]] &>/dev/null; then
  DIP_MARKET_COUNT="0"
fi
if [[ -z "$DIP_TARGET_COUNT" ]] &>/dev/null; then
  DIP_TARGET_COUNT="0"
fi

################################################################################

# market symbol
DIP_MARKET_SYMBOL="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market | awk '{ print $1 }' | awk -F/ '{ print $2 }' | tr -d ':()' | head -1)"
# target market
DIP_TARGET_MARKET="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | awk -FBuy: '{ print $2 }' | xargs)"

if [[ -z "$DIP_MARKET_SYMBOL" ]] &>/dev/null; then
  DIP_MARKET_SYMBOL="N/A"
fi
if [[ -z "$DIP_TARGET_MARKET" ]] &>/dev/null; then
  DIP_TARGET_MARKET="N/A"
fi

################################################################################

if [[ -z "$TX_ID_LAST" ]] &>/dev/null; then
  TX_ID_LAST="N/A"
fi

################################################################################

# get data
echo "Market(s).............: $DIP_MARKET_COUNT ($DIP_MARKET_SYMBOL)
Target(s).............: $DIP_TARGET_COUNT
Target.Market.........: $DIP_TARGET_MARKET

Last_Order.txid.......: $TX_ID_LAST" | column -t >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".data 2>>"${LOG_ERROR:?}"

################################################################################

open_positions

################################################################################

DIP_MARKET_FILE_AGE="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

if [[ -z "$DIP_MARKET_FILE_AGE" ]] &>/dev/null; then
  DIP_MARKET_FILE_AGE="0"
fi

################################################################################

# not available
if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | awk '{ print $1 }')" == "N/A" ]] &>/dev/null; then
  # reset data
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
fi

################################################################################

DIP_TARGET_COUNT="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"

# target count greater than n
if [[ "$DIP_TARGET_COUNT" -gt "0" ]] &>/dev/null; then
  # reset data
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market &>/dev/null
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target &>/dev/null
  # target output
  DIP_TARGET_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Potential :: Buying: $POTENTIAL_BUY_SYMBOL at Bid: $POTENTIAL_BUY_BID"
  echo "$DIP_TARGET_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
fi

################################################################################

# file age greater than max age
if [[ "$DIP_MARKET_FILE_AGE" -gt "$DIP_MAX_AGE" ]] &>/dev/null; then

  # disregard markets w active orders
  if [[ "$(egrep -c "[A-Z]+" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active)" -gt "0" ]] &>/dev/null; then
    DIP_LIST="$(egrep -vf "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active "${LOG_DIR:?}"/leeloo/southxchange/prices 2>/dev/null)"
    echo "$DIP_LIST" >"${LOG_DIR:?}"/leeloo/southxchange/prices.dip
  else
    cp "${LOG_DIR:?}"/leeloo/southxchange/prices "${LOG_DIR:?}"/leeloo/southxchange/prices.dip &>/dev/null
  fi

  # set by configuration (default)
  DIP_FILE_PATH="${LOG_DIR:?}/leeloo/southxchange/prices.dip"

  if [[ ! -z "$DIP_MARKETS" ]] &>/dev/null; then
    # get market (config)
    egrep -w "$DIP_MARKETS" "${LOG_DIR:?}"/leeloo/southxchange/prices.dip >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"."${DIP_MARKETS:?}"
    DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.${DIP_MARKETS:?}"
    DIP_MARKET_LIST="$(wc -l "$DIP_FILE_PATH" 2>/dev/null | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
  fi

  # config not set do random markets
  if [[ -z "$DIP_MARKETS" ]] &>/dev/null; then

    # get big markets (BTC, ETH, LTC, BNB, USDT)
    egrep -w "BTC" "${LOG_DIR:?}"/leeloo/southxchange/prices.dip >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BTC
    egrep -w "ETH" "${LOG_DIR:?}"/leeloo/southxchange/prices.dip >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ETH
    egrep -w "LTC" "${LOG_DIR:?}"/leeloo/southxchange/prices.dip >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".LTC
    egrep -w "BNB" "${LOG_DIR:?}"/leeloo/southxchange/prices.dip >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BNB
    egrep -w "USDT" "${LOG_DIR:?}"/leeloo/southxchange/prices.dip >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".USDT

    # random market n
    RANDOM_MARKET=$((((RANDOM % 5) + 1)))

    # bitcoin market
    if [[ "$RANDOM_MARKET" == "1" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BTC | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.BTC"
      DIP_MARKETS="BTC"
      # ethereum market
    elif [[ "$RANDOM_MARKET" == "2" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ETH | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.ETH"
      DIP_MARKETS="ETH"
      # litecoin market
    elif [[ "$RANDOM_MARKET" == "3" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".LTC | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.LTC"
      DIP_MARKETS="LTC"
      # binance market
    elif [[ "$RANDOM_MARKET" == "4" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".BNB | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.BNB"
      DIP_MARKETS="BNB"
      # tether market
    elif [[ "$RANDOM_MARKET" == "5" ]] &>/dev/null; then
      DIP_MARKET_LIST="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".USDT | awk '{ print $1 }' | awk '{ printf "%.0f\n", $1 }')"
      DIP_FILE_PATH="${SYS_DIR:?}/robot/$BASENAME_STRATEGY.USDT"
      DIP_MARKETS="USDT"
    fi
  fi

  # error output
  if [[ -z "$DIP_MARKETS" ]] &>/dev/null; then
    echo "$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Exiting strategy! No market available!" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    exit
  fi

  ##############################################################################

  DIP_STATUS_SEARCH="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Searching :: Market: $DIP_MARKETS +$DIP_MARKET_LIST"

  ##############################################################################

  echo "$DIP_STATUS_SEARCH" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

  ##############################################################################

  # variables for potential buy recommendation (default)
  POTENTIAL_BUY_SYMBOL=""
  POTENTIAL_BUY_BID="0"

  # read the file line by line
  while IFS= read -r line; do

    # extract relevant information from the line
    SYMBOL=$(echo "$line" | awk '{print $1}')
    BID=$(echo "$line" | awk '{print $2}')
    ASK=$(echo "$line" | awk '{print $3}')
    LAST=$(echo "$line" | awk '{print $4}')
    DIP=$(echo "$line" | awk '{print $5}' | sed 's/%//')
    VOLUME_PERCENTAGE=$(echo "$line" | awk '{print $6}' | sed 's/%//')

    # check if the symbol matches the specified market and if the spread, dip, and volume meet the criteria
    if [[ "$SYMBOL" == *"$DIP_MARKETS"* ]] && (($(echo "$DIP < -$MIN_DIP_PERCENTAGE" | bc -l))) && (($(echo "$VOLUME_PERCENTAGE > $MIN_VOLUME_PERCENTAGE" | bc -l))); then
      if [[ $BID != "0" ]] && [[ $BID != "0.000000000" ]]; then
        SPREAD=$(bc <<<"scale=2; ($ASK - $BID) / $BID * 100")
        if (($(echo "$SPREAD > $MIN_SPREAD_PERCENTAGE" | bc -l))); then
          PRICE_MOVEMENT=$(bc <<<"scale=2; ($LAST - $BID) / $BID * 100")
          VOLUME_PERCENTAGE="$(echo "$VOLUME_PERCENTAGE" | awk '{ printf "%.2f\n", $1 }')"

          # correct market
          if [[ "$(echo "$SYMBOL" | egrep -c "$DIP_MARKETS")" -gt "0" ]] &>/dev/null; then
            # create potential market
            echo "$SYMBOL | Bid: $BID | Ask: $ASK | Dip: $DIP% | Spread: $SPREAD% | Price Movement: $PRICE_MOVEMENT% | Volume: $VOLUME_PERCENTAGE%" | sed '/^$/d' >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market
          fi

          # check if the symbol meets the potential buy criteria
          if (($(echo "$PRICE_MOVEMENT > 0" | bc -l))); then
            if (($(echo "$BID < $POTENTIAL_BUY_BID" | bc -l))) || [[ -z "$POTENTIAL_BUY_SYMBOL" ]]; then

              # potential symbol, bid
              POTENTIAL_BUY_SYMBOL="$SYMBOL"
              POTENTIAL_BUY_BID="$BID"
              POTENTIAL_BUY_ASK="$ASK"

              # create potential file
              echo "$POTENTIAL_BUY_SYMBOL $POTENTIAL_BUY_BID $POTENTIAL_BUY_ASK" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".potential
            fi
          fi
        fi
      fi
    fi
  done <"$DIP_FILE_PATH"

  # get only specific market, lean up file for duplicates, remove empty lines
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market 2>/dev/null | grep "$DIP_MARKETS" | awk '!a[$0]++' | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market

  ##############################################################################

  # buy, sell trigger (default)
  BUY_SELL_TRIGGER="NO"

  # provide potential buy recommendation if any
  if [[ -n "$POTENTIAL_BUY_SYMBOL" ]] &>/dev/null; then
    # buy, sell trigger
    BUY_SELL_TRIGGER="OK"

    # target output
    DIP_TARGET_OUTPUT="$POTENTIAL_BUY_SYMBOL $POTENTIAL_BUY_BID"
    echo "$DIP_TARGET_OUTPUT" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target

    # clean up file for duplicates, remove empty lines
    echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | awk '!a[$0]++' | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
  fi
fi

################################################################################

# create active order
echo "$POTENTIAL_BUY_SYMBOL" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active
# clean up file for not available, symbol, duplicates, remove empty lines, sort
echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | grep -v "N/A" | tr -d ':' | awk '!a[$0]++' | sort | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active

################################################################################

# buy, sell trigger
if [[ "$BUY_SELL_TRIGGER" == "OK" ]] &>/dev/null; then
  # check if target is active
  DIP_TARGET_NAME="$(echo "$POTENTIAL_BUY_SYMBOL" | tr -d ':')"
  DIP_TARGET_BID="$POTENTIAL_BUY_BID"
  DIP_TARGET_ASK="$POTENTIAL_BUY_ASK"

  # get listing, reference
  DIP_TARGET_LISTING="$(echo "$DIP_TARGET_NAME" | awk -F/ '{ print $1 }')"
  DIP_TARGET_REFERENCE="$(echo "$DIP_TARGET_NAME" | awk -F/ '{ print $2 }')"

  # variables for southxchange template
  LISTING_CURRENCY="$DIP_TARGET_LISTING"
  REFERENCE_CURRENCY="$DIP_TARGET_REFERENCE"

  # get pair
  DIP_TARGET_PAIR="$DIP_TARGET_LISTING $DIP_TARGET_REFERENCE"
  # get market balance listing (target)
  DIP_MARKET_BALANCE_LISTING="$(grep "$DIP_TARGET_LISTING" "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null | awk '{ print $2 }')"
  # get market balance reference (market)
  DIP_MARKET_BALANCE_REFERENCE="$(grep "$DIP_TARGET_REFERENCE" "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null | awk '{ print $2 }')"

  # calculate dip allocated
  DIP_ALLOCATED="$(echo "$DIP_ALLOCATED/100" | bc -l 2>/dev/null)"
  # calculate dip allocated listing (target)
  DIP_AMOUNT_LISTING="$(echo "$DIP_ALLOCATED*$DIP_MARKET_BALANCE_LISTING" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # calculate dip allocated reference (market)
  DIP_AMOUNT_REFERENCE="$(echo "$DIP_ALLOCATED*$DIP_MARKET_BALANCE_REFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

  ##############################################################################

  MARKET_DIP_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $DIP_TARGET_PAIR :: Limit $DIP_AMOUNT_REFERENCE $DIP_TARGET_REFERENCE :: Buy"

  ##############################################################################
  # BUY ORDER
  # placeOrder limit ###########################################################
  PLACE_ORDER="$(placeOrder_limit "buy" "$DIP_TARGET_PAIR" "$DIP_TARGET_BID" "$DIP_AMOUNT_REFERENCE" "false")"
  # output
  echo "$MARKET_DIP_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
  # tx_id BETA
  # remove duplicates
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

  ##############################################################################

  MARKET_DIP_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $DIP_TARGET_PAIR :: Limit $DIP_AMOUNT_LISTING $DIP_TARGET_LISTING :: Sell"

  ##############################################################################

  # update balances
  echo "$(listBalances | jq -r '.[] | "\(.Currency): \(.Deposited) \(.Available) \(.Unconfirmed)"' 2>/dev/null | awk '{printf "%s %.8f %.8f %.8f\n", $1, $2, $3, $4}' | column -t)" >"${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null
  DIP_MARKET_BALANCE_LISTING="$(grep "$DIP_TARGET_LISTING" "${LOG_DIR:?}"/leeloo/southxchange/balances 2>/dev/null | awk '{ print $2 }')"

  if [[ "$(echo "$DIP_MARKET_BALANCE_LISTING" | egrep "[0-9]+.[0-9]+" | tr -d '.' | sed 's/^0*//')" -gt "0" ]] &>/dev/null; then

    ############################################################################
    # SELL ORDER
    # placeOrder limit #########################################################
    PLACE_ORDER="$(placeOrder_limit "sell" "$DIP_TARGET_PAIR" "$DIP_TARGET_ASK" "$DIP_MARKET_BALANCE_LISTING" "false")"
    # output
    echo "$MARKET_DIP_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    # tx_id BETA
    # remove duplicates
    echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
  fi
fi

################################################################################

if [[ "$(grep -c "$POTENTIAL_BUY_SYMBOL" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active)" -gt "0" ]] &>/dev/null; then
  truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".potential &>/dev/null
fi

################################################################################

save_orders
last_orders
sxc_backup_orders

################################################################################

robot_Log_cleanup

################################################################################

# END
