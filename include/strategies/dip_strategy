function remove_ghost_orders() {

  # oldest order by listing
  DIP_GHOST_LISTING="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders 2>/dev/null | head -1 | awk '{ print $6 }')"
  # oldest order by reference
  DIP_GHOST_REFERENCE="$REFERENCE_CURRENCY"

  # if any data
  if [[ -n "$DIP_GHOST_LISTING" && -n "$DIP_GHOST_REFERENCE" ]] &>/dev/null; then

    # order status id
    DIP_ORDER_STATUS_ID="$(grep -w "$DIP_GHOST_REFERENCE" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -w "$DIP_GHOST_LISTING" | awk '{ print $1 }' | tr -d ':' | head -1)"
    # newest order
    DIP_ORDER_NEWEST="$(tail -1 "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | awk '{ print $1 }' | tr -d ':')"

    # if order id exist, if not the newest one
    if [[ -n "$DIP_ORDER_STATUS_ID" && ! "$DIP_ORDER_STATUS_ID" == "$DIP_ORDER_NEWEST" ]] &>/dev/null; then

      # calculate the age of target orders file in seconds
      TARGET_ORDERS_AGE_SECONDS=$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/"${DIP_GHOST_LISTING:?}"_"${DIP_GHOST_REFERENCE:?}".trades 2>/dev/null || echo 0)

      # check if target orders data is old enough or doesn't exist
      if ((TARGET_ORDERS_AGE_SECONDS > 180)) || [[ ! -f "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/"${DIP_GHOST_LISTING:?}"_"${DIP_GHOST_REFERENCE:?}".trades ]]; then
        # get trades data and format it
        getTrades "$DIP_GHOST_LISTING" "$DIP_GHOST_REFERENCE" | jq -r '.[]? | "\(.id): \(.market) \(.orderid) \(.side) \(.price) \(.quantity) \(.createdAt) \(.updatedAt)"' | column -t >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/"${DIP_GHOST_LISTING:?}"_"${DIP_GHOST_REFERENCE:?}".trades
        # get orders data, remove duplicate ID
        cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders* 2>/dev/null | grep -w "$DIP_GHOST_LISTING" | grep -w "$DIP_GHOST_REFERENCE" | awk '!a[$1]++' >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/"${DIP_GHOST_LISTING:?}"_"${DIP_GHOST_REFERENCE:?}".orders
      fi

      # time now (epoch)
      DIP_EPOCH_TIME_NOW="$(date '+%s' | awk '{ printf "%.10f\n", $1 }')"

      # bought trade time (epoch)
      DIP_BOUGHT_TRADE_TIME="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/"$DIP_GHOST_LISTING"_"$DIP_GHOST_REFERENCE".trades 2>/dev/null | grep "buy" | awk '{ print $NF }' | head -1)"
      # sold trade time (epoch)
      DIP_SOLD_TRADE_TIME="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/"$DIP_GHOST_LISTING"_"$DIP_GHOST_REFERENCE".trades 2>/dev/null | grep "sell" | awk '{ print $NF }' | head -1)"

      # bought age (seconds)
      DIP_BOUGHT_GHOST_AGE_SECONDS="$(echo "${DIP_EPOCH_TIME_NOW:0:10}-${DIP_BOUGHT_TRADE_TIME:0:10}" | bc 2>/dev/null)"
      # sold age (seconds)
      DIP_SOLD_GHOST_AGE_SECONDS="$(echo "${DIP_EPOCH_TIME_NOW:0:10}-${DIP_SOLD_TRADE_TIME:0:10}" | bc 2>/dev/null)"

      # if zero
      if [[ -z "$DIP_BOUGHT_GHOST_AGE_SECONDS" ]] &>/dev/null; then
        DIP_BOUGHT_GHOST_AGE_SECONDS="0"
      fi

      # if zero
      if [[ -z "$DIP_SOLD_GHOST_AGE_SECONDS" ]] &>/dev/null; then
        DIP_SOLD_GHOST_AGE_SECONDS="0"
      fi

      # bought file age (days)
      DIP_BOUGHT_GHOST_AGE_DAYS="$(echo "$DIP_BOUGHT_GHOST_AGE_SECONDS/86400" | bc 2>/dev/null)"
      # sold file age (days)
      DIP_SOLD_GHOST_AGE_DAYS="$(echo "$DIP_SOLD_GHOST_AGE_SECONDS/86400" | bc 2>/dev/null)"

      # order status as active (check)
      DIP_ORDER_STATUS_ACTIVE="$(grep -c "$DIP_GHOST_LISTING/$DIP_GHOST_REFERENCE" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active || true)"

      time_and_profit

      # if trades has only selling data available, if bought and sold is too old (ruled by configuration * 3)
      if [[ -z "$DIP_BOUGHT_TRADE_TIME" && -n "$DIP_SOLD_TRADE_TIME" || "$DIP_BOUGHT_GHOST_AGE_DAYS" -gt "$(echo "$DIP_MAX_BUY_AGE*3" | bc 2>/dev/null | awk -F. '{ print $1 }')" && "$DIP_BOUGHT_GHOST_AGE_DAYS" -gt "$(echo "$DIP_MAX_SELL_AGE*3" | bc 2>/dev/null | awk -F. '{ print $1 }')" ]] &>/dev/null; then
        # if order status as active equal null
        if [[ "$DIP_ORDER_STATUS_ACTIVE" -eq "0" ]] &>/dev/null; then

          # cancel ghost order
          cancelOrder "$DIP_ORDER_STATUS_ID" 2>>"${LOG_ERROR:?}"

          # order n greater than n
          if [[ "$(echo "$DIP_ORDER_STATUS_ID" | wc -L)" -gt "9" ]] &>/dev/null; then
            DIP_ORDER_ID_DOTS=".."
          else
            DIP_ORDER_ID_DOTS=""
          fi

          # reset all files (reset data, age)
          truncate -s 0 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${DIP_GHOST_LISTING}"_"${DIP_GHOST_REFERENCE}".* &>/dev/null

          # removing ghost order output (log)
          DIP_ANCIENT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $DIP_GHOST_LISTING/$DIP_GHOST_REFERENCE :: Removing ghost order: ${DIP_ORDER_STATUS_ID:0:9}$DIP_ORDER_ID_DOTS (${DIP_BOUGHT_GHOST_AGE_DAYS:?}d/${DIP_SOLD_GHOST_AGE_DAYS:?}d)"
          echo "$DIP_ANCIENT_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"

          # pause ghost market (listing)
          echo "$DIP_GHOST_LISTING" | sed '/^$/d' >>"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/pause
        fi
      fi
    fi
  fi
}

