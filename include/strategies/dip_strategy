  ACTIVE_MARKET_PAIRS="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | awk '{ print $1 }' | awk -F/ '{ print $2 }' | tr -d ':' | sort -n | awk '!a[$0]++' | xargs)"

  ##############################################################################

  # buy count
  DIP_ORDER_BUY_COUNT="$(echo "$CAT_ORDERS_FILE" | grep -c "buy" || true)"

