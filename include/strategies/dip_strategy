  DIP_CHANGE_BALANCES="$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/balances 2>/dev/null | grep -v "$DIP_ACTIVE_ORDERS" | grep -v "$DIP_ACTIVE_BALANCES" | grep -v "$DIP_REFERENCE_CURRENCY:" | awk '{for(i=2;i<=NF;i++) if($i>0) {print; break}}')"

  ##############################################################################

