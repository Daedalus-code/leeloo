# market.list file output
CAT_MARKET_LIST_FILE="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market.list 2>/dev/null)"

# if zero
if [[ -z "$CAT_MARKET_LIST_FILE" ]] &>/dev/null; then
