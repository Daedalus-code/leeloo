  # dip markets (random)
  DIP_MARKETS="$(echo "$CAT_PRICES_DIP_FILE" | awk -F_ '{ print $2 }' | awk '{ print $1 }' | awk '!a[$1]++' | tr -d ':' | shuf | head -1)"
