    echo "$DIP_DUMP_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
  else
    echo "$DIP_DUMP_OUTPUT" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".ssr 2>>"${LOG_ERROR:?}"
  fi

  ##############################################################################
  ##############################################################################

  # if xeggex order
  if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
    # CreateOrder limit ########################################################
    PLACE_ORDER="$(CreateOrder "" "$DIP_DUMP_LISTING/$REFERENCE_CURRENCY" "sell" "market" "$DUMP_LISTING_BALANCE" "" "false")"
