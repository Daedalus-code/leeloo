#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# exit strategy if any error
set -e

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"

################################################################################

log_date

################################################################################
# dip strategy configuration (static) BETA (embrace chaos)
################################################################################

STRATEGY_TYPE="DIP"

# exchange template
EXCHANGE_API="$(egrep "EXCHANGE_API=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum dip percentage (default 5%)
DIP_MIN_DIP="$(egrep "DIP_MIN_DIP=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum spread percentage (default 10%)
DIP_MIN_SPREAD="$(egrep "DIP_MIN_SPREAD=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# minimum volume percentage (default 0.5%)
DIP_MIN_VOLUME="$(egrep "DIP_MIN_VOLUME=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# markets to consider
DIP_MARKETS="$(egrep "DIP_MARKETS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk '{ print $1 }' | awk -F= '{ print $2 }' | tr -d '"#')"
# dip allocated (1% of balance)
DIP_ALLOCATED="$(egrep "DIP_ALLOCATED=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# max open orders (default 10)
DIP_MAX_ORDERS="$(egrep "DIP_MAX_ORDERS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# dip margin (default 1)
DIP_MARGIN="$(egrep "DIP_MARGIN=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# dca (default false) 100=100%
DIP_DCA="$(egrep "DIP_DCA=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# disregard reference as targets
DIP_ALL_IN="$(egrep "DIP_ALL_IN=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# dip max age (default 600 seconds)
DIP_MAX_AGE="$(egrep "DIP_MAX_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# disregard other markets run by other bots
DIP_DISREGARD_BOTS="$(egrep "DIP_DISREGARD_BOTS=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# max buy order age (days)
DIP_OLD_ORDER_MAX="$(egrep "DIP_OLD_ORDER_MAX=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"

################################################################################
# exchange template
################################################################################

exchange_template

################################################################################
# data
################################################################################

tx_id_data # txid data
delisted   # delisted markets

################################################################################

# latest and oldest dip order data
function dip_order_data {
  # order data
  DIP_OLDEST_ORDER_DATA="$(echo "$CAT_ORDERS_FILE" | tail -1)"
  DIP_LATEST_ORDER_DATA="$(echo "$CAT_ORDERS_FILE" | head -1)"
  # order id
  DIP_LATEST_ORDER_ID="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $1 }' | tr -d ':')"
  DIP_OLDEST_ORDER_ID="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $1 }' | tr -d ':')"
  # order type
  DIP_LATEST_ORDER_TYPE="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $2 }')"
  DIP_OLDEST_ORDER_TYPE="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $2 }')"
  # order listing
  DIP_LATEST_ORDER_LISTING="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $6 }')"
  DIP_OLDEST_ORDER_LISTING="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $6 }')"
  # order reference
  DIP_LATEST_ORDER_REFERENCE="$(echo "$DIP_LATEST_ORDER_DATA" 2>/dev/null | awk '{ print $7 }')"
  DIP_OLDEST_ORDER_REFERENCE="$(echo "$DIP_OLDEST_ORDER_DATA" 2>/dev/null | awk '{ print $7 }')"

  # if zeros
  if [[ -z "$DIP_LATEST_ORDER_ID" ]] &>/dev/null; then
    DIP_LATEST_ORDER_ID="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_ID" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_ID="0"
  fi
  if [[ -z "$DIP_LATEST_ORDER_TYPE" ]] &>/dev/null; then
    DIP_LATEST_ORDER_TYPE="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_TYPE" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_TYPE="0"
  fi
  if [[ -z "$DIP_LATEST_ORDER_LISTING" ]] &>/dev/null; then
    DIP_LATEST_ORDER_LISTING="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_LISTING" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_LISTING="0"
  fi
  if [[ -z "$DIP_LATEST_ORDER_REFERENCE" ]] &>/dev/null; then
    DIP_LATEST_ORDER_REFERENCE="0"
  fi
  if [[ -z "$DIP_OLDEST_ORDER_REFERENCE" ]] &>/dev/null; then
    DIP_OLDEST_ORDER_REFERENCE="0"
  fi
}

################################################################################

# amount to buy sell
function amount_to_buy_sell() {

  # account allocated (n%)
  REFERENCE_ALLOCATED="$DIP_ALLOCATED"

  # if zero, use n%
  if [[ -z "$REFERENCE_ALLOCATED" ]] &>/dev/null; then
    REFERENCE_ALLOCATED="1" # n%
  fi

  # calculate dip allocated (configuration)
  REFERENCE_ALLOCATED="$(echo "$REFERENCE_ALLOCATED/100" | bc -l 2>/dev/null)"

  # reference balance (available)
  REFERENCE_BALANCE="$(grep -w "\<$REFERENCE_CURRENCY:" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/balances 2>/dev/null | awk '{ print $3 }' | awk '{ printf "%.9f\n", $1 }' | head -1)"
  # listing balance (available)
  LISTING_BALANCE="$(grep -w "\<$LISTING_CURRENCY:" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/balances 2>/dev/null | awk '{ print $3 }' | awk '{ printf "%.9f\n", $1 }' | head -1)"

  # reference balance (deposited)
  REFERENCE_BALANCE_DEPOSITED="$(grep -w "\<$REFERENCE_CURRENCY:" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/balances 2>/dev/null | awk '{ print $2 }' | awk '{ printf "%.9f\n", $1 }' | head -1)"
  # listing balance (deposited)
  LISTING_BALANCE_DEPOSITED="$(grep -w "\<$LISTING_CURRENCY:" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/balances 2>/dev/null | awk '{ print $2 }' | awk '{ printf "%.9f\n", $1 }' | head -1)"

  # if zero
  if [[ -z "$REFERENCE_BALANCE" ]] &>/dev/null; then
    REFERENCE_BALANCE="0.000000000"
  fi

  # if zero
  if [[ -z "$LISTING_BALANCE" ]] &>/dev/null; then
    LISTING_BALANCE="0.000000000"
  fi

  # calculate dip margin
  DIP_MARGIN="$(echo "$DIP_MARGIN/1000000000" | bc -l 2>/dev/null)"
  # price margin (default 1 = 0.000000001), buy with margin (positive)
  DIP_TARGET_BID="$(echo "$DIP_TARGET_BID+$DIP_MARGIN" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # price margin (default 1 = 0.000000001), sell with margin (negative)
  DIP_TARGET_ASK="$(echo "$DIP_TARGET_ASK-$DIP_MARGIN" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

  # amount for buy (reference)
  DIP_BUY_AMOUNT_REFERENCE="$(echo "$REFERENCE_ALLOCATED*$REFERENCE_BALANCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # amount to buy (listing)
  DIP_BUY_AMOUNT_LISTING="$(echo "$DIP_BUY_AMOUNT_REFERENCE/$DIP_TARGET_BID" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

  # amount to recieve(reference)
  DIP_GET_AMOUNT_REFERENCE="$(echo "$DIP_BUY_AMOUNT_LISTING*$DIP_TARGET_ASK" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # amount to profit (reference)
  DIP_GET_AMOUNT_PROFIT="$(echo "$DIP_GET_AMOUNT_REFERENCE-$DIP_BUY_AMOUNT_REFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
  # amount to profit (reference percentage)
  DIP_GET_RATIO_PROFIT="$(echo "100/$DIP_BUY_AMOUNT_REFERENCE*$DIP_GET_AMOUNT_PROFIT" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_GET_RATIO_PROFIT" ]] &>/dev/null; then
    DIP_GET_RATIO_PROFIT="0"
  fi

  # amount to profit (reference percentage, no decimal)
  DIP_GET_RATIO_PROFIT_CHECK="$(echo "$DIP_GET_RATIO_PROFIT" | tr -d '.' | sed 's/^0*//')"
}

################################################################################

# if not found
if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active ]] &>/dev/null; then
  # create active file
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active
fi
# if not found
if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target ]] &>/dev/null; then
  # create target file
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
fi

################################################################################

function cat_active_target() {
  # cat active data
  CAT_ACTIVE_FILE="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null)"
  # cat target data
  CAT_TARGET_FILE="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null)"
}

# cat active, target data
cat_active_target

################################################################################
# specific target & specific active variables
################################################################################

# target data for both target and active
function target_data() {

  # cat active, target data
  cat_active_target

  # use latest target
  if [[ "$TARGET_ACTIVE" == "TARGET" ]] &>/dev/null; then

    DIP_TARGET_FILE_OUTPUT="$(echo "$CAT_TARGET_FILE" | head -1)"

    # use active list
  elif [[ "$TARGET_ACTIVE" == "ACTIVE" ]] &>/dev/null; then

    DIP_TARGET_FILE_OUTPUT="$(echo "$CAT_ACTIVE_FILE" 2>/dev/null | shuf | head -1)"

    # if active has more lines than n
    if [[ "$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1 }')" -gt "10" ]] &>/dev/null; then
      # if search has more lines than n
      if [[ "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".search | sed '/^$/d' | wc -l)" -gt "0" ]] &>/dev/null; then
        # disregard with already searched markets
        DIP_TARGET_FILE_OUTPUT="$(grep -vf "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".search "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | shuf | tail -1)"
      fi
    fi
  fi

  ##############################################################################

  # target symbol
  DIP_TARGET_SYMBOL="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $1 }' | tr -d ':')"

  # listing (target from above)
  LISTING_CURRENCY="$(echo "$DIP_TARGET_SYMBOL" 2>/dev/null | awk -F/ '{ print $1 }')"
  # reference (market from above)
  REFERENCE_CURRENCY="$(echo "$DIP_TARGET_SYMBOL" 2>/dev/null | awk -F/ '{ print $2 }')"

  # target bid
  DIP_TARGET_BID="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $4 }')"
  # target ask
  DIP_TARGET_ASK="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $7 }')"
  # target last
  DIP_TARGET_LAST="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $10 }')"
  # target dip
  DIP_TARGET_DIP="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $13 }' | tr -d '%')"
  # target spread
  DIP_TARGET_SPREAD="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $16 }' | awk '{ printf "%.2f\n", $1 }')"
  # target price movement
  DIP_TARGET_PRICE_MOVEMENT="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $20 }' | tr -d '%')"
  # target volume
  DIP_TARGET_VOLUME="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $23 }')"

  ##############################################################################

  amount_to_buy_sell

  # target amount to buy and sell (listing)
  DIP_TARGET_AMOUNT="$(echo "$DIP_TARGET_FILE_OUTPUT" | awk '{ print $26 }' | awk '{ printf "%.9f\n", $1 }')"

  # if zero
  if [[ -z "$DIP_TARGET_AMOUNT" ]] &>/dev/null; then
    DIP_TARGET_AMOUNT="0"
  fi

  # if dca enabled
  if [[ "$DIP_DCA" -gt "0" ]] &>/dev/null; then
    # if market dca is found
    if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then
      # extra amount
      DIP_TARGET_DCA="$(grep "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca | awk '{ print $8 }' | tr -d '+')"
      # increase target amount
      DIP_TARGET_AMOUNT="$(echo "$DIP_TARGET_AMOUNT+$DIP_TARGET_DCA" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"
    fi
  fi
}

################################################################################
function bought_sold_age() {

  # if not zero
  if [[ ! -z "$LISTING_CURRENCY" || ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then

    # if not found
    if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought ]] &>/dev/null; then
      touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought &>/dev/null
    fi
    # if not found
    if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold ]] &>/dev/null; then
      touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold &>/dev/null
    fi

    # bought file age (seconds)
    DIP_BOUGHT_FILE_AGE_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

    # if zero
    if [[ -z "$DIP_BOUGHT_FILE_AGE_SECONDS" ]] &>/dev/null; then
      DIP_BOUGHT_FILE_AGE_SECONDS="0"
    fi

    # bought file age (days)
    DIP_BOUGHT_FILE_AGE_DAYS="$(echo "$DIP_BOUGHT_FILE_AGE_SECONDS/86400" | bc 2>/dev/null)"
    # sold file age (seconds)
    DIP_SOLD_FILE_AGE_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"

    # if zero
    if [[ -z "$DIP_SOLD_FILE_AGE_SECONDS" ]] &>/dev/null; then
      DIP_SOLD_FILE_AGE_SECONDS="0"
    fi

    # sold file age (days)
    DIP_SOLD_FILE_AGE_DAYS="$(echo "$DIP_SOLD_FILE_AGE_SECONDS/86400" | bc 2>/dev/null)"

    # bought file age (hours:minutes:seconds)
    DIP_BOUGHT_FILE_AGE=$(printf '%dh:%dm:%ds\n' $(("$DIP_BOUGHT_FILE_AGE_SECONDS/3600")) $(("$DIP_BOUGHT_FILE_AGE_SECONDS%3600/60")) $(("$DIP_BOUGHT_FILE_AGE_SECONDS%60")))
    DIP_BOUGHT_FILE_AGE_MINUTES="$(echo "$DIP_BOUGHT_FILE_AGE_SECONDS/60" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
    DIP_BOUGHT_FILE_AGE_HOURS="$(echo "$DIP_BOUGHT_FILE_AGE_SECONDS/3600" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"
    DIP_BOUGHT_FILE_AGE_DAYS="$(echo "$DIP_BOUGHT_FILE_AGE_SECONDS/86400" | bc -l 2>/dev/null | awk '{ printf "%.0f\n", $1 }')"

    # if greater than n seconds (day)
    if [[ "$DIP_BOUGHT_FILE_AGE_SECONDS" -gt "86400" ]] &>/dev/null; then
      DIP_BOUGHT_AGE_OUTPUT="${DIP_BOUGHT_FILE_AGE_DAYS:?}d"
      # if greater than n seconds (hours)
    elif [[ "$DIP_BOUGHT_FILE_AGE_SECONDS" -gt "3600" ]] &>/dev/null; then
      DIP_BOUGHT_AGE_OUTPUT="${DIP_BOUGHT_FILE_AGE_HOURS:?}h"
      # if greater than n seconds (minutes)
    elif [[ "$DIP_BOUGHT_FILE_AGE_SECONDS" -gt "60" ]] &>/dev/null; then
      DIP_BOUGHT_AGE_OUTPUT="${DIP_BOUGHT_FILE_AGE_MINUTES:?}m"
      # if less than n seconds (minutes)
    elif [[ "$DIP_BOUGHT_FILE_AGE_SECONDS" -lt "60" ]] &>/dev/null; then
      DIP_BOUGHT_AGE_OUTPUT="0m"
    fi

    # default after
    DIP_BOUGHT_AGE_OUTPUT_AFTER="$DIP_BOUGHT_AGE_OUTPUT"
  fi
}

################################################################################

function remove_old_dca() {
  # if dca enabled
  if [[ "$DIP_DCA" -gt "0" ]] &>/dev/null; then
    # if file exist
    if [[ -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca ]] &>/dev/null; then
      # if listing, reference has value
      if [[ -n "$LISTING_CURRENCY" || -n "$REFERENCE_CURRENCY" ]] &>/dev/null; then
        # if listing, reference already exist as dca order
        if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then

          ######################################################################
          ######################################################################

          echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca 2>/dev/null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY")" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca

          ######################################################################
          ######################################################################
        fi
      fi
    fi
  fi
}

################################################################################

function cancel_DCA() {
  # if listing, reference has data
  if [[ -n "$LISTING_CURRENCY" || -n "$REFERENCE_CURRENCY" ]] &>/dev/null; then
    # if dca exist
    if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca || true)" -eq "1" ]] &>/dev/null; then
      # if no order exist
      if [[ "$(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/orders | grep -c "$LISTING_CURRENCY" || true)" -eq "0" ]] &>/dev/null; then
        # if no active exist
        if [[ "$(grep "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active || true)" -eq "0" ]] &>/dev/null; then

          ######################################################################
          ######################################################################

          # remove obsolete dca
          echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca 2>/dev/null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY")" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca

          ######################################################################
          ######################################################################

          # if no_dca exist
          if [[ "$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca || true)" -eq "1" ]] &>/dev/null; then
            # remove old no_dca
            echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca 2>/dev/null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY")" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".no_dca
          fi
        fi
      fi
    fi
  fi
}

################################################################################

function clean_DCA() {

  # remove market duplicates
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca 2>/dev/null | awk '!a[$1]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca

  ##############################################################################
  ##############################################################################

  # remove listing duplicates, column
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca 2>/dev/null | awk -F/ '!a[$1]++' | column -t)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca

  ##############################################################################
  ##############################################################################

  # if active has data
  if [[ "$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active | awk '{ print $1 }')" -gt "0" ]] &>/dev/null; then
    # if dca has data
    if [[ "$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca | awk '{ print $1 }')" -gt "0" ]] &>/dev/null; then
      # remove old dca
      echo "$(awk -F'[:[:space:]]+' 'NR==FNR { active[$1]; next } $1 in active' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".dca
    fi
  fi
}

################################################################################
# market prices
################################################################################

# create price.dip file, only print lines with bids that are less than ask
cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices 2>/dev/null | awk '{if ($2 < $3) print}' >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices.dip

# if xeggex api, change _ into /
if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
  echo "$(cat "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices.dip 2>/dev/null | sed 's/\([A-Za-z0-9]\+\)_\([A-Za-z0-9]\+\):/\1\/\2:/g')" >"${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices.dip
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market.list 2>/dev/null | sed 's/\([A-Za-z0-9]\+\)_\([A-Za-z0-9]\+\):/\1\/\2:/g')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".market.list
  echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target 2>/dev/null | sed 's/\([A-Za-z0-9]\+\)_\([A-Za-z0-9]\+\):/\1\/\2:/g')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".target
fi

################################################################################

# disregard already active bots from market (orders)
if [[ "$(egrep -c "[0-9]+" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active || true)" -gt "0" ]] &>/dev/null; then

  # random n
  RANDOM_CLEARED_MARKET=$((((RANDOM % 2) + 1)))

  # disregard already active markets (positions)
  if [[ "$RANDOM_CLEARED_MARKET" == "1" ]] &>/dev/null; then

    # set the paths for the files
    PRICES_FILE="${LOG_DIR}/leeloo/$EXCHANGE_DIR_NAME/prices.dip"

    # extract the active markets from active file
    ALREADY_ACTIVE_BOTS="$(egrep -o "[A-Z]+/[A-Z]+|[0-9]+/[0-9]+|[A-Z]+[0-9]+/[A-Z]+[0-9]+|[0-9]+[A-Z]+/[0-9]+[A-Z]+" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active)"

    # filter out markets with found data
    grep -vf <(echo "$ALREADY_ACTIVE_BOTS") "$PRICES_FILE" >"${PRICES_FILE}.temp"
    # replace the original prices file with the filtered version
    mv "${PRICES_FILE}.temp" "$PRICES_FILE"
  fi
fi

################################################################################

# if zero
if [[ -z "$DIP_DISREGARD_BOTS" ]] &>/dev/null; then
  DIP_DISREGARD_BOTS="1"
fi

# disregard already running bots from market (strategies)
if [[ "$DIP_DISREGARD_BOTS" == "1" ]] &>/dev/null; then

  # set the paths for the files
  ROBOT_LOG="${LOG_DIR}/leeloo/robot.log"
  PRICES_FILE="${LOG_DIR}/leeloo/$EXCHANGE_DIR_NAME/prices.dip"

  # extract the running markets from robot.log file
  ALREADY_RUNNING_BOTS=$(tail -100 "$ROBOT_LOG" 2>/dev/null | awk '!/All|DIP/ {print $7}' | awk '!a[$0]++' | egrep -o "[A-Z]+/[A-Z]+|[0-9]+/[0-9]+|[A-Z]+[0-9]+/[A-Z]+[0-9]+|[0-9]+[A-Z]+/[0-9]+[A-Z]+")

  # filter out markets with found data
  grep -vf <(echo "$ALREADY_RUNNING_BOTS") "$PRICES_FILE" >"${PRICES_FILE}.temp"
  # replace the original prices file with the filtered version
  mv "${PRICES_FILE}.temp" "$PRICES_FILE"
fi

################################################################################

# if zero
if [[ -z "$DIP_ALL_IN" ]] &>/dev/null; then
  DIP_ALL_IN="0"
fi

# disregard reference as targets (markets)
if [[ "$DIP_ALL_IN" == "0" ]] &>/dev/null; then

  # set the paths for the files
  PRICES_FILE_RAW="${LOG_DIR}/leeloo/$EXCHANGE_DIR_NAME/prices"
  PRICES_FILE="${LOG_DIR}/leeloo/$EXCHANGE_DIR_NAME/prices.dip"

  # extract the reference markets from prices
  ALREADY_REFERENCE_MARKETS=$(awk -F'[:/[:blank:]]+' '{ print $2 }' "$PRICES_FILE_RAW" | awk '!a[$0]++')

  # filter out markets with found data using awk
  awk -F'[:/[:blank:]]+' -v refs="$ALREADY_REFERENCE_MARKETS" '
    BEGIN {
      n = split(refs, ref_arr, "\n");
      for (i = 1; i <= n; i++) {
        reference[ref_arr[i]] = 1;
      }
    }
    $1 in reference { next }
    { print }
  ' "$PRICES_FILE" >"${PRICES_FILE}.temp"
  # replace the original prices file with the filtered version
  mv "${PRICES_FILE}.temp" "$PRICES_FILE"
fi

