  DIP_ACTIVE_ORDERS="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".active 2>/dev/null | tr '/' ' ' | tr '_' ' ' | awk '{ print $1 }' | awk '!a[$1]++')"
