  LISTING_PRICE="$(grep "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/robot.log 2>/dev/null | egrep -o "[0-9]+.[0-9]+ Bullish|[0-9]+.[0-9]+ Bearish" | egrep "[0-9]+.[0-9]+" | grep -v "0.000000000" | awk '{ print $1 }' | awk '!a[$0]++' | tail -5 | sort -R | tail -1)"
