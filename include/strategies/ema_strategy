#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# exit strategy if any error
set -e

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# indicators
source /usr/local/bin/include/leeloo/indicators/ema

################################################################################

# get strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"

################################################################################

log_date

################################################################################
# ema strategy configuration (static)
################################################################################

STRATEGY_TYPE="EMA"

# exchange template
EXCHANGE_API="$(egrep "EXCHANGE_API=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# market or limit order
MARKET_LIMIT="$(egrep "MARKET_LIMIT=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# ema short
EMA_SHORT="$(egrep "EMA_SHORT=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# ema long
EMA_LONG="$(egrep "EMA_LONG=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# ema fomo
EMA_FOMO="$(egrep "EMA_FOMO=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# rogue profit enable, disable
ROGUE_PROFIT="$(egrep "ROGUE_PROFIT=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# signal age
SIGNAL_AGE="$(egrep "SIGNAL_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# listing currency
LISTING_CURRENCY="$(egrep "LISTING_CURRENCY=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# account allocated
LISTING_ALLOCATED="$(egrep "LISTING_ALLOCATED=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# reference currency
REFERENCE_CURRENCY="$(egrep "REFERENCE_CURRENCY=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# account allocated
REFERENCE_ALLOCATED="$(egrep "REFERENCE_ALLOCATED=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"

################################################################################
# exchange template
################################################################################

exchange_template

################################################################################
# data
################################################################################

listing_data          # get available listing data
reference_data        # get available reference data
listing_total_value   # calculate total listing values
reference_total_value # calculate total reference values
listing_allocated     # total listing allocated
reference_allocated   # total reference allocated
last_tx               # last tx
txid_null             # txid null

################################################################################

# get data
GET_EMA_DATA="$(get_ema "$EMA_SHORT" "$EMA_LONG" "$LISTING_CURRENCY")"
GET_EMA_SIGNAL="$(echo "$GET_EMA_DATA" | awk '{ print $1 }')"
GET_EMA_CONFIG="$(echo "$GET_EMA_DATA" | awk '{ print $NF }')"
GET_SHORT_DATA="$(echo "$GET_EMA_DATA" | awk '{ print $3 }')"
GET_LONG_DATA="$(echo "$GET_EMA_DATA" | awk '{ print $5 }')"
GET_DIFFERENCE="$(echo "$GET_SHORT_DATA-$GET_LONG_DATA" | bc -l 2>/dev/null)"
GET_PERCENTAGE="$(echo "100/$GET_SHORT_DATA*$GET_DIFFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.4f\n", $1 }')"

if [[ -z "$GET_PERCENTAGE" ]] &>/dev/null; then
  GET_PERCENTAGE="0"
fi
if [[ -z "$TX_ID_LAST" ]] &>/dev/null; then
  TX_ID_LAST="N/A"
fi

################################################################################

# if zero
if [[ -z "$EMA_FOMO" ]] &>/dev/null; then
  EMA_FOMO="false"
fi

# fomo data
if [[ "$EMA_FOMO" == "false" ]] &>/dev/null; then
  EMA_FOMO_DATA="Disabled"
elif [[ "$EMA_FOMO" == "true" ]] &>/dev/null; then
  EMA_FOMO_DATA="Enabled"
fi

################################################################################

echo "Market................: $LISTING_CURRENCY/$REFERENCE_CURRENCY

EMA_Data..............: $STRATEGY_TYPE $GET_EMA_CONFIG
EMA_Short.............: $GET_SHORT_DATA
EMA_Long..............: $GET_LONG_DATA
EMA_Signal............: $GET_EMA_SIGNAL
EMA_Strength..........: ${GET_PERCENTAGE:?}%
EMA_FOMO..............: $EMA_FOMO_DATA
Price.................: $LISTING_PRICE $REFERENCE_CURRENCY
Listing_Allocated.....: ${LISTING_ALLOCATED_REAL:?}%/${LISTING_ALLOCATED:?}%
Listing_Amount........: $LISTING_AMOUNT $LISTING_CURRENCY $LISTING_AMOUNT_VALUED $REFERENCE_CURRENCY
Listing_Available.....: $LISTING_AVAILABLE_BALANCE $LISTING_CURRENCY $LISTING_AVAILABLE_VALUED $REFERENCE_CURRENCY
Listing_Unconfirmed...: $LISTING_UNCONFIRMED_BALANCE $LISTING_CURRENCY $LISTING_UNCONFIRMED_VALUED $REFERENCE_CURRENCY
Reference_Allocated...: ${REFERENCE_ALLOCATED_REAL:?}%/${REFERENCE_ALLOCATED:?}%
Reference_Amount......: $REFERENCE_AMOUNT $REFERENCE_CURRENCY $REFERENCE_AMOUNT_VALUED $LISTING_CURRENCY
Reference_Available...: $REFERENCE_AVAILABLE_BALANCE $REFERENCE_CURRENCY $REFERENCE_AVAILABLE_VALUED $LISTING_CURRENCY
Reference_Unconfirmed.: $REFERENCE_UNCONFIRMED_BALANCE $REFERENCE_CURRENCY $REFERENCE_UNCONFIRMED_VALUED $LISTING_CURRENCY
Last_Order.txid.......: $TX_ID_LAST $TXID_AGE" | column -t >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".data 2>>"${LOG_ERROR:?}"

################################################################################

open_positions

################################################################################

BUY_MARKET_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $REFERENCE_CURRENCY Market $REFERENCE_AMOUNT"
SELL_MARKET_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY :: Market $LISTING_AMOUNT"

BUY_LIMIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $REFERENCE_CURRENCY Limit $REFERENCE_PRICE $REFERENCE_AMOUNT"
SELL_LIMIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY :: Limit $LISTING_PRICE $LISTING_AMOUNT"

ORDER_SELL_POSITION="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Sell :: $LISTING_OPEN_CURRENCY :: $LISTING_OPEN_AMOUNT $REFERENCE_OPEN_AMOUNT ${LISTING_OPEN_RESULT:?}% $LISTING_OPEN_AMOUNT_AGE"
ORDER_BUY_POSITION="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Buy :: $LISTING_OPEN_CURRENCY :: $LISTING_OPEN_AMOUNT $REFERENCE_OPEN_AMOUNT ${LISTING_OPEN_RESULT:?}% $LISTING_OPEN_AMOUNT_AGE"

################################################################################

incoming_listing
incoming_reference

################################################################################

rogue_profit

# rogue profit indicator output
if [[ "$ROGUE_PROFIT" -eq "1" ]] 2>>"${LOG_ERROR:?}"; then
  ROGUE_PROFIT_INDICATOR="RPI $(echo "$ROGUE_LISTING_RPI" | awk '{ printf "%.0f\n", $1 }')/$(echo "$ROGUE_REFERENCE_RPI" | awk '{ printf "%.0f\n", $1 }')"
else
  ROGUE_PROFIT_INDICATOR=""
fi

################################################################################

EMA_REAL_RAW="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".data 2>>"${LOG_ERROR:?}")"
EMA_REAL_SIGNAL="$(echo "$EMA_REAL_RAW" | grep "EMA_Signal" | awk '{ print $2 }')"
EMA_REAL_SHORT="$(echo "$EMA_REAL_RAW" | grep "EMA_Short" | awk '{ print $2 }')"
EMA_REAL_LONG="$(echo "$EMA_REAL_RAW" | grep "EMA_Long" | awk '{ print $2 }')"

# if zero, skip signal
if [[ ! "$(echo "$EMA_REAL_SHORT" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
  if [[ ! "$(echo "$EMA_REAL_LONG" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
    echo "$EMA_REAL_SIGNAL :: $EMA_REAL_SHORT $EMA_REAL_LONG" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal 2>>"${LOG_ERROR:?}"
  fi
fi

# keep n lines
echo "$(tail -21 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal 2>>"${LOG_ERROR:?}"

# latest signal
EMA_REAL_SIGNAL="$(tail -1 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | awk '{ print $1 }')"

# if zero, skip
if [[ -z "$EMA_REAL_SIGNAL" ]] &>/dev/null; then
  EMA_REAL_SIGNAL="Idling"
fi

EMA_DIFFERENCE="$(echo "$EMA_REAL_SHORT-$EMA_REAL_LONG" | bc -l 2>/dev/null)"
EMA_PERCENTAGE="$(echo "100/$EMA_REAL_SHORT*$EMA_DIFFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.4f\n", $1 }')"

if [[ -z "$EMA_PERCENTAGE" ]] &>/dev/null; then
  EMA_PERCENTAGE="0"
fi

################################################################################

signal_age

################################################################################
# B U L L I S H - S I G N A L
################################################################################

BULLISH_EMA_CROSS="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : ${REFERENCE_ALLOCATED:?}% :: Bullish+Cross :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $TYPE"
BULLISH_EMA_SIGNAL="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Trigger :: Bullish+Signal :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: ${REFERENCE_ALLOCATED_REAL:?}% > ${REFERENCE_ALLOCATED:?}%"
BULLISH_EMA_STATUS="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $EMA_REAL_SHORT/$EMA_REAL_LONG Bullish ${EMA_PERCENTAGE:?}% ${ROGUE_PROFIT_INDICATOR:?}"

################################################################################

if [[ "$EMA_REAL_SIGNAL" == "Bullish" ]] 2>>"${LOG_ERROR:?}"; then

  # if zero, skip log
  if [[ ! "$(echo "$EMA_REAL_SHORT" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
    if [[ ! "$(echo "$EMA_REAL_LONG" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
      # log bullish trend
      echo "$BULLISH_EMA_STATUS" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    fi
  fi

  ##############################################################################

  # if fear of missing out is true
  if [[ "$EMA_FOMO" == "true" ]] &>/dev/null; then
    # ready to buy (signal age)
    if [[ "$SIGNAL_ORDER_AGE" -gt "$SIGNAL_AGE_SECONDS" ]] 2>>"${LOG_ERROR:?}"; then
      # is this bullish signal allocated correctly? (without decimal)
      if [[ "$(echo "$LISTING_ALLOCATED_REAL" | tr -d '.' | sed 's/^0*//')" -lt "$(echo "$LISTING_ALLOCATED" | tr -d '.' | sed 's/^0*//')" ]] &>/dev/null; then
        # trigger a buy for fear of missing out
        echo "$BULLISH_EMA_SIGNAL" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log
        echo "Bearish" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal
        echo "Bullish" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal
      fi
    fi
  fi

  ##############################################################################

  # is this a bullish cross?
  if [[ ! "$(tail -10 "${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}" | egrep -c "Bullish+Cross|Bullish+Signal")" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then

    if [[ ! "$(tail -2 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | head -1 | awk '{ print $1 }')" == "$(tail -2 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | tail -1 | awk '{ print $1 }')" ]] 2>>"${LOG_ERROR:?}"; then
      if [[ "$(tail -1 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | grep -c "Bullish")" -eq "1" ]] 2>>"${LOG_ERROR:?}"; then

        ########################################################################

        signal_age_buying

        # ready to buy (signal age)
        if [[ "$SIGNAL_ORDER_AGE" -gt "$SIGNAL_AGE_SECONDS" ]] 2>>"${LOG_ERROR:?}"; then
          rm "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_order 2>>"${LOG_ERROR:?}"

          # buy order ##########################################################

          TYPE="buy"
          AMOUNT_IN_REFERENCE_CURRENCY="true"

          if [[ "$MARKET_LIMIT" == "market" ]] 2>>"${LOG_ERROR:?}"; then

            # placeOrder market ################################################
            PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$REFERENCE_AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            ####################################################################

            echo "$BUY_MARKET_OUTPUT :: $TYPE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            tx_id
            cost_price
            echo "$ORDER_BUY_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

            # remove duplicates
            echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

          elif [[ "$MARKET_LIMIT" == "limit" ]] 2>>"${LOG_ERROR:?}"; then

            # placeOrder limit #################################################
            PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$REFERENCE_PRICE" "$REFERENCE_AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            ####################################################################

            echo "$BUY_LIMIT_OUTPUT :: $TYPE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            tx_id
            cost_price
            echo "$ORDER_BUY_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

            # remove duplicates
            echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
          fi
          echo "$BULLISH_EMA_CROSS" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
        fi
      fi
    fi
  fi
fi

################################################################################
# B E A R I S H - S I G N A L
################################################################################

BEARISH_EMA_CROSS="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : ${LISTING_ALLOCATED:?}% :: Bearish+Cross :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $TYPE"
BEARISH_EMA_SIGNAL="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : Trigger :: Bearish+Signal :: $LISTING_CURRENCY/$REFERENCE_CURRENCY :: ${LISTING_ALLOCATED_REAL:?}% > ${LISTING_ALLOCATED:?}%"
BEARISH_EMA_STATUS="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $EMA_REAL_SHORT/$EMA_REAL_LONG Bearish ${EMA_PERCENTAGE:?}% ${ROGUE_PROFIT_INDICATOR:?}"

################################################################################

if [[ "$EMA_REAL_SIGNAL" == "Bearish" ]] 2>>"${LOG_ERROR:?}"; then

  # if zero, skip log
  if [[ ! "$(echo "$EMA_REAL_SHORT" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
    if [[ ! "$(echo "$EMA_REAL_LONG" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
      # log bearish trend
      echo "$BEARISH_EMA_STATUS" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    fi
  fi

  ##############################################################################

  # if fear of missing out is true
  if [[ "$EMA_FOMO" == "true" ]] &>/dev/null; then
    # ready to sell (signal age)
    if [[ "$SIGNAL_ORDER_AGE" -gt "$SIGNAL_AGE_SECONDS" ]] 2>>"${LOG_ERROR:?}"; then
      # is this bullish signal allocated correctly? (without decimal)
      if [[ "$(echo "$REFERENCE_ALLOCATED_REAL" | awk -F. '{ print $1 }')" -lt "$(echo "$REFERENCE_ALLOCATED" | awk -F. '{ print $1 }')" ]] &>/dev/null; then
        # trigger a sell for fear of missing out
        echo "$BEARISH_EMA_SIGNAL" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log
        echo "Bullish" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal
        echo "Bearish" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal
      fi
    fi
  fi

  ##############################################################################

  # is this a bearish cross?
  if [[ ! "$(tail -10 "${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}" | egrep -c "Bearish+Cross|Bearish+Signal")" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then

    if [[ ! "$(tail -2 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | head -1 | awk '{ print $1 }')" == "$(tail -2 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | tail -1 | awk '{ print $1 }')" ]] 2>>"${LOG_ERROR:?}"; then
      if [[ "$(tail -1 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | grep -c "Bearish")" -eq "1" ]] 2>>"${LOG_ERROR:?}"; then

        ########################################################################

        signal_age_selling

        # ready to sell (signal age)
        if [[ "$SIGNAL_ORDER_AGE" -gt "$SIGNAL_AGE_SECONDS" ]] 2>>"${LOG_ERROR:?}"; then
          rm "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_order 2>>"${LOG_ERROR:?}"

          # sell order #########################################################

          TYPE="sell"
          AMOUNT_IN_REFERENCE_CURRENCY="false"

          if [[ "$MARKET_LIMIT" == "market" ]] 2>>"${LOG_ERROR:?}"; then

            # placeOrder market ################################################
            PLACE_ORDER="$(placeOrder_market "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$LISTING_AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            ####################################################################

            echo "$SELL_MARKET_OUTPUT :: $TYPE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            tx_id
            cost_price
            echo "$ORDER_SELL_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

            # remove duplicates
            echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

          elif [[ "$MARKET_LIMIT" == "limit" ]] 2>>"${LOG_ERROR:?}"; then

            # placeOrder limit #################################################
            PLACE_ORDER="$(placeOrder_limit "$TYPE" "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" "$LISTING_PRICE" "$LISTING_AMOUNT" "$AMOUNT_IN_REFERENCE_CURRENCY")"
            ####################################################################

            echo "$SELL_LIMIT_OUTPUT :: $TYPE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
            tx_id
            cost_price
            echo "$ORDER_SELL_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

            # remove duplicates
            echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
          fi
          echo "$BEARISH_EMA_CROSS" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
        fi
      fi
    fi
  fi
fi

################################################################################

save_orders
last_orders
sxc_backup_orders

################################################################################

robot_Log_cleanup

################################################################################

# END
