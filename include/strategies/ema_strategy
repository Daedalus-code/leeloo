# B U L L I S H - S I G N A L
################################################################################

BULLISH_EMA_CROSS="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: ${REFERENCE_ALLOCATED:?}% : Bullish+Cross : Buy"
BULLISH_EMA_SIGNAL="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Trigger : Bullish+Signal : Buying $LISTING_AMOUNT $LISTING_CURRENCY $LISTING_ALLOCATED_REAL_CHECK+$LISTING_ALL_DIFF_CHECK% > ${LISTING_ALLOCATED:?}%"
BULLISH_EMA_STATUS="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: $EMA_REAL_SHORT / $EMA_REAL_LONG / ($LISTING_PRICE Bullish ${EMA_PERCENTAGE:?}%) ${ROGUE_PROFIT_INDICATOR:?}"

################################################################################

# if missing
if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_fomo ]] 2>/dev/null; then
  echo "$EMA_REAL_SIGNAL" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_fomo
fi

# fomo signal
SIGNAL_FOMO="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_fomo 2>/dev/null)"

if [[ "$EMA_REAL_SIGNAL" == "Bullish" || "$EMA_REAL_SIGNAL" == "Bullish" && "$SIGNAL_FOMO" == "Bearish" ]] 2>>"${LOG_ERROR:?}"; then
  # if zero, skip log
  if [[ ! "$(echo "$EMA_REAL_SHORT" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
    if [[ ! "$(echo "$EMA_REAL_LONG" | awk -F. '{ print $1 }')" -eq "0" ]] 2>>"${LOG_ERROR:?}"; then
      # log bullish trend
      echo "$BULLISH_EMA_STATUS" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
    fi
  fi

  ##############################################################################
  # F O M O - B U Y
  ##############################################################################

  # check if balances, prices exist
  if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/balances | awk '{ print $1 }')" -gt "1" ]] &>/dev/null; then
    if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/"$EXCHANGE_DIR_NAME"/prices | awk '{ print $1 }')" -gt "1" ]] &>/dev/null; then

      backup_balances

      # if fear of missing out is true
      if [[ "$EMA_FOMO" == "true" ]] &>/dev/null; then
        # if fomo signal is bearish while bullish
        if [[ "$SIGNAL_FOMO" == "Bearish" ]] &>/dev/null; then
          # ready to buy (signal age)
          if [[ "$SIGNAL_ORDER_AGE" -gt "$SIGNAL_AGE_SECONDS" ]] 2>>"${LOG_ERROR:?}"; then

            # if xeggex rsi
            if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
              # rsi bullish check
              RSI_BULLISH_CHECK="$(get_rsi_xgx "$LISTING_CURRENCY" "USDT" | awk '{ print $NF }' | awk -F. '{ print $1 }')"
            fi

            # if nonkyc rsi
            if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
              # rsi bullish check
              RSI_BULLISH_CHECK="$(get_rsi_nky "$LISTING_CURRENCY" "USDT" | awk '{ print $NF }' | awk -F. '{ print $1 }')"
            fi

            # if zero
            if [[ -z "$RSI_BULLISH_CHECK" ]] &>/dev/null; then
              RSI_BULLISH_CHECK="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rsi 2>/dev/null | grep "L_NOW" | awk '{ print $NF }' | awk -F. '{ print $1 }')"
            fi

            # if not zero, has data
            if [[ ! -z "$RSI_BULLISH_CHECK" && -n "$RSI_BULLISH_CHECK" ]] &>/dev/null; then
              # if any data
              if [[ "$(echo "$RSI_BULLISH_CHECK" | egrep -c "[0-9]+" || true)" -gt "0" ]] &>/dev/null; then
                # rsi below bullish, above bearish
                if [[ "$RSI_BULLISH_CHECK" -lt "70" && "$RSI_BULLISH_CHECK" -gt "30" ]] &>/dev/null; then
                  # if valued (check)
                  if [[ "$LISTING_ALL_DIFF_CHECK" -gt "0" ]] &>/dev/null; then

                    # new listing amount (missing difference)
                    LISTING_AMOUNT="$(echo "$REFERENCE_AMOUNT_FOMO" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"
                    # new bullish output
                    BULLISH_EMA_SIGNAL="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: FOMO : Bullish+Signal : Buying $LISTING_AMOUNT $LISTING_CURRENCY $LISTING_ALLOCATED_REAL_CHECK+$LISTING_ALL_DIFF_CHECK% > ${LISTING_ALLOCATED:?}%"

                    # has value
                    if [[ "$(echo "$LISTING_AMOUNT" | tr -d '.' | sed 's/^0*//')" -gt "0" ]] &>/dev/null; then
                      # if any data
                      if [[ -n "$LISTING_ALLOCATED_REAL_CHECK" && -n "$LISTING_ALLOCATED_CONFIG_CHECK" ]] &>/dev/null; then
                        # is this bullish signal allocated correctly? (without decimal)
                        if [[ "$LISTING_ALLOCATED_REAL_CHECK" -lt "$LISTING_ALLOCATED_CONFIG_CHECK" ]] &>/dev/null; then
                          # if not equal
                          if [[ ! "$LISTING_ALLOCATED_REAL_CHECK" -eq "$LISTING_ALLOCATED_CONFIG_CHECK" ]] &>/dev/null; then
                            # trigger a buy for fear of missing out
                            echo "$BULLISH_EMA_SIGNAL" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log
                            echo "Bearish :: 1$EMA_REAL_SHORT $EMA_REAL_LONG" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal
                            echo "Bullish :: $EMA_REAL_SHORT 1$EMA_REAL_LONG" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal
                          fi
                        fi
                      fi
                    fi
                  fi
                fi
              fi
            fi
          fi
        fi
      fi
    fi
  fi

  ##############################################################################

  # is this a bullish cross?
  if [[ ! "$(tail -10 "${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}" | egrep -c "Bullish+Cross|Bullish+Signal")" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then

    if [[ ! "$(tail -2 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | head -1 | awk '{ print $1 }')" == "$(tail -2 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | tail -1 | awk '{ print $1 }')" ]] 2>>"${LOG_ERROR:?}"; then
      if [[ "$(tail -1 "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal | grep -c "Bullish")" -eq "1" ]] 2>>"${LOG_ERROR:?}"; then

        ########################################################################

        signal_age_buying

        # buy order ############################################################

        TYPE="buy"
        DEBUG_TYPE="Buying"

        ########################################################################

        # ready to buy (signal age)
        if [[ "$SIGNAL_ORDER_AGE" -gt "$SIGNAL_AGE_SECONDS" ]] 2>>"${LOG_ERROR:?}"; then

          # if market order
          if [[ "$MARKET_LIMIT" == "market" ]] 2>>"${LOG_ERROR:?}"; then
            # balance check
            if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
              # if insufficient funds from last order
              if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

                # remove old signal_order
                rm "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_order 2>>"${LOG_ERROR:?}"

                ################################################################
                ################################################################

                # if xeggex order
                if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
                  # createorder buy market #####################################
                  PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "$TYPE" "market" "$LISTING_AMOUNT" "" "false")"
                  # debug line #################################################
                  echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY $TYPE market $LISTING_AMOUNT '' false <--- $DEBUG_TYPE asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
                  ##############################################################
                fi

                # if nonkyc order
                if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
                  # createorder buy market #####################################
                  PLACE_ORDER="$(CreateOrder_nky "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "$TYPE" "market" "$LISTING_AMOUNT" "" "false")"
                  # debug line #################################################
                  echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY $TYPE market $LISTING_AMOUNT '' false <--- $DEBUG_TYPE asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
                  ##############################################################
                fi

                # create fomo signal based on ema values
                echo "$EMA_REAL_SIGNAL" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_fomo 2>>"${LOG_ERROR:?}"

                ################################################################
                ################################################################

                tx_id
                cost_price
                echo "$ORDER_BUY_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

                # remove duplicates
                echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
              fi
            fi
            # if limit order
          elif [[ "$MARKET_LIMIT" == "limit" ]] 2>>"${LOG_ERROR:?}"; then

            ####################################################################
            ####################################################################

            # balance check
            if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
              # if insufficient funds from last order
              if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

                # cancel old ema orders
                cancel_old_orders

                # if xeggex order
                if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
                  # createorder buy limit ######################################
                  PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "$TYPE" "limit" "$LISTING_AMOUNT" "$LISTING_PRICE" "false")"
                  # debug line #################################################
                  echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY $TYPE limit $LISTING_AMOUNT $LISTING_PRICE false <--- $DEBUG_TYPE asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
                  ##############################################################
                fi

                # if nonkyc order
                if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
                  # createorder buy limit ######################################
                  PLACE_ORDER="$(CreateOrder_nky "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "$TYPE" "limit" "$LISTING_AMOUNT" "$LISTING_PRICE" "false")"
                  # debug line #################################################
                  echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY $TYPE limit $LISTING_AMOUNT $LISTING_PRICE false <--- $DEBUG_TYPE asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
                  ##############################################################
                fi

                # create fomo signal based on ema values
                echo "$EMA_REAL_SIGNAL" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".signal_fomo 2>>"${LOG_ERROR:?}"

                ################################################################
                ################################################################

                echo "$BUY_LIMIT_OUTPUT :: $TYPE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
                tx_id
                cost_price
                echo "$ORDER_BUY_POSITION" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"

                # remove duplicates
                echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}" | awk '!a[$0]++')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".orders 2>>"${LOG_ERROR:?}"
              fi
            fi
            echo "$BULLISH_EMA_CROSS" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>>"${LOG_ERROR:?}"
          fi
        fi
      fi
    fi
  fi
fi

