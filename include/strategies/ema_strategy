function rogue_buying() {

  # default
  MINIMUM_AMOUNT_REACHED="0"
  # amount check with decimal_market
  AMOUNT_DECIMAL_CHECK="$(echo "$ROGUE_LISTING_AMOUNT" | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }' | tr -d '.' | sed 's/^0*//')"
  # if zero
  if [[ -z "$AMOUNT_DECIMAL_CHECK" ]] &>/dev/null; then
    # output minimum reached
    echo "$LOG_DATE : $EXCHANGE_API : RGP : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Minimum buy amount reached! $ROGUE_LISTING_AMOUNT $REFERENCE_CURRENCY @ $REFERENCE_PRICE $LISTING_CURRENCY" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null
    # minimum amount reached, do not buy
    MINIMUM_AMOUNT_REACHED="1"
  fi

  ##############################################################################

  # if market order, if minimum amount not reached
  if [[ "$MARKET_LIMIT" == "market" && "$MINIMUM_AMOUNT_REACHED" == "0" ]] &>/dev/null; then

    ############################################################################
    ############################################################################

    # balance check
    if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
      # if insufficient funds from last order
      if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

        # buy output
        echo "$LOG_DATE : $EXCHANGE_API : RGP : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Cheap Shot successfully! $ROGUE_LISTING_AMOUNT @ $REFERENCE_PRICE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null

        ########################################################################

        # if xeggex order
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # createorder buy market #############################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "market" "$ROGUE_LISTING_AMOUNT" "" "false")"
          # debug line #########################################################
          echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY buy market $ROGUE_LISTING_AMOUNT '' false <--- Buying asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
          ######################################################################
        fi

        # if nonkyc order
        if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
          # createorder buy market #############################################
          PLACE_ORDER="$(CreateOrder_nky "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "market" "$ROGUE_LISTING_AMOUNT" "" "false")"
          # debug line #########################################################
          echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY buy market $ROGUE_LISTING_AMOUNT '' false <--- Buying asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
          ######################################################################
        fi
      fi
    fi
    # if limit order, if minimum amount not reached
  elif [[ "$MARKET_LIMIT" == "limit" && "$MINIMUM_AMOUNT_REACHED" == "0" ]] &>/dev/null; then

    ############################################################################
    ############################################################################

    # balance check
    if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
      # if insufficient funds from last order
      if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

        # if xeggex order
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # createorder buy limit ##############################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "limit" "$ROGUE_LISTING_AMOUNT" "$LISTING_PRICE" "false")"
          # debug line #########################################################
          echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY buy limit $ROGUE_LISTING_AMOUNT $LISTING_PRICE false <--- Buying asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
          ######################################################################
        fi

        # if nonkyc order
        if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
          # createorder buy limit ##############################################
          PLACE_ORDER="$(CreateOrder_nky "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "limit" "$ROGUE_LISTING_AMOUNT" "$LISTING_PRICE" "false")"
          # debug line #########################################################
          echo "$LOG_DATE : DebugOrder '' $LISTING_CURRENCY/$REFERENCE_CURRENCY buy limit $ROGUE_LISTING_AMOUNT $LISTING_PRICE false <--- Buying asset" >>"${LOG_DIR:?}"/leeloo/"$BASENAME_STRATEGY".debug
          ######################################################################
        fi
      fi
    fi
  fi
}

