#!/bin/bash

# shellcheck disable=SC2034  # Unused variables left for readability

################################################################################

# exit strategy if any error
set -e

################################################################################

# configuration
source /usr/local/bin/include/leeloo/broker.conf
# s & k
source /usr/local/bin/include/leeloo/sMcD
# exchanges, includes functions
source /usr/local/bin/include/leeloo/strategies/templates/exchanges

################################################################################

# indicators
source /usr/local/bin/include/leeloo/indicators/ema
source /usr/local/bin/include/leeloo/indicators/rsi_xgx

################################################################################

# get strategy id.config, run strategy
BASENAME_STRATEGY="$(basename "$0" | awk -F. '{ print $1 }')"

################################################################################

log_date

################################################################################
# ema strategy configuration (static)
################################################################################

STRATEGY_TYPE="EMA"

# exchange template
EXCHANGE_API="$(egrep "EXCHANGE_API=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# market or limit order
MARKET_LIMIT="$(egrep "MARKET_LIMIT=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# ema short
EMA_SHORT="$(egrep "EMA_SHORT=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# ema long
EMA_LONG="$(egrep "EMA_LONG=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# ema fomo
EMA_FOMO="$(egrep "EMA_FOMO=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# rogue profit enable, disable
ROGUE_PROFIT="$(egrep "ROGUE_PROFIT=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# signal age
SIGNAL_AGE="$(egrep "SIGNAL_AGE=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# listing currency
LISTING_CURRENCY="$(egrep "LISTING_CURRENCY=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# account allocated
LISTING_ALLOCATED="$(egrep "LISTING_ALLOCATED=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# reference currency
REFERENCE_CURRENCY="$(egrep "REFERENCE_CURRENCY=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"
# account allocated
REFERENCE_ALLOCATED="$(egrep "REFERENCE_ALLOCATED=" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".config | awk -F= '{ print $2 }' | tr -d '"' | awk '{ print $1 }')"

################################################################################
# exchange template
################################################################################

exchange_template

################################################################################
# data
################################################################################

robot_log               # strategy log
signal_age              # signal age
tx_id_data              # txid data
listing_data            # get available listing data
reference_data          # get available reference data
listing_allocated       # total listing allocated
reference_allocated     # total reference allocated
listing_balance_check   # check for listing balance
reference_balance_check # check for reference balance
insufficient_funds      # check for available funds
listing_fomo            # listing fomo
reference_fomo          # reference fomo
decimal_market          # decimal market

################################################################################

# get ema data
GET_EMA_DATA="$(get_ema "$EMA_SHORT" "$EMA_LONG" "$LISTING_CURRENCY")"
# create temp
echo "$GET_EMA_DATA" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ema.tmp
# get ema check
GET_EMA_CHECK="$(echo "$GET_EMA_DATA" | awk '{ print $3 }' | egrep -c "[0-9]+" || true)"

# if any data
if [[ "$GET_EMA_CHECK" -eq "1" ]] &>/dev/null; then
  # update ema
  mv "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ema.tmp "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ema
fi

# ema data
GET_EMA_DATA="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".ema 2>/dev/null)"

GET_EMA_SIGNAL="$(echo "$GET_EMA_DATA" | awk '{ print $1 }')"
GET_EMA_CONFIG="$(echo "$GET_EMA_DATA" | awk '{ print $NF }')"
GET_SHORT_DATA="$(echo "$GET_EMA_DATA" | awk '{ print $3 }')"
GET_LONG_DATA="$(echo "$GET_EMA_DATA" | awk '{ print $5 }')"
GET_DIFFERENCE="$(echo "$GET_SHORT_DATA-$GET_LONG_DATA" | bc -l 2>/dev/null)"
GET_PERCENTAGE="$(echo "100/$GET_SHORT_DATA*$GET_DIFFERENCE" | bc -l 2>/dev/null | awk '{ printf "%.4f\n", $1 }')"

# if zero
if [[ -z "$GET_PERCENTAGE" ]] &>/dev/null; then
  GET_PERCENTAGE="0"
fi

# if zero
if [[ -z "$TX_ID_LAST" ]] &>/dev/null; then
  TX_ID_LAST="N/A"
fi

################################################################################

# fomo data
if [[ "$EMA_FOMO" == "true" ]] &>/dev/null; then
  EMA_FOMO_DATA="Enabled"
else
  EMA_FOMO_DATA="Disabled"
fi

# if zero
if [[ -z "$LISTING_ALLOCATED_REAL_CHECK" ]] &>/dev/null; then
  LISTING_ALLOCATED_REAL_CHECK="N/A"
fi

# if zero
if [[ -z "$REFERENCE_ALLOCATED_REAL_CHECK" ]] &>/dev/null; then
  REFERENCE_ALLOCATED_REAL_CHECK="N/A"
fi

# if market
if [[ "$MARKET_LIMIT" == "market" ]] &>/dev/null; then
  MARKET_LIMIT_DATA="Market"
fi

# if limit
if [[ "$MARKET_LIMIT" == "limit" ]] &>/dev/null; then
  MARKET_LIMIT_DATA="Limit"
fi

# listing available balance (market decimal)
LISTING_AVAILABLE_BALANCE="$(echo "$LISTING_AVAILABLE_BALANCE" | awk '{ printf "%."'$DIP_DECIMAL_LIMIT'"f\n", $1 }')"

################################################################################

echo "Market................: $LISTING_CURRENCY/$REFERENCE_CURRENCY
Order_Type............: $MARKET_LIMIT_DATA
Exchange..............: $EXCHANGE_OUTPUT_NAME $EXCHANGE_API
EMA_Data..............: $STRATEGY_TYPE $GET_EMA_CONFIG
EMA_Short.............: $GET_SHORT_DATA
EMA_Long..............: $GET_LONG_DATA
EMA_Signal............: $GET_EMA_SIGNAL
EMA_Signal_Age/Limit..: ${SIGNAL_ORDER_AGE_HOURS:?}h/${SIGNAL_AGE:?}h
EMA_Strength..........: ${GET_PERCENTAGE:?}%
EMA_FOMO..............: $EMA_FOMO_DATA
EMA_Total_Value.......: $TOTAL_EMA_VALUE $REFERENCE_CURRENCY
Price.................: $LISTING_PRICE $LISTING_CURRENCY
Listing_Allocated.....: ${LISTING_ALLOCATED_REAL_CHECK:?}%/${LISTING_ALLOCATED:?}%/D:${LISTING_ALL_DIFF_CHECK:?}%=$REFERENCE_AMOUNT_FOMO $LISTING_CURRENCY
Listing_Amount........: $LISTING_AMOUNT $LISTING_CURRENCY ($LISTING_AMOUNT_VALUED $REFERENCE_CURRENCY)
Listing_Available.....: $LISTING_AVAILABLE_BALANCE $LISTING_CURRENCY ($LISTING_AVAILABLE_VALUED $REFERENCE_CURRENCY)
Listing_Unconfirmed...: $LISTING_UNCONFIRMED_BALANCE $LISTING_CURRENCY ($LISTING_UNCONFIRMED_VALUED $REFERENCE_CURRENCY)
Reference_Allocated...: ${REFERENCE_ALLOCATED_REAL_CHECK:?}%/${REFERENCE_ALLOCATED:?}%/D:${REFERENCE_ALL_DIFF_CHECK:?}%=$LISTING_AMOUNT_FOMO $LISTING_CURRENCY
Reference_Amount......: $REFERENCE_AMOUNT $REFERENCE_CURRENCY ($REFERENCE_AMOUNT_VALUED $LISTING_CURRENCY)
Reference_Available...: $REFERENCE_AVAILABLE_BALANCE $REFERENCE_CURRENCY ($REFERENCE_AVAILABLE_VALUED $LISTING_CURRENCY)
Reference_Unconfirmed.: $REFERENCE_UNCONFIRMED_BALANCE $REFERENCE_CURRENCY ($REFERENCE_UNCONFIRMED_VALUED $LISTING_CURRENCY)
Last_Order.txid.......: $TX_ID_LAST $TX_ID_AGE (${TX_ID_AGE_DAYS:?}d)" | column -t >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".data 2>>"${LOG_ERROR:?}"

################################################################################

open_positions

################################################################################

BUY_LIMIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $REFERENCE_CURRENCY Limit $REFERENCE_PRICE $REFERENCE_AMOUNT"
SELL_LIMIT_OUTPUT="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY :: Limit $LISTING_PRICE $LISTING_AMOUNT"

ORDER_SELL_POSITION="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : sell :: $LISTING_OPEN_CURRENCY :: $REFERENCE_AVAILABLE_BALANCE $LISTING_AVAILABLE_BALANCE ${LISTING_OPEN_RESULT:?}% $LISTING_OPEN_AMOUNT_AGE"
ORDER_BUY_POSITION="$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : buy :: $LISTING_OPEN_CURRENCY :: $REFERENCE_AVAILABLE_BALANCE $LISTING_AVAILABLE_BALANCE ${LISTING_OPEN_RESULT:?}% $LISTING_OPEN_AMOUNT_AGE"

################################################################################

incoming_listing
incoming_reference

################################################################################

# rogue profit using rsi

ROGUE_TIMER_NOW="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
ROGUE_STATUS_NOW="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".status 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
ROGUE_AMOUNT="0.009225" # n % to be used (default: 0.009225)
ROGUE_TIMER="3600"      # n seconds (default: 3600 seconds/1 hour cooldown)
ROGUE_HOURS="6"         # n hours of data (default: 6 hours)
ROGUE_MAX_DAY="4"       # n trades a day (default: 4)

# n% reference, listing amount
REFERENCE_AMOUNT="$(echo "$ROGUE_AMOUNT*$REFERENCE_AVAILABLE_BALANCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }' | head -1)"
LISTING_AMOUNT="$(echo "$ROGUE_AMOUNT*$LISTING_AVAILABLE_BALANCE" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }' | head -1)"

################################################################################

# missing
if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue ]] &>/dev/null; then
  touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue &>/dev/null
fi

################################################################################

# get_rsi n
function rogue_data() {
  echo "L $LISTING_CURRENCY $(get_rsi_xgx "$LISTING_CURRENCY" "USDT")" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
  sleep 1
  echo "R $REFERENCE_CURRENCY $(get_rsi_xgx "$REFERENCE_CURRENCY" "USDT")" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
}

################################################################################

function rogue_stealth() {
  if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".stealth ]] &>/dev/null; then
    echo "Lurking in the Shadows.." >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".stealth 2>/dev/null
    sleep 1
  fi

  STEALTH_TIME_SECONDS="$(stat -c '%Y' "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".stealth 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
  STEALTH_TIME=$(printf '%dh:%dm:%ds\n' $(("$STEALTH_TIME_SECONDS/3600")) $(("$STEALTH_TIME_SECONDS%3600/60")) $(("$STEALTH_TIME_SECONDS%60")))
  STEALTH_TIME_H="$(("$STEALTH_TIME_SECONDS/3600"))"
  STEALTH_TIME_D="$(("$STEALTH_TIME_H/24"))"
  echo "$LOG_DATE : $EXCHANGE_API : RGP : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Stealth mode ${STEALTH_TIME_D:?}d (${STEALTH_TIME:?})" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null
}

################################################################################

function rogue_buying() {

  # balance check
  if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
    # if insufficient funds from last order
    if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

      # buy output
      echo "$LOG_DATE : $EXCHANGE_API : RGP : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Cheap Shot successfully! $LISTING_AMOUNT @ $REFERENCE_PRICE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null
      # if market order
      if [[ "$MARKET_LIMIT" == "market" ]] &>/dev/null; then

        ########################################################################
        ########################################################################

        # if xeggex order
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # createorder buy market #############################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "market" "$LISTING_AMOUNT" "" "false")"
          ######################################################################
        fi

        ########################################################################
        ########################################################################
      fi
    fi
    # if limit order
  elif [[ "$MARKET_LIMIT" == "limit" ]] &>/dev/null; then

    ############################################################################
    ############################################################################

    # balance check
    if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
      # if insufficient funds from last order
      if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

        # if xeggex order
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # createorder buy limit ##############################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "buy" "limit" "$LISTING_AMOUNT" "$LISTING_PRICE" "false")"
          ######################################################################
        fi
        ########################################################################
        ########################################################################
      fi
    fi
  fi
}

################################################################################

function rogue_selling() {

  # balance check
  if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
    # if insufficient funds from last order
    if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

      # sell output
      echo "$LOG_DATE : $EXCHANGE_API : RGP : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Pick Pocket successfully! $LISTING_AMOUNT @ $REFERENCE_PRICE" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null
      # if market order
      if [[ "$MARKET_LIMIT" == "market" ]] &>/dev/null; then

        ########################################################################
        ########################################################################

        # if xeggex
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # CreateOrder market #################################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "sell" "market" "$LISTING_AMOUNT" "" "false")"
          ######################################################################
        fi
        ########################################################################
        ########################################################################
      fi
    fi
    # if limit order
  elif [[ "$MARKET_LIMIT" == "limit" ]] &>/dev/null; then

    ############################################################################
    ############################################################################

    # balance check
    if [[ "$LISTING_AVAILABLE_BALANCE_NR" -gt "0" || "$REFERENCE_AVAILABLE_BALANCE_NR" -gt "0" ]] 2>>"${LOG_ERROR:?}"; then
      # if insufficient funds from last order
      if [[ "$NO_FUNDS" -eq "0" ]] &>/dev/null; then

        # if xeggex order
        if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
          # createorder sell limit #############################################
          PLACE_ORDER="$(CreateOrder "" "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "sell" "limit" "$LISTING_AMOUNT" "$LISTING_PRICE" "false")"
          ######################################################################
        fi
        ########################################################################
        ########################################################################
      fi
    fi
  fi
}

################################################################################

function rogue_clean_lines() {
  # keep n lines
  echo "$(tail -"$(echo "$ROGUE_HOURS*2" | bc -l 2>/dev/null)" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null)" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
}

################################################################################

if [[ "$ROGUE_PROFIT" -eq "1" ]] &>/dev/null; then

  # update data every n seconds
  if [[ "$ROGUE_TIMER_NOW" -gt "$ROGUE_TIMER" ]] &>/dev/null; then
    rogue_data
    rogue_stealth
    rogue_clean_lines
    # update data if missing
  elif [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue ]] &>/dev/null; then
    rogue_data
    rogue_stealth
    rogue_clean_lines
    # update data if empty
  elif [[ ! -s "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue ]] &>/dev/null; then
    rogue_data
    rogue_stealth
    rogue_clean_lines
  fi

  ##############################################################################

  # line count
  ROGUE_LINES="$(wc -l "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $1 }')"
  ROGUE_COUNT="$(echo "$ROGUE_LINES/2" | bc 2>/dev/null)"
  ROGUE_DAYS="$(echo "$ROGUE_COUNT/24" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # backup prices
  backup_prices

  # if zero
  if [[ -z "$LISTING_PRICE" || "$LISTING_PRICE" == "0.000000000" ]] &>/dev/null; then
    # listing price backup
    LISTING_PRICE="$(grep -w "${LISTING_CURRENCY:?}_${REFERENCE_CURRENCY:?}" "${LOG_DIR:?}"/leeloo/xeggex/prices.bkp 2>/dev/null | awk '{ print $2 }')"
  fi

  # rogue listing price
  ROGUE_LISTING_PRICE="$LISTING_PRICE"

  # rogue listing price old
  ROGUE_LISTING_PRICE_OLD="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".status 2>/dev/null | awk '{ print $3 }' | tail -1)"

  # if zero
  if [[ -z "$ROGUE_LISTING_PRICE_OLD" ]] &>/dev/null; then
    ROGUE_LISTING_PRICE_OLD="0"
  fi

  ROGUE_LISTING_PRICE_DIFF="$(echo "100/$ROGUE_LISTING_PRICE_OLD*$ROGUE_LISTING_PRICE" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$ROGUE_LISTING_PRICE_DIFF" ]] &>/dev/null; then
    ROGUE_LISTING_PRICE_DIFF="0"
  fi

  ROGUE_LISTING_NOW="$(grep "L " "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $NF }' | tail -1 | awk '{ printf "%.4f\n", $1 }')"
  ROGUE_LISTING_HIGH="$(grep "L " "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $NF }' | sort -n | tail -1 | awk '{ printf "%.4f\n", $1 }')"
  ROGUE_LISTING_LOW="$(grep "L " "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $NF }' | sort -n | head -1 | awk '{ printf "%.4f\n", $1 }')"

  # rsi can not be empty/zero, regardless

  # if zero
  if [[ -z "$ROGUE_LISTING_NOW" || "$(echo "$ROGUE_LISTING_NOW" | awk -F. '{ print $1 }')" -eq "0" ]] &>/dev/null; then
    ROGUE_LISTING_NOW="50.1111"
  fi

  # if zero
  if [[ -z "$ROGUE_LISTING_HIGH" || "$(echo "$ROGUE_LISTING_HIGH" | awk -F. '{ print $1 }')" -eq "0" ]] &>/dev/null; then
    ROGUE_LISTING_HIGH="50.1111"
  fi

  # if zero
  if [[ -z "$ROGUE_LISTING_LOW" || "$(echo "$ROGUE_LISTING_LOW" | awk -F. '{ print $1 }')" -eq "0" ]] &>/dev/null; then
    ROGUE_LISTING_LOW="50.1111"
  fi

  ROGUE_LISTING_DIFF="$(echo "$ROGUE_LISTING_HIGH-$ROGUE_LISTING_LOW" | bc -l 2>/dev/null | tr -d '-' | awk '{ printf "%.2f\n", $1 }')"
  ROGUE_LISTING_TOTAL="$(echo "$ROGUE_LISTING_NOW+$ROGUE_LISTING_HIGH+$ROGUE_LISTING_LOW" | bc -l 2>/dev/null | awk '{ printf "%.34f\n", $1 }')"
  ROGUE_LISTING_AVERAGE="$(echo "$ROGUE_LISTING_TOTAL/3" | bc -l 2>/dev/null | awk '{ printf "%.9f\n", $1 }')"

  ##############################################################################

  # set idle
  ROGUE_LISTING_RPI="50.1111"

  # overbought, greater than n
  if [[ "$(echo "$ROGUE_LISTING_NOW" | awk -F. '{ print $1 }')" -gt "50" ]] &>/dev/null; then
    # positive
    ROGUE_LISTING_RPI="$(echo "$ROGUE_LISTING_AVERAGE+$ROGUE_LISTING_DIFF" | bc -l 2>/dev/null | awk '{ printf "%.34f\n", $1 }')"
  fi

  # oversold, less than n
  if [[ "$(echo "$ROGUE_LISTING_NOW" | awk -F. '{ print $1 }')" -lt "50" ]] &>/dev/null; then
    # negative
    ROGUE_LISTING_RPI="$(echo "$ROGUE_LISTING_AVERAGE-$ROGUE_LISTING_DIFF" | bc -l 2>/dev/null | awk '{ printf "%.34f\n", $1 }')"
  fi

  ROGUE_LISTING_RPI="$(echo "$ROGUE_LISTING_RPI" | awk '{ printf "%.9f\n", $1 }')"

  # keep at idle if zero
  if [[ -z "$ROGUE_LISTING_RPI" ]] &>/dev/null; then
    ROGUE_LISTING_RPI="0"
  fi

  ##############################################################################

  ROGUE_LISTING_DIFF_PERCENTAGE="$(echo "100/$ROGUE_LISTING_AVERAGE*$ROGUE_LISTING_DIFF" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$ROGUE_LISTING_DIFF_PERCENTAGE" ]] &>/dev/null; then
    ROGUE_LISTING_DIFF_PERCENTAGE="0"
  fi

  # reference
  ROGUE_REFERENCE_PRICE="$REFERENCE_PRICE"
  ROGUE_REFERENCE_PRICE_OLD="$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".status 2>/dev/null | awk '{ print $5 }' | tail -1)"

  # if zero
  if [[ -z "$ROGUE_REFERENCE_PRICE_OLD" ]] &>/dev/null; then
    ROGUE_REFERENCE_PRICE_OLD="0"
  fi

  ROGUE_REFERENCE_PRICE_DIFF="$(echo "100/$ROGUE_REFERENCE_PRICE_OLD*$ROGUE_REFERENCE_PRICE" | bc -l 2>/dev/null | awk '{ printf "%.2f\n", $1 }')"

  # if zero
  if [[ -z "$ROGUE_REFERENCE_PRICE_DIFF" ]] &>/dev/null; then
    ROGUE_REFERENCE_PRICE_DIFF="0"
  fi

  ROGUE_REFERENCE_NOW="$(grep "R " "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $NF }' | tail -1 | awk '{ printf "%.4f\n", $1 }')"
  ROGUE_REFERENCE_HIGH="$(grep "R " "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $NF }' | sort -n | tail -1 | awk '{ printf "%.4f\n", $1 }')"
  ROGUE_REFERENCE_LOW="$(grep "R " "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null | awk '{ print $NF }' | sort -n | head -1 | awk '{ printf "%.4f\n", $1 }')"

  # rsi can not be empty/zero, regardless

  # if zero
  if [[ -z "$ROGUE_REFERENCE_NOW" || "$(echo "$ROGUE_REFERENCE_NOW" | awk -F. '{ print $1 }')" -eq "0" ]] &>/dev/null; then
    ROGUE_REFERENCE_NOW="50.1111"
  fi

  # if zero
  if [[ -z "$ROGUE_REFERENCE_HIGH" || "$(echo "$ROGUE_REFERENCE_HIGH" | awk -F. '{ print $1 }')" -eq "0" ]] &>/dev/null; then
    ROGUE_REFERENCE_HIGH="50.1111"
  fi

  # if zero
