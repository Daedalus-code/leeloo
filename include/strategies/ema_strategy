# get_rsi n
function rsi_data() {

  # if xeggex rsi
  if [[ "$EXCHANGE_API" == "XGX" ]] &>/dev/null; then
    echo "L $LISTING_CURRENCY $(get_rsi_xgx "$LISTING_CURRENCY" "USDT")" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
    sleep 1
    echo "R $REFERENCE_CURRENCY $(get_rsi_xgx "$REFERENCE_CURRENCY" "USDT")" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
  fi

  # if nonkyc rsi
  if [[ "$EXCHANGE_API" == "NKY" ]] &>/dev/null; then
    echo "L $LISTING_CURRENCY $(get_rsi_nky "$LISTING_CURRENCY" "USDT")" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
    sleep 1
    echo "R $REFERENCE_CURRENCY $(get_rsi_nky "$REFERENCE_CURRENCY" "USDT")" >>"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".rogue 2>/dev/null
  fi

}

