################################################################################

function delisted() {
  # if not found
  if [[ ! -f "${SYS_DIR:?}"/delisted_southxchange ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/delisted_southxchange
  fi

  PRICES_FILE="${LOG_DIR:?}/leeloo/southxchange/prices"
  DELISTED_FILE="${SYS_DIR:?}/delisted_southxchange"
  PRICES_COPY_FILE="${PRICES_FILE}.copy"

  if [[ "$(egrep -c "[0-9]+|[A-Z]+" "$DELISTED_FILE" || true)" -gt "0" ]] &>/dev/null; then

    # make a copy of the prices file
    cp "$PRICES_FILE" "$PRICES_COPY_FILE" &>/dev/null

    # read the delisted markets from the file into an array
    mapfile -t DELISTED_MARKETS <"$DELISTED_FILE"

    # loop through the delisted markets and remove them from the prices copy file
    for MARKET in "${DELISTED_MARKETS[@]}"; do
      sed -i "/^${MARKET//\//\\/}/d" "$PRICES_COPY_FILE"
    done

    # remove duplicates, sort
    echo "$(cat "$DELISTED_FILE" 2>/dev/null | awk '!a[$0]++' | sort)" >"$DELISTED_FILE"

    # use file if any data
    if [[ "$(wc -l "${LOG_DIR:?}"/leeloo/southxchange/prices.copy | awk '{ print $1 }')" ]] &>/dev/null; then
      mv "$PRICES_COPY_FILE" "$PRICES_FILE"
    fi
  fi
}

