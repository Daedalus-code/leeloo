################################################################################

function decimal_market() {
  # default decimal
  DECIMAL_LIMIT="9"
  # market list age (seconds)
  GET_LIST_AGE="$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/getlist 2>/dev/null | while read lastedit; do echo "$(($(date +%s) - $lastedit))"; done)"
  # if greater than n, if not found
  if [[ "$GET_LIST_AGE" -gt "3600" || ! -f "${LOG_DIR:?}"/leeloo/getlist ]] &>/dev/null; then
    # quantity decimals
    echo "$(getlist 2>/dev/null | column -t | sort -n -k 2)" >"${LOG_DIR:?}"/leeloo/getlist.tmp 2>/dev/null
    # if getlist.tmp has data
    if [[ -s "${LOG_DIR:?}"/leeloo/getlist.tmp ]] &>/dev/null; then
      # update data
      mv "${LOG_DIR:?}"/leeloo/getlist.tmp "${LOG_DIR:?}"/leeloo/getlist 2>/dev/null
    fi
    # remove tmp
    rm "${LOG_DIR:?}"/leeloo/getlist.tmp &>/dev/null
  fi
  # if any data points
  if [[ -n "$LISTING_CURRENCY" && -n "$REFERENCE_CURRENCY" ]] &>/dev/null; then
    # if any data
    if [[ -s "${LOG_DIR:?}"/leeloo/getlist ]] &>/dev/null; then
      # decimal limit
      DECIMAL_LIMIT="$(cat "${LOG_DIR:?}"/leeloo/getlist 2>/dev/null | grep -w "$LISTING_CURRENCY/$REFERENCE_CURRENCY:" | awk '{ print $2 }')"

      ##########################################################################

      # insufficient null data
      INSUFFICIENT_NULL="$(grep "Insufficient funds" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null.log 2>/dev/null || true)"

      # if any data
      if [[ -n "$INSUFFICIENT_NULL" ]] &>/dev/null; then

        # if any insufficient funds error
        if [[ "$(echo "$INSUFFICIENT_NULL" | grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" || true)" -eq "1" ]] &>/dev/null; then
          # disregard one decimal
          DECIMAL_LIMIT="$(echo "$DECIMAL_LIMIT-1" | bc 2>/dev/null | awk -F. '{ print $1 }')"
        fi
        # if any insufficient funds errors
        if [[ "$(echo "$INSUFFICIENT_NULL" | grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" || true)" -gt "1" ]] &>/dev/null; then
          # disregard another decimal
          DECIMAL_LIMIT="$(echo "$DECIMAL_LIMIT-2" | bc 2>/dev/null | awk -F. '{ print $1 }')"
        fi
        # if any persistence insufficient funds errors
        if [[ "$(echo "$INSUFFICIENT_NULL" | grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" || true)" -gt "1" ]] &>/dev/null; then
          # disregard all decimal
          DECIMAL_LIMIT="0"
        fi
      fi

      ##########################################################################

    fi
    # if zero
    if [[ -z "$DECIMAL_LIMIT" || "$(echo "$DECIMAL_LIMIT" | wc -w)" -gt "1" ]] &>/dev/null; then
      DECIMAL_LIMIT="9"
    fi
  fi

  ##############################################################################
  # include exchange fees eating up order, through decimals
  ##############################################################################

  # if decimal is less than n
  if [[ "$DECIMAL_LIMIT" -lt "5" ]] &>/dev/null; then
    DECIMAL_LIMIT_RULER="4"
  else
    DECIMAL_LIMIT_RULER="3"
  fi

  # decimal random ruler
  RANDOM_DECIMAL_RULER=$((((RANDOM % $DECIMAL_LIMIT_RULER) + 1)))
  # default
  DECIMAL_LIMIT_FLICKER="$DECIMAL_LIMIT"

  # if equal
  if [[ "$RANDOM_DECIMAL_RULER" -eq "1" ]] &>/dev/null; then
    # random check (1 + decimal limit) - (random decimal ruler + decimal limit / half-life)
    DECIMAL_LIMIT_FLICKER="$(echo "1+$DECIMAL_LIMIT-$(echo "$RANDOM_DECIMAL_RULER+$DECIMAL_LIMIT/2" | bc 2>/dev/null | awk -F. '{ print $1 }')" | bc 2>/dev/null | awk -F. '{ print $1 }')"
  fi

  # if equal
  if [[ "$RANDOM_DECIMAL_RULER" -eq "2" ]] &>/dev/null; then
    # random check (decimal limit / half-life)
    DECIMAL_LIMIT_FLICKER="$(echo "$DECIMAL_LIMIT/2" | bc 2>/dev/null | awk -F. '{ print $1 }')"
  fi

  # if equal
  if [[ "$RANDOM_DECIMAL_RULER" -eq "3" ]] &>/dev/null; then
    # random check (default)
    DECIMAL_LIMIT_FLICKER="$DECIMAL_LIMIT"
  fi

  # if equal
  if [[ "$RANDOM_DECIMAL_RULER" -eq "4" ]] &>/dev/null; then
    # random check (0)
    DECIMAL_LIMIT_FLICKER="0"
  fi

  # if zero
  if [[ "$DECIMAL_LIMIT_FLICKER" -lt "0" || -z "$DECIMAL_LIMIT_FLICKER" ]] &>/dev/null; then
    # default
    DECIMAL_LIMIT_FLICKER="$DECIMAL_LIMIT"
  fi
}

################################################################################

function insufficient_funds {
  # if not found
  if [[ ! -f "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null ]] &>/dev/null; then
    touch "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null &>/dev/null
  fi

  # xeggex
  EXCHANGE_NULL_KEYWORD="Insufficient funds"

  # if data exist
  if [[ -n "$LISTING_CURRENCY" && -n "$REFERENCE_CURRENCY" ]] &>/dev/null; then
    # null data
    NO_FUNDS="$(grep "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null | grep -c "$EXCHANGE_NULL_KEYWORD" || true)"

    # if no funds
    if [[ "$NO_FUNDS" -gt "0" ]] &>/dev/null; then
      # listing output
      echo "$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Insufficient funds! $REFERENCE_AVAILABLE_BALANCE $REFERENCE_CURRENCY" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null

      # keep record of insufficient funds ######################################
      echo "$REFERENCE_AVAILABLE_BALANCE $REFERENCE_CURRENCY" >"${LOG_DIR:?}"/leeloo/xeggex/insufficient_$BASENAME_STRATEGY
      ##########################################################################

      # cleanup null
      echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null 2>/dev/null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY" | sed '/^$/d')" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null
    fi

    # insufficient limit
    INSUFFICIENT_LIMIT="$(cat "${LOG_DIR:?}"/leeloo/xeggex/insufficient_$BASENAME_STRATEGY 2>/dev/null | awk '{ print $1 }' | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')"

    # if zero
    if [[ -z "$INSUFFICIENT_LIMIT" ]] &>/dev/null; then
      INSUFFICIENT_LIMIT="0"
    fi

    # if available balance is greater than insufficient limit
    if [[ "$(echo "$REFERENCE_AVAILABLE_BALANCE" | awk '{ printf "%.9f\n", $1 }' | tr -d '.' | sed 's/^0*//')" -gt "$INSUFFICIENT_LIMIT" ]] &>/dev/null; then
      # funds available (trade)
      NO_FUNDS="0"
    else
      # funds too small (wait)
      NO_FUNDS="1"
    fi
  fi
}

################################################################################

function delisted_market() {
  # check if delisted_xeggex file exists, create it if not
  if [[ ! -f "${SYS_DIR:?}/delisted_xeggex" ]] &>/dev/null; then
    touch "${SYS_DIR:?}/delisted_xeggex"
  fi

  # define file paths
  PRICES_FILE="${LOG_DIR:?}/leeloo/xeggex/prices"
  DELISTED_FILE="${SYS_DIR:?}/delisted_xeggex"

  # check if there are delisted markets
  if [[ -s "$DELISTED_FILE" ]] &>/dev/null; then
    if [[ "$(egrep -c "[0-9]+|[A-Z]+" "$DELISTED_FILE" || true)" -gt "0" ]] &>/dev/null; then
      # loop through the delisted markets and remove them from the prices file
      while IFS= read -r MARKET; do
        # remove the market in both formats
        sed -i "/${MARKET//\//\\/}/d" "$PRICES_FILE"
      done <"$DELISTED_FILE"
    fi
  fi
}

