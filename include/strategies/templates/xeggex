function insufficient_funds {
  NO_FUNDS="$(grep -c "$LISTING_CURRENCY/$REFERENCE_CURRENCY" "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null || true)"
  # if no funds
  if [[ "$NO_FUNDS" -gt "0" ]] &>/dev/null; then
    # cleanup null
    echo "$(cat "${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null | grep -v "$LISTING_CURRENCY/$REFERENCE_CURRENCY")" >"${SYS_DIR:?}"/robot/"$BASENAME_STRATEGY".null
    # listing output
    echo "$LOG_DATE : $EXCHANGE_API : $STRATEGY_TYPE : $LISTING_CURRENCY/$REFERENCE_CURRENCY :: Insufficient funds! $REFERENCE_AVAILABLE_BALANCE $REFERENCE_CURRENCY" >>"${LOG_DIR:?}"/leeloo/robot."$BASENAME_STRATEGY".log 2>/dev/null
    # keep record of insufficient funds
    echo "$REFERENCE_AVAILABLE_BALANCE $REFERENCE_CURRENCY" >"${LOG_DIR:?}"/leeloo/xeggex/insufficient_$BASENAME_STRATEGY
  fi

  # insufficient limit
  INSUFFICIENT_LIMIT="$(cat "${LOG_DIR:?}"/leeloo/xeggex/insufficient_$BASENAME_STRATEGY 2>/dev/null | awk '{ print $2 }' | tr -d '.' | sed 's/^0*//')"

  # if zero
  if [[ -z "$INSUFFICIENT_LIMIT" ]] &>/dev/null; then
    INSUFFICIENT_LIMIT="0"
  fi

  # if greater than limit
  if [[ "$(echo "$REFERENCE_AVAILABLE_BALANCE" | tr -d '.' | sed 's/^0*//')" -gt "$INSUFFICIENT_LIMIT" ]] &>/dev/null; then
    # limit is broken (trade)
    NO_FUNDS="0"
  else
    # not greater (wait)
    NO_FUNDS="1"
  fi
}

################################################################################

function delisted() {
  # check if delisted_xeggex file exists, create it if not
  if [[ ! -f "${SYS_DIR:?}/delisted_xeggex" ]] &>/dev/null; then
    touch "${SYS_DIR:?}/delisted_xeggex"
  fi

  # define file paths
  PRICES_FILE="${LOG_DIR:?}/leeloo/xeggex/prices"
  DELISTED_FILE="${SYS_DIR:?}/delisted_xeggex"

  # check if there are delisted markets
  if [[ -s "$DELISTED_FILE" ]] &>/dev/null; then
    # loop through the delisted markets and remove them from the prices file
    while IFS= read -r MARKET; do
      # remove the market in both formats
      sed -i "/${MARKET//\//\\/}/d" "$PRICES_FILE"
    done <"$DELISTED_FILE"
  fi
}

