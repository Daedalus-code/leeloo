  PRICES_FILE="${LOG_DIR:?}/leeloo/xeggex/prices"
  PAUSED_FILE="${LOG_DIR:?}/leeloo/xeggex/pause"
  # check if there are paused markets
  if [[ -s "$PAUSED_FILE" ]] &>/dev/null; then
    if [[ "$(egrep -c "[0-9]+|[A-Z]+" "$PAUSED_FILE" || true)" -gt "0" ]] &>/dev/null; then
      # loop through the paused markets and remove them from the prices file
      while IFS= read -r MARKET; do
        # remove the market in both formats
        sed -i "/${MARKET//\//\\/}/d" "$PRICES_FILE"
      done <"$PAUSED_FILE"
    fi
  fi
}

