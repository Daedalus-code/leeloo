################################################################################

function target_order_status() {
  # check if listing currency and reference currency are not empty
  if [[ -n "$LISTING_CURRENCY" && -n "$REFERENCE_CURRENCY" ]] &>/dev/null; then

    # calculate the age of target orders file in seconds
    TARGET_ORDERS_AGE_SECONDS=$(stat -c '%Y' "${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".trades 2>/dev/null || echo 0)

    # if age is zero, set it to 0
    [[ -z "$TARGET_ORDERS_AGE_SECONDS" ]] && TARGET_ORDERS_AGE_SECONDS=0

    # check if target orders data is old enough or doesn't exist
    if ((TARGET_ORDERS_AGE_SECONDS > 180)) || [[ ! -f "${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".trades ]]; then
      # get trades data and format it
      getTrades "$LISTING_CURRENCY" "$REFERENCE_CURRENCY" | jq -r '.[]? | "\(.id): \(.market) \(.orderid) \(.side) \(.price) \(.quantity) \(.createdAt) \(.updatedAt)"' | column -t >"${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".trades
      # get orders data, remove duplicate ID
      cat "${LOG_DIR:?}"/leeloo/xeggex/orders* 2>/dev/null | grep -w "$LISTING_CURRENCY" | grep -w "$REFERENCE_CURRENCY" | awk '!a[$1]++' >"${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".orders
    fi

    # extract relevant information
    LISTING_TRADES=$(cat "${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".trades 2>/dev/null)
    LISTING_ORDERS=$(cat "${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".orders 2>/dev/null)

    # buy order data ###########################################################

    # extract last buy order status from trades file
    BUY_TRADES_STATUS=$(echo "$LISTING_TRADES" | head -1 | grep -c "buy" || true)
    # extract a buy order from trades file
    BUYING_STATUS=$(echo "$LISTING_TRADES" | grep -c "buy" || true)

    # sell trades data #########################################################

    # extract last sell order ID from trades file
    SELL_TRADES_ID=$(echo "$LISTING_TRADES" | grep "sell" | head -1 | awk '{ print $3 }' || true)

    # if still zero
    if [[ -z "$SELL_TRADES_ID" ]] &>/dev/null; then
      # unique trade id
      SELL_TRADES_ID="K123456789EEEE987654321K"
    fi

    # sell orders data #########################################################

    # extract last sell order ID from orders file
    SELL_ORDERS_ID=$(echo "$LISTING_ORDERS" | grep "sell" | head -1 | awk '{ print $1 }' | tr -d ':' || true)

    ############################################################################

    # if zero
    if [[ -z "$SELL_ORDERS_ID" ]] &>/dev/null; then
      # if bought file exist
      if [[ -f "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought ]] &>/dev/null; then
        # bought data
        BOUGHT_DATA=$(cat "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought 2>/dev/null)
        # quest value
        BOUGHT_SELL_VALUE_QUEST="$(echo "$BOUGHT_DATA" | tail -1 | awk '{ print $4 }' | awk '{ printf "%." '$DECIMAL_LIMIT_FLICKER' "f\n", int($0 * 10^'$DECIMAL_LIMIT_FLICKER') / 10^'$DECIMAL_LIMIT_FLICKER' }')"
        # sell value
        BOUGHT_SELL_VALUE="$(echo "$LISTING_TRADES" | head -1 | grep "sell" | awk '{ print $6 }' | awk '{ printf "%." '$DECIMAL_LIMIT_FLICKER' "f\n", int($0 * 10^'$DECIMAL_LIMIT_FLICKER') / 10^'$DECIMAL_LIMIT_FLICKER' }')"
        # if same value
        if [[ "$BOUGHT_SELL_VALUE" == "$BOUGHT_SELL_VALUE_QUEST" ]] &>/dev/null; then
          # id based on identical values
          SELL_ORDERS_ID="$(echo "$LISTING_TRADES" | head -1 | awk '{ print $3 }')"
        fi
      fi
    fi

    ############################################################################

    # if any data
    if [[ -n "$SELL_ORDERS_ID" ]] &>/dev/null; then
      # keep sell order id
      echo "$SELL_ORDERS_ID" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sell_id
    fi

    # if zero
    if [[ -z "$SELL_ORDERS_ID" ]] &>/dev/null; then
      # use old id until (sold) is confirmed
      SELL_ORDERS_ID="$(cat "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sell_id 2>/dev/null || true)"
    fi

    # if still zero, again
    if [[ -z "$SELL_ORDERS_ID" ]] &>/dev/null; then
      # unique order id
      SELL_ORDERS_ID="001234567890098765432100"
    fi

    # quantity & target ########################################################

    # extract sell order quantity based on ID from trades file
    ORDER_SOLD_QUANTITY="$(echo "$LISTING_TRADES" | grep "$SELL_TRADES_ID" | awk '{ print $6 }' | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%." '$DECIMAL_LIMIT' "f\n", int($0 * 10^'$DECIMAL_LIMIT') / 10^'$DECIMAL_LIMIT' }')"

    ############################################################################

    # extract last buy order ID from trades file
    BUY_TRADES_ID=$(echo "$LISTING_TRADES" | grep "buy" | head -1 | awk '{ print $3 }' || true)

    # if any data
    if [[ -n "$BUY_TRADES_ID" ]] &>/dev/null; then
      # if bought file exist
      if [[ -f "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought ]] &>/dev/null; then
        # if trades file exist
        if [[ -f "${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".trades ]] &>/dev/null; then
          # bought data
          BOUGHT_DATA=$(cat "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought 2>/dev/null)
          # trades data
          TRADES_DATA=$(cat "${LOG_DIR:?}"/leeloo/xeggex/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".trades 2>/dev/null)
          # quest value
          BOUGHT_SELL_VALUE_QUEST="$(echo "$BOUGHT_DATA" | tail -1 | awk '{ print $4 }' | awk '{ printf "%." '$DECIMAL_LIMIT_FLICKER' "f\n", int($0 * 10^'$DECIMAL_LIMIT_FLICKER') / 10^'$DECIMAL_LIMIT_FLICKER' }')"
          # sell value
          BOUGHT_SELL_VALUE="$(echo "$TRADES_DATA" | grep -B500 "$BUY_TRADES_ID" | grep "sell" | awk '{ print $6 }' | awk '{ SUM += $1} END { print SUM }' | awk '{ printf "%." '$DECIMAL_LIMIT_FLICKER' "f\n", int($0 * 10^'$DECIMAL_LIMIT_FLICKER') / 10^'$DECIMAL_LIMIT_FLICKER' }')"
          # if same value
          if [[ "$BOUGHT_SELL_VALUE" == "$BOUGHT_SELL_VALUE_QUEST" ]] &>/dev/null; then
            # value based on equal sell values
            ORDER_SOLD_QUANTITY="$BOUGHT_SELL_VALUE"
          fi
        fi
      fi
    fi

    ############################################################################

    # sold quantity check
    ORDER_SOLD_QUANTITY_CHECK="$(echo "$ORDER_SOLD_QUANTITY" | awk '{ printf "%." '$DECIMAL_LIMIT_FLICKER' "f\n", int($0 * 10^'$DECIMAL_LIMIT_FLICKER') / 10^'$DECIMAL_LIMIT_FLICKER' }' | tr -d '.' | sed 's/^0*//')"
    # target bought amount check
    TARGET_BOUGHT_CHECK="$(cat "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".bought 2>/dev/null | tail -1 | awk '{ print $4 }' | awk '{ printf "%." '$DECIMAL_LIMIT_FLICKER' "f\n", int($0 * 10^'$DECIMAL_LIMIT_FLICKER') / 10^'$DECIMAL_LIMIT_FLICKER' }' | tr -d '.' | sed 's/^0*//')"

    # selling & sold sum #######################################################

    # if any data
    if [[ -n "$SELL_TRADES_ID" && -n "$SELL_ORDERS_ID" ]] &>/dev/null; then
      # if trades and orders id matches
      if [[ "$SELL_TRADES_ID" == "$SELL_ORDERS_ID" ]] &>/dev/null; then
        # if any data
        if [[ -n "$ORDER_SOLD_QUANTITY_CHECK" && -n "$TARGET_BOUGHT_CHECK" ]] &>/dev/null; then
          # if total sum is greater or equal to the target
          if [[ "$ORDER_SOLD_QUANTITY_CHECK" -ge "$TARGET_BOUGHT_CHECK" ]] &>/dev/null; then
            # if bot are actually trading
            if [[ "$BUYING_STATUS" -gt "0" ]] &>/dev/null; then
              # if not a new buy
              if [[ "$BUY_TRADES_STATUS" -eq "0" ]] &>/dev/null; then
                # update sold file
                echo "$ORDER_SOLD_QUANTITY" >"${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sold
                # reset sell_id
                truncate -s 0 "${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".sell_id &>/dev/null
              fi
            fi
          fi
        fi
        # track order amount being sold (constantly if id matches)
        echo "$ORDER_SOLD_QUANTITY" | sed '/^$/d' >"${SYS_DIR:?}"/robot/"${BASENAME_STRATEGY}"/"${LISTING_CURRENCY:?}"_"${REFERENCE_CURRENCY:?}".selling
      fi
    fi
  fi
}

