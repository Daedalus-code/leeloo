function setup_market_order {
  LISTING_CURRENCY=$(
    dialog --title "Listing Currency (BTC)" \
      --inputbox "Enter name:" 8 40 \
      3>&1 1>&2 2>&3 3>&-
  )

  if [[ ! -z "$LISTING_CURRENCY" ]] &>/dev/null; then

    REFERENCE_CURRENCY=$(
      dialog --title "Reference Currency (USDT)" \
        --inputbox "Enter name:" 8 40 \
        3>&1 1>&2 2>&3 3>&-
    )

    if [[ ! -z "$REFERENCE_CURRENCY" ]] &>/dev/null; then

      # currency
      LISTING_CURRENCY="$(echo "$LISTING_CURRENCY" | tr '[:lower:]' '[:upper:]')"
      REFERENCE_CURRENCY="$(echo "$REFERENCE_CURRENCY" | tr '[:lower:]' '[:upper:]')"
      # amount
      LISTING_CURRENCY_AMOUNT="$LISTING_CURRENCY: $(grep "$LISTING_CURRENCY" "${LOG_DIR:?}"/leeloo/xeggex/balances | awk '{ print $3 }')"
      REFERENCE_CURRENCY_AMOUNT="$REFERENCE_CURRENCY: $(grep "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/xeggex/balances | awk '{ print $3 }')"

      AMOUNT=$(
        dialog --title "Amount $LISTING_CURRENCY/$REFERENCE_CURRENCY" \
          --inputbox "Enter amount:
$LISTING_CURRENCY_AMOUNT $REFERENCE_CURRENCY_AMOUNT" 8 40 \
          3>&1 1>&2 2>&3 3>&-
      )
    fi
  fi
}

