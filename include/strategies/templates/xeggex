      REFERENCE_CURRENCY_AMOUNT="$REFERENCE_CURRENCY: $(grep -w "$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/xeggex/balances 2>/dev/null | awk '{ print $3 }')"
      # listing/reference price
      LISTING_REFERENCE_CURRENCY_PRICE="$REFERENCE_CURRENCY: $(egrep -w "$LISTING_CURRENCY.$REFERENCE_CURRENCY" "${LOG_DIR:?}"/leeloo/xeggex/prices 2>/dev/null | awk '{ print $4 }')"

      # ask amount
      AMOUNT=$(
        dialog --title "Amount $LISTING_CURRENCY/$REFERENCE_CURRENCY" \
          --inputbox "Enter amount:
$LISTING_CURRENCY_AMOUNT $REFERENCE_CURRENCY_AMOUNT" 8 40 \
          3>&1 1>&2 2>&3 3>&-
      )

      # if not zero
      if [[ ! -z "$AMOUNT" ]] &>/dev/null; then
        # ask price
        PRICE=$(
          dialog --title "Price $LISTING_CURRENCY/$REFERENCE_CURRENCY" \
            --inputbox "Enter price:
$LISTING_CURRENCY: $AMOUNT $LISTING_REFERENCE_CURRENCY_PRICE" 8 40 \
            3>&1 1>&2 2>&3 3>&-
        )
      fi
    fi
  fi
}

